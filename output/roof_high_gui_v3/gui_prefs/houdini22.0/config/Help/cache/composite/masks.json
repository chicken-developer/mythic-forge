{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Mask off areas of an image"], "extent": [12, 43]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Most compositing nodes support a ", {"type": "em", "text": ["mask"]}, ". The mask confines the operation\nof the node to specific areas of the input image."], "extent": [87, 211]}, {"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["Pixels of the input image corresponding to black pixels in the mask\n  are not affected at all by the operation."], "extent": [211, 326]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Pixels of the input image corresponding to white pixels in the mask\n  show the full effect of the operation."], "extent": [326, 438]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Gray pixels in the mask blend between the input and the manipulated\n  output (so, antialiased edges in the mask create antialiased edges\n  between affected and masked areas of the output image)."], "extent": [438, 636]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["If you have a mask image with opposite values (that is, it has white\n  in the areas you want to mask off), or a different size, you don\u2019t\n  need to manipulate the image directly to use it as a mask. You can use\n  the ", {"type": "ui", "text": ["Resize mask to fit image"]}, " and ", {"type": "ui", "text": ["Invert mask"]}, " options on the\n  filter node\u2019s ", {"type": "ui", "text": ["Mask"]}, " tab to fix the mask there."], "extent": [636, 972]}], "container": true}, {"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": ["Mask an operation with a separate image"], "role": "item", "extent": [972, 1019], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["Set up the compositing node that contains the mask image."], "extent": [1019, 1084]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Connect the mask node to the bottom (mask) input of the node\n      you want to mask."], "extent": [1084, 1176]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["You may need to go to the masked node\u2019s ", {"type": "ui", "text": ["Mask"]}, " tab and set\n      ", {"type": "ui", "text": ["Operation mask"]}, " to ", {"type": "q", "text": ["Mask input"]}, "."], "extent": [1176, 1286]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Mask an operation using a plane (such as Alpha) from the input"], "role": "item", "extent": [1286, 1356], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["Go to the filter node\u2019s ", {"type": "ui", "text": ["Mask"]}, " tab and set ", {"type": "ui", "text": ["Operation\n      mask"]}, " to ", {"type": "q", "text": ["First input"]}, "."], "extent": [1356, 1451]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Use the pop-up menu next to ", {"type": "q", "text": ["First input"]}, " to choose the plane\n      or component to use as the mask."], "extent": [1451, 1559], "body": [{"type": "para", "indent": 6, "text": ["Houdini displays the name of the masking plane next tot the\n      connection in the  ", {"scheme": null, "value": "/ref/panes/network", "type": "link", "text": ["network\n      editor"], "fullpath": "/ref/panes/network.html"}, " ."], "extent": [1559, 1695]}], "container": true}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Scale the effect of an operation (with or without a mask)"], "role": "item", "extent": [1695, 1760], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Go to the filter node\u2019s ", {"type": "ui", "text": ["Mask"]}, " tab and change the ", {"type": "ui", "text": ["Effect\n      amount"]}, " parameter."], "extent": [1760, 1854]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Turn off masking of a node"], "role": "item", "extent": [1854, 1888], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Go to the node\u2019s ", {"type": "ui", "text": ["Mask"]}, " tab and set ", {"type": "ui", "text": ["Operation mask"]}, " to\n      ", {"type": "q", "text": ["None"]}, "."], "extent": [1888, 1971]}], "container": true}], "container": true}], "container": true, "role": "item_group"}], "title": ["Mask off areas of an image"], "included": ["/composite/_old_cops_deprecated"]}