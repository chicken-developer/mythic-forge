{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Common image effects"], "extent": [12, 37]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["See also ", {"scheme": null, "value": "distort", "type": "link", "text": ["how to distort or convolve an image"], "fullpath": "/composite/distort.html"}, " ."], "extent": [81, 139]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Glow"], "extent": [139, 150], "body": [{"type": "para", "indent": 4, "text": ["To create a glow effect, blur the bright parts of the image."], "extent": [150, 217]}, {"tag": "steps", "attrs": {}, "type": "pxml", "indent": 4, "extent": [217, 229], "body": [{"type": "ord_group", "body": [{"blevel": 10, "type": "ord", "indent": 8, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/lumakey", "type": "link", "text": ["Lumakey operator"], "fullpath": "/nodes/cop2/lumakey.html"}, " to extract the\n          bright parts of the image as a  ", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["matte"], "fullpath": "/composite/mattes.html"}, " ."], "extent": [229, 370]}, {"blevel": 10, "type": "ord", "indent": 8, "text": ["Use a ", {"scheme": "Node", "value": "/nodes/cop2/bright", "type": "link", "text": ["Bright operator"], "fullpath": "/nodes/cop2/bright.html"}, " to increase the\n          brightness of the extracted matte (because the blurring step\n          will dim it back down)."], "extent": [370, 543]}, {"blevel": 10, "type": "ord", "indent": 8, "text": ["Use a  ", {"scheme": null, "value": "/composite/blur_sharpen", "type": "link", "text": ["blur node"], "fullpath": "/composite/blur_sharpen.html"}, "  to blur the matte. The blur\n          softens the highlights, and basically determines the amount of\n          glow."], "extent": [543, 715]}, {"blevel": 11, "type": "ord", "indent": 8, "text": [{"scheme": null, "value": "/composite/layers", "type": "link", "text": ["Combine"], "fullpath": "/composite/layers.html"}, "  the blurred matte back over the\n          original image."], "extent": [715, 814]}], "container": true}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Drop shadow"], "extent": [814, 832], "body": [{"tag": "steps", "attrs": {}, "type": "pxml", "indent": 4, "extent": [832, 845], "body": [{"type": "ord_group", "body": [{"blevel": 10, "type": "ord", "indent": 8, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/channelcopy", "type": "link", "text": ["Channel Copy operator"], "fullpath": "/nodes/cop2/channelcopy.html"}, " to set\n          the Color channel to black (or whatever color you want for the\n          shadow)."], "extent": [845, 1009]}, {"blevel": 10, "type": "ord", "indent": 8, "text": ["Use a  ", {"scheme": null, "value": "/composite/blur_sharpen", "type": "link", "text": ["blur node"], "fullpath": "/composite/blur_sharpen.html"}, "  to blur the shadow."], "extent": [1009, 1084]}, {"blevel": 10, "type": "ord", "indent": 8, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/xform", "type": "link", "text": ["Transform operator"], "fullpath": "/nodes/cop2/xform.html"}, " to offset the\n          shadow."], "extent": [1084, 1172]}, {"blevel": 11, "type": "ord", "indent": 8, "text": [{"scheme": null, "value": "/composite/layers", "type": "link", "text": ["Combine"], "fullpath": "/composite/layers.html"}, "  the original image over the shadow."], "extent": [1172, 1249]}], "container": true}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Blurs"], "extent": [1249, 1261], "body": [{"type": "para", "indent": 4, "text": ["See  ", {"scheme": null, "value": "/composite/blur_sharpen", "type": "link", "text": ["how to blur and sharpen images"], "fullpath": "/composite/blur_sharpen.html"}, " ."], "extent": [1261, 1331]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Emboss"], "extent": [1331, 1344], "body": [{"type": "para", "indent": 4, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/emboss", "type": "link", "text": ["Emboss operator"], "fullpath": "/nodes/cop2/emboss.html"}, " can fake lighting by using\n    luminance to extract bumps, and apply specular highlights."], "extent": [1344, 1479]}, {"type": "para", "indent": 4, "text": ["If you already have a bump map, connect it to the second input of\n    Emboss to override the automatic bump detection."], "extent": [1479, 1604]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 4, "role": "item", "extent": [1604, 1613], "body": [{"type": "para", "indent": 8, "text": ["For more advanced embossing, use the ", {"scheme": "Node", "value": "/nodes/cop2/light", "type": "link", "text": ["Lighting\n        operator"], "fullpath": "/nodes/cop2/light.html"}, " with bump mapped lighting. The\n        Lighting COP can add atmospheric effects as well."], "extent": [1613, 1792]}], "container": true}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Fake caustics"], "extent": [1792, 1812], "body": [{"type": "para", "indent": 4, "text": ["Caustics are made up of several layers of luminance noise."], "extent": [1812, 1877]}, {"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["The base layer is a gradual modulation of brightness. This is best\n      accomplished with alligator noise, which produces the cell-like\n      quality of underwater caustics."], "extent": [1877, 2059]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["The specular layer is made up of sharp spikes of focused light.\n      This can be done by edge detecting the noise to extract prominent\n      lines, and then pulling out the brightest parts. Adjust the gamma\n      to further pull specks out of the lines, and then blur slightly to\n      avoid pixelation."], "extent": [2059, 2371]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Multiply the image by the base layer, and use over or screen to\n      composite the specular highlights in."], "extent": [2371, 2486]}], "container": true}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/caustics.jpg", "type": "img", "text": ""}], "extent": [2486, 2520]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Fake table-top reflection"], "extent": [2520, 2552], "body": [{"tag": "steps", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2552, 2565], "body": [{"type": "ord_group", "body": [{"blevel": 10, "type": "ord", "indent": 8, "text": ["Create the reflection with the ", {"scheme": "Node", "value": "/nodes/cop2/pin", "type": "link", "text": ["Pin operator"], "fullpath": "/nodes/cop2/pin.html"}, ".\n          Move the corners so they form an upside-down trapezoid, with\n          the bottom along the axis of reflection."], "extent": [2565, 2759]}, {"blevel": 10, "type": "ord", "indent": 8, "text": ["To blur the reflection, use the ", {"scheme": "Node", "value": "/nodes/cop2/ramp", "type": "link", "text": ["Ramp operator"], "fullpath": "/nodes/cop2/ramp.html"}, "\n          to create a vertical ramp fill with black at the axis of\n          reflection, increasing to white away from the axis. Connect\n          this to the  ", {"scheme": null, "value": "/nodes/cop2/", "type": "link", "text": ["mask input"], "fullpath": "/nodes/cop2/index.html"}, "  of a  ", {"scheme": null, "value": "/composite/blur_sharpen", "type": "link", "text": ["blur\n          node"], "fullpath": "/composite/blur_sharpen.html"}, "  (with per-pixel on). This blurs little at the\n          closest point of reflection (black in the mask) and more\n          further away (white in the mask). Adjust the blur amount."], "extent": [2759, 3254]}, {"blevel": 10, "type": "ord", "indent": 8, "text": ["Use an ", {"scheme": "Node", "value": "/nodes/cop2/hsv", "type": "link", "text": ["HSV operator"], "fullpath": "/nodes/cop2/hsv.html"}, " to reduce the saturation\n          of the reflection. Use a ", {"scheme": "Node", "value": "/nodes/cop2/bright", "type": "link", "text": ["Bright operator"], "fullpath": "/nodes/cop2/bright.html"}, " to\n          dim the reflection to make it more subtle. You can also use a\n          ", {"scheme": "Node", "value": "/nodes/cop2/gamma", "type": "link", "text": ["Gamma operator"], "fullpath": "/nodes/cop2/gamma.html"}, " to wash out the reflection."], "extent": [3254, 3542]}, {"blevel": 11, "type": "ord", "indent": 8, "text": [{"scheme": null, "value": "/composite/layers", "type": "link", "text": ["Combine"], "fullpath": "/composite/layers.html"}, "  the reflection, the original image,\n          and any background plates."], "extent": [3542, 3656]}], "container": true}], "container": true}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/reflect.jpg", "type": "img", "text": ""}], "extent": [3656, 3689]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Borders"], "extent": [3689, 3703], "body": [{"type": "para", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/border", "type": "link", "text": ["Border operator"], "fullpath": "/nodes/cop2/border.html"}, " to a solid color border\n    around the image, either by increasing the resolution to accommodate\n    the border, or by overwriting some of the edge information."], "extent": [3703, 3914]}]}], "title": ["Common image effects"], "included": ["/composite/_old_cops_deprecated"]}