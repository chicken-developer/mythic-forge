{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Distort or convolve an image"], "extent": [12, 45]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["General convolutions"], "extent": [89, 116], "body": [{"type": "para", "indent": 4, "text": ["To apply general convolution kernels, use the ", {"scheme": "Node", "value": "/nodes/cop2/convolve", "type": "link", "text": ["Convolve\n    operator"], "fullpath": "/nodes/cop2/convolve.html"}, ". You can specify up to a 9\u00d79 kernel in\n    the node\u2019s parameters, or connect an image to use as a kernel."], "extent": [116, 318]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 4, "role": "item", "extent": [318, 327], "body": [{"type": "para", "indent": 8, "text": ["Convolving images is a slow operation, so try to keep the the\n        kernel image smaller than 50\u00d750."], "extent": [327, 439]}], "container": true}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Image displacement maps"], "extent": [439, 469], "body": [{"type": "para", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/deform", "type": "link", "text": ["Deform operator"], "fullpath": "/nodes/cop2/deform.html"}, " to move pixels based on a\n    displacement map."], "extent": [469, 566]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Waves and ripples"], "extent": [566, 590], "body": [{"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/water_reflect.jpg", "type": "img", "text": ""}], "extent": [590, 630]}, {"type": "para", "indent": 4, "text": ["You can use slowly animated, smooth noise as the basis for\n    concentric ripples. Use a cycling ", {"scheme": "Node", "value": "/nodes/cop2/ramp", "type": "link", "text": ["Ramp node"], "fullpath": "/nodes/cop2/ramp.html"}, " with a\n    range from 0 to 1 and an interpolation of ", {"type": "q", "text": ["Ease in Ease Out"]}, " to\n    create ripples (concentric ramp) or waves (rotated horizontal map)."], "extent": [630, 906]}, {"type": "para", "indent": 4, "text": ["Create a ", {"scheme": "Node", "value": "/nodes/cop2/deform", "type": "link", "text": ["Deform node"], "fullpath": "/nodes/cop2/deform.html"}, " and use the noise to\n    displace the image."], "extent": [906, 996]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/water_ripple.jpg", "type": "img", "text": ""}], "extent": [996, 1034]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/ripple.jpg", "type": "img", "text": ""}], "extent": [1034, 1066]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 4, "role": "item", "extent": [1066, 1075], "body": [{"type": "para", "indent": 8, "text": ["You should use  ", {"scheme": null, "value": "comp_terms#comp_datatypes", "type": "link", "text": ["floating point\n        images"], "fullpath": "/composite/comp_terms.html#comp_datatypes", "fragment": "#comp_datatypes"}, "  for distortion maps whenever\n        possible. Otherwise, quantization errors can cause unwanted\n        noise in the image."], "extent": [1075, 1285]}], "container": true}], "container": true, "role": "item_group"}]}], "title": ["Distort or convolve an image"], "included": ["/composite/_old_cops_deprecated"]}