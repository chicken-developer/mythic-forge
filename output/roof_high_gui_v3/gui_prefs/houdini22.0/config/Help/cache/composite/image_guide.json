{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Image guide file"], "extent": [12, 33]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["An image guide file is a text file containing one or more drawing\ncommands which describe guides to overlay on compositing images."], "extent": [77, 209]}, {"tag": "steps", "attrs": {}, "type": "pxml", "indent": 0, "extent": [209, 217], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["In a compositing viewer pane, open the right side toolbar and click ", {"scheme": "Icon", "value": "BUTTONS/chooser", "type": "link", "text": "", "fullpath": "/composite/BUTTONS/chooser.html"}, " Display Options or press ", {"keys": ["D"], "type": "keys", "text": null}, " to open the Display Options window."], "extent": [217, 382]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Click the ", {"type": "ui", "text": ["Viewport"]}, " tab."], "extent": [382, 417]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Use the ", {"type": "ui", "text": ["Image Guide"]}, " option to set the image guide file to\n      use."], "extent": [417, 497]}], "container": true}], "container": true}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Commands"], "extent": [497, 512], "body": [{"type": "para", "indent": 4, "text": ["All coordinates are expressed in pixels."], "extent": [512, 559]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["color ", {"type": "var", "text": ["R"]}, " ", {"type": "var", "text": ["G"]}, " ", {"type": "var", "text": ["B"]}, " ", {"type": "var", "text": ["A"]}, " "]}, " "], "extent": [559, 598], "body": [{"type": "para", "indent": 8, "text": ["Sets the drawing color."], "extent": [598, 630]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["box ", {"type": "var", "text": ["X"]}, " ", {"type": "var", "text": ["Y"]}, " ", {"type": "var", "text": ["Width"]}, " ", {"type": "var", "text": ["Height"]}, " "]}, " "], "extent": [630, 676], "body": [{"type": "para", "indent": 8, "text": ["Draws a box at (", {"type": "var", "text": ["X"]}, ",", {"type": "var", "text": ["Y"]}, ") with the specified ", {"type": "var", "text": ["Width"]}, " and\n        ", {"type": "var", "text": ["Height"]}, "."], "extent": [676, 766]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["rect ", {"type": "var", "text": ["X1"]}, " ", {"type": "var", "text": ["Y1"]}, " ", {"type": "var", "text": ["X2"]}, " ", {"type": "var", "text": ["Y2"]}, " "]}, " "], "extent": [766, 808], "body": [{"type": "para", "indent": 8, "text": ["Draws a box with one corner at (", {"type": "var", "text": ["X1"]}, ", ", {"type": "var", "text": ["Y1"]}, ") and the opposite\n        corner at (", {"type": "var", "text": ["X2"]}, ", ", {"type": "var", "text": ["Y2"]}, ")."], "extent": [808, 917]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["line ", {"type": "var", "text": ["X1"]}, " ", {"type": "var", "text": ["Y1"]}, " ", {"type": "var", "text": ["X2"]}, " ", {"type": "var", "text": ["Y2"]}, " "]}, " "], "extent": [917, 959], "body": [{"type": "para", "indent": 8, "text": ["Draws a line from (", {"type": "var", "text": ["X1"]}, ", ", {"type": "var", "text": ["Y1"]}, ") to (", {"type": "var", "text": ["X2"]}, ", ", {"type": "var", "text": ["Y2"]}, ")."], "extent": [959, 1023]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["lines ", {"type": "var", "text": ["N"]}, " ", {"type": "var", "text": ["dX"]}, " ", {"type": "var", "text": ["dY"]}, " ", {"type": "var", "text": ["X1"]}, " ", {"type": "var", "text": ["Y1"]}, " ", {"type": "var", "text": ["X2"]}, " ", {"type": "var", "text": ["Y2"]}, " "]}, " "], "extent": [1023, 1086], "body": [{"type": "para", "indent": 8, "text": ["Draws ", {"type": "var", "text": ["N"]}, " lines from (", {"type": "var", "text": ["X1"]}, ", ", {"type": "var", "text": ["Y1"]}, ") to (", {"type": "var", "text": ["X2"]}, ", ", {"type": "var", "text": ["Y2"]}, "),\n        offsetting both coordinate pairs by ( ", {"type": "var", "text": ["dX"]}, ", ", {"type": "var", "text": ["dY"]}, ") each time.\n        Use this to draw grids."], "extent": [1086, 1261]}], "container": true}], "container": true}]}], "title": ["Image guide file"], "included": ["/composite/_old_cops_deprecated"]}