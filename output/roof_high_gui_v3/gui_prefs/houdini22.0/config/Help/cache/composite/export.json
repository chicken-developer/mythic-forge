{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Use compositor images in other nodes"], "extent": [12, 53]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"tag": "table", "attrs": {}, "type": "pxml", "indent": 0, "extent": [97, 105], "body": [{"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [105, 114], "body": [{"tag": "th", "attrs": {}, "type": "pxml", "indent": 8, "text": ["To use compositor data here\u2026"], "extent": [114, 157]}, {"tag": "th", "attrs": {}, "type": "pxml", "indent": 8, "text": ["Do this\u2026"], "extent": [157, 180]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [180, 198], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["Any parameter that expects an image file."], "extent": [198, 252]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [252, 265], "body": [{"type": "para", "indent": 12, "text": ["Instead of entering a filename, use ", {"type": "code", "text": ["op:", {"type": "var", "text": ["path_to_cop_node"]}, "\n            "]}, ". This will load the Color and Alpha data from the COP node\n            as an RGBA image."], "extent": [265, 442]}, {"type": "warning_group", "body": [{"type": "warning", "indent": 12, "role": "item", "extent": [442, 463], "body": [{"type": "para", "indent": 16, "text": ["This will not work in VOPs. The VEX code generated by\n                VOPs cannot do this kind of dynamic image reference."], "extent": [463, 603]}, {"type": "para", "indent": 16, "text": ["Instead, fetch the image in the shader node (SHOP) that\n                encapsulates the VOP shader network."], "extent": [603, 729]}], "container": true}], "container": true, "role": "item_group"}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [729, 738], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Node", "value": "/nodes/sop/trace", "type": "link", "text": ["Trace SOP"], "fullpath": "/nodes/sop/trace.html"}], "extent": [738, 777]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [777, 790], "body": [{"type": "para", "indent": 12, "text": ["Creates curve geometry from the color contours of an image.\n            It has an explicit option to take data from a COP node instead\n            of an image file."], "extent": [790, 976]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [976, 985], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Node", "value": "/nodes/pop/color", "type": "link", "text": ["Color POP"], "fullpath": "/nodes/pop/color.html"}], "extent": [985, 1024]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [1024, 1037], "body": [{"type": "para", "indent": 12, "text": ["Colors particles based on the pixel colors of an image. It\n            has an explicit option to take data from a COP node instead of\n            an image file."], "extent": [1037, 1210]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1210, 1219], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Node", "value": "/nodes/chop/image", "type": "link", "text": ["Image CHOP"], "fullpath": "/nodes/chop/image.html"}], "extent": [1219, 1260]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [1260, 1273], "body": [{"type": "para", "indent": 12, "text": ["Converts scanlines of an image from a COP node into\n            channels. You can fetch sub-regions of the image instead of the\n            full image."], "extent": [1273, 1438]}], "container": true}], "container": true}], "container": true}], "title": ["Use compositor images in other nodes"], "included": ["/composite/_old_cops_deprecated"]}