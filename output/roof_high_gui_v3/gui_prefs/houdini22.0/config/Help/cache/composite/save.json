{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Save composited data to disk"], "extent": [12, 45]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": ["Save the image in a node"], "role": "item", "extent": [89, 121], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Press ", {"keys": ["RMB"], "type": "keys", "text": null}, " on the node tile and choose ", {"type": "ui", "text": ["Save Image"]}, "."], "extent": [121, 194]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Save the image in the viewer"], "role": "item", "extent": [194, 230], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Press ", {"keys": ["RMB"], "type": "keys", "text": null}, " in the viewer and choose ", {"type": "ui", "text": ["Save Image"]}, "."], "extent": [230, 292]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Render the result of a compositing network"], "role": "item", "extent": [292, 342], "body": [{"type": "para", "indent": 4, "text": ["Create a ", {"scheme": "Node", "value": "/nodes/out/comp", "type": "link", "text": ["Composite render node"], "fullpath": "/nodes/out/comp.html"}, " (in a render network), or a ", {"scheme": "Node", "value": "/nodes/cop2/rop_comp", "type": "link", "text": ["ROP file output compositing node"], "fullpath": "/nodes/cop2/rop_comp.html"}, " (in a compositing network) and point it at the compositing node to render."], "extent": [342, 559]}, {"type": "para", "indent": 4, "text": ["Using a ", {"scheme": "Node", "value": "/nodes/out/comp", "type": "link", "text": ["Composite render node"], "fullpath": "/nodes/out/comp.html"}, " lets you set up ", {"scheme": null, "value": "/render/batch", "type": "link", "text": ["render dependencies"], "fullpath": "/render/batch.html"}, " between renders and compositing jobs."], "extent": [559, 700]}], "container": true}], "container": true, "role": "item_group"}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [700, 705], "body": [{"type": "para", "indent": 4, "text": ["You can optionally apply a  ", {"scheme": null, "value": "luts", "type": "link", "text": ["color look-up table (LUT)"], "fullpath": "/composite/luts.html"}, "\n    to the output as you save it."], "extent": [705, 805]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Mapping planes to image channels"], "extent": [805, 844], "body": [{"type": "para", "indent": 4, "text": ["When you save to a file format that supports deep rasters (Houdini\n    ", {"type": "code", "text": ["pic"]}, " format), you can save all planes. When you save image data to\n    a non-deep raster image file format such as TIFF, you can map\n    different planes to the 3 or 4 channels available."], "extent": [844, 1110]}, {"type": "para", "indent": 4, "text": ["For example, the regular mapping would be to store the Color\n    channels (", {"type": "code", "text": ["C.r"]}, ", ", {"type": "code", "text": ["C.g"]}, ", ", {"type": "code", "text": ["C.b"]}, ") in the TIFF\u2019s RGB channels and the\n    Alpha (", {"type": "code", "text": ["A"]}, ") plane in the TIFF\u2019s Alpha channel. However, you could\n    instead choose to store the Normal plane in the TIFF\u2019s RGB channels,\n    and store the Depth plane in the TIFF\u2019s Alpha channel."], "extent": [1110, 1450]}]}], "title": ["Save composited data to disk"], "included": ["/composite/_old_cops_deprecated"]}