{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Create shapes and text"], "extent": [12, 39]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": ["Create simple shapes such as rectangles, polygons, circles, and triangles"], "role": "item", "extent": [83, 164], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["In the compositor network editor,\n      create a ", {"scheme": "Node", "value": "/nodes/cop2/shape", "type": "link", "text": ["Shape node"], "fullpath": "/nodes/cop2/shape.html"}, "."], "extent": [164, 250]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Use the parameters in the node\u2019s parameter editor to choose\n      the type of shape, number of points, radius, etc."], "extent": [250, 373]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Create complex and free-form spline shapes"], "role": "item", "extent": [373, 423], "body": [{"type": "para", "indent": 4, "text": ["In the compositor network editor,\n    create a ", {"scheme": "Node", "value": "/nodes/cop2/rotoshape", "type": "link", "text": ["Rotoshape node"], "fullpath": "/nodes/cop2/rotoshape.html"}, "."], "extent": [423, 513]}, {"type": "para", "indent": 4, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/rotoshape", "type": "link", "text": ["online help for Rotoshape"], "fullpath": "/nodes/cop2/rotoshape.html"}, " has\n    extensive information on how to use it to create spline\n    shapes."], "extent": [513, 646]}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Create text"], "role": "item", "extent": [646, 665], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/font", "type": "link", "text": ["Font operator"], "fullpath": "/nodes/cop2/font.html"}, " to create an image\n      containing text."], "extent": [665, 753]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Type the text to render into the ", {"type": "ui", "text": ["Text"]}, " field, or specify a\n      ", {"type": "ui", "text": ["Text file"]}, " from which to get the text."], "extent": [753, 870]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Use the ", {"type": "ui", "text": ["Text size"]}, " to resize the text."], "extent": [870, 919]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Use the ", {"type": "ui", "text": ["Color"]}, " parameter on the ", {"type": "ui", "text": ["Layout"]}, " tab to set the\n      color of the text."], "extent": [919, 1014]}], "container": true}], "container": true}], "container": true, "role": "item_group"}], "title": ["Create shapes and text"], "included": ["/composite/_old_cops_deprecated"]}