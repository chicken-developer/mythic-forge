{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Blend or layer images"], "extent": [12, 38]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Useful nodes"], "extent": [113, 132], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/layer", "type": "link", "text": ["Layer COP"], "fullpath": "/nodes/cop2/layer.html"}, " is a general purpose compositor, which\n  can composite any number of inputs, each with its own compositing\n  method."], "extent": [132, 285]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["You can also use specific operators for each method on pairs of inputs\n  (with the ", {"scheme": "Node", "value": "/nodes/cop2/over", "type": "link", "text": ["Over COP"], "fullpath": "/nodes/cop2/over.html"}, ", ", {"scheme": "Node", "value": "/nodes/cop2/add", "type": "link", "text": ["Add COP"], "fullpath": "/nodes/cop2/add.html"}, ",\n  ", {"scheme": "Node", "value": "/nodes/cop2/multiply", "type": "link", "text": ["Multiply COP"], "fullpath": "/nodes/cop2/multiply.html"}, ", etc.)."], "extent": [285, 467]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/blend", "type": "link", "text": ["Blend COP"], "fullpath": "/nodes/cop2/blend.html"}, " blends between its two inputs. It can\n  blend with a constant value, or based on a  ", {"scheme": null, "value": "/composite/masks", "type": "link", "text": ["mask"], "fullpath": "/composite/masks.html"}, " ."], "extent": [467, 612], "body": [{"type": "para", "indent": 2, "text": [{"scheme": "Image", "value": "/images/blend_mask.jpg", "type": "img", "text": ""}], "extent": [612, 646]}], "container": true}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/wipe", "type": "link", "text": ["Wipe COP"], "fullpath": "/nodes/cop2/wipe.html"}, " lets you quickly set up common wipe\n  patterns. For complete control over a wipe, use an animated\n  ", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["matte"], "fullpath": "/composite/mattes.html"}, "  to mask a blend."], "extent": [646, 823]}], "container": true}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [823, 829], "body": [{"type": "para", "indent": 4, "text": ["See  ", {"scheme": null, "value": "layers", "type": "link", "text": ["compositing methods"], "fullpath": "/composite/layers.html"}, "  for an explanation of the\n    different compositing methods available for combining images, such\n    as ", {"type": "em", "text": ["over"]}, ", ", {"type": "em", "text": ["add"]}, ", and ", {"type": "em", "text": ["multiply"]}, "."], "extent": [829, 1004]}], "container": true}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Compositing methods"], "extent": [1004, 1030], "body": [{"tag": "table", "attrs": {}, "type": "pxml", "indent": 0, "extent": [1030, 1039], "body": [{"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1039, 1048], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_a.png", "type": "img", "text": ""}], "extent": [1048, 1087]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["Original image ", {"type": "strong", "text": ["A"]}], "extent": [1087, 1118]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1118, 1127], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_b.png", "type": "img", "text": ""}], "extent": [1127, 1166]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["Original image ", {"type": "strong", "text": ["B"]}], "extent": [1166, 1197]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1197, 1206], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_1.png", "type": "img", "text": ""}], "extent": [1206, 1252]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["over"]}, " B"], "extent": [1252, 1275]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1275, 1284], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_2.png", "type": "img", "text": ""}], "extent": [1284, 1330]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["under"]}, " B"], "extent": [1330, 1354]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1354, 1363], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_3.png", "type": "img", "text": ""}], "extent": [1363, 1409]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["atop"]}, " B"], "extent": [1409, 1432]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1432, 1441], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_4.png", "type": "img", "text": ""}], "extent": [1441, 1487]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["inside"]}, " B"], "extent": [1487, 1512]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1512, 1521], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_5.png", "type": "img", "text": ""}], "extent": [1521, 1567]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["outside"]}, " B"], "extent": [1567, 1593]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1593, 1602], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_6.png", "type": "img", "text": ""}], "extent": [1602, 1648]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["screen"]}, "-ed over B."], "extent": [1648, 1682], "body": [{"type": "para", "indent": 12, "text": [{"type": "q", "text": ["Saturating add"]}, ". Screening brightens the second image based\n            on the luminosity of the first image. Where the first image\n            is black, the second image will not be brightened at all.\n            Where the first image is white, the second image will be\n            white. Screen does not work well with HDR images."], "extent": [1682, 2029]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2029, 2038], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_7.png", "type": "img", "text": ""}], "extent": [2038, 2084]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["add"]}, "-ed to B."], "extent": [2084, 2113], "body": [{"type": "para", "indent": 12, "text": ["This simply adds the color values of the two images\n            together."], "extent": [2113, 2200]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2200, 2209], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_8.png", "type": "img", "text": ""}], "extent": [2209, 2255]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["subtract"]}, "-ed from B."], "extent": [2255, 2291], "body": [{"type": "para", "indent": 12, "text": ["This simply subtracts the color values of A from B."], "extent": [2291, 2356]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2356, 2365], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_9.png", "type": "img", "text": ""}], "extent": [2365, 2411]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["diff"]}, " B"], "extent": [2411, 2434], "body": [{"type": "para", "indent": 12, "text": ["This takes the ", {"type": "em", "text": ["absolute"]}, " value of subtracting A from B."], "extent": [2434, 2504]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2504, 2513], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_10.png", "type": "img", "text": ""}], "extent": [2513, 2560]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["multiply"]}, " by B."], "extent": [2560, 2591], "body": [{"type": "para", "indent": 12, "text": ["This simply multiplies the color values of A and B.\n            Multiplying with a grayscale  ", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["matte"], "fullpath": "/composite/mattes.html"}, "  is the\n            same as  ", {"scheme": null, "value": "/composite/masks", "type": "link", "text": ["masking"], "fullpath": "/composite/masks.html"}, " ."], "extent": [2591, 2782]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2782, 2791], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_11.png", "type": "img", "text": ""}], "extent": [2791, 2838]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["min"]}, " B"], "extent": [2838, 2860], "body": [{"type": "para", "indent": 12, "text": ["Takes the minimum of A and B."], "extent": [2860, 2903]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [2903, 2912], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_12.png", "type": "img", "text": ""}], "extent": [2912, 2959]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["max"]}, " B"], "extent": [2959, 2981], "body": [{"type": "para", "indent": 12, "text": ["Takes the maximum of A and B."], "extent": [2981, 3024]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [3024, 3033], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_13.png", "type": "img", "text": ""}], "extent": [3033, 3080]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["average"]}, " B"], "extent": [3080, 3106], "body": [{"type": "para", "indent": 12, "text": ["Takes the average of A and B."], "extent": [3106, 3149]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [3149, 3158], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [{"scheme": "Image", "value": "/images/comp_method_14.png", "type": "img", "text": ""}], "extent": [3158, 3205]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": ["A ", {"type": "strong", "text": ["Xor"]}, " B"], "extent": [3205, 3227], "body": [{"type": "para", "indent": 12, "text": ["The union of A and B, except where A and B overlap."], "extent": [3227, 3294]}], "container": true}], "container": true}], "container": true}]}], "title": ["Blend or layer images"], "included": ["/composite/_old_cops_deprecated"]}