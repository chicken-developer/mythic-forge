{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Work with planes"], "extent": [12, 33]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": ["Copy image data from one image into a plane of another image"], "role": "item", "extent": [77, 145], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["Create a ", {"scheme": "Node", "value": "/nodes/cop2/channelcopy", "type": "link", "text": ["Channel Copy node"], "fullpath": "/nodes/cop2/channelcopy.html"}, "."], "extent": [145, 204]}, {"blevel": 7, "type": "ord", "indent": 4, "text": [{"scheme": null, "value": "/ref/panes/network", "type": "link", "text": ["Connect"], "fullpath": "/ref/panes/network.html"}, "  the compositing node (usually a [File\n      node|Node:cop2/file]) containing the color image to the first\n      input, and the compositing node containing the deep raster\n      plane to the second input."], "extent": [204, 446]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["In the Channel Copy node\u2019s parameters, set ", {"type": "ui", "text": ["Source"]}, " to\n      ", {"type": "q", "text": ["Input 2"]}, " and set ", {"type": "ui", "text": ["Target"]}, " to the name of the deep raster\n      plane you're importing."], "extent": [446, 606]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Create planes from scratch"], "role": "item", "extent": [606, 640], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Add a  ", {"scheme": null, "value": "/composite/", "type": "link", "text": ["generator node"], "fullpath": "/composite/index.html"}, "  and on its\n      ", {"type": "ui", "text": ["Image"]}, " tab set the ", {"type": "ui", "text": ["Add plane"]}, " parameter."], "extent": [640, 748]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Use one image as the alpha channel of another image"], "role": "item", "extent": [748, 807], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/switchalpha", "type": "link", "text": ["Switch Alpha COP"], "fullpath": "/nodes/cop2/switchalpha.html"}, " moves the alpha\n      plane from its second input into its first input."], "extent": [807, 931]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Use color data as the basis for the alpha channel"], "role": "item", "extent": [931, 988], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["See  ", {"scheme": null, "value": "keying", "type": "link", "text": ["keying"], "fullpath": "/composite/keying.html"}, " ."], "extent": [988, 1019]}], "container": true}], "container": true}], "container": true, "role": "item_group"}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [1019, 1024], "body": [{"type": "para", "indent": 4, "text": ["You can also use the Channel Copy operator to swap image data\n    between planes/components or inputs."], "extent": [1024, 1134]}], "container": true}], "container": true, "role": "item_group"}], "title": ["Work with planes"], "included": ["/composite/_old_cops_deprecated"]}