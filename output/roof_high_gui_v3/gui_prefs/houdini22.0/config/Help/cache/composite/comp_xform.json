{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Position, resize, rotate, and crop image layers"], "extent": [12, 64]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": ["Move, resize, or rotate an image"], "role": "item", "extent": [108, 148], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/xform", "type": "link", "text": ["Transform operator"], "fullpath": "/nodes/cop2/xform.html"}, " to move, rotate,\n      or scale an image ", {"type": "em", "text": ["without changing the canvas size"]}, ". (If you\n      scale the image outside the current canvas size, it will be\n      cropped. If you scale it down, the canvas will have empty\n      pixels around the resized image.)"], "extent": [148, 455]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/scale", "type": "link", "text": ["Scale operator"], "fullpath": "/nodes/cop2/scale.html"}, " to resize an image\n      and change the canvas size."], "extent": [455, 556]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Crop an image"], "role": "item", "extent": [556, 577], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/crop", "type": "link", "text": ["Crop operator"], "fullpath": "/nodes/cop2/crop.html"}, " to crop an image and\n      change its size."], "extent": [577, 667]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Crop an image to a shape"], "role": "item", "extent": [667, 699], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["See  ", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["how to work with mattes"], "fullpath": "/composite/mattes.html"}, " ."], "extent": [699, 757]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Increase the size of the image canvas"], "role": "item", "extent": [757, 802], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/border", "type": "link", "text": ["Border operator"], "fullpath": "/nodes/cop2/border.html"}, " to add empty pixels\n      around the edges of an image. The border can also write a\n      border over existing pixels inside an image."], "extent": [802, 987]}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Do simple perspective and shearing"], "role": "item", "extent": [987, 1029], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Use the ", {"scheme": "Node", "value": "/nodes/cop2/pin", "type": "link", "text": ["Pin operator"], "fullpath": "/nodes/cop2/pin.html"}, " to stretch an image into\n      an arbitrary quadrilateral shape."], "extent": [1029, 1138], "body": [{"type": "para", "indent": 6, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/unpin", "type": "link", "text": ["Unpin operator"], "fullpath": "/nodes/cop2/unpin.html"}, " performs the opposite\n      function: it extracts an arbitrary quadrilateral shape from an\n      image and stretches it into a regular rectangular shape."], "extent": [1138, 1336]}], "container": true}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": ["Distort the image"], "role": "item", "extent": [1336, 1361], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["See  ", {"scheme": null, "value": "distort", "type": "link", "text": ["how to distort or convolve an image"], "fullpath": "/composite/distort.html"}, " ."], "extent": [1361, 1421]}], "container": true}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["how to work with mattes"], "fullpath": "/composite/mattes.html"}, "  for additional ways to resize\n", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["mattes"], "fullpath": "/composite/mattes.html"}, " ."], "extent": [1421, 1532]}], "title": ["Position, resize, rotate, and crop image layers"], "included": ["/composite/_old_cops_deprecated"]}