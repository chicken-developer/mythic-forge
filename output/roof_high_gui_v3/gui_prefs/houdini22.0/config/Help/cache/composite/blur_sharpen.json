{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Blur or sharpen the image"], "extent": [12, 42]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [86, 91], "body": [{"type": "para", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/blur", "type": "link", "text": ["Blur"], "fullpath": "/nodes/cop2/blur.html"}, ", ", {"scheme": "Node", "value": "/nodes/cop2/defocus", "type": "link", "text": ["Defocus"], "fullpath": "/nodes/cop2/defocus.html"}, ", and ", {"scheme": "Node", "value": "/nodes/cop2/sharpen", "type": "link", "text": ["Sharpen"], "fullpath": "/nodes/cop2/sharpen.html"}, " can use a\n    ", {"scheme": null, "value": "/composite/mattes", "type": "link", "text": ["matte"], "fullpath": "/composite/mattes.html"}, "  to control the per-pixel effect amount (black\n    is no blur/sharpen, white is maximum blur/sharpen)."], "extent": [91, 323]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/perpixelblur.jpg", "type": "img", "text": ""}], "extent": [323, 363]}], "container": true}, {"type": "tip", "indent": 0, "role": "item", "extent": [363, 368], "body": [{"type": "para", "indent": 4, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop2/xform", "type": "link", "text": ["Transform COP"], "fullpath": "/nodes/cop2/xform.html"}, " and all  ", {"scheme": null, "value": "/composite/layers", "type": "link", "text": ["compositing\n    operators"], "fullpath": "/composite/layers.html"}, "  that have a transformation option let you\n    add motion blur to the transformation."], "extent": [368, 551]}], "container": true}], "container": true, "role": "item_group"}, {"tag": "table", "attrs": {}, "type": "pxml", "indent": 0, "extent": [551, 559], "body": [{"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [559, 568], "body": [{"tag": "th", "attrs": {}, "type": "pxml", "indent": 8, "text": [" To do this\u2026"], "extent": [568, 595]}, {"tag": "th", "attrs": {}, "type": "pxml", "indent": 8, "text": [" Use this operator"], "extent": [595, 626]}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [626, 635], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [" Blur"], "extent": [635, 653]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [653, 666], "body": [{"type": "para", "indent": 12, "text": [{"scheme": "Node", "value": "/nodes/cop2/blur", "type": "link", "text": ["Blur COP"], "fullpath": "/nodes/cop2/blur.html"}], "extent": [666, 705]}, {"type": "para", "indent": 12, "text": [{"scheme": "Image", "value": "/images/normalblur.jpg", "type": "img", "text": ""}], "extent": [705, 749]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [749, 758], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [" Blur edges"], "extent": [758, 782]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [782, 795], "body": [{"type": "para", "indent": 12, "text": [{"scheme": "Node", "value": "/nodes/cop2/edgeblur", "type": "link", "text": ["Edge Blur COP"], "fullpath": "/nodes/cop2/edgeblur.html"}], "extent": [795, 842]}], "container": true}], "c