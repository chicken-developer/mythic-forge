, "type": "img", "text": ""}, "\n            ", {"scheme": "Image", "value": "/images/angularblur.jpg", "type": "img", "text": ""}], "extent": [1272, 1360]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1360, 1369], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [" Motion blur"], "extent": [1369, 1394]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [1394, 1407], "body": [{"type": "para", "indent": 12, "text": ["When animating transformations using the ", {"scheme": "Node", "value": "/nodes/cop2/xform", "type": "link", "text": ["Transform\n            COP"], "fullpath": "/nodes/cop2/xform.html"}, " or the  ", {"scheme": null, "value": "/composite/layers", "type": "link", "text": ["compositing\n            operators"], "fullpath": "/composite/layers.html"}, "  with a transformation option, you\n            can add motion blur to the transformation with the ", {"type": "ui", "text": ["Motion\n            blur"]}, " parameter on the ", {"type": "ui", "text": ["Transform"]}, " tab."], "extent": [1407, 1728]}], "container": true}], "container": true}, {"tag": "tr", "attrs": {}, "type": "pxml", "indent": 4, "extent": [1728, 1737], "body": [{"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "text": [" Sharpen features of an image"], "extent": [1737, 1779]}, {"tag": "td", "attrs": {}, "type": "pxml", "indent": 8, "extent": [1779, 1792], "body": [{"type": "para", "indent": 12, "text": [{"scheme": "Node", "value": "/nodes/cop2/sharpen", "type": "link", "text": ["Sharpen COP"], "fullpath": "/nodes/cop2/sharpen.html"}], "extent": [1792, 1837]}, {"type": "para", "indent": 12, "text": ["Increase the kernel size to sharpen larger features. The\n            kernel size controls how many surrounding pixels to consider\n            when the node calculates local contrast."], "extent": [1837, 2033]}, {"type": "para", "indent": 12, "text": ["Use the ", {"type": "ui", "text": ["Noise"]}, " parameter to prevent the node from\n            sharpening grain and other noise."], "extent": [2033, 2146]}], "container": true}], "container": true}], "container": true}], "title": ["Blur or sharpen the image"], "included": ["/composite/_old_cops_deprecated"]}