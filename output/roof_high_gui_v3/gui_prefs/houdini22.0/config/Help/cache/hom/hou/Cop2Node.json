{"type": "root", "attrs": {"index": "no", "type": "homclass", "cppname": "HOM_Cop2Node", "superclass": "hou.OpNode", "group": "image", "replaces": "/expressions/pic /expressions/picni /expressions/opflag /expressions/opget /expressions/opsave /expressions/res /expressions/seqanim /expressions/seqend /expressions/seqlength /expressions/seqstart /expressions/copmeta /expressions/copmetas"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": [{"type": "supertitle", "text": "hou."}, "Cop2Node"], "extent": [0, 17]}, {"type": "summary", "indent": 0, "text": ["Represents a compositing node."], "extent": [370, 408]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "methods", "container": true, "type": "methods_section", "indent": 0, "role": "section", "extent": [451, 460], "body": [{"type": "methods_item_group", "body": [{"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["planes(self)"]}, "  \u2192 ", {"type": "code", "text": ["tuple of strings"]}], "role": "item", "extent": [460, 501], "body": [{"type": "para", "indent": 4, "text": ["Returns a tuple of plane names in the node\u2019s image sequence."], "extent": [536, 602]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [602, 702]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::planes"}, "id": "planes"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["components(self, plane)"]}, "  \u2192 ", {"type": "code", "text": ["tuple"]}, " of ", {"type": "code", "text": ["str"]}], "role": "item", "extent": [702, 751], "body": [{"type": "para", "indent": 4, "text": ["Returns a tuple of component names for the specified plane in\n    the node\u2019s image sequence.  The value of the ", {"type": "code", "text": ["plane"]}, " argument must\n    be a plane name."], "extent": [790, 949]}, {"type": "para", "indent": 4, "text": ["Raises ValueError if ", {"type": "code", "text": ["plane"]}, " is None or empty.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the given plane does not exist."], "extent": [949, 1172]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::components"}, "id": "components"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["xRes(self)"]}], "role": "item", "extent": [1172, 1188], "body": [{"type": "para", "indent": 4, "text": ["Returns the x-resolution of the node\u2019s image for the current frame."], "extent": [1250, 1323]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [1323, 1423]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::xRes", "replaces": "/commands/res"}, "id": "xRes"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["yRes(self)"]}], "role": "item", "extent": [1423, 1439], "body": [{"type": "para", "indent": 4, "text": ["Returns the y-resolution of the node\u2019s image for the current frame."], "extent": [1501, 1574]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [1574, 1674]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::yRes", "replaces": "/commands/res"}, "id": "yRes"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["imageBounds(self, plane=\"C\")"]}, "  \u2192 ", {"type": "code", "text": ["tuple"]}, " of ", {"type": "code", "text": ["int"]}], "role": "item", "extent": [1674, 1728], "body": [{"type": "para", "indent": 4, "text": ["Returns the x and y boundaries of the given plane in the form\n    of (xmin, ymin, xmax, ymax).  The value of the ", {"type": "code", "text": ["plane"]}, " argument\n    is the plane name.  By default, the image bounds of the color plane\n    is returned."], "extent": [1806, 2030]}, {"type": "para", "indent": 4, "text": ["Note that the image bounds is not the same as the image resolution.\n    For example, the image bounds for a Font COP is the bounding rectangle\n    around the displayed letters while the resolution is the size of the\n    node\u2019s image."], "extent": [2030, 2269]}, {"type": "para", "indent": 4, "text": ["Note that the returned image bounds is for the current frame."], "extent": [2269, 2336]}, {"type": "para", "indent": 4, "text": ["Raises ValueError if ", {"type": "code", "text": ["plane"]}, " is None or empty.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the given plane does not exist."], "extent": [2336, 2559]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::imageBounds", "replaces": "/expressions/imgbounds"}, "id": "imageBounds"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["depth(self, plane)"]}, "  \u2192 ", {"scheme": "Hom", "value": "/hom/hou/imageDepth", "type": "link", "text": "", "fallback_text": "hou.imageDepth", "fullpath": "/hom/hou/imageDepth.html"}, " enum value"], "role": "item", "extent": [2559, 2618], "body": [{"type": "para", "indent": 4, "text": ["Return the data format used to represent one component of one pixel in\n    the given image plane."], "extent": [2652, 2755]}, {"type": "para", "indent": 4, "text": ["For example, if the depth of the ", {"type": "code", "text": ["\"C\""]}, " (color) plane is\n    ", {"scheme": "Hom", "value": "/hom/hou/imageDepth", "type": "link", "text": ["hou.imageDepth.Int8"], "fullpath": "/hom/hou/imageDepth.html"}, ", each of the red, green, and blue\n    components is stored as an (unsigned) 8-bit integer, occupying one byte.\n    If, for example, it is instead ", {"scheme": "Hom", "value": "/hom/hou/imageDepth", "type": "link", "text": ["hou.imageDepth.Float32"], "fullpath": "/hom/hou/imageDepth.html"}, ",\n    each of the red, green, and blue components is a 32-bit float and\n    occupies 4 bytes (12 bytes total for all 3 components combined)."], "extent": [2755, 3191]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::depth"}, "id": "depth"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["maskInputIndex(self)"]}, "  \u2192 ", {"type": "code", "text": ["int"]}], "role": "item", "extent": [3191, 3226], "body": [{"type": "para", "indent": 4, "text": ["Return the input index of the mask input for this node. Return -1 if this\n    node type does not provide a mask input."], "extent": [3269, 3393]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::maskInputIndex"}, "id": "maskInputIndex"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["allPixels(self, plane=\"C\", component=None, interleaved=True, time=-1.0)"]}, "  \u2192 ", {"type": "code", "text": ["tuple"]}, " of ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [3393, 3492], "body": [{"type": "para", "indent": 4, "text": ["Return a tuple of floats containing all pixel values for a particular image\n    plane.  The pixels in the bottom scanline of the image are first in the\n    result, followed by the second-last scanline, etc.  Floating point values\n    in the color plane (", {"type": "q", "text": ["C"]}, "), for example, are typically in the range 0.0 to\n    1.0."], "extent": [3530, 3851]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["plane"], "extent": [3851, 3862], "body": [{"type": "para", "indent": 8, "text": ["The name of the image plane to return.  All images have ", {"type": "q", "text": ["C"]}, " (color)\n        and ", {"type": "q", "text": ["A"]}, " (alpha) planes.  Deep raster images may contain other planes,\n        such as ", {"type": "q", "text": ["Pz"]}, " (depth), ", {"type": "q", "text": ["N"]}, " (normal), etc."], "extent": [3862, 4065]}], "container": true}, {"type": "dt", "indent": 4, "text": ["component"], "extent": [4065, 4080], "body": [{"type": "para", "indent": 8, "text": ["A particular subcomponent of the plane.  For example, for the ", {"type": "q", "text": ["C"]}, " plane\n        you could specify one of the ", {"type": "q", "text": ["r"]}, ", ", {"type": "q", "text": ["g"]}, ", or ", {"type": "q", "text": ["b"]}, " subcomponents.  Specify\n        ", {"type": "code", "text": ["None"]}, " to indicate all components."], "extent": [4080, 4281]}], "container": true}, {"type": "dt", "indent": 4, "text": ["interleaved"], "extent": [4281, 4298], "body": [{"type": "para", "indent": 8, "text": ["Whether the different components of the plane are interleaved in the\n        result.  For example, if the plane is ", {"type": "q", "text": ["C"]}, ", the interleaved result would\n        be organized as ", {"type": "code", "text": ["rgbrgbrgb..."]}, " while the uninterleaved result would\n        be ", {"type": "code", "text": ["rrr...ggg...bbb..."]}, ".  This parameter has no effect when a\n        particular component is specified."], "extent": [4298, 4644]}], "container": true}, {"type": "dt", "indent": 4, "text": ["time"], "extent": [4644, 4654], "body": [{"type": "para", "indent": 8, "text": ["The time at which to cook the COP node.  If this value is negative,\n        Houdini uses the current time."], "extent": [4654, 4770]}, {"type": "para", "indent": 8, "text": ["Note that this argument does not apply if ", {"type": "code", "text": ["allPixels"]}, " is called from a\n        Python COP that is cooking.  In that case ", {"type": "code", "text": ["allPixels"]}, " evaluates at the\n        current cooking time."], "extent": [4770, 4959]}], "container": true}], "container": true}, {"type": "para", "indent": 4, "text": ["This method does not accept a ", {"type": "code", "text": ["depth"]}, " parameter like ", {"type": "code", "text": ["allPixelsAsString"]}, "\n    does.  The values are converted to floating point data, regardless of\n    the actual depth of the image plane."], "extent": [4959, 5152]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the ", {"type": "code", "text": ["time"]}, " argument is set to a value\n    greater than or equal to 0.0 and ", {"type": "code", "text": ["allPixels"]}, " is called from a cooking\n    Python COP."], "extent": [5152, 5321]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::allPixels"}, "id": "allPixels"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["allPixelsAsString(self, plane=\"C\", component=None, interleaved=True, time=-1.0, depth=None)"]}, "  \u2192 ", {"type": "code", "text": ["str"]}, " for Python 2, ", {"type": "code", "text": ["bytes"]}, " for Python 3"], "role": "item", "extent": [5321, 5462], "body": [{"type": "para", "indent": 4, "text": ["Return a binary string representation of the floats\n    containing all the values of all voxels.  This method is faster than\n    ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#allPixels", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.allPixels", "fullpath": "/hom/hou/Cop2Node.html#allPixels", "fragment": "#allPixels"}, ", and you can use the ", {"type": "code", "text": ["array"]}, " module to convert\n    the string into a Python sequence.  Note that this method returns binary\n    float data, so there are 4 bytes per R, G, and B component, not 1 byte."], "extent": [5508, 5871]}, {"type": "para", "indent": 4, "text": ["The returned binary string is a ", {"type": "code", "text": ["bytes"]}, " object in Python 3 and a ", {"type": "code", "text": ["str"]}, "\n    object in Python 2.  See ", {"scheme": "Hom", "value": "/hom/binary_data", "type": "link", "text": ["HOM binary data"], "fullpath": "/hom/binary_data.html"}, " for\n    more information."], "extent": [5871, 6036]}, {"type": "para", "indent": 4, "text": ["If depth is ", {"scheme": "Hom", "value": "/hom/hou/imageDepth", "type": "link", "text": ["hou.imageDepth.Float32"], "fullpath": "/hom/hou/imageDepth.html"}, ", this method\n    provides a faster implementation of the following:"], "extent": [6036, 6164]}, {"lang": "python", "type": "pre", "indent": 4, "text": ["\n    import array\n    def allPixelsAsString(self):\n        return array.array(\"f\", self.allPixels()).tostring()\n    "], "extent": [6164, 6304]}, {"type": "para", "indent": 4, "text": ["If ", {"type": "code", "text": ["depth"]}, " is ", {"type": "code", "text": ["None"]}, " and this method is called from the code implementing a\n    Python COP to get an input plane, the depth will be the same as the plane\u2019s\n    native depth.  If ", {"type": "code", "text": ["depth"]}, " is ", {"type": "code", "text": ["None"]}, " and this method is called from outside\n    a Python COP, the depth will be ", {"type": "code", "text": ["hou.imageDepth.Float32"]}, ".  Otherwise, if\n    ", {"type": "code", "text": ["depth"]}, " is a ", {"scheme": "Hom", "value": "/hom/hou/imageDepth", "type": "link", "text": "", "fallback_text": "hou.imageDepth", "fullpath": "/hom/hou/imageDepth.html"}, " enumerated value the result will be\n    converted to the specified depth."], "extent": [6304, 6734]}, {"type": "para", "indent": 4, "text": ["See ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#allPixels", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.allPixels", "fullpath": "/hom/hou/Cop2Node.html#allPixels", "fragment": "#allPixels"}, " for more information.  See also\n    ", {"scheme": "Hom", "value": "/hom/hou/Volume#setVoxelSliceFromString", "type": "link", "text": "", "fallback_text": "hou.Volume.setVoxelSliceFromString", "fullpath": "/hom/hou/Volume.html#setVoxelSliceFromString", "fragment": "#setVoxelSliceFromString"}, "."], "extent": [6734, 6850]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the ", {"type": "code", "text": ["time"]}, " argument is set to a value\n    greater than or equal to 0.0 and ", {"type": "code", "text": ["allPixelsAsString"]}, " is called from a\n    cooking Python COP."], "extent": [6850, 7027]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::allPixelsAsString"}, "id": "allPixelsAsString"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["setPixelsOfCookingPlane(self, values, component=None, interleaved=True, flip_vertically=False)"]}], "role": "item", "extent": [7027, 7127], "body": [{"type": "para", "indent": 4, "text": ["Set the pixels of the plane being cooked by the currently-running\n    Python COP."], "extent": [7179, 7266]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["values"], "extent": [7266, 7278], "body": [{"type": "para", "indent": 8, "text": ["A sequence of floats, organized with the contents of the bottom\n        scanline first."], "extent": [7278, 7375]}, {"type": "para", "indent": 8, "text": ["If ", {"type": "code", "text": ["component"]}, " is ", {"type": "code", "text": ["None"]}, ", the length of the sequence of floats must be\n        the number of pixels in the image times the number of components.\n        Otherwise, it must be the number of pixels in the image."], "extent": [7375, 7593]}], "container": true}, {"type": "dt", "indent": 4, "text": ["component"], "extent": [7593, 7608], "body": [{"type": "para", "indent": 8, "text": ["Either the name of one component in the plane being cooked, or\n        ", {"type": "code", "text": ["None"]}, ".  If a component name is given, ", {"type": "code", "text": ["values"]}, " will contain only\n        the values for that component.  Otherwise, it will contain the\n        values for all components of all pixels in the plane."], "extent": [7608, 7886]}], "container": true}, {"type": "dt", "indent": 4, "text": ["interleaved"], "extent": [7886, 7903], "body": [{"type": "para", "indent": 8, "text": ["If ", {"type": "code", "text": ["component"]}, " is ", {"type": "code", "text": ["None"]}, " and interleaved is ", {"type": "code", "text": ["True"]}, ", ", {"type": "code", "text": ["values"]}, " is\n        contains the first component of the first pixel, followed by the second\n        component of the first pixel, until the last component of the first\n        pixel, then the first component of the second pixel, etc.  If it is\n        ", {"type": "code", "text": ["False"]}, ", ", {"type": "code", "text": ["values"]}, " contains all the values of the first component for\n        all pixels, followed by all the values of the second component, etc."], "extent": [7903, 8362]}, {"type": "para", "indent": 8, "text": ["For example, if the plane is ", {"type": "q", "text": ["C"]}, " and interleaved is ", {"type": "code", "text": ["True"]}, ", the\n        values will be organized as ", {"type": "code", "text": ["rgbrgbrgb..."]}, ".  If it is not interleaved,\n        it will be organized as ", {"type": "code", "text": ["rrr...ggg...bbb..."]}, "."], "extent": [8362, 8568]}, {"type": "para", "indent": 8, "text": ["If ", {"type": "code", "text": ["component"]}, " is not ", {"type": "code", "text": ["None"]}, ", this parameter is ignored."], "extent": [8568, 8633]}], "container": true}, {"type": "dt", "indent": 4, "text": ["flip_vertically"], "extent": [8633, 8654], "body": [{"type": "para", "indent": 8, "text": ["The default value for this parameter is ", {"type": "code", "text": ["False"]}, ", so the first scanline\n        in the ", {"type": "code", "text": ["values"]}, " array is assumed to be the bottom scanline.  If\n        ", {"type": "code", "text": ["flip_vertically"]}, " is ", {"type": "code", "text": ["True"]}, ", the input values are assumed to oriented\n        starting at the top scanline."], "extent": [8654, 8922]}], "container": true}], "container": true}, {"type": "para", "indent": 4, "text": ["If you call this method from outside the ", {"type": "code", "text": ["cook"]}, " function in a Python\n    COP, raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, "."], "extent": [8922, 9039]}, {"type": "para", "indent": 4, "text": ["See also ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#allPixels", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.allPixels", "fullpath": "/hom/hou/Cop2Node.html#allPixels", "fragment": "#allPixels"}, " and\n    ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#setPixelsOfCookingPlaneFromString", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.setPixelsOfCookingPlaneFromString", "fullpath": "/hom/hou/Cop2Node.html#setPixelsOfCookingPlaneFromString", "fragment": "#setPixelsOfCookingPlaneFromString"}, ".  Also see the\n    ", {"scheme": null, "value": "/hom/cb/", "type": "link", "text": ["HOM cookbook"], "fullpath": "/hom/cb/index.html"}, " and the ", {"scheme": null, "value": "/hom/pythoncop2", "type": "link", "text": ["Python COP"], "fullpath": "/hom/pythoncop2.html"}, "\n    documentation for examples."], "extent": [9039, 9255]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::setPixelsOfCookingPlane"}, "id": "setPixelsOfCookingPlane"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["setPixelsOfCookingPlaneFromString(self, values, component=None, interleaved=True, depth=None, flip_vertically=False)"]}], "role": "item", "extent": [9255, 9377], "body": [{"type": "para", "indent": 4, "text": ["Set the pixels of the plane being cooked by the currently-running Python\n    COP.  This method is like ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#setPixelsOfCookingPlane", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.setPixelsOfCookingPlane", "fullpath": "/hom/hou/Cop2Node.html#setPixelsOfCookingPlane", "fragment": "#setPixelsOfCookingPlane"}, " except\n    ", {"type": "code", "text": ["values"]}, " contains a binary string representation of\n    the data instead of a sequence of floats.  Consequently, this method is\n    faster."], "extent": [9439, 9741]}, {"type": "para", "indent": 4, "text": ["The ", {"type": "code", "text": ["values"]}, " binary string must be a ", {"type": "code", "text": ["bytes"]}, " object in Python 3 and a ", {"type": "code", "text": ["str"]}, "\n    object in Python 2.  See ", {"scheme": "Hom", "value": "/hom/binary_data", "type": "link", "text": ["HOM binary data"], "fullpath": "/hom/binary_data.html"}, " for more\n    information."], "extent": [9741, 9911]}, {"type": "para", "indent": 4, "text": ["The ", {"type": "code", "text": ["depth"]}, " parameter specifies how to interpret the values in the binary\n    string, and is a ", {"scheme": "Hom", "value": "/hom/hou/imageDepth", "type": "link", "text": "", "fallback_text": "hou.imageDepth", "fullpath": "/hom/hou/imageDepth.html"}, " enumerated value.  If ", {"type": "code", "text": ["depth"]}, " is None,\n    the depth is assumed to be in the depth of the plane being cooked.  Note\n    that, by specifying ", {"type": "code", "text": ["depth"]}, " explicitly, you can provide data in any depth,\n    regardless of the actual depth stored by the COP."], "extent": [9911, 10281]}, {"type": "para", "indent": 4, "text": ["Note that this method can accept more types that just a string: it can\n    receive any Python object that supports the buffer interface.  In\n    particular, arrays from the ", {"type": "code", "text": ["array"]}, " and ", {"type": "code", "text": ["numpy"]}, " Python modules are\n    supported, so there is no need to first construct strings from those\n    arrays."], "extent": [10281, 10583]}, {"type": "para", "indent": 4, "text": ["See ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#setPixelsOfCookingPlane", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.setPixelsOfCookingPlane", "fullpath": "/hom/hou/Cop2Node.html#setPixelsOfCookingPlane", "fragment": "#setPixelsOfCookingPlane"}, " and\n    ", {"scheme": "Hom", "value": "/hom/hou/Cop2Node#allPixelsAsString", "type": "link", "text": "", "fallback_text": "hou.Cop2Node.allPixelsAsString", "fullpath": "/hom/hou/Cop2Node.html#allPixelsAsString", "fragment": "#allPixelsAsString"}, " for more information."], "extent": [10583, 10702]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::setPixelsOfCookingPlaneFromString"}, "id": "setPixelsOfCookingPlaneFromString"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["saveImage(self, file_name, frame_range=())"]}], "role": "item", "extent": [10702, 10750], "body": [{"type": "para", "indent": 4, "text": ["Saves the node\u2019s cooked image sequence to disk.  For multiple images,\n    make sure that the ", {"type": "code", "text": ["file_name"]}, " argument contains $F so that the\n    sequence is written to multiple files."], "extent": [10820, 11006]}, {"type": "para", "indent": 4, "text": ["The optional ", {"type": "code", "text": ["frame_range"]}, " argument can be specified to write\n    only a subset of frames in the image sequence.  ", {"type": "code", "text": ["frame_range"]}, " must\n    be a 2-tuple or a 3-tuple, where the first element is the start frame,\n    the second element is the end frame and the third element is the\n    frame increment.  If ", {"type": "code", "text": ["frame_range"]}, " is not given, then every frame in \n    the image sequence is saved to disk."], "extent": [11006, 11403]}, {"type": "para", "indent": 4, "text": ["Raises ValueError if the frame increment in ", {"type": "code", "text": ["frame_range"]}, " is 0.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/InvalidSize", "type": "link", "text": "", "fallback_text": "hou.InvalidSize", "fullpath": "/hom/hou/InvalidSize.html"}, " if the size of ", {"type": "code", "text": ["frame_range"]}, " is not\n    0, 2 or 3.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the image could not be saved to disk."], "extent": [11403, 11733]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::saveImage", "replaces": "/commands/opsave"}, "id": "saveImage"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["getPixelByUV(self, plane, u, v, component=None, interpolate=True)"]}, "  \u2192 ", {"type": "code", "text": ["tuple"]}, " of ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [11733, 11826], "body": [{"type": "para", "indent": 4, "text": ["Returns plane values for a single pixel in the node\u2019s image.  The\n    plane is defined by the ", {"type": "code", "text": ["plane"]}, " argument which must be set to the\n    plane\u2019s name.  The pixel is defined by (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") coordinates where \n    ", {"type": "code", "text": ["u"]}, " and ", {"type": "code", "text": ["v"]}, " are values between 0.0 and 1.0.  If the optional \n    ", {"type": "code", "text": ["component"]}, " argument is specified, then the value for that particular \n    component is returned.  Otherwise, all of the plane\u2019s component \n    values are returned.  The value of ", {"type": "code", "text": ["component"]}, " should be the\n    component\u2019s name (i.e. ", {"type": "q", "text": ["r"]}, ", ", {"type": "q", "text": ["g"]}, ", ", {"type": "q", "text": ["b"]}, ", etc.)."], "extent": [11919, 12457]}, {"type": "para", "indent": 4, "text": ["If the (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") coordinates do not fall exactly on a pixel, then\n    the return values are calculated by linear blending of the values\n    for the surrounding pixels.  This can be disabled by setting the\n    ", {"type": "code", "text": ["interpolate"]}, " argument to False, in which case the values of the \n    pixel located immediately to the bottom-left of (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") are returned."], "extent": [12457, 12815]}, {"type": "para", "indent": 4, "text": ["Note that the returned values are for the node\u2019s image at the\n    current frame."], "extent": [12815, 12901]}, {"type": "para", "indent": 4, "text": ["Raises ValueError if either ", {"type": "code", "text": ["u"]}, " or ", {"type": "code", "text": ["v"]}, " is outside of the 0.0-1.0 range.\n    Raises ValueError if ", {"type": "code", "text": ["plane"]}, " is None or empty.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the given plane does not exist.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the given component does not exist\n    in the plane."], "extent": [12901, 13293]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::getPixelByUV", "replaces": "/expressions/pic /expressions/picni"}, "id": "getPixelByUV"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["getPixelHSVByUV(self, u, v, interpolate=True)"]}, "  \u2192 ", {"type": "code", "text": ["tuple"]}, " of ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [13293, 13366], "body": [{"type": "para", "indent": 4, "text": ["Returns a 3-tuple containing the hue, saturation and value for\n    a single pixel in the node\u2019s image.  The pixel is defined by \n    (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") coordinates where ", {"type": "code", "text": ["u"]}, " and ", {"type": "code", "text": ["v"]}, " are values between 0.0 and 1.0.  "], "extent": [13462, 13675]}, {"type": "para", "indent": 4, "text": ["If the (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") coordinates do not fall exactly on a pixel, then\n    the return values are calculated by linear blending of the values\n    for the surrounding pixels.  This can be disabled by setting the\n    ", {"type": "code", "text": ["interpolate"]}, " argument to False, in which case the values of the \n    pixel located immediately to the bottom-left of (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") are returned."], "extent": [13675, 14033]}, {"type": "para", "indent": 4, "text": ["Note that the returned hue, saturation and value are for the\n    node\u2019s image at the current frame."], "extent": [14033, 14138]}, {"type": "para", "indent": 4, "text": ["Raises ValueError if either ", {"type": "code", "text": ["u"]}, " or ", {"type": "code", "text": ["v"]}, " is outside of the 0.0-1.0 range.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [14138, 14314]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::getPixelHSVByUV", "replaces": "/expressions/pic /expressions/picni"}, "id": "getPixelHSVByUV"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["getPixelLuminanceByUV(self, u, v, interpolate=True)"]}, "  \u2192 ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [14314, 14382], "body": [{"type": "para", "indent": 4, "text": ["Returns the luminance value for a single pixel in the node\u2019s image.\n    The pixel is defined by (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") coordinates where ", {"type": "code", "text": ["u"]}, " and ", {"type": "code", "text": ["v"]}, " \n    are values between 0.0 and 1.0.  "], "extent": [14484, 14665]}, {"type": "para", "indent": 4, "text": ["If the (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") coordinates do not fall exactly on a pixel, then\n    the luminance is calculated by linear blending of the luminance values\n    for the surrounding pixels.  This can be disabled by setting the\n    ", {"type": "code", "text": ["interpolate"]}, " argument to False, in which case the luminance of the \n    pixel located immediately to the bottom-left of (", {"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}, ") is returned."], "extent": [14665, 15030]}, {"type": "para", "indent": 4, "text": ["Note that the returned luminance value is for the node\u2019s image \n    at the current frame."], "extent": [15030, 15125]}, {"type": "para", "indent": 4, "text": ["Raises ValueError if either ", {"type": "code", "text": ["u"]}, " or ", {"type": "code", "text": ["v"]}, " is outside of the 0.0-1.0 range.\n    Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [15125, 15301]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::getPixelLuminanceByUV", "replaces": "/expressions/pic /expressions/picni"}, "id": "getPixelLuminanceByUV"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["isSingleImage(self)"]}, "  \u2192 ", {"type": "code", "text": ["bool"]}], "role": "item", "extent": [15301, 15336], "body": [{"type": "para", "indent": 4, "text": ["Returns True if the node has a single image.  Returns False if the\n    node has an image sequence."], "extent": [15414, 15518]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::isSingleImage", "replaces": "/expressions/seqanim"}, "id": "isSingleImage"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["sequenceStartFrame(self)"]}, "  \u2192 ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [15518, 15559], "body": [{"type": "para", "indent": 4, "text": ["Returns the start frame in the node\u2019s image sequence."], "extent": [15643, 15702]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [15702, 15802]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::sequenceStartFrame", "replaces": "/expressions/seqstart"}, "id": "sequenceStartFrame"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["sequenceEndFrame(self)"]}, "  \u2192 ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [15802, 15841], "body": [{"type": "para", "indent": 4, "text": ["Returns the last frame in the node\u2019s image sequence."], "extent": [15921, 15979]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [15979, 16079]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::sequenceEndFrame", "replaces": "/expressions/seqend"}, "id": "sequenceEndFrame"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["sequenceFrameLength(self)"]}, "  \u2192 ", {"type": "code", "text": ["float"]}], "role": "item", "extent": [16079, 16121], "body": [{"type": "para", "indent": 4, "text": ["Returns the frame length of the node\u2019s image sequence."], "extent": [16207, 16267]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/OperationFailed", "type": "link", "text": "", "fallback_text": "hou.OperationFailed", "fullpath": "/hom/hou/OperationFailed.html"}, " if the node could not be cooked or\n    opened for processing."], "extent": [16267, 16367]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::sequenceFrameLength", "replaces": "/expressions/seqlength"}, "id": "sequenceFrameLength"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["setDisplayFlag(self, on)"]}], "role": "item", "extent": [16367, 16397], "body": [{"type": "para", "indent": 4, "text": ["Turns the node\u2019s display flag on or off.  When the display flag is\n    on, the node\u2019s image will appear in the image viewport.\n    The value of the ", {"type": "code", "text": ["on"]}, " argument must be True or False."], "extent": [16471, 16661]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/PermissionError", "type": "link", "text": "", "fallback_text": "hou.PermissionError", "fullpath": "/hom/hou/PermissionError.html"}, " if the node is unwritable."], "extent": [16661, 16726]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::setDisplayFlag", "replaces": "/commands/opset"}, "id": "setDisplayFlag"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["isDisplayFlagSet(self)"]}, "  \u2192 ", {"type": "code", "text": ["bool"]}], "role": "item", "extent": [16726, 16764], "body": [{"type": "para", "indent": 4, "text": ["Returns True if the node\u2019s display flag is turned on.  Returns False\n    otherwise."], "extent": [16861, 16950]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::isDisplayFlagSet", "replaces": "/expressions/opflag /commands/opget"}, "id": "isDisplayFlagSet"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["setRenderFlag(self, on)"]}], "role": "item", "extent": [16950, 16979], "body": [{"type": "para", "indent": 4, "text": ["Turns the node\u2019s render flag on or off.  The render flag controls\n    which node in a compositing network will be rendered to ", {"scheme": null, "value": "Mplay", "type": "link", "text": "", "fullpath": "/hom/hou/Mplay.html"}, " \n    or to disk.  The value of the ", {"type": "code", "text": ["on"]}, " argument must be True or False."], "extent": [17052, 17263]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/PermissionError", "type": "link", "text": "", "fallback_text": "hou.PermissionError", "fullpath": "/hom/hou/PermissionError.html"}, " if the node is unwritable."], "extent": [17263, 17328]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::setRenderFlag", "replaces": "/commands/opset"}, "id": "setRenderFlag"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["isRenderFlagSet(self)"]}, "  \u2192 ", {"type": "code", "text": ["bool"]}], "role": "item", "extent": [17328, 17365], "body": [{"type": "para", "indent": 4, "text": ["Returns True if the node\u2019s render flag is turned on.  Returns False\n    otherwise."], "extent": [17461, 17549]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::isRenderFlagSet", "replaces": "/expressions/opflag /commands/opget"}, "id": "isRenderFlagSet"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["setTemplateFlag(self, on)"]}], "role": "item", "extent": [17549, 17580], "body": [{"type": "para", "indent": 4, "text": ["Turns the node\u2019s template flag on or off.\n    The value of the ", {"type": "code", "text": ["on"]}, " argument must be True or False."], "extent": [17655, 17760]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/PermissionError", "type": "link", "text": "", "fallback_text": "hou.PermissionError", "fullpath": "/hom/hou/PermissionError.html"}, " if the node is unwritable."], "extent": [17760, 17825]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::setTemplateFlag", "replaces": "/commands/opset"}, "id": "setTemplateFlag"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["isTemplateFlagSet(self)"]}, "  \u2192 ", {"type": "code", "text": ["bool"]}], "role": "item", "extent": [17825, 17864], "body": [{"type": "para", "indent": 4, "text": ["Returns True if the node\u2019s template flag is turned on.  Returns False\n    otherwise."], "extent": [17962, 18052]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::isTemplateFlagSet", "replaces": "/expressions/opflag /commands/opget"}, "id": "isTemplateFlagSet"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["setCompressFlag(self, on)"]}], "role": "item", "extent": [18052, 18083], "body": [{"type": "para", "indent": 4, "text": ["Turns the node\u2019s compress flag on or off. If the compress flag is True,\n    this node will not show a preview image in the Network View. If the\n    compress flag is False, a preview image will be shown in the Network View.\n    The value of the ", {"type": "code", "text": ["on"]}, " argument must be True or False."], "extent": [18158, 18444]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/PermissionError", "type": "link", "text": "", "fallback_text": "hou.PermissionError", "fullpath": "/hom/hou/PermissionError.html"}, " if the node is unwritable."], "extent": [18444, 18509]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::setCompressFlag", "replaces": "/commands/opset"}, "id": "setCompressFlag"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["isCompressFlagSet(self)"]}, "  \u2192 ", {"type": "code", "text": ["bool"]}], "role": "item", "extent": [18509, 18548], "body": [{"type": "para", "indent": 4, "text": ["Returns True if the node\u2019s compress flag is turned on.  Returns False\n    otherwise. The compress flag controls whether or not a preview image is\n    shown for this node in the Network View."], "extent": [18646, 18842]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::isCompressFlagSet", "replaces": "/expressions/opflag /commands/opget"}, "id": "isCompressFlagSet"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["bypass(self, on)"]}], "role": "item", "extent": [18842, 18864], "body": [{"type": "para", "indent": 4, "text": ["Turns the node\u2019s bypass flag on or off.  When the bypass flag is\n    on, the node will have no effect on the scene. The value of the \n    ", {"type": "code", "text": ["on"]}, " argument must be True or False."], "extent": [18930, 19110]}, {"type": "para", "indent": 4, "text": ["Raises ", {"scheme": "Hom", "value": "/hom/hou/PermissionError", "type": "link", "text": "", "fallback_text": "hou.PermissionError", "fullpath": "/hom/hou/PermissionError.html"}, " if the node is unwritable."], "extent": [19110, 19175]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::bypass", "replaces": "/commands/opset"}, "id": "bypass"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["isBypassed(self)"]}, "  \u2192 ", {"type": "code", "text": ["bool"]}], "role": "item", "extent": [19175, 19207], "body": [{"type": "para", "indent": 4, "text": ["Returns True if the node\u2019s bypass flag is turned on.  Returns False\n    otherwise."], "extent": [19298, 19386]}], "container": true, "attrs": {"cppname": "HOM_Cop2Node::isBypassed", "replaces": "/expressions/opflag /commands/opget"}, "id": "isBypassed"}, {"ext": null, "type": "methods_item", "indent": 0, "text": [{"type": "code", "text": ["hasMetaData(se