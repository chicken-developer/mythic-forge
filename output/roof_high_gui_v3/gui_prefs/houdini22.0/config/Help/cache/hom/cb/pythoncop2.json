{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": [{"type": "supertitle", "text": ["HOM cookbook"]}, " Python COP"], "extent": [12, 43]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [43, 59], "body": [{"type": "para", "indent": 0, "text": ["You can create compositing node (COP) assets that are ", {"scheme": null, "value": "../pythoncop2", "type": "link", "text": ["defined by a Python script"], "fullpath": "/hom/pythoncop2.html"}, " instead of a subnetwork of nodes (", {"type": "ui", "text": ["File \u25b8 New Asset\u2026"]}, ", click ", {"type": "ui", "text": ["Python type"]}, ", set ", {"type": "ui", "text": ["Network type"]}, " to ", {"type": "q", "text": ["Compositing Generator"]}, " or ", {"type": "q", "text": ["Composting Filter"]}, "). This example defines a Python COP that copies its input, creates a Cd (diffuse color) point attribute, and assigns each point a color based on the distance to a position."], "extent": [59, 484]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [484, 490], "body": [{"type": "para", "indent": 8, "text": ["This example requires the ", {"scheme": null, "value": "http://numpy.sourceforge.net", "type": "link", "text": ["numpy"], "exists": true}, " library which ships with Houdini."], "extent": [490, 596]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Open ", {"type": "code", "text": ["$HFS/houdini/help/files/multi_stamp.hip"]}, " to see the node."], "extent": [596, 661]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Implementation"], "extent": [661, 682], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["You can load the pre-made asset from ", {"type": "code", "text": ["$HFS/houdini/help/files/PythonCops.hda"]}], "extent": [682, 764]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Right-click a ", {"type": "code", "text": ["multistamp"]}, " node and choose ", {"type": "ui", "text": ["Type properties"]}, " to open the asset\u2019s ", {"scheme": null, "value": "/ref/windows/optype", "type": "link", "text": ["type properties window"], "fullpath": "/ref/windows/optype.html"}, "."], "extent": [764, 896]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["We created parameters in the ", {"type": "ui", "text": ["Parameters"]}, " tab, just as we would for a normal asset."], "extent": [896, 985]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["The ", {"type": "ui", "text": ["Code"]}, " tab contains the Python code implementing the node\u2019s logic."], "extent": [985, 1060]}], "container": true}]}], "title": [{"type": "supertitle", "text": ["HOM cookbook"]}, " Python COP"]}