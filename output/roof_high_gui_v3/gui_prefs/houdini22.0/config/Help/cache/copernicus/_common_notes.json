{"type": "root", "attrs": {"type": "include"}, "body": [{"level": 2, "id": "comp_sim", "container": true, "type": "h", "indent": 0, "text": ["Compiled simulation"], "extent": [16, 53], "body": [{"type": "para", "indent": 0, "text": ["Compiled COP networks don\u2019t support simulation."], "extent": [53, 103]}]}, {"level": 2, "id": "previews", "container": true, "type": "h", "indent": 0, "text": ["Create preview materials"], "extent": [103, 145], "body": [{"type": "para", "indent": 0, "text": ["After you wire the final outputs from the previous workflows into ", {"scheme": "Node", "value": "/nodes//cop/null", "type": "link", "text": ["Null COPs"], "fullpath": "/nodes//cop/null.html"}, ", use the ", {"scheme": "Node", "value": "/nodes//cop/previewmaterial", "type": "link", "text": ["Preview Material COP"], "fullpath": "/nodes//cop/previewmaterial.html"}, " to preview the final organic texture. Change parameter values to output the desired material texture. See ", {"scheme": "Node", "value": "/nodes//vop/mtlxopen_pbr_surface", "type": "link", "text": ["MtlX OpenPBR Surface VOP"], "fullpath": "/nodes//vop/mtlxopen_pbr_surface.html"}, " for more information about how material parameters (such as ", {"type": "ui", "text": ["Metalness"]}, ") impact the rendered output."], "extent": [145, 565]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [565, 571], "body": [{"type": "para", "indent": 8, "text": ["Set the following parameters in the Preview Material COP:"], "extent": [571, 637]}, {"type": "bullet_group", "body": [{"blevel": 10, "type": "bullet", "indent": 8, "text": [{"type": "ui", "text": ["Default Roughness"]}, " for ", {"type": "ui", "text": ["Specular Defaults"]}, ": ", {"type": "code", "text": ["0.3"]}], "extent": [637, 702]}, {"blevel": 10, "type": "bullet", "indent": 8, "text": [{"type": "ui", "text": ["Index of Refraction"]}, ": ", {"type": "code", "text": ["1.8"]}], "extent": [702, 743]}, {"blevel": 10, "type": "bullet", "indent": 8, "text": [{"type": "ui", "text": ["Default Subsurface"]}, " ", {"type": "code", "text": ["0.7"]}], "extent": [743, 783]}], "container": true}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/copernicus/working_with_cops#copmat", "type": "link", "text": ["Using COPs as materials"], "fullpath": "/copernicus/working_with_cops.html#copmat", "fragment": "#copmat"}, " for how to apply COP outputs as materials on geometry nodes."], "extent": [783, 911]}]}]}