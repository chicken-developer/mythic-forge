{"type": "root", "attrs": {"type": "expression", "group": "images", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["pic"], "extent": [45, 53]}, {"type": "summary", "indent": 0, "text": ["Returns the color of a pixel in a compositing node."], "extent": [53, 113]}, {"type": "usage_group", "body": [{"ext": null, "type": "usage", "indent": 0, "text": [" ", {"type": "code", "text": ["pic(", {"type": "var", "text": ["copname"]}, ", ", {"type": "var", "text": ["U"]}, ", ", {"type": "var", "text": ["V"]}, ", ", {"type": "var", "text": ["color_type"]}, ")"]}], "role": "item", "extent": [113, 171]}], "container": true, "role": "item_group"}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [171, 177], "body": [{"type": "para", "indent": 4, "text": ["This applies to the old compositing nodes."], "extent": [177, 225]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["The color_type parameter can be one of the\nfollowing: D_CR, D_CG, D_CB, D_CA, D_CHUE, D_CSAT, D_CVAL, D_CLUM for\nthe red, green, blue, alpha, hue, saturation, value, or luminance of the\npixel."], "extent": [225, 419]}, {"type": "para", "indent": 0, "text": ["The color returned will be interpolated smoothly between adjacent\npixels. For the non-interpolated color, use ", {"scheme": "Exp", "value": "/expressions/picni", "type": "link", "text": "", "fallback_text": "picni()", "fullpath": "/expressions/picni.html"}, "."], "extent": [419, 543]}, {"level": 1, "id": "examples", "container": true, "type": "examples_section", "indent": 0, "role": "section", "extent": [543, 553], "body": [{"lang": "exp", "type": "pre", "indent": 4, "text": ["\n    pic(\"/img/img1/color1\", .5, .5, D_CLUM)\n    "], "extent": [553, 623]}], "text": "Examples"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [623, 633], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Exp", "value": "/expressions/picni", "type": "link", "text": "", "fallback_text": "picni()", "fullpath": "/expressions/picni.html"}], "extent": [633, 648]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Exp", "value": "/expressions/tex", "type": "link", "text": "", "fallback_text": "tex()", "fullpath": "/expressions/tex.html"}], "extent": [648, 660]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Exp", "value": "/expressions/texni", "type": "link", "text": "", "fallback_text": "texni()", "fullpath": "/expressions/texni.html"}], "extent": [660, 674]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Exp", "value": "/expressions/res", "type": "link", "text": "", "fallback_text": "res()", "fullpath": "/expressions/res.html"}], "extent": [674, 686]}], "container": true}], "text": "Related"}], "title": ["pic"], "summary": ["Returns the color of a pixel in a compositing node."]}