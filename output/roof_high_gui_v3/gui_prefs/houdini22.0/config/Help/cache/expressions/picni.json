{"type": "root", "attrs": {"type": "expression", "group": "images", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["picni"], "extent": [45, 55]}, {"type": "summary", "indent": 0, "text": ["Returns the non-interpolated color of a pixel in a compositing node."], "extent": [55, 132]}, {"type": "usage_group", "body": [{"ext": null, "type": "usage", "indent": 0, "text": [" ", {"type": "code", "text": ["picni(", {"type": "var", "text": ["copname"]}, ", ", {"type": "var", "text": ["U"]}, ", ", {"type": "var", "text": ["V"]}, ", ", {"type": "var", "text": ["color_type"]}, ")"]}], "role": "item", "extent": [132, 192]}], "container": true, "role": "item_group"}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [192, 198], "body": [{"type": "para", "indent": 4, "text": ["This applies to the old compositing nodes."], "extent": [198, 246]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["The color_type parameter can be one of the\nfollowing: D_CR, D_CG, D_CB, D_CA, D_CHUE, D_CSAT, D_CVAL, D_CLUM for\nthe red, green, blue, alpha, hue, saturation, value, or luminance of the\npixel."], "extent": [246, 440]}, {"type": "para", "indent": 0, "text": ["The color returned will not be interpolated. That is, it will be\nthe exact color of the pixel.\nFor the interpolated color, use ", {"scheme": "Exp", "value": "/expressions/pic", "type": "link", "text": "", "fallback_text": "pic()", "fullpath": "/expressions/pic.html"}, "."], "extent": [440, 579]}, {"level": 1, "id": "examples", "container": true, "type": "examples_section", "indent": 0, "role": "section", "extent": [579, 589], "body": [{"lang": "exp", "type": "pre", "indent": 4, "text": ["\n    picni(\"/img/img1/color1\", .5, .5, D_CLUM)\n    "], "extent": [589, 661]}], "text": "Examples"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [661, 671], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Exp", "value": "/expressions/pic", "type": "link", "text": "", "fallback_text": "pic()", "fullpath": "/expressions/pic.html"}], "extent": [671, 687]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Exp", "value": "/expressions/tex", "type": "link", "text": "", "fallback_text": "tex()", "fullpath": "/expressions/tex.html"}], "extent": [687, 703]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Exp", "value": "/expressions/texni", "type": "link", "text": "", "fallback_text": "texni()", "fullpath": "/expressions/texni.html"}], "extent": [703, 721]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Exp", "value": "/expressions/res", "type": "link", "text": "", "fallback_text": "res()", "fullpath": "/expressions/res.html"}], "extent": [721, 738]}], "container": true}], "text": "Related"}], "title": ["picni"], "summary": ["Returns the non-interpolated color of a pixel in a compositing node."]}