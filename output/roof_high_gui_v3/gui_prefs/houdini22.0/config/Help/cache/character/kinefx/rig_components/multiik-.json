{"type": "root", "attrs": {"type": "rig_component", "tags": "apex", "since": "20.5", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Multi IK"], "extent": [58, 71]}, {"type": "summary", "indent": 0, "text": ["Sets up IK chains with more than 3 nodes, or multiple IK chains using segments."], "extent": [71, 159]}, {"type": "para", "indent": 0, "text": ["This component sets up IK chains with more than 3 nodes. It can also set up multiple IK chains in the rig hierarchy using ", {"type": "ui", "text": ["segments"]}, "."], "extent": [159, 296]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [296, 308], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["name"], "extent": [308, 315], "body": [{"type": "para", "indent": 4, "text": ["The name that is added to the nodes created by this component. This name is not necessary when using ", {"type": "ui", "text": ["segments"]}, " because the segment name is also added to the nodes."], "extent": [315, 487]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["prefix"], "extent": [487, 495], "body": [{"type": "para", "indent": 4, "text": ["The prefix for the ", {"scheme": null, "value": "/character/kinefx/animationgraphs#controls", "type": "link", "text": ["controls"], "fullpath": "/character/kinefx/animationgraphs.html#controls", "fragment": "#controls"}, " (", {"scheme": "Node", "value": "/nodes/apex/TransformObject", "type": "link", "text": ["TransformObject"], "fullpath": "/nodes/apex/TransformObject.html"}, " nodes) that are added by this component."], "extent": [495, 659]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["suffix"], "extent": [659, 667], "body": [{"type": "para", "indent": 4, "text": ["The suffix for the controls (TransformObject nodes) that are added by this component."], "extent": [667, 758]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["guidesource"], "extent": [758, 771], "body": [{"type": "para", "indent": 4, "text": ["The ", {"scheme": null, "value": "/character/kinefx/preparingskeletons", "type": "link", "text": ["guide skeleton"], "fullpath": "/character/kinefx/preparingskeletons.html"}, " that is used as a reference when creating controls. "], "extent": [771, 888]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Settings"], "extent": [888, 903], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["dampen"], "extent": [903, 912], "body": [{"type": "para", "indent": 4, "text": ["A larger value dampens the effect of the IK solve, smoothing its snapping effects at the cost of accuracy."], "extent": [912, 1024]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["stretch"], "extent": [1024, 1033], "body": [{"type": "para", "indent": 4, "text": ["A larger value allows more stretch for the IK chain when the target is beyond the length of the chain."], "extent": [1033, 1141]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["trackingthreshold"], "extent": [1141, 1160], "body": [{"type": "para", "indent": 4, "text": ["Sets the accuracy of the solve. A higher value is faster but less accurate. "], "extent": [1160, 1242]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["usetwist"], "extent": [1242, 1252], "body": [{"type": "para", "indent": 4, "text": ["When turned on, uses the pole vector to twist the IK chain."], "extent": [1252, 1317]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["usegoalrot"], "extent": [1317, 1329], "body": [{"type": "para", "indent": 4, "text": ["When turned on, uses the goal rotation for the target orientation. When turned off, uses the solver\u2019s position for the target orientation."], "extent": [1329, 1473]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["resiststraight"], "extent": [1473, 1489], "body": [{"type": "para", "indent": 4, "text": ["When turned on, resists straightening of the IK chain."], "extent": [1489, 1549]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["levelpolevec"], "extent": [1549, 1563], "body": [{"type": "para", "indent": 4, "text": ["When turned on, sets the pole vector controls to world orientation. "], "extent": [1563, 1637]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["leveltip"], "extent": [1637, 1647], "body": [{"type": "para", "indent": 4, "text": ["When turned on, sets the tip controls to world orientation."], "extent": [1647, 1712]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["levelroot"], "extent": [1712, 1723], "body": [{"type": "para", "indent": 4, "text": ["When turned on, sets the root controls to world orientation."], "extent": [1723, 1789]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["polvecoffset"], "extent": [1789, 1803], "body": [{"type": "para", "indent": 4, "text": ["The amount to offset the pole vector in the direction of the middle joint (between the root and tip). The IK chain must be slightly bent for this to work."], "extent": [1803, 1963]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["swapname"], "extent": [1963, 1973], "body": [{"type": "para", "indent": 4, "text": ["When turned on, sets the ", {"type": "ui", "text": ["name"]}, " parameter to be a prefix. When turned off, sets the ", {"type": "ui", "text": ["name"]}, " parameter to be a suffix."], "extent": [1973, 2100]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Driven"], "extent": [2100, 2113], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["segments"], "extent": [2113, 2124], "body": [{"type": "para", "indent": 4, "text": ["Segments are ", {"scheme": null, "value": "/character/kinefx/graphmetadata#tags", "type": "link", "text": ["tags"], "fullpath": "/character/kinefx/graphmetadata.html#tags", "fragment": "#tags"}, " that separate each IK chain. For example, ", {"type": "code", "text": ["*Leg"]}, " loops over tags ", {"type": "code", "text": ["L_Leg"]}, " and ", {"type": "code", "text": ["R_Leg"]}, ". Tags can be set up on skeleton joints using an ", {"scheme": "Node", "value": "/nodes/sop/attribadjustarray", "type": "link", "text": ["Attribute Adjust Array SOP"], "fullpath": "/nodes/sop/attribadjustarray.html"}, ". See ", {"scheme": null, "value": "/character/kinefx/preparingskeletons", "type": "link", "text": ["preparing skeletons for rigging"], "fullpath": "/character/kinefx/preparingskeletons.html"}, " for more information."], "extent": [2124, 2473]}, {"type": "para", "indent": 4, "text": ["If ", {"type": "ui", "text": ["segments"]}, " is empty, the IK logic is run once."], "extent": [2473, 2530]}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [2530, 2540], "body": [{"type": "para", "indent": 8, "text": ["The segments parameter does not take ", {"scheme": null, "value": "/character/kinefx/apexpathpattern", "type": "link", "text": ["APEX path patterns"], "fullpath": "/character/kinefx/apexpathpattern.html"}, ", for example, the %tag() function. Instead, specify the tag names directly in this field."], "extent": [2540, 2731]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["driven"], "extent": [2731, 2739], "body": [{"type": "para", "indent": 4, "text": ["The nodes to drive. You can specify the individual joints, for example, ", {"type": "code", "text": ["L_Hip"]}, ", ", {"type": "code", "text": ["L_Knee"]}, ", ", {"type": "code", "text": ["L_Ankle"]}, ", or a tag that exists on the TransformObject nodes, for example, ", {"type": "code", "text": ["%tag(ik) & %tag(L_Leg)"]}, "."], "extent": [2739, 2936]}, {"type": "para", "indent": 4, "text": ["It is good practice to also specify the ", {"type": "code", "text": ["bind"]}, " tags that are set up by default on the ", {"scheme": null, "value": "/character/kinefx/rig_components/fktransform", "type": "link", "text": ["FK transform component\u2019s"], "fullpath": "/character/kinefx/rig_components/fktransform.html"}, " ", {"type": "ui", "text": ["tags"]}, " parameter. The FK transform component is normally the first component used to start building a rig. Including the ", {"type": "code", "text": ["bind"]}, " tag helps to ensure that you don\u2019t include other controls that might have inherited, for example, the ", {"type": "code", "text": ["L_Leg"]}, " tag. So in this case, you can set ", {"type": "ui", "text": ["driven"]}, " to ", {"type": "code", "text": ["%tag(bind) & %tag(ik)"]}, "."], "extent": [2936, 3413]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Parents"], "extent": [3413, 3427], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["rootparent"], "extent": [3427, 3440], "body": [{"type": "para", "indent": 4, "text": ["The parent of the root control(s). When empty, the root control has the same parent as the root node of the IK chain. To unparent the root control, put an underscore (", {"type": "q", "text": [{"type": "code", "text": ["_"]}]}, ") in ", {"type": "ui", "text": ["rootparent"]}, "."], "extent": [3440, 3638]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tipparent"], "extent": [3638, 3649], "body": [{"type": "para", "indent": 4, "text": ["The parent of the tip control(s). When empty, the tip is not parented."], "extent": [3649, 3725]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["povectorparent"], "extent": [3725, 3741], "body": [{"type": "para", "indent": 4, "text": ["The parent of the pole vector(s). When empty, the pole vector is parented to the tip. "], "extent": [3741, 3834]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tags"], "extent": [3834, 3845], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["tagroot"], "extent": [3845, 3855], "body": [{"type": "para", "indent": 4, "text": ["The tag that is added to the roots created by this component."], "extent": [3855, 3922]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tagpolevec"], "extent": [3922, 3934], "body": [{"type": "para", "indent": 4, "text": ["The tag that is added to the pole vectors created by this component."], "extent": [3934, 4008]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tagtarget"], "extent": [4008, 4019], "body": [{"type": "para", "indent": 4, "text": ["The tag that is added to the targets created by this component."], "extent": [4019, 4089]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Shape"], "extent": [4089, 4101], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["shape"], "extent": [4101, 4109], "body": [{"type": "para", "indent": 4, "text": ["The shape of the controls. It can be set to any of the ", {"scheme": "Node", "value": "/nodes/sop/apex--configurecontrols#shapeoverride", "type": "link", "text": ["built-in APEX control shapes"], "fullpath": "/nodes/sop/apex--configurecontrols.html#shapeoverride", "fragment": "#shapeoverride"}, "."], "extent": [4109, 4248]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["scale"], "extent": [4248, 4255], "body": [{"type": "para", "indent": 4, "text": ["The scale of the control shapes."], "extent": [4255, 4293]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["color"], "extent": [4293, 4300], "body": [{"type": "para", "indent": 4, "text": ["The color of the control shapes. "], "extent": [4300, 4339]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [4339, 4348], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/apexgraphbasics", "type": "link", "text": ["APEX graph basics"], "fullpath": "/character/kinefx/apexgraphbasics.html"}], "extent": [4348, 4404]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/graphmetadata#tags", "type": "link", "text": ["APEX graph tags"], "fullpath": "/character/kinefx/graphmetadata.html#tags", "fragment": "#tags"}], "extent": [4404, 4461]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/apexpathpattern", "type": "link", "text": ["APEX path pattern"], "fullpath": "/character/kinefx/apexpathpattern.html"}], "extent": [4461, 4517]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--configurecontrols#shapeoverride", "type": "link", "text": ["Built-in APEX control shapes"], "fullpath": "/nodes/sop/apex--configurecontrols.html#shapeoverride", "fragment": "#shapeoverride"}], "extent": [4517, 4597]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/preparingskeletons", "type": "link", "text": ["Preparing skeletons for rigging"], "fullpath": "/character/kinefx/preparingskeletons.html"}], "extent": [4597, 4670]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/rigsimplegeometry", "type": "link", "text": ["Rigging a simple geometry"], "fullpath": "/character/kinefx/rigsimplegeometry.html"}], "extent": [4670, 4736]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/rigcharacter", "type": "link", "text": ["Rigging a character"], "fullpath": "/character/kinefx/rigcharacter.html"}], "extent": [4736, 4791]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--autorigcomponent", "type": "link", "text": "", "fullpath": "/nodes/sop/apex--autorigcomponent.html"}], "extent": [4791, 4827]}], "container": true}], "text": "Related"}], "title": ["Multi IK"], "summary": ["Sets up IK chains with more than 3 nodes, or multiple IK chains using segments."]}