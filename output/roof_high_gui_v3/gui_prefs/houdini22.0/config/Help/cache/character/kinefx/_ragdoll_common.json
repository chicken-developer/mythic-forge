{"type": "root", "attrs": {"type": "include"}, "body": [{"level": 2, "id": "editshapes", "container": true, "type": "h", "indent": 0, "text": ["Editing collision shapes"], "extent": [16, 62], "body": [{"type": "ord_group", "body": [{"blevel": 2, "type": "ord", "indent": 0, "text": ["To manually adjust the position, orientation, and scale of collision shapes, use the transform handle on the shape:"], "extent": [62, 182], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Select a shape or joint."], "extent": [182, 214]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["On the top toolbar, turn on ", {"type": "ui", "text": ["Enable Handle"]}, "."], "extent": [214, 268]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["(Optional) Press ", {"keys": ["Y"], "type": "keys", "text": null}, " over the viewport to cycle through the different transform handle modes."], "extent": [268, 371]}], "container": true}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [371, 381], "body": [{"type": "para", "indent": 8, "text": ["Selecting a joint or shape will automatically change the shape to the ", {"type": "ui", "text": ["Shape"]}, " setting on the top toolbar."], "extent": [381, 498]}], "container": true}], "container": true, "role": "item_group"}], "container": true}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["To create one collision shape that encapsulates multiple joints, for example, one collision shape for the entire hand:"], "extent": [498, 620], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Select the finger joints/shapes."], "extent": [620, 660]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"keys": ["RMB"], "type": "keys", "text": null}, " click and select ", {"type": "ui", "text": ["Merge Convex Hull with Parent"]}, "."], "extent": [660, 727], "body": [{"type": "fig_group", "body": [{"ext": null, "type": "fig", "indent": 8, "text": [" ", {"scheme": "Image", "value": "/images/char/kinefx_ragdoll_collisionshapesmerge.jpg", "type": "img", "text": ""}], "role": "item", "extent": [727, 802], "body": [{"type": "summary", "indent": 12, "text": ["Generate one collision shape from selected joints"], "extent": [834, 903]}], "container": true, "attrs": {"display": "left full"}}], "container": true, "role": "item_group"}], "container": true}], "container": true}, {"type": "para", "indent": 4, "text": ["The ", {"type": "ui", "text": ["Generate Shapes Group"]}, " parameter on the node is updated to list the joints for which collision shapes are not generated (the joint names are preceded with a ", {"type": "code", "text": ["^"]}, "). These joints have their collision shapes merged together with the parent shape."], "extent": [903, 1158]}], "container": true}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["To undo the merging of multiple collision shapes with the parent shape:"], "extent": [1158, 1233], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Press ", {"keys": ["Z"], "type": "keys", "text": null}, " to enter the Restore from Groups mode. The joints that have been merged are available to be selected."], "extent": [1233, 1354]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Select the joints."], "extent": [1354, 1380]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"keys": ["RMB"], "type": "keys", "text": null}, " click over the viewport and select ", {"type": "ui", "text": ["Restore Convex Hull"]}, "."], "extent": [1380, 1455]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Press ", {"keys": ["Z"], "type": "keys", "text": null}, " again to exit the Restore from Groups mode."], "extent": [1455, 1518]}], "container": true}], "container": true}], "container": true}]}, {"level": 2, "id": "customshapes", "container": true, "type": "h", "indent": 0, "text": ["Create custom collision shapes"], "extent": [1518, 1572], "body": [{"type": "ord_group", "body": [{"blevel": 2, "type": "ord", "indent": 0, "text": ["In the viewer state, select a shape or joint."], "extent": [1572, 1626]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["On the top toolbar, set ", {"type": "ui", "text": ["Shape"]}, " to ", {"type": "ui", "text": ["Custom"]}, "."], "extent": [1626, 1678]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["(Optional) ", {"keys": ["RMB"], "type": "keys", "text": null}, " click the ", {"scheme": "Icon", "value": "TOOLS/select_component", "type": "link", "text": "", "fullpath": "/character/kinefx/TOOLS/select_component.html"}, " Select button from the left toolbar, and choose one of the selection options."], "extent": [1678, 1818]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["Press ", {"keys": ["S"], "type": "keys", "text": null}, " over the viewport, which shows the character skin. "], "extent": [1818, 1885]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["Select the areas on the character skin that you want to use to create the custom shape."], "extent": [1885, 1976]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["Press ", {"keys": ["S"], "type": "keys", "text": null}, " or ", {"keys": ["Enter"], "type": "keys", "text": null}, " to exit the selection mode. A convex hull is built out of the selection."], "extent": [1976, 2077], "body": [{"type": "video_group", "body": [{"ext": null, "type": "video", "indent": 4, "role": "item", "extent": [2077, 2089], "body": [{"type": "summary", "indent": 8, "text": ["Create custom collision shape"], "extent": [2164, 2209]}], "container": true, "attrs": {"src": "/videos/kinefx_ragdoll_customshape.webm", "loop": "false"}}], "container": true, "role": "item_group"}], "container": true}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["To remove the custom shape:"], "extent": [2209, 2240], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": ["Select the shape or joint."], "extent": [2240, 2274]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Press ", {"keys": ["S"], "type": "keys", "text": null}, " over the viewport to show the character skin. "], "extent": [2274, 2340]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Click away from the character skin so that nothing is selected."], "extent": [2340, 2411]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": ["Press ", {"keys": ["S"], "type": "keys", "text": null}, " or ", {"keys": ["Enter"], "type": "keys", "text": null}, " to exit the selection mode. "], "extent": [2411, 2472]}], "container": true}], "container": true}], "container": true}]}, {"level": 2, "id": "adjustbasicshapes", "container": true, "type": "h", "indent": 0, "text": ["Orienting and positioning basic shapes"], "extent": [2472, 2539], "body": [{"type": "para", "indent": 0, "text": ["To orient basic collision shapes toward certain joints:"], "extent": [2539, 2597]}, {"type": "ord_group", "body": [{"blevel": 2, "type": "ord", "indent": 0, "text": ["In the viewer state, select a basic shape or its associated joint."], "extent": [2597, 2667]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["Press ", {"keys": ["A"], "type": "keys", "text": null}, ". The joint options that the shape can be oriented towards are shown:"], "extent": [2667, 2751], "body": [{"type": "fig_group", "body": [{"ext": null, "type": "fig", "indent": 4, "text": [" ", {"scheme": "Image", "value": "/images/char/kinefx_ragdoll_referencejoints.jpg", "type": "img", "text": ""}], "role": "item", "extent": [2751, 2817], "body": [{"type": "summary", "indent": 8, "text": ["Joints that the collision shape can be oriented towards"], "extent": [2845, 2916]}], "container": true, "attrs": {"display": "left full"}}], "container": true, "role": "item_group"}], "container": true}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["Select the joint to orient the shape towards:"], "extent": [2916, 2965], "body": [{"type": "video_group", "body": [{"ext": null, "type": "video", "indent": 4, "role": "item", "extent": [2965, 2977], "body": [{"type": "summary", "indent": 8, "text": ["Orient basic collision shape"], "extent": [3052, 3096]}], "container": true, "attrs": {"src": "/videos/kinefx_ragdoll_orientshape.webm", "loop": "false"}}], "container": true, "role": "item_group"}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [3096, 3106], "body": [{"type": "para", "indent": 8, "text": ["If ", {"type": "ui", "text": ["Compute Shape Transform"]}, " on the top toolbar is set to ", {"type": "ui", "text": ["Off"]}, ", you won\u2019t see the effect of reorienting the shape until ", {"type": "ui", "text": ["Compute Shape Transform"]}, " is set to ", {"type": "ui", "text": ["From Convex Hull"]}, " or ", {"type": "ui", "text": ["From Reference Joint"]}, "."], "extent": [3106, 3328]}], "container": true}], "container": true, "role": "item_group"}], "container": true}], "container": true}, {"type": "para", "indent": 0, "text": ["To automatically position basic collision shapes:"], "extent": [3328, 3379]}, {"type": "ord_group", "body": [{"blevel": 2, "type": "ord", "indent": 0, "text": ["Select a basic shape or its associated joint."], "extent": [3379, 3428]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["On the top toolbar, select from the ", {"type": "ui", "text": ["Compute Shape Transform"]}, " drop-down menu:"], "extent": [3428, 3511], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"type": "ui", "text": ["From Convex Hull"]}, " scales the shape and places it within the bounds of the convex hull."], "extent": [3511, 3608], "body": [{"type": "fig_group", "body": [{"ext": null, "type": "fig", "indent": 8, "text": [" ", {"scheme": "Image", "value": "/images/char/kinefx_ragdoll_shapewithinconvexhull.jpg", "type": "img", "text": ""}], "role": "item", "extent": [3608, 3684], "body": [{"type": "summary", "indent": 12, "text": ["Collision shape placed within convex hull bounds"], "extent": [3716, 3784]}], "container": true, "attrs": {"display": "left full"}}], "container": true, "role": "item_group"}], "container": true}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"type": "ui", "text": ["From Reference Joints"]}, " uses the distance between the selected joint and reference joint to scale the shape. "], "extent": [3784, 3903], "body": [{"type": "fig_group", "body": [{"ext": null, "type": "fig", "indent": 8, "text": [" ", {"scheme": "Image", "value": "/images/char/kinefx_ragdoll_shapefromrefjoint.jpg", "type": "img", "text": ""}], "role": "item", "extent": [3903, 3975], "body": [{"type": "summary", "indent": 12, "text": ["Collision shape between selected and reference joints"], "extent": [4007, 4080]}], "container": true, "attrs": {"display": "left full"}}], "container": true, "role": "item_group"}], "container": true}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"type": "ui", "text": ["Off"]}, " centers the shape at the selected joint."], "extent": [4080, 4136], "body": [{"type": "fig_group", "body": [{"ext": null, "type": "fig", "indent": 8, "text": [" ", {"scheme": "Image", "value": "/images/char/kinefx_ragdoll_shapetransformoff.jpg", "type": "img", "text": ""}], "role": "item", "extent": [4136, 4208], "body": [{"type": "summary", "indent": 12, "text": ["Collision shape placed at selected joint"], "extent": [4240, 4299]}], "container": true, "attrs": {"display": "left full"}}], "container": true, "role": "item_group"}], "container": true}], "container": true}], "container": true}], "container": true}]}]}