{"type": "root", "attrs": {"type": "rig_component", "tags": "apex", "since": "20.5", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Delta Mush"], "extent": [58, 73]}, {"type": "summary", "indent": 0, "text": ["Smooths out point deformations."], "extent": [73, 113]}, {"tag": "div", "attrs": {"style": "position: relative;"}, "type": "xml", "text": ["\n    ", {"tag": "div", "attrs": {"style": "float: left; width: 5em;"}, "type": "xml", "text": ["\n        ", {"scheme": "Image", "value": "/images/beta.svg", "type": "link", "text": "", "fullpath": "/images/beta.svg.html"}, "\n    "]}, "\n    ", {"tag": "div", "attrs": {"style": "margin-left: 5em; padding-left: 1em; min-height: 4em;"}, "type": "xml", "text": ["\n        This feature is still under development. The current functionality is\n        unfinished and subject to change, and may have thin or no documentation.\n        Please bear this in mind when using it.\n    "]}, "\n"]}, {"type": "para", "indent": 0, "text": ["This component adds a ", {"scheme": "Node", "value": "/nodes/sop/deltamush", "type": "link", "text": ["sop::deltamush"], "fullpath": "/nodes/sop/deltamush.html"}, " node after a ", {"scheme": "Node", "value": "/nodes/sop/bonedeform", "type": "link", "text": ["sop::bonedeform"], "fullpath": "/nodes/sop/bonedeform.html"}, " node in an APEX rig."], "extent": [135, 266]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [266, 278], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["prefix"], "extent": [278, 287], "body": [{"type": "para", "indent": 4, "text": ["The prefix that is added to the nodes created by this component."], "extent": [287, 357]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["bonedeform"], "extent": [357, 369], "body": [{"type": "para", "indent": 4, "text": ["The sop::bonedeform node that the sop::deltamush node is connected to. This parameter is composed of the sop::bonedeform node name and the sop::bonedeform  port that connects to the sop::deltamush node, for example, ", {"type": "code", "text": ["Bonedeformation.geo"]}, ". This parameter also accepts the ", {"scheme": null, "value": "/character/kinefx/apexpathpattern#ports", "type": "link", "text": ["APEX path pattern port syntax"], "fullpath": "/character/kinefx/apexpathpattern.html#ports", "fragment": "#ports"}, ", for example, ", {"type": "code", "text": ["Bonedeformation:geo"]}, " and ", {"type": "code", "text": ["Bonedeformation:geo[out]"]}, ". If the ", {"type": "code", "text": ["[out]"]}, " port is not specified, the first port is used."], "extent": [369, 847]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["method"], "extent": [847, 855], "body": [{"type": "para", "indent": 4, "text": ["The weighting method used for smoothing."], "extent": [855, 901]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["iterations"], "extent": [901, 913], "body": [{"type": "para", "indent": 4, "text": ["The number of smoothing iterations to apply. More iterations result in smoother results. In general, more iterations are needed for the same amount of smoothing for geometry that have higher point counts at the same size."], "extent": [913, 1140]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["stepsize"], "extent": [1140, 1150], "body": [{"type": "para", "indent": 4, "text": ["The amount of smoothing applied for each iteration. Larger step sizes result in smoother results. If there are artifacts in the result, try using smaller step sizes and more ", {"type": "ui", "text": ["iterations"]}, " (at the expense of longer cook times)."], "extent": [1150, 1383]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1383, 1392], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/apexgraphbasics", "type": "link", "text": ["APEX graph basics"], "fullpath": "/character/kinefx/apexgraphbasics.html"}], "extent": [1392, 1448]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/apexpathpattern", "type": "link", "text": ["APEX path pattern"], "fullpath": "/character/kinefx/apexpathpattern.html"}], "extent": [1448, 1504]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/rigcharacter", "type": "link", "text": ["Rigging a character"], "fullpath": "/character/kinefx/rigcharacter.html"}], "extent": [1504, 1559]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--autorigcomponent", "type": "link", "text": "", "fullpath": "/nodes/sop/apex--autorigcomponent.html"}], "extent": [1559, 1595]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--rigscriptcomponent", "type": "link", "text": "", "fullpath": "/nodes/sop/apex--rigscriptcomponent.html"}], "extent": [1595, 1633]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/bonedeform", "type": "link", "text": "", "fullpath": "/nodes/sop/bonedeform.html"}], "extent": [1633, 1657]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/deltamush", "type": "link", "text": "", "fullpath": "/nodes/sop/deltamush.html"}], "extent": [1657, 1680]}], "container": true}], "text": "Related"}], "title": ["Delta Mush"], "summary": ["Smooths out point deformations."], "included": ["/news/beta"]}