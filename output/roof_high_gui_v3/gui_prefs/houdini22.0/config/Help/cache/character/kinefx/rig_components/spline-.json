{"type": "root", "attrs": {"type": "rig_component", "tags": "apex", "since": "20.5", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Spline"], "extent": [58, 69]}, {"type": "summary", "indent": 0, "text": ["Sets up a spline solver."], "extent": [69, 102]}, {"type": "para", "indent": 0, "text": ["This component sets up a spline solver and adds the control for either a tangent control or a custom setup by the user. This component can be run in a loop over different segments, or parts, of the character. "], "extent": [102, 313]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [313, 325], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["name"], "extent": [325, 332], "body": [{"type": "para", "indent": 4, "text": ["The name that is added to the nodes created by this component. When using ", {"type": "ui", "text": ["segments"]}, ", the segment name is also added to the nodes. "], "extent": [332, 471]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["guidesource"], "extent": [471, 484], "body": [{"type": "para", "indent": 4, "text": ["The ", {"scheme": null, "value": "/character/kinefx/preparingskeletons", "type": "link", "text": ["guide skeleton"], "fullpath": "/character/kinefx/preparingskeletons.html"}, " that is used as a reference when creating controls. "], "extent": [484, 601]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Settings"], "extent": [601, 616], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["curveorder"], "extent": [616, 629], "body": [{"type": "para", "indent": 4, "text": ["The order of the Bezier curve to build from the CVs. Defaults to 2 (linear Bezier curve)."], "extent": [629, 724]}, {"type": "para", "indent": 4, "text": ["Each segment of a Bezier curve requires that ", {"type": "code", "text": ["<number_of_cvs> = order"]}, ". Compound curves share a CV between their curve segments, so each additional curve segment requires an additional ", {"type": "code", "text": ["order-1"]}, " CVs. This requirement can be expressed by the equation ", {"type": "code", "text": ["<number_of_cvs> % (order-1) == 1"]}, "."], "extent": [724, 1015]}, {"type": "para", "indent": 4, "text": ["Order 3 and 4 curves are popular choices for ensuring that each CV has a relatively local impact on the shape of the curve while allowing for the smoothness and flexibility of quadratic and cubic polynomial curves. "], "extent": [1015, 1236]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tangent"], "extent": [1236, 1245], "body": [{"type": "para", "indent": 4, "text": ["The direction down the length of the chain."], "extent": [1245, 1294]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["pinroot"], "extent": [1294, 1303], "body": [{"type": "para", "indent": 4, "text": ["When turned on, constrains the orientation of the driven root to the controls. When turned off, the spline solver determines the orientation of the root."], "extent": [1303, 1462]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["pintip"], "extent": [1462, 1470], "body": [{"type": "para", "indent": 4, "text": ["When turned on, constrains the orientation of the driven tip to the controls. When turned off, the spline solver determines the orientation of the tip."], "extent": [1470, 1628]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Driven"], "extent": [1628, 1641], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["segments"], "extent": [1641, 1652], "body": [{"type": "para", "indent": 4, "text": ["Segments are ", {"scheme": null, "value": "/character/kinefx/graphmetadata#tags", "type": "link", "text": ["tags"], "fullpath": "/character/kinefx/graphmetadata.html#tags", "fragment": "#tags"}, " that separate each spline chain. Tags can be set up on skeleton joints using an ", {"scheme": "Node", "value": "/nodes/sop/attribadjustarray", "type": "link", "text": ["Attribute Adjust Array SOP"], "fullpath": "/nodes/sop/attribadjustarray.html"}, ". See ", {"scheme": null, "value": "/character/kinefx/preparingskeletons", "type": "link", "text": ["preparing skeletons for rigging"], "fullpath": "/character/kinefx/preparingskeletons.html"}, " for more information."], "extent": [1652, 1948]}, {"type": "para", "indent": 4, "text": ["If ", {"type": "ui", "text": ["segments"]}, " is empty, the spline logic is run once. "], "extent": [1948, 2010]}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [2010, 2020], "body": [{"type": "para", "indent": 8, "text": ["The segments parameter does not take ", {"scheme": null, "value": "/character/kinefx/apexpathpattern", "type": "link", "text": ["APEX path patterns"], "fullpath": "/character/kinefx/apexpathpattern.html"}, ", for example, the %tag() function. Instead, specify the tag names directly in this field."], "extent": [2020, 2211]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["driven"], "extent": [2211, 2219], "body": [{"type": "para", "indent": 4, "text": ["The TransformObject nodes to drive, for example, ", {"type": "code", "text": ["spine_01"]}, ", ", {"type": "code", "text": ["spine_02"]}, ", ", {"type": "code", "text": ["spine_03"]}, ". This parameter also accepts ", {"scheme": null, "value": "/character/kinefx/apexpathpattern", "type": "link", "text": ["APEX path patterns"], "fullpath": "/character/kinefx/apexpathpattern.html"}, ", so you can specify tags in this field, for example, ", {"type": "code", "text": ["%tag(spline)"]}, "."], "extent": [2219, 2461]}, {"type": "para", "indent": 4, "text": ["It is good practice to also specify the ", {"type": "code", "text": ["bind"]}, " tags that are set up by default on the ", {"scheme": null, "value": "/character/kinefx/rig_components/fktransform", "type": "link", "text": ["FK transform component\u2019s"], "fullpath": "/character/kinefx/rig_components/fktransform.html"}, " ", {"type": "ui", "text": ["tags"]}, " parameter. The FK transform component is normally the first component that is used to start building a rig. Including the ", {"type": "code", "text": ["bind"]}, " tag helps to ensure that you don\u2019t include other controls that might have inherited, for example, the ", {"type": "code", "text": ["spline"]}, " tag. In this case, you can set ", {"type": "ui", "text": ["driven"]}, " to ", {"type": "code", "text": ["%tag(bind) & %tag(spline)"]}, "."], "extent": [2461, 2947]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["root"], "extent": [2947, 2953], "body": [{"type": "para", "indent": 4, "text": ["The root of the spline. If this is empty, the root of the driven chain is used. This parameter accepts APEX path patterns, so you can specify tags in this field, for example, ", {"type": "code", "text": ["%tag(splineroot)"]}, ". "], "extent": [2953, 3154]}, {"type": "para", "indent": 4, "text": ["When using ", {"type": "ui", "text": ["segments"]}, ", you can use the segment name plus the tag, for example, ", {"type": "code", "text": ["%tag(splineroot) & %tag({segment})"]}, ". The ", {"type": "code", "text": ["{segment}"]}, " string is used to find the segment names. "], "extent": [3154, 3337]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tip"], "extent": [3337, 3342], "body": [{"type": "para", "indent": 4, "text": ["The tip of the spline. If this is empty, the tip of the driven chain is used. This parameter accepts APEX path patterns, so you can specify tags in this field, for example, ", {"type": "code", "text": ["%tag(splinetip)"]}, "."], "extent": [3342, 3539]}, {"type": "para", "indent": 4, "text": ["When using ", {"type": "ui", "text": ["segments"]}, ", you can use the segment name plus the tag, for example, ", {"type": "code", "text": ["%tag(splinetip) & %tag({segment})"]}, ". The ", {"type": "code", "text": ["{segment}"]}, " string is used to find the segment names. "], "extent": [3539, 3722]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Driver"], "extent": [3722, 3735], "body": [{"type": "para", "indent": 0, "text": ["By default, the spline component sets up a tangent spline with 4 controls - ", {"type": "ui", "text": ["rootname"]}, ", ", {"type": "ui", "text": ["rootcvname"]}, ", ", {"type": "ui", "text": ["tipcvname"]}, ", and ", {"type": "ui", "text": ["tipname"]}, ". The controls are created automatically using the root and tip as reference. Make sure the control names are unique and don\u2019t conflict with any other controls. You can use the ", {"type": "code", "text": ["{segment}"]}, " string when creating multiple splines so that there are no naming conflicts (see the ", {"type": "ui", "text": ["root"]}, " parameter)."], "extent": [3735, 4168]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["custom"], "extent": [4168, 4176], "body": [{"type": "para", "indent": 4, "text": ["When turned on, the ", {"type": "ui", "text": ["drivers"]}, ", ", {"type": "ui", "text": ["resample"]}, ", ", {"type": "ui", "text": ["prefix"]}, ", and ", {"type": "ui", "text": ["suffix"]}, " parameters are available for creating a custom spline setup. "], "extent": [4176, 4317]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["rootname"], "extent": [4317, 4327], "body": [{"type": "para", "indent": 4, "text": ["The name of the root control."], "extent": [4327, 4362]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["rootcvname"], "extent": [4362, 4374], "body": [{"type": "para", "indent": 4, "text": ["The name of the root tangent CV (control vertex). "], "extent": [4374, 4430]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tipcvname"], "extent": [4430, 4441], "body": [{"type": "para", "indent": 4, "text": ["The name of the tip tangent CV."], "extent": [4441, 4478]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tipname"], "extent": [4478, 4487], "body": [{"type": "para", "indent": 4, "text": ["The name of the tip control."], "extent": [4487, 4521]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["drivers"], "extent": [4521, 4530], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["custom"]}, " is turned on, these are the drivers for the custom spline setup. The controls are created based on the drivers. This parameter accepts APEX path patterns, so you can specify tags in this field, for example, ", {"type": "code", "text": ["%tag(spline)"]}, "."], "extent": [4530, 4774]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["resample"], "extent": [4774, 4784], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["custom"]}, " is turned on, the controls are deleted based on this value."], "extent": [4784, 4865]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["prefix"], "extent": [4865, 4873], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["custom"]}, " is turned on, this is the prefix for the control names in the custom spline setup."], "extent": [4873, 4977]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["suffix"], "extent": [4977, 4985], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["custom"]}, " is turned on, this is the suffix for the control names in the custom spline setup."], "extent": [4985, 5090]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Parents"], "extent": [5090, 5104], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["rootparent"], "extent": [5104, 5117], "body": [{"type": "para", "indent": 4, "text": ["The parent of the root. If left empty, the root is parented to ", {"type": "ui", "text": ["root"]}, "'s parent. If you are setting up multiple splines, you can leave this field empty. However, you can set parent tags on the guide skeleton, and use the parent tag plus the segment tag to get the correct parent for each segment. "], "extent": [5117, 5421]}, {"type": "para", "indent": 4, "text": ["This parameter accepts APEX path patterns, so you can specify tags in this field, for example, ", {"type": "code", "text": ["%tag(<tag>)"]}, ". "], "extent": [5421, 5537]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["tipparent"], "extent": [5537, 5548], "body": [{"type": "para", "indent": 4, "text": ["The parent of the tip. This parameter accepts APEX path patterns, so you can specify tags in this field. "], "extent": [5548, 5659]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["cvparent"], "extent": [5659, 5669], "body": [{"type": "para", "indent": 4, "text": ["The parent of the CVs. This parameter accepts APEX path patterns, so you can specify tags in this field. "], "extent": [5669, 5781]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tags"], "extent": [5781, 5792], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["tags"], "extent": [5792, 5799], "body": [{"type": "para", "indent": 4, "text": ["The tags that are added to the nodes created by this component."], "extent": [5799, 5869]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Shape"], "extent": [5869, 5881], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["scaleinheritance"], "extent": [5881, 5900], "body": [{"type": "para", "indent": 4, "text": ["The ", {"scheme": "Node", "value": "/nodes/apex/TransformObject#scale_inheritance", "type": "link", "text": ["scale inheritance"], "fullpath": "/nodes/apex/TransformObject.html#scale_inheritance", "fragment": "#scale_inheritance"}, " for the controls."], "extent": [5900, 5991]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["shape"], "extent": [5991, 5998], "body": [{"type": "para", "indent": 4, "text": ["The shape of the controls. It can be set to any of the ", {"scheme": "Node", "value": "/nodes/sop/apex--configurecontrols#shapeoverride", "type": "link", "text": ["built-in APEX control shapes"], "fullpath": "/nodes/sop/apex--configurecontrols.html#shapeoverride", "fragment": "#shapeoverride"}, "."], "extent": [5998, 6137]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["scale"], "extent": [6137, 6144], "body": [{"type": "para", "indent": 4, "text": ["The scale of the control shapes. To inherit the shape scale from the guide skeleton, set this value to (0, 0, 0)."], "extent": [6144, 6263]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["color"], "extent": [6263, 6270], "body": [{"type": "para", "indent": 4, "text": ["The color of the control shapes. To inherit the shape color from the guide skeleton, set this value to (0, 0, 0)."], "extent": [6270, 6389]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [6389, 6398], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/apexgraphbasics", "type": "link", "text": ["APEX graph basics"], "fullpath": "/character/kinefx/apexgraphbasics.html"}], "extent": [6398, 6454]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/graphmetadata#tags", "type": "link", "text": ["APEX graph tags"], "fullpath": "/character/kinefx/graphmetadata.html#tags", "fragment": "#tags"}], "extent": [6454, 6511]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/apexpathpattern", "type": "link", "text": ["APEX path pattern"], "fullpath": "/character/kinefx/apexpathpattern.html"}], "extent": [6511, 6567]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--configurecontrols#shapeoverride", "type": "link", "text": ["Built-in APEX control shapes"], "fullpath": "/nodes/sop/apex--configurecontrols.html#shapeoverride", "fragment": "#shapeoverride"}], "extent": [6567, 6647]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/preparingskeletons", "type": "link", "text": ["Preparing skeletons for rigging"], "fullpath": "/character/kinefx/preparingskeletons.html"}], "extent": [6647, 6720]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/rigcharacter", "type": "link", "text": ["Rigging a character"], "fullpath": "/character/kinefx/rigcharacter.html"}], "extent": [6720, 6775]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--autorigcomponent", "type": "link", "text": "", "fullpath": "/nodes/sop/apex--autorigcomponent.html"}], "extent": [6775, 6811]}], "container": true}], "text": "Related"}], "title": ["Spline"], "summary": ["Sets up a spline solver."]}