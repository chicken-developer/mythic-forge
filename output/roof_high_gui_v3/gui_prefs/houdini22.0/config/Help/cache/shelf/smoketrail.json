{"type": "root", "attrs": {"index": "no", "icon": "SHELF/contrail"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Smoke Trail"], "extent": [12, 28]}, {"type": "summary", "indent": 0, "text": ["Generates a clustered simulation of smoke from an animated object."], "extent": [52, 126]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [126, 147], "body": [{"type": "para", "indent": 4, "text": ["This shelf tool is deprecated."], "extent": [147, 183]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [183, 198], "body": [{"type": "para", "indent": 0, "text": ["This tool creates a complex geometry network to generate clustered source\ngeometry for the smoke from points scattered along the object\u2019s animated path.\nEach cluster of points is simulated in a separate smoke box. Simulating a\nseries of smaller boxes along the path is much more efficient than simulating\nall smoke in one large box."], "extent": [198, 533]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["How to"], "extent": [533, 546], "body": [{"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": [" Give an animated object a smoke trail"], "role": "item", "extent": [546, 593], "body": [{"type": "para", "indent": 4, "text": ["The object should already be animated before you use this tool."], "extent": [593, 662]}, {"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["Select an animated object."], "extent": [662, 696]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["On the ", {"type": "ui", "text": ["Pyro"]}, " shelf, click the Smoke Trail tool."], "extent": [696, 758], "body": [{"type": "para", "indent": 8, "text": ["The tool creates a Geometry object to generate the smoke source\n        (", {"type": "code", "text": [{"type": "var", "text": ["objectname"]}, "_sourcepts"]}, "), a simulation network (if it doesn\u2019t\n        already exist), and a Geometry object to import the results of the\n        simulation back as renderable geometry."], "extent": [758, 1028]}], "container": true}], "container": true}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": [" Prevent the smoke from rising"], "role": "item", "extent": [1028, 1066], "body": [{"type": "para", "indent": 4, "text": ["Modify the ", {"type": "code", "text": ["temperature"]}, " point attribute in the ", {"type": "code", "text": [{"type": "var", "text": ["objectname"]}, "_sourcepts"]}, "\n    network before the ", {"type": "code", "text": ["rasterization"]}, " loop."], "extent": [1066, 1191]}, {"level": 3, "type": "sep", "indent": 4, "text": [" or "], "extent": [1191, 1206]}, {"type": "para", "indent": 4, "text": ["Change the buoyancy on the ", {"type": "code", "text": ["pyrosolver"]}, " node."], "extent": [1206, 1258]}, {"level": 3, "type": "sep", "indent": 4, "text": [" or "], "extent": [1258, 1273]}, {"type": "para", "indent": 4, "text": ["In the DOP network, select the ", {"type": "code", "text": ["source_density_from_"]}, " node and set\n    ", {"type": "ui", "text": ["Scale"]}, " parameter for temperature import (under the ", {"type": "ui", "text": ["Volumes"]}, " tab) to\n    ", {"type": "code", "text": ["0"]}, "."], "extent": [1273, 1433]}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": [" Change the smoke density"], "role": "item", "extent": [1433, 1466], "body": [{"type": "para", "indent": 4, "text": ["Modify the ", {"type": "code", "text": ["density"]}, " point attribute in the ", {"type": "code", "text": [{"type": "var", "text": ["objectname"]}, "_sourcepts"]}, "\n    network before the ", {"type": "code", "text": ["rasterization"]}, " loop."], "extent": [1466, 1591]}, {"level": 3, "type": "sep", "indent": 4, "text": [" or "], "extent": [1591, 1606]}, {"type": "para", "indent": 4, "text": ["In the DOP network, select the ", {"type": "code", "text": ["source_density_from_"]}, " node and change the\n    ", {"type": "ui", "text": ["Scale"]}, " parameter for density import (under the ", {"type": "ui", "text": ["Volumes"]}, " tab)."], "extent": [1606, 1762]}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": [" Make the smoke dissipate faster or slower"], "role": "item", "extent": [1762, 1812], "body": [{"type": "para", "indent": 4, "text": ["In the DOP network, select the ", {"type": "code", "text": ["pyrosolver"]}, " node. Click the ", {"type": "ui", "text": ["Shape"]}, " tab,\n    then change the ", {"type": "ui", "text": ["Dissipation"]}, ". Higher values make the smoke dissipate\n    faster."], "extent": [1812, 1980]}], "container": true}, {"ext": null, "type": "task", "indent": 0, "text": [" Apply a material to the smoke"], "role": "item", "extent": [1980, 2018], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["In the ", {"scheme": null, "value": "/ref/panes/materialpalette", "type": "link", "text": ["material palette"], "fullpath": "/ref/panes/materialpalette.html"}, ", drag one of the\n    materials from under the Volume heading in the tree on the left to the area\n    on the right to create an instance of the material."], "extent": [2018, 2235], "body": [{"type": "para", "indent": 8, "text": ["Different materials give different looks to the generated smoke at\n        render time. For example, ", {"type": "q", "text": ["Wispy Smoke"]}, " looks less dense than ", {"type": "q", "text": ["Billowy\n        Smoke"]}, "."], "extent": [2235, 2410]}], "container": true}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["In the network editor, at the object level, select the ", {"type": "code", "text": ["pyro_import"]}, "\n    node. This node imports the results of the simulation (the generated smoke)\n    to make it a renderable object. This object is where you should apply the\n    material."], "extent": [2410, 2658]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["In the parameter editor, click the ", {"type": "ui", "text": ["Render"]}, " tab. Click the\n    ", {"scheme": "Icon", "value": "BUTTONS/chooser_node", "type": "link", "text": "", "fullpath": "/shelf/BUTTONS/chooser_node.html"}, " chooser icon next to the ", {"type": "ui", "text": ["Material"]}, " field.\n    Select the material you just created (for example, ", {"type": "code", "text": ["/mat/basicsmoke"]}, ") and\n    click ", {"type": "ui", "text": ["Accept"]}, "."], "extent": [2658, 2903]}], "container": true}], "container": true}], "container": true, "role": "item_group"}]}], "title": ["Smoke Trail"], "summary": ["Generates a clustered simulation of smoke from an animated object."]}