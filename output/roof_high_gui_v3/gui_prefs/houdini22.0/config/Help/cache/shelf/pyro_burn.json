{"type": "root", "attrs": {"icon": "SHELF/fire", "tags": "pyro", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Flames"], "extent": [0, 11]}, {"type": "summary", "indent": 0, "text": ["Creates flames rising from the selected object."], "extent": [54, 109]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [109, 130], "body": [{"type": "para", "indent": 4, "text": ["This shelf tool is deprecated. Use the ", {"scheme": null, "value": "/shelf/spyro_smokelessflame", "type": "link", "text": ["Smokeless Flames"], "fullpath": "/shelf/spyro_smokelessflame.html"}, " tool on the SOP Pyro FX tab instead."], "extent": [130, 258]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [258, 273], "body": [{"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [273, 280], "body": [{"type": "para", "indent": 4, "text": ["The effect created by this tool in Houdini 12+ and later looks different from the equivalent preset in prior versions of Houdini."], "extent": [280, 415]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This preset uses a low gas release rate to create persistent flames without\nan explosion. It has a high heat output so the smoke from the fire rises\nfaster than the flames."], "extent": [415, 589]}, {"type": "para", "indent": 0, "text": ["On the ", {"scheme": "Node", "value": "/nodes/dop/pyrosolver", "type": "link", "text": ["Pyro solver node"], "fullpath": "/nodes/dop/pyrosolver.html"}, "\u2026"], "extent": [589, 639]}, {"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Smoke amount"]}, " to control the amount of secondary smoke."], "extent": [639, 709]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Shredding"]}, " controls to rip the streaks apart."], "extent": [709, 769]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Disturbance"]}, " and ", {"type": "ui", "text": ["Turbulence"]}, " controls to add detail or\n  change motion. Flames usually need high turbulence."], "extent": [769, 895]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["For more detail you can also lower ", {"type": "ui", "text": ["Temperature Diffusion"]}, "."], "extent": [895, 960]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use ", {"type": "ui", "text": ["Flame Height"]}, " to change the height of the flames."], "extent": [960, 1020]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["For thicker smoke, turn on ", {"type": "ui", "text": ["Create Dense Smoke"]}, " and lower the\n  ", {"type": "ui", "text": ["Heat Cutoff"]}, "."], "extent": [1020, 1106]}], "container": true}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/pyro/pyro", "type": "link", "text": ["how to use the pyro tools"], "fullpath": "/pyro/pyro.html"}, "."], "extent": [1106, 1151]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tips"], "extent": [16, 27], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["If the object has a velocity point attribute (", {"type": "code", "text": ["v"]}, "), the\n  ", {"scheme": "Node", "value": "/nodes/sop/volumerasterizeattributes", "type": "link", "text": ["Volume Rasterize Attributes"], "fullpath": "/nodes/sop/volumerasterizeattributes.html"}, " SOP will\n  create a velocity volume for the simulation."], "extent": [27, 212], "body": [{"type": "para", "indent": 2, "text": ["To add velocity attributes to the object, use the\n  ", {"scheme": "Node", "value": "/nodes/sop/pointvelocity", "type": "link", "text": ["Point Velocity"], "fullpath": "/nodes/sop/pointvelocity.html"}, " SOP."], "extent": [212, 312]}], "container": true}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the disturbance and turbulence controls on the Pyro Solver\u2019s ", {"type": "ui", "text": ["Shape"]}, "\n  tab to add detail or change motion."], "extent": [312, 430]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the settings on the object\u2019s ", {"scheme": "Node", "value": "/nodes/sop/pyrosource", "type": "link", "text": ["Pyro Source"], "fullpath": "/nodes/sop/pyrosource.html"}, " and\n  ", {"scheme": "Node", "value": "/nodes/sop/attribnoise", "type": "link", "text": ["Attribute Noise"], "fullpath": "/nodes/sop/attribnoise.html"}, " SOPs to change the emission."], "extent": [430, 574]}], "container": true}]}]}], "title": ["Flames"], "summary": ["Creates flames rising from the selected object."], "included": ["/shelf/pyro_tips"]}