{"type": "root", "attrs": {"icon": "SHELF/candle", "tags": "pyro", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Candle"], "extent": [0, 11]}, {"type": "summary", "indent": 0, "text": ["Creates a smooth burning candle flame rising from the selected object."], "extent": [56, 134]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [134, 155], "body": [{"type": "para", "indent": 4, "text": ["This shelf tool is deprecated. Use the ", {"scheme": null, "value": "/shelf/spyro_candleflame", "type": "link", "text": ["Candle Flame"], "fullpath": "/shelf/spyro_candleflame.html"}, " tool on the SOP Pyro FX tab instead."], "extent": [155, 276]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [276, 291], "body": [{"type": "para", "indent": 0, "text": ["This shelf tool sets up a preset pyro effect resembling a candle flame. The\npyro system has low burn and gas release rates, so it looks smaller and less\ndynamic than other pyro presets. The preset uses disturbance to perturb the\nflame slightly. This preset releases almost no energy and so doesn\u2019t use up\nmuch fuel."], "extent": [291, 609]}, {"type": "para", "indent": 0, "text": ["One simple way to increase the height of the flame is to remap the Emit Range\non the Pyro object\u2019s multi-field visualization to make more of the flame\nvisible."], "extent": [609, 770]}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/pyro/pyro", "type": "link", "text": ["how to use the pyro tools"], "fullpath": "/pyro/pyro.html"}, "."], "extent": [770, 815]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tips"], "extent": [16, 27], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["If the object has a velocity point attribute (", {"type": "code", "text": ["v"]}, "), the\n  ", {"scheme": "Node", "value": "/nodes/sop/volumerasterizeattributes", "type": "link", "text": ["Volume Rasterize Attributes"], "fullpath": "/nodes/sop/volumerasterizeattributes.html"}, " SOP will\n  create a velocity volume for the simulation."], "extent": [27, 212], "body": [{"type": "para", "indent": 2, "text": ["To add velocity attributes to the object, use the\n  ", {"scheme": "Node", "value": "/nodes/sop/pointvelocity", "type": "link", "text": ["Point Velocity"], "fullpath": "/nodes/sop/pointvelocity.html"}, " SOP."], "extent": [212, 312]}], "container": true}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the disturbance and turbulence controls on the Pyro Solver\u2019s ", {"type": "ui", "text": ["Shape"]}, "\n  tab to add detail or change motion."], "extent": [312, 430]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the settings on the object\u2019s ", {"scheme": "Node", "value": "/nodes/sop/pyrosource", "type": "link", "text": ["Pyro Source"], "fullpath": "/nodes/sop/pyrosource.html"}, " and\n  ", {"scheme": "Node", "value": "/nodes/sop/attribnoise", "type": "link", "text": ["Attribute Noise"], "fullpath": "/nodes/sop/attribnoise.html"}, " SOPs to change the emission."], "extent": [430, 574]}], "container": true}]}]}], "title": ["Candle"], "summary": ["Creates a smooth burning candle flame rising from the selected object."], "included": ["/shelf/pyro_tips"]}