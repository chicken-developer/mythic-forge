{"type": "root", "attrs": {"icon": "SHELF/smoke_heavy", "tags": "pyro", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Billowy smoke"], "extent": [0, 18]}, {"type": "summary", "indent": 0, "text": ["Creates thick cloud-like smoke rising from the selected object."], "extent": [68, 139]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [139, 160], "body": [{"type": "para", "indent": 4, "text": ["This shelf tool is deprecated. Use the ", {"scheme": null, "value": "/shelf/pyrosimplebillowysmoke", "type": "link", "text": ["Sparse Billowy Smoke"], "fullpath": "/shelf/pyrosimplebillowysmoke.html"}, " tool on the SOP Pyro FX tab instead."], "extent": [160, 294]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [294, 309], "body": [{"type": "para", "indent": 0, "text": ["Creates thick cloud-like smoke rising from the selected object."], "extent": [309, 375]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [375, 380], "body": [{"type": "para", "indent": 4, "text": ["The ", {"scheme": null, "value": "/shelf/spyro_billowysmoke", "type": "link", "text": ["Sparse Billowy Smoke"], "fullpath": "/shelf/spyro_billowysmoke.html"}, " tool on the ", {"type": "ui", "text": ["Sparse Pyro"]}, " shelf will give you similar results with a faster solve time."], "extent": [380, 528]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/pyro/pyro", "type": "link", "text": ["how to use the pyro tools"], "fullpath": "/pyro/pyro.html"}, "."], "extent": [528, 573]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tips"], "extent": [16, 27], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["If the object has a velocity point attribute (", {"type": "code", "text": ["v"]}, "), the\n  ", {"scheme": "Node", "value": "/nodes/sop/volumerasterizeattributes", "type": "link", "text": ["Volume Rasterize Attributes"], "fullpath": "/nodes/sop/volumerasterizeattributes.html"}, " SOP will\n  create a velocity volume for the simulation."], "extent": [27, 212], "body": [{"type": "para", "indent": 2, "text": ["To add velocity attributes to the object, use the\n  ", {"scheme": "Node", "value": "/nodes/sop/pointvelocity", "type": "link", "text": ["Point Velocity"], "fullpath": "/nodes/sop/pointvelocity.html"}, " SOP."], "extent": [212, 312]}], "container": true}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the disturbance and turbulence controls on the Pyro Solver\u2019s ", {"type": "ui", "text": ["Shape"]}, "\n  tab to add detail or change motion."], "extent": [312, 430]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the settings on the object\u2019s ", {"scheme": "Node", "value": "/nodes/sop/pyrosource", "type": "link", "text": ["Pyro Source"], "fullpath": "/nodes/sop/pyrosource.html"}, " and\n  ", {"scheme": "Node", "value": "/nodes/sop/attribnoise", "type": "link", "text": ["Attribute Noise"], "fullpath": "/nodes/sop/attribnoise.html"}, " SOPs to change the emission."], "extent": [430, 574]}], "container": true}]}]}], "title": ["Billowy smoke"], "summary": ["Creates thick cloud-like smoke rising from the selected object."], "included": ["/shelf/pyro_tips"]}