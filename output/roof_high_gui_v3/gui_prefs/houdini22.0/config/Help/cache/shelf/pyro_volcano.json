{"type": "root", "attrs": {"icon": "SHELF/volcano", "tags": "pyro", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Volcano"], "extent": [0, 12]}, {"type": "summary", "indent": 0, "text": ["Creates a voluminous column of thick smoke, as from the rim of an erupting volcano."], "extent": [58, 149]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [149, 170], "body": [{"type": "para", "indent": 4, "text": ["This shelf tool is deprecated."], "extent": [170, 206]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [206, 221], "body": [{"type": "para", "indent": 0, "text": ["Creates a voluminous column of thick smoke, as from the rim of an erupting volcano. The resolution (", {"type": "ui", "text": ["Divisions"]}, ") of the cloud\u2019s pyro box is low to begin with. As you play with the parameters and start to get the motion you want, increase the ", {"type": "ui", "text": ["Divisions"]}, " to get more detail."], "extent": [221, 501]}, {"type": "para", "indent": 0, "text": ["On the ", {"scheme": "Node", "value": "/nodes/dop/pyrosolver", "type": "link", "text": ["Pyro solver node"], "fullpath": "/nodes/dop/pyrosolver.html"}, "\u2026"], "extent": [501, 551]}, {"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Smoke amount"]}, " to control the amount of secondary smoke."], "extent": [551, 621]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Heat output"]}, " parameter to make the plume rise faster."], "extent": [621, 689]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Gas released"]}, " parameter to influence the size of the plume."], "extent": [689, 763]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Shredding"]}, " controls to rip the streaks apart."], "extent": [763, 823]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the ", {"type": "ui", "text": ["Disturbance"]}, " and ", {"type": "ui", "text": ["Turbulence"]}, " controls to add detail or\n  change motion."], "extent": [823, 912]}], "container": true}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/pyro/pyro", "type": "link", "text": ["how to use the pyro tools"], "fullpath": "/pyro/pyro.html"}, "."], "extent": [912, 957]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tips"], "extent": [16, 27], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["If the object has a velocity point attribute (", {"type": "code", "text": ["v"]}, "), the\n  ", {"scheme": "Node", "value": "/nodes/sop/volumerasterizeattributes", "type": "link", "text": ["Volume Rasterize Attributes"], "fullpath": "/nodes/sop/volumerasterizeattributes.html"}, " SOP will\n  create a velocity volume for the simulation."], "extent": [27, 212], "body": [{"type": "para", "indent": 2, "text": ["To add velocity attributes to the object, use the\n  ", {"scheme": "Node", "value": "/nodes/sop/pointvelocity", "type": "link", "text": ["Point Velocity"], "fullpath": "/nodes/sop/pointvelocity.html"}, " SOP."], "extent": [212, 312]}], "container": true}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the disturbance and turbulence controls on the Pyro Solver\u2019s ", {"type": "ui", "text": ["Shape"]}, "\n  tab to add detail or change motion."], "extent": [312, 430]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the settings on the object\u2019s ", {"scheme": "Node", "value": "/nodes/sop/pyrosource", "type": "link", "text": ["Pyro Source"], "fullpath": "/nodes/sop/pyrosource.html"}, " and\n  ", {"scheme": "Node", "value": "/nodes/sop/attribnoise", "type": "link", "text": ["Attribute Noise"], "fullpath": "/nodes/sop/attribnoise.html"}, " SOPs to change the emission."], "extent": [430, 574]}], "container": true}]}]}], "title": ["Volcano"], "summary": ["Creates a voluminous column of thick smoke, as from the rim of an erupting volcano."], "included": ["/shelf/pyro_tips"]}