{"type": "root", "attrs": {"icon": "SHELF/dry_ice", "tags": "pyro", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Dry Ice"], "extent": [0, 12]}, {"type": "summary", "indent": 0, "text": ["Creates dry ice fog falling from the selected object."], "extent": [58, 119]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [119, 140], "body": [{"type": "para", "indent": 4, "text": ["This shelf tool is deprecated. Use the ", {"scheme": null, "value": "/shelf/spyro_dryice", "type": "link", "text": ["Dry Ice"], "fullpath": "/shelf/spyro_dryice.html"}, " tool on the SOP Pyro FX tab instead."], "extent": [140, 251]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [251, 266], "body": [{"type": "para", "indent": 0, "text": ["This shelf tool sets up a falling smoke effect resembling dry ice fog. The\npreset uses a negative ", {"type": "ui", "text": ["Scale"]}, " value for temperature sourcing on the\n", {"scheme": "Node", "value": "/nodes/dop/volumesource", "type": "link", "text": ["Volume Source"], "fullpath": "/nodes/dop/volumesource.html"}, " node to create cold smoke that will fall\ninstead of rise."], "extent": [266, 510]}, {"type": "para", "indent": 0, "text": ["The preset uses a high diffusion rate to make the smoke settle quickly and\ncreate the appropriate ", {"type": "q", "text": ["drizzling"]}, " look."], "extent": [510, 627]}, {"type": "para", "indent": 0, "text": ["On the ", {"scheme": "Node", "value": "/nodes/dop/pyrosolver", "type": "link", "text": ["Pyro Solver"], "fullpath": "/nodes/dop/pyrosolver.html"}, " node, the dissipation range is\nremapped to start below zero, to correctly evaporate the fog over time."], "extent": [627, 772]}, {"type": "para", "indent": 0, "text": ["Use the Disturbance and Turbulence controls on the pyro solver to add detail or\nchange motion."], "extent": [772, 868]}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/pyro/pyro", "type": "link", "text": ["how to use the pyro tools"], "fullpath": "/pyro/pyro.html"}, "."], "extent": [868, 913]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Tips"], "extent": [16, 27], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["If the object has a velocity point attribute (", {"type": "code", "text": ["v"]}, "), the\n  ", {"scheme": "Node", "value": "/nodes/sop/volumerasterizeattributes", "type": "link", "text": ["Volume Rasterize Attributes"], "fullpath": "/nodes/sop/volumerasterizeattributes.html"}, " SOP will\n  create a velocity volume for the simulation."], "extent": [27, 212], "body": [{"type": "para", "indent": 2, "text": ["To add velocity attributes to the object, use the\n  ", {"scheme": "Node", "value": "/nodes/sop/pointvelocity", "type": "link", "text": ["Point Velocity"], "fullpath": "/nodes/sop/pointvelocity.html"}, " SOP."], "extent": [212, 312]}], "container": true}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the disturbance and turbulence controls on the Pyro Solver\u2019s ", {"type": "ui", "text": ["Shape"]}, "\n  tab to add detail or change motion."], "extent": [312, 430]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Use the settings on the object\u2019s ", {"scheme": "Node", "value": "/nodes/sop/pyrosource", "type": "link", "text": ["Pyro Source"], "fullpath": "/nodes/sop/pyrosource.html"}, " and\n  ", {"scheme": "Node", "value": "/nodes/sop/attribnoise", "type": "link", "text": ["Attribute Noise"], "fullpath": "/nodes/sop/attribnoise.html"}, " SOPs to change the emission."], "extent": [430, 574]}], "container": true}]}]}], "title": ["Dry Ice"], "summary": ["Creates dry ice fog falling from the selected object."], "included": ["/shelf/pyro_tips"]}