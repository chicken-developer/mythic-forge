{"type": "root", "attrs": {"type": "hscript", "index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["compproject"], "extent": [27, 43]}, {"type": "summary", "indent": 0, "text": ["Controls the current compositing project."], "extent": [43, 93]}, {"type": "usage_group", "body": [{"ext": null, "type": "usage", "indent": 0, "text": [" ", {"type": "code", "text": ["compproject [-a ", {"type": "var", "text": ["pixelAspectRatio"]}, "] [-d i8|i16|i32|fp] [-P ", {"type": "var", "text": ["zoom"]}, "] [-p ", {"type": "var", "text": ["black"]}, " ", {"type": "var", "text": ["white"]}, "] [-r ", {"type": "var", "text": ["xres"]}, " ", {"type": "var", "text": ["yres"]}, "] [-f on|off] [-F on|off] [-l on|off] [-m ", {"type": "var", "text": ["xres"]}, " ", {"type": "var", "text": ["yres"]}]}], "role": "item", "extent": [93, 281]}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["These settings are saved with the hip file. Changing these settings will\nchange any COP nodes that are following these next time they are output\nor viewed."], "extent": [281, 438]}, {"level": 1, "id": "options", "container": true, "type": "options_section", "indent": 0, "role": "section", "extent": [438, 447], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-a ", {"type": "var", "text": ["pixelAspectRatio"]}, " "]}], "extent": [447, 479], "body": [{"type": "para", "indent": 8, "text": ["Sets the pixel aspect ratio. A ratio of 2:1 (X:Y) should be\n        passed as 2."], "extent": [479, 568]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-d i8|i16|i32|fp"]}], "extent": [568, 592], "body": [{"type": "para", "indent": 8, "text": ["Sets the project data format: 8, 16, 32 bit integer, or floating\n        point."], "extent": [592, 680]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-P ", {"type": "var", "text": ["zoom"]}, " "]}], "extent": [680, 700], "body": [{"type": "para", "indent": 8, "text": ["Sets the proxy zoom level. Zoom levels are: icon 1/8 1/4 1/3 1/2\n        2/3 3/4 full 1.33 1.5 2 4 8"], "extent": [700, 809]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-p ", {"type": "var", "text": ["black"]}, " ", {"type": "var", "text": ["white"]}, " "]}], "extent": [809, 840], "body": [{"type": "para", "indent": 8, "text": ["Sets the black and white points for integer formats."], "extent": [840, 901]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-r ", {"type": "var", "text": ["xres"]}, " ", {"type": "var", "text": ["yres"]}, " "]}], "extent": [901, 930], "body": [{"type": "para", "indent": 8, "text": ["Sets the project resolution."], "extent": [930, 967]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-f on|off"]}], "extent": [967, 984], "body": [{"type": "para", "indent": 8, "text": ["If on, all File COPs' resolutions are overridden by the project\n        resolution (as the default setting for all new File COPs). If\n        off, the files natural resolution is used."], "extent": [984, 1177]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-F on|off"]}], "extent": [1177, 1194], "body": [{"type": "para", "indent": 8, "text": ["If on, all File COPs' pixel depths are overridden by the project\n        pixel depth (as the default setting for all new file COPs). If\n        off, the files natural depth is used."], "extent": [1194, 1384]}], "container": true}, {"type": "dt", "indent": 4, "text": [{"type": "code", "text": ["-l on|off"]}], "extent": [1384, 1401], "body": [{"type": "para", "indent": 8, "text": ["Turns Large Canvas support on or off. If on, image data outside\n        of (0,0) - (", {"type": "code", "text": ["xres"]}, ", ", {"type": "code", "text": ["yres"]}, ") will be retained. If off, this data is\n        cropped."], "extent": [1401, 1565]}], "container": true}], "container": true}, {"type": "para", "indent": 4, "text": [{"type": "code", "text": ["-m ", {"type": "var", "text": ["xres"]}, " ", {"type": "var", "text": ["yres"]}]}], "extent": [1565, 1592], "body": [{"type": "para", "indent": 8, "text": ["Sets the resolution limit. Images larger than this will error out\n        rather than cook. This is to avoid accidentally creating huge images,\n        which can crash the application."], "extent": [1592, 1786]}], "container": true}], "text": "Options"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1786, 1795], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Cmd", "value": "/commands/compopts", "type": "link", "text": ["compopts"], "fallback_text": "compopts", "fullpath": "/commands/compopts.html"}], "extent": [1795, 1826]}], "container": true}], "text": "Related"}], "title": ["compproject"], "summary": ["Controls the current compositing project."]}