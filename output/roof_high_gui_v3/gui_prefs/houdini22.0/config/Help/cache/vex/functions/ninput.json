{"type": "root", "attrs": {"type": "vex", "context": "cop2", "tags": "cop2, pixel, sample", "group": "image", "index": "no", "showtags": "true"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["ninput"], "extent": [0, 11]}, {"type": "summary", "indent": 0, "text": ["Reads a component from a pixel and its eight neighbors."], "extent": [91, 154]}, {"type": "usage_group", "body": [{"ext": null, "type": "usage", "indent": 0, "text": [" ", {"type": "code", "text": ["matrix3 ninput(int opinput, int plane, int component, int array_index, int u, int v, int frame, ...)"]}], "role": "item", "extent": [154, 265]}, {"ext": null, "type": "usage", "indent": 0, "text": [" ", {"type": "code", "text": ["matrix3 ninput(int opinput, int plane, int component, int array_index; float u, float v; int frame, ...)"]}], "role": "item", "extent": [265, 381]}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Reads the given component from the targeted pixel and its eight neighbors and returns them in a 3\u00d73 matrix.\nNote that this function only reads one component (for example, red, green, or blue) at a time.\nTo sample full color, you need to call the function three times with ", {"type": "code", "text": ["component"]}, " set to 0, 1, and 2."], "extent": [381, 686]}, {"type": "arg_group", "body": [{"ext": null, "type": "arg", "indent": 0, "text": {"type": "code", "text": {"type": "code", "text": ["opinput"]}}, "role": "item", "extent": [423, 437], "body": [{"type": "para", "indent": 4, "text": ["The input number to read from, starting from 0. For example, the first input is 0, the second input is 1, and so on."], "extent": [463, 585]}], "container": true, "attrs": {"id": "opinput_arg"}}, {"ext": null, "type": "arg", "indent": 0, "text": {"type": "code", "text": ["plane"]}, "role": "item", "extent": [717, 729], "body": [{"type": "para", "indent": 4, "text": ["The index of the plane to read from."], "extent": [729, 771]}], "container": true}, {"ext": null, "type": "arg", "indent": 0, "text": {"type": "code", "text": ["component"]}, "role": "item", "extent": [771, 787], "body": [{"type": "para", "indent": 4, "text": ["The index of the component to read from. For example, 0 is red, 1 is green, 2 is blue in an RGB plane."], "extent": [787, 895]}], "container": true}, {"ext": null, "type": "arg", "indent": 0, "text": {"type": "code", "text": {"type": "code", "text": ["array_index"]}}, "role": "item", "extent": [2280, 2298], "body": [{"type": "para", "indent": 4, "text": ["For use if the plane has array values. Generally, just pass ", {"type": "code", "text": ["0"]}, " here."], "extent": [2327, 2402]}], "container": true, "attrs": {"id": "arrayindex_arg"}}, {"ext": null, "type": "arg", "indent": 0, "text": [{"type": "code", "text": ["u"]}, ", ", {"type": "code", "text": ["v"]}], "role": "item", "extent": [2624, 2639], "body": [{"type": "para", "indent": 4, "text": ["If you give floating point UVs, the values are interpreted as unit (0-1) values. For example, ", {"type": "code", "text": ["0.5, 0.5"]}, " would be the center of the image.\n    If you give integer UVs, the values are in pixels, ranging from ", {"type": "code", "text": ["0,0"]}, " to ", {"type": "code", "text": ["XRES-1, YRES-1"]}, "."], "extent": [2660, 2899]}], "container": true, "attrs": {"id": "uv_arg"}}], "container": true, "role": "item_group"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [954, 963], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Vex", "value": "/vex/functions/binput", "type": "link", "text": "", "fallback_text": "binput()", "fullpath": "/vex/functions/binput.html"}], "extent": [963, 979]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Vex", "value": "/vex/functions/cinput", "type": "link", "text": "", "fallback_text": "cinput()", "fullpath": "/vex/functions/cinput.html"}], "extent": [979, 994]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Vex", "value": "/vex/functions/finput", "type": "link", "text": "", "fallback_text": "finput()", "fullpath": "/vex/functions/finput.html"}], "extent": [994, 1009]}], "container": true}], "text": "Related"}], "title": ["ninput"], "summary": ["Reads a component from a pixel and its eight neighbors."], "included": ["/vex/functions/_common", "/vex/functions/binput"]}