{"type": "root", "attrs": {"type": "node", "context": "vop", "internal": "mtlxambientocclusion", "icon": "COMMON/materialx", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["MtlX Ambientocclusion"], "extent": [83, 109]}, {"type": "para", "indent": 0, "text": ["Compute the ambient occlusion at the current surface point, returning a scalar value between 0 and 1.  Ambient occlusion represents the accessibility of each surface point to ambient lighting, with larger values representing greater accessibility to light.  This node must be of type float."], "extent": [109, 402]}, {"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [402, 411], "body": [{"type": "para", "indent": 4, "text": ["This node was removed from MaterialX. The ", {"scheme": "Node", "value": "/nodes/vop/kma_ao", "type": "link", "text": ["Karma Ambient Occlusion"], "fullpath": "/nodes/vop/kma_ao.html"}, " can be used instead, starting from Houdini 22."], "extent": [411, 547]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [547, 559], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["coneangle"], "extent": [559, 570], "body": [{"type": "para", "indent": 4, "text": ["The half-angle of a cone about the surface normal, within which geometric surface features are considered as potential occluders.  The unit for this input is degrees, and its default value is 90.0 (full hemisphere)."], "extent": [570, 790]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["maxdistance"], "extent": [790, 803], "body": [{"type": "para", "indent": 4, "text": ["The maximum distance from the surface point at which geometric surface features are considered as potential occluders.  Defaults to 1e38, e.g. 'unlimited'."], "extent": [803, 963]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [963, 972], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["out"], "extent": [972, 977], "body": [{"type": "para", "indent": 4, "text": ["float"], "extent": [977, 987]}], "container": true}], "container": true}], "text": "Outputs"}], "title": ["MtlX Ambientocclusion"]}