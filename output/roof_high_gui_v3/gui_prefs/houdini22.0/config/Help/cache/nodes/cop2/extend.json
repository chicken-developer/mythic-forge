{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "extend", "icon": "COP2/extend", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Extend"], "extent": [76, 87]}, {"type": "summary", "indent": 0, "text": ["Extends the length of a sequence so that it can be animated beyond\nits frame range."], "extent": [87, 179]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation extends the length of a sequence so that it can be\nanimated beyond its frame range. This operation can also be used to\nchange the sequence\u2019s extend conditions."], "extent": [222, 398]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [398, 404], "body": [{"type": "para", "indent": 4, "text": ["This operation does not use any cache memory."], "extent": [404, 456]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [456, 468], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Extend Before/After"], "extent": [468, 493], "body": [{"type": "para", "indent": 8, "text": ["The number of frames to extend before or after the sequence. The\n        menu determine how the missing frames are filled in."], "extent": [493, 628]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Black Frames"], "extent": [628, 650], "body": [{"type": "para", "indent": 12, "text": ["Black frames are used for the extended frames."], "extent": [650, 709]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Cycle"], "extent": [709, 724], "body": [{"type": "para", "indent": 12, "text": ["Frames are cycled from the sequence so the extended sequence\n            appears cyclic."], "extent": [724, 825]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Mirror"], "extent": [825, 841], "body": [{"type": "para", "indent": 12, "text": ["Frames are cycled in a mirrored fashion so the extended\n            sequence cycles back and forth."], "extent": [841, 953]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Hold"], "extent": [953, 967], "body": [{"type": "para", "indent": 12, "text": ["The first/last frame is held for the extended frames."], "extent": [967, 1033]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Pre/Post Extend"], "extent": [1033, 1054], "body": [{"type": "para", "indent": 8, "text": ["Changes the Pre or Post extend condition of the sequence."], "extent": [1054, 1120]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Pre/Post Hold"], "extent": [1120, 1139], "body": [{"type": "para", "indent": 8, "text": ["Changes the Pre or Post hold of the sequence when the new extend\n        condition is 'Hold for N frames'."], "extent": [1139, 1255]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1255, 1264], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/snip", "type": "link", "text": "", "fullpath": "/nodes/cop2/snip.html"}], "extent": [1264, 1287]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/trim", "type": "link", "text": "", "fullpath": "/nodes/cop2/trim.html"}], "extent": [1287, 1311]}], "container": true}], "text": "Related"}], "title": ["Extend"], "summary": ["Extends the length of a sequence so that it can be animated beyond\nits frame range."], "included": ["/composite/_old_cops_deprecated"]}