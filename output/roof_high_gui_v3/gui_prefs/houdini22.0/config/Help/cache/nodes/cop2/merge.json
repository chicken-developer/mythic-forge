{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "merge", "icon": "COP2/merge", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Merge"], "extent": [74, 84]}, {"type": "summary", "indent": 0, "text": ["Merges the planes of several inputs together."], "extent": [84, 138]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation merges the planes of several inputs together. Most of the\nparameters determine how to handle differences in the sequences, such as\nimage size, frame range and plane conflicts."], "extent": [181, 374]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [374, 386], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Plane Conflict"], "extent": [386, 406], "body": [{"type": "para", "indent": 8, "text": ["Planes from different inputs with the same name are in conflict.\n        A conflicting plane is the second plane or later which matches\n        an existing plane name. This parameter determines how to resolve\n        the conflict."], "extent": [406, 646]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Rename Conflicting Plane"], "extent": [646, 680], "body": [{"type": "para", "indent": 12, "text": ["The plane is renamed by adding a unique suffix number."], "extent": [680, 747]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Add to Plane Array if Identical else Rename"], "extent": [747, 800], "body": [{"type": "para", "indent": 12, "text": ["A plane array is created if the planes' data format and\n            structure match, otherwise the conflicting plane is\n            renamed."], "extent": [800, 953]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Add to Plane Array if Identical else Ignore"], "extent": [953, 1006], "body": [{"type": "para", "indent": 12, "text": ["A plane array is created if the planes' data format and\n            structure match, otherwise the conflicting plane is not\n            merged in."], "extent": [1006, 1165]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Ignore Conflicting Planes"], "extent": [1165, 1200], "body": [{"type": "para", "indent": 12, "text": ["Any conflicting planes are not merged in."], "extent": [1200, 1254]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Error if Conflicts Occur"], "extent": [1254, 1288], "body": [{"type": "para", "indent": 12, "text": ["A conflict flags a cooking error."], "extent": [1288, 1334]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Resolution Match"], "extent": [1334, 1356], "body": [{"type": "para", "indent": 8, "text": ["If the resolutions of the inputs are not all the same, this\n        parameter determines how to choose the output resolution."], "extent": [1356, 1490]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Size"], "extent": [1490, 1500], "body": [{"type": "para", "indent": 8, "text": ["If Resolution Match is set to 'Specify a Resolution', this is\n        the parameter which specifies the size."], "extent": [1500, 1618]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Scale to New Size"], "extent": [1618, 1641], "body": [{"type": "para", "indent": 8, "text": ["If on, all inputs not matching the output resolution are scaled\n        to the output resolution, otherwise they are cropped or extended\n        with black."], "extent": [1641, 1806]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Scale Filter"], "extent": [1806, 1824], "body": [{"type": "para", "indent": 8, "text": ["The filter to use when scaling images."], "extent": [1824, 1871]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Range"], "extent": [1871, 1888], "body": [{"type": "para", "indent": 8, "text": ["If the frame ranges of the inputs differ, this determines what\n        the output range should be."], "extent": [1888, 1995]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Rate"], "extent": [1995, 2011], "body": [{"type": "para", "indent": 8, "text": ["If the frame rates of the inputs differ, this determines what\n        the output frame rate should be."], "extent": [2011, 2122]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Match"], "extent": [2122, 2139], "body": [{"type": "para", "indent": 8, "text": ["If the frame rates of the inputs differ, this determines which\n        input frame to pick when the cook time doesn\u2019t reside on a frame\n        boundary."], "extent": [2139, 2301]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Input ", {"type": "var", "text": ["n"]}, " Scope"], "extent": [2301, 2324], "body": [{"type": "para", "indent": 8, "text": ["One of these parameters is available for each connected input.\n        Only planes listed in the scope will be merged from the given\n        input; the others will be ignored ('*' indicates all planes).\n        You can use the menu button to select planes from the available\n        input planes."], "extent": [2324, 2629]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [2629, 2637], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2663, 2672], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/delete", "type": "link", "text": "", "fullpath": "/nodes/cop2/delete.html"}], "extent": [2672, 2697]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/rename", "type": "link", "text": "", "fullpath": "/nodes/cop2/rename.html"}], "extent": [2697, 2723]}], "container": true}], "text": "Related"}], "title": ["Merge"], "summary": ["Merges the planes of several inputs together."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}