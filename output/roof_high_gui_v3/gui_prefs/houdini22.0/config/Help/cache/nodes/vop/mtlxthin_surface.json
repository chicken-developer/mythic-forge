{"type": "root", "attrs": {"type": "node", "context": "vop", "internal": "mtlxthin_surface", "icon": "COMMON/materialx", "version": null, "namespace": null}, "body": [{"type": "summary", "indent": 0, "text": ["A constructor node for two-sided objects."], "extent": [79, 128]}, {"level": 0, "type": "title", "indent": 0, "text": ["MtlX Thin Surface"], "extent": [128, 150]}, {"type": "para", "indent": 0, "text": [{"scheme": "Image", "value": "/images/nodes/vop/mtlxthin_surface.jpg", "type": "img", "text": ""}], "extent": [150, 199]}, {"type": "para", "indent": 0, "text": ["A constructor node for the surfaceshader type for non-closed 'thin' objects. The surface is two sided and can describe a different BSDF and EDF for each side. If only one BSDF is connected the same BSDF will be used on both sides. If an EDF is not connected no emission will occur from that side. Volumetric properties of connected BSDF\u2019s are not supported since the object has no volume."], "extent": [199, 589]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [589, 601], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["front_bsdf"], "extent": [601, 613], "body": [{"type": "para", "indent": 4, "text": ["Distribution function for front-side surface scattering."], "extent": [613, 674]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["front_edf"], "extent": [674, 685], "body": [{"type": "para", "indent": 4, "text": ["Distribution function for front-side surface emission."], "extent": [685, 744]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["back_bsdf"], "extent": [744, 755], "body": [{"type": "para", "indent": 4, "text": ["Distribution function for back-side surface scattering."], "extent": [755, 815]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["back_edf"], "extent": [815, 825], "body": [{"type": "para", "indent": 4, "text": ["Distribution function for back-side surface emission."], "extent": [825, 883]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["opacity"], "extent": [883, 892], "body": [{"type": "para", "indent": 4, "text": ["Surface cutout opacity"], "extent": [892, 920]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [920, 929], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["out"], "extent": [929, 934], "body": [{"type": "para", "indent": 4, "text": ["surfaceshader"], "extent": [934, 952]}], "container": true}], "container": true}], "text": "Outputs"}], "summary": ["A constructor node for two-sided objects."], "title": ["MtlX Thin Surface"]}