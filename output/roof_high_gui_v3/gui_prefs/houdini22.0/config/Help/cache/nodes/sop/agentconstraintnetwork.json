{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "agentconstraintnetwork", "icon": "SOP/agentconstraintnetwork", "version": "2.0", "since": "22.0", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Agent Constraint Network"], "extent": [122, 151]}, {"type": "summary", "indent": 0, "text": ["Builds a constraint network to hold an agent\u2019s limbs together."], "extent": [151, 222]}, {"type": "para", "indent": 0, "text": ["This node will create a ", {"scheme": "Node", "value": "/nodes/dop/constraintnetwork", "type": "link", "text": ["constraint"], "fullpath": "/nodes/dop/constraintnetwork.html"}, " for each transform in the agent\u2019s collision layer that has a shape attached to it.\nThe rotation limits set up by the ", {"scheme": "Node", "value": "/nodes/sop/agentconfigurejoints", "type": "link", "text": ["Agent Configure Joints"], "fullpath": "/nodes/sop/agentconfigurejoints.html"}, " node will be used to set up ", {"scheme": "Node", "value": "/nodes/dop/conetwistconrel", "type": "link", "text": ["cone twist constraints"], "fullpath": "/nodes/dop/conetwistconrel.html"}, ".\nIf there are multiple root collision shapes, ", {"scheme": "Node", "value": "/nodes/dop/hardconrel", "type": "link", "text": ["pin constraints"], "fullpath": "/nodes/dop/hardconrel.html"}, " can be created to prevent the ragdoll from immediately separating."], "extent": [222, 688]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [688, 700], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Group"], "extent": [700, 708], "body": [{"type": "para", "indent": 4, "text": ["The agents to create constraints for."], "extent": [723, 770]}], "container": true, "attrs": {"id": "group"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Joint Config Metadata"], "extent": [770, 793], "body": [{"type": "para", "indent": 4, "text": ["The name of the joint configuration metadata to read rotation limits from, as defined by ", {"scheme": "Node", "value": "/nodes/sop/agentconfigurejoints", "type": "link", "text": ["Agent Configure Joints"], "fullpath": "/nodes/sop/agentconfigurejoints.html"}, "."], "extent": [822, 976]}], "container": true, "attrs": {"id": "jointconfigmetadata"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Pin Root Collision Shapes"], "extent": [976, 1003], "body": [{"type": "para", "indent": 4, "text": ["If there are multiple root collision shapes, pin constraints will be created to hold those objects together."], "extent": [1026, 1144]}], "container": true, "attrs": {"id": "pinrootshapes"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Softness"], "extent": [1144, 1154], "body": [{"type": "para", "indent": 8, "text": ["Once an angle is greater than softness times the maximum angle, the constraint begins to take effect.\n        Lowering the value of softness softens the constraint boundaries."], "extent": [1670, 1855]}], "container": true, "attrs": {"id": "softness"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Constraint Force Mixing"], "extent": [1231, 1256], "body": [{"type": "para", "indent": 8, "text": ["Increase this to make the constraint spongier, and potentially increase the stability of the simulation.\n        The angular component of the constraint may be violated by an amount proportional to the force required to re-establish the constraint, times this parameter."], "extent": [2257, 2537]}], "container": true, "attrs": {"id": "constraintforcemixing"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Bias Factor"], "extent": [1341, 1354], "body": [{"type": "para", "indent": 8, "text": ["The rate at which the constraint corrects errors in orientation.\n        A value of 1 will ensure that the constraint is always obeyed.\n        It is recommended to keep bias between 0.2 and 0.5."], "extent": [2579, 2784]}], "container": true, "attrs": {"id": "biasfactor"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Relaxation Factor"], "extent": [1436, 1455], "body": [{"type": "para", "indent": 8, "text": ["The rate at which the angular velocity is changed by the\n        constraint. A low value means the constraint will modify\n        the velocities slowly, leaving the boundaries appearing\n        softer."], "extent": [2838, 3049]}], "container": true, "attrs": {"id": "relaxationfactor"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Position CFM"], "extent": [1549, 1563], "body": [{"type": "para", "indent": 8, "text": ["Increase this to make the constraint spongier, and potentially increase the stability of the simulation.\n        The position component of the constraint may be violated by an amount proportional to the force required to re-establish the constraint, times this parameter."], "extent": [4440, 4721]}], "container": true, "attrs": {"id": "positioncfm"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Position ERP"], "extent": [1646, 1660], "body": [{"type": "para", "indent": 8, "text": ["Specifies what proportion of the position error will be fixed during the next simulation step.\n        A value between 0.1 and 0.8 is recommended for most simulation."], "extent": [4764, 4940]}], "container": true, "attrs": {"id": "positionerp"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Show Guides"], "extent": [1743, 1756], "body": [{"type": "para", "indent": 4, "text": ["Toggles the visibility of guide geometry which represents the constraints' limits. "], "extent": [1776, 1869]}], "container": true, "attrs": {"id": "showguides"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Guide Scale"], "extent": [1869, 1882], "body": [{"type": "para", "indent": 4, "text": ["Scales the size of the guide geometry when ", {"type": "ui", "text": ["Show Guides"]}, " is enabled."], "extent": [1905, 1981]}], "container": true, "attrs": {"id": "guidegeoscale"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [1981, 1989], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Agents"], "extent": [1989, 1998], "body": [{"type": "para", "indent": 4, "text": ["The agents to create constraints for."], "extent": [1998, 2041]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [2041, 2050], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Agents"], "extent": [2050, 2059], "body": [{"type": "para", "indent": 4, "text": ["The agents from the input geometry."], "extent": [2059, 2100]}], "container": true}, {"type": "dt", "indent": 0, "text": ["Constraint Geometry"], "extent": [2100, 2121], "body": [{"type": "para", "indent": 4, "text": ["Constraint geometry to be used with the ", {"scheme": "Node", "value": "/nodes/dop/bulletrbdsolver", "type": "link", "text": ["Bullet Solver"], "fullpath": "/nodes/dop/bulletrbdsolver.html"}, "."], "extent": [2121, 2208]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2208, 2217], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agent", "type": "link", "text": "", "fullpath": "/nodes/sop/agent.html"}], "extent": [2217, 2236]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/kinefx--agentfromrig", "type": "link", "text": "", "fullpath": "/nodes/sop/kinefx--agentfromrig.html"}], "extent": [2236, 2270]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agentcollisionlayer", "type": "link", "text": "", "fullpath": "/nodes/sop/agentcollisionlayer.html"}], "extent": [2270, 2303]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agentconfigurejoints", "type": "link", "text": "", "fullpath": "/nodes/sop/agentconfigurejoints.html"}], "extent": [2303, 2337]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/bulletrbdsolver", "type": "link", "text": "", "fullpath": "/nodes/dop/bulletrbdsolver.html"}], "extent": [2337, 2366]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/crowdsolver", "type": "link", "text": "", "fullpath": "/nodes/dop/crowdsolver.html"}], "extent": [2366, 2391]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/conetwistconrel", "type": "link", "text": "", "fullpath": "/nodes/dop/conetwistconrel.html"}], "extent": [2391, 2420]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/constraintnetwork", "type": "link", "text": "", "fullpath": "/nodes/dop/constraintnetwork.html"}], "extent": [2420, 2451]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/hardconrel", "type": "link", "text": "", "fullpath": "/nodes/dop/hardconrel.html"}], "extent": [2451, 2475]}], "container": true}], "text": "Related"}], "title": ["Agent Constraint Network"], "summary": ["Builds a constraint network to hold an agent\u2019s limbs together."], "included": ["/nodes/dop/conetwistconrel", "/nodes/dop/standard_bulletconstraint_parm", "/nodes/dop/standard_conetwistconrelguide_parms", "/nodes/dop/standard_data_idparms", "/nodes/dop/standard_data_inputs", "/nodes/dop/standard_data_locals", "/nodes/dop/standard_data_outputs", "/nodes/dop/standard_data_parms", "/nodes/dop/standard_dataactive_parms", "/nodes/dop/standard_datagroup_parms", "/nodes/dop/standard_dataname_parms", "/nodes/dop/standard_dataop_parms", "/nodes/dop/standard_datashare_parms", "/nodes/dop/standard_locals"]}