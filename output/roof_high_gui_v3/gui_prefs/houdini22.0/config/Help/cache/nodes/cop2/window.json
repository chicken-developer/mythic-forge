{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "window", "icon": "COP2/window", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Window"], "extent": [76, 87]}, {"type": "summary", "indent": 0, "text": ["Cuts a small window out of a larger image."], "extent": [87, 138]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation reduces the resolution of the image, and allows you to\nfocus in on a specific area of the image. It does not replace the area\noutside the windowed area with black; the original image information is\nkept."], "extent": [181, 401]}, {"type": "para", "indent": 0, "text": ["This operation effectively does a Transform and Crop."], "extent": [401, 456]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [456, 462], "body": [{"type": "para", "indent": 4, "text": ["If Large Canvas support is off, this node does exactly the same\n    thing as the Crop operation."], "extent": [462, 565]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [565, 577], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Method"], "extent": [577, 589], "body": [{"type": "para", "indent": 8, "text": ["The window area can either be represented by 2 opposite points\n        of a rectangle, or the rectangles lower left corner and its\n        width and height."], "extent": [589, 754]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Units"], "extent": [754, 765], "body": [{"type": "para", "indent": 8, "text": ["Specifies the units to crop in, either pixels or UV."], "extent": [765, 826]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Horizontal Area"], "extent": [826, 847], "body": [{"type": "para", "indent": 8, "text": ["The left/right bounds of the window area. This parameter cannot\n        be animated; use the Offset parameter to pan the image through\n        the window."], "extent": [847, 1010]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Vertical Area"], "extent": [1010, 1029], "body": [{"type": "para", "indent": 8, "text": ["The bottom/top bounds of the window area. This parameter cannot\n        be animated; use the Offset parameter to pan the image through\n        the window."], "extent": [1029, 1192]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Offset"], "extent": [1192, 1204], "body": [{"type": "para", "indent": 8, "text": ["An animatable image offset, so the image may be panned through\n        the area."], "extent": [1242, 1340]}], "container": true, "attrs": {"channels": "/offset1 /offset2"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Hold Edges Outside Image Bounds"], "extent": [1340, 1377], "body": [{"type": "para", "indent": 8, "text": ["This determines the behavior of the crop when the crop window goes outside the normal image bounds. If on, the edge pixels will be streaked outward to fill the outside area. If off, black pixels will be used."], "extent": [1402, 1620]}], "container": true, "attrs": {"channels": "hold"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1620, 1628], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1654, 1663], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/crop", "type": "link", "text": "", "fullpath": "/nodes/cop2/crop.html"}], "extent": [1663, 1687]}], "container": true}], "text": "Related"}], "title": ["Window"], "summary": ["Cuts a small window out of a larger image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}