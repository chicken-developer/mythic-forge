{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "tile", "icon": "COP2/tile", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Tile"], "extent": [72, 81]}, {"type": "summary", "indent": 0, "text": ["Tiles the image sequence with multiple copies of the input image."], "extent": [81, 155]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation tiles the image sequence with multiple copies of the\ninput image. The copies can be flipped every other tiling by mirroring\nthe image."], "extent": [198, 349]}, {"type": "para", "indent": 0, "text": ["The resolution of the image is increased by the amount of tiling\nvertically and horizontally:"], "extent": [349, 444]}, {"lang": null, "type": "pre", "indent": 0, "text": ["\nNew X resolution = (old X resolution) * (# of tiles in X)\nNew Y resolution = (old Y resolution) * (# of tiles in Y)\n"], "extent": [444, 568]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [568, 574], "body": [{"type": "para", "indent": 4, "text": ["The amount of tiling in X and Y cannot be animated, as this changes\n    the size of the image (though the offsets can be animated). If you\n    want to animate the tiling, use a Transform COP with the Image Wrap\n    set to 'Repeat' or 'Mirror' and animate the transform."], "extent": [574, 850]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [850, 862], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Tiling"], "extent": [862, 874], "body": [{"type": "para", "indent": 8, "text": ["Specify the number of copies of the input image to tile here,\n        both horizontally and vertically."], "extent": [912, 1024]}], "container": true, "attrs": {"channels": "/tiling1 /tiling2"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Tile Offset"], "extent": [1024, 1041], "body": [{"type": "para", "indent": 8, "text": ["Allows you to set the origin of the tiling (uses UV 0-1\n        ranges). This will translate the tiles."], "extent": [1079, 1191]}], "container": true, "attrs": {"channels": "/offset1 /offset2"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Tile Method"], "extent": [1191, 1208], "body": [{"type": "para", "indent": 8, "text": ["Allows you to mirror the copies that you are tiling\n        independently for X and Y."], "extent": [1208, 1304]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Normal"], "extent": [1304, 1320], "body": [{"type": "para", "indent": 12, "text": ["Don\u2019t do any mirroring."], "extent": [1320, 1356]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Mirror"], "extent": [1356, 1372], "body": [{"type": "para", "indent": 12, "text": ["Flip every other tile, starting with the second tile."], "extent": [1372, 1438]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Mirror First"], "extent": [1438, 1460], "body": [{"type": "para", "indent": 12, "text": ["Flip every other tile, starting at the first tile."], "extent": [1460, 1523]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1523, 1531], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1557, 1566], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/mosaic", "type": "link", "text": "", "fullpath": "/nodes/cop2/mosaic.html"}], "extent": [1566, 1591]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/xform", "type": "link", "text": "", "fullpath": "/nodes/cop2/xform.html"}], "extent": [1591, 1616]}], "container": true}], "text": "Related"}], "title": ["Tile"], "summary": ["Tiles the image sequence with multiple copies of the input image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}