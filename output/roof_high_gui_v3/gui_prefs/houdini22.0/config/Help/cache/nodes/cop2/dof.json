{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "dof", "icon": "COP2/dof", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Depth of Field"], "extent": [70, 89]}, {"type": "summary", "indent": 0, "text": ["Creates a depth-of-field mask, which describes how out of focus parts\nof the image are."], "extent": [89, 185]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation creates a depth-of-field mask, which describes how out of\nfocus parts of the image are. Combined with a Blur or Defocus COP, with\nthe mask set to M and ", {"type": "q", "text": ["Per-Pixel Blur/Defocus"]}, " on, a depth-of-field\neffect can be done. This mask can also used as an input to color\ncorrection operations to accentuate an area of interest."], "extent": [228, 564]}, {"type": "para", "indent": 0, "text": ["A point or depth plane (P or Pz) must be present in order for this\noperation to produce valid results."], "extent": [564, 668]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overloading VEX Parameters"], "extent": [27, 60], "body": [{"type": "para", "indent": 0, "text": ["This operator is implemented in VEX, which supports parameter\noverloading. If the first input has a plane which matches an\noperation parameter\u2019s channel name, the input plane will be used as\nthe parameter\u2019s value, effectively overriding it. The overloaded\nparameter is then evaluated from the plane on a per-pixel basis."], "extent": [60, 383]}, {"type": "para", "indent": 0, "text": [{"type": "em", "text": ["eg."]}, " If the input COP has the following planes:"], "extent": [383, 433]}, {"lang": null, "type": "pre", "indent": 0, "text": ["\nC{r,g,b}\nA\nfogdens\n"], "extent": [433, 460]}, {"type": "para", "indent": 0, "text": ["and it is fed into a VEX Fog COP, the fog density will be determined\nat each pixel by the fogdens plane, since the Fog Density\nparameter\u2019s channel name matches the 'fogdens' channel name."], "extent": [460, 649]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [688, 700], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Focus Distance"], "extent": [700, 720], "body": [{"type": "para", "indent": 8, "text": ["The distance where everything is entirely in focus."], "extent": [720, 780]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Depth Adjustment"], "extent": [780, 802], "body": [{"type": "para", "indent": 8, "text": ["Increase or decrease the size of the area that will be out of\n        focus. Corresponds to the ", {"type": "q", "text": ["depth of focus"]}, " on a real camera\n        lens."], "extent": [802, 954]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Distance Adjustment"], "extent": [954, 979], "body": [{"type": "para", "indent": 8, "text": ["Adds a constant value to the distance (which is not the same as\n        adjusting the focus distance, which adjusts the dropoff as\n        well)."], "extent": [979, 1133]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Default Mask Value"], "extent": [1133, 1157], "body": [{"type": "para", "indent": 8, "text": ["The mask value to use when a depth-of-field value cannot be\n        computed (if the depth is zero)."], "extent": [1157, 1266]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1266, 1274], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1300, 1309], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/blur", "type": "link", "text": "", "fullpath": "/nodes/cop2/blur.html"}], "extent": [1309, 1332]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/defocus", "type": "link", "text": "", "fullpath": "/nodes/cop2/defocus.html"}], "extent": [1332, 1358]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/light", "type": "link", "text": "", "fullpath": "/nodes/cop2/light.html"}], "extent": [1358, 1383]}], "container": true}], "text": "Related"}], "title": ["Depth of Field"], "summary": ["Creates a depth-of-field mask, which describes how out of focus parts\nof the image are."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/vexnode"]}