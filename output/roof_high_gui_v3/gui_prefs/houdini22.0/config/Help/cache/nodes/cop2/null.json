{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "null", "icon": "COP2/null", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Null"], "extent": [72, 81]}, {"type": "summary", "indent": 0, "text": ["Does nothing."], "extent": [81, 103]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation does nothing. It acts simply as a placeholder to make\nwiring networks easier, or to allow you to reference a single output COP\nwithout having to update all the references to it if the real output COP\nchanges."], "extent": [146, 371]}, {"type": "para", "indent": 0, "text": ["This COP does not use any image cache space, nor does it cook anything."], "extent": [371, 446]}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [446, 455], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fetch", "type": "link", "text": "", "fullpath": "/nodes/cop2/fetch.html"}], "extent": [455, 480]}], "container": true}], "text": "Related"}], "title": ["Null"], "summary": ["Does nothing."], "included": ["/composite/_old_cops_deprecated"]}