{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "implicitsurface_core", "icon": "SOP/implicitsurface_core", "since": "22.0", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Implicit Surface Core"], "extent": [116, 142]}, {"type": "summary", "indent": 0, "text": ["Creates one implicit surface operation."], "extent": [142, 190]}, {"type": "para", "indent": 0, "text": ["Creates a single low-level implicit surface operation point. This is the atomic building block used by the ", {"scheme": "Node", "value": "/nodes/sop/implicitsurface", "type": "link", "text": ["Implicit Surface SOP"], "fullpath": "/nodes/sop/implicitsurface.html"}, " and ", {"scheme": "Node", "value": "/nodes/sop/implicitsurface_operation", "type": "link", "text": ["Implicit Surface Operation SOP"], "fullpath": "/nodes/sop/implicitsurface_operation.html"}, ". "], "extent": [190, 420]}, {"type": "para", "indent": 0, "text": ["Use this node in custom networks where you need to construct the implicit surface expression one operation at a time and need precise control over the evaluation order."], "extent": [420, 590]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [590, 602], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Transform"], "extent": [602, 619], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Translate"], "extent": [619, 631], "body": [{"type": "para", "indent": 4, "text": ["Position of the shape in world space."], "extent": [642, 685]}], "container": true, "attrs": {"id": "t"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rotate"], "extent": [685, 693], "body": [{"type": "para", "indent": 4, "text": ["Rotation of the shape in degrees."], "extent": [704, 747]}], "container": true, "attrs": {"id": "r"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Operation"], "extent": [747, 763], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Operation"], "extent": [763, 775], "body": [{"type": "para", "indent": 4, "text": ["Operation stored on this point. Controls how the point modifies the implicit surface expression."], "extent": [795, 897]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["None/Invalid"], "extent": [897, 915], "body": [{"type": "para", "indent": 8, "text": ["Creates an ignored operation. The point does not contribute to the implicit surface."], "extent": [915, 1009]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Begin"], "extent": [1009, 1020], "body": [{"type": "para", "indent": 8, "text": ["Starts a grouped sub-expression. Use a shape set to ", {"type": "ui", "text": ["End"]}, " to close the group and combine the grouped result back into the previous value."], "extent": [1020, 1169]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Invert"], "extent": [1169, 1181], "body": [{"type": "para", "indent": 8, "text": ["Swaps inside and outside by negating the current value."], "extent": [1181, 1246]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Offset"], "extent": [1246, 1258], "body": [{"type": "para", "indent": 8, "text": ["Offsets the current implicit surface. Positive values expand the surface and negative values shrink it."], "extent": [1258, 1371]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Shell"], "extent": [1371, 1382], "body": [{"type": "para", "indent": 8, "text": ["Converts the current implicit surface into a shell around the surface."], "extent": [1382, 1462]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Union"], "extent": [1462, 1473], "body": [{"type": "para", "indent": 8, "text": ["Combines the current value with this point\u2019s shape, keeping the region inside either surface."], "extent": [1473, 1576]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Intersect"], "extent": [1576, 1591], "body": [{"type": "para", "indent": 8, "text": ["Combines the current value with this point\u2019s shape, keeping only the region inside both surfaces."], "extent": [1591, 1698]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Subtract"], "extent": [1698, 1712], "body": [{"type": "para", "indent": 8, "text": ["Removes this point\u2019s shape from the current value."], "extent": [1712, 1772]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Difference"], "extent": [1772, 1788], "body": [{"type": "para", "indent": 8, "text": ["Keeps the region inside either the current value or this point\u2019s shape, but not both."], "extent": [1788, 1887]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "operation"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Fillet"], "extent": [1887, 1895], "body": [{"type": "para", "indent": 4, "text": ["Optional transition style for binary operations."], "extent": [1912, 1966]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["None"], "extent": [1966, 1976], "body": [{"type": "para", "indent": 8, "text": ["Uses the sharp version of the selected operation."], "extent": [1976, 2035]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Smooth"], "extent": [2035, 2047], "body": [{"type": "para", "indent": 8, "text": ["Smoothly blends between the operands using ", {"type": "ui", "text": ["Smoothness"]}, "."], "extent": [2047, 2115]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Round"], "extent": [2115, 2126], "body": [{"type": "para", "indent": 8, "text": ["Rounds the transition between the operands using ", {"type": "ui", "text": ["Round Radius"]}, "."], "extent": [2126, 2202]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Chamfer"], "extent": [2202, 2215], "body": [{"type": "para", "indent": 8, "text": ["Adds a chamfered transition between the operands using ", {"type": "ui", "text": ["Chamfer"]}, "."], "extent": [2215, 2296]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "fillet"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Operation Parameters"], "extent": [2296, 2325], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Offset Distance"], "extent": [2325, 2343], "body": [{"type": "para", "indent": 4, "text": ["Distance used by ", {"type": "ui", "text": ["Offset"]}, ". Positive values expand the surface and negative values shrink it."], "extent": [2359, 2463]}], "container": true, "attrs": {"id": "offset"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Offset"], "extent": [2463, 2471], "body": [{"type": "para", "indent": 4, "text": ["Offset of the shell center from the original surface for ", {"type": "ui", "text": ["Shell"]}, "."], "extent": [2492, 2565]}], "container": true, "attrs": {"id": "shelloffset"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Thickness"], "extent": [2565, 2576], "body": [{"type": "para", "indent": 4, "text": ["Thickness of the shell created by ", {"type": "ui", "text": ["Shell"]}, "."], "extent": [2600, 2650]}], "container": true, "attrs": {"id": "shellthickness"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Smoothness"], "extent": [2650, 2662], "body": [{"type": "para", "indent": 4, "text": ["Width of the smooth blend region when ", {"type": "ui", "text": ["Fillet"]}, " is ", {"type": "ui", "text": ["Smooth"]}, ". Larger values create a broader transition."], "extent": [2680, 2797]}], "container": true, "attrs": {"id": "smoothk"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Round Radius"], "extent": [2797, 2811], "body": [{"type": "para", "indent": 4, "text": ["Radius of the rounded transition when ", {"type": "ui", "text": ["Fillet"]}, " is ", {"type": "ui", "text": ["Round"]}, "."], "extent": [2832, 2900]}], "container": true, "attrs": {"id": "roundradius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Chamfer"], "extent": [2900, 2909], "body": [{"type": "para", "indent": 4, "text": ["Size of the chamfered transition when ", {"type": "ui", "text": ["Fillet"]}, " is ", {"type": "ui", "text": ["Chamfer"]}, "."], "extent": [2927, 2998]}], "container": true, "attrs": {"id": "chamferk"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Repulsion"], "extent": [2998, 3009], "body": [{"type": "para", "indent": 4, "text": ["Repulsion amount used by smooth repulsive union. This only applies when ", {"type": "ui", "text": ["Operation"]}, " is ", {"type": "ui", "text": ["Union"]}, " and ", {"type": "ui", "text": ["Fillet"]}, " is ", {"type": "ui", "text": ["Smooth"]}, "."], "extent": [3028, 3166]}], "container": true, "attrs": {"id": "repulsion"}, "role": "item"}], "container": true, "role": "item_group"}]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Shape Settings"], "extent": [3166, 3187], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Shape"], "extent": [3187, 3195], "body": [{"type": "para", "indent": 4, "text": ["Shape evaluated by binary operations. Unary operations ignore this setting."], "extent": [3211, 3292]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Empty"], "extent": [3292, 3303], "body": [{"type": "para", "indent": 8, "text": ["Uses no shape. The point does not add a geometric primitive."], "extent": [3303, 3373]}], "container": true}, {"type": "dt", "indent": 4, "text": ["End"], "extent": [3373, 3382], "body": [{"type": "para", "indent": 8, "text": ["Ends a group started by ", {"type": "ui", "text": ["Begin"]}, ". The selected operation combines the grouped result with the value that existed before the group started."], "extent": [3382, 3531]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Box"], "extent": [3531, 3540], "body": [{"type": "para", "indent": 8, "text": ["Creates a box, optionally with rounded edges."], "extent": [3540, 3595]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Plane"], "extent": [3595, 3606], "body": [{"type": "para", "indent": 8, "text": ["Creates an infinite plane."], "extent": [3606, 3642]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Sphere"], "extent": [3642, 3654], "body": [{"type": "para", "indent": 8, "text": ["Creates a sphere. Unequal radii create an ellipsoid."], "extent": [3654, 3716]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Torus"], "extent": [3716, 3727], "body": [{"type": "para", "indent": 8, "text": ["Creates a torus. A positive ", {"type": "ui", "text": ["Link Length"]}, " stretches it into a chain link shape."], "extent": [3727, 3818]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Tube"], "extent": [3818, 3828], "body": [{"type": "para", "indent": 8, "text": ["Creates a cylinder, cone, segment, or capsule depending on the radius values and ", {"type": "ui", "text": ["Round Caps"]}, " setting."], "extent": [3828, 3942]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "shape"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Uniform Scale"], "extent": [3942, 3957], "body": [{"type": "para", "indent": 4, "text": ["Uniform scale applied to the selected shape parameters."], "extent": [3971, 4037]}], "container": true, "attrs": {"id": "size"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Shape Parameters"], "extent": [4037, 4062], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Box Size"], "extent": [4062, 4073], "body": [{"type": "para", "indent": 4, "text": ["Size of the box along its local X, Y, and Z axes."], "extent": [4090, 4145]}], "container": true, "attrs": {"id": "boxsize"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Roundness"], "extent": [4145, 4156], "body": [{"type": "para", "indent": 4, "text": ["Radius used to round the box edges. A value of ", {"type": "code", "text": ["0"]}, " creates a sharp box."], "extent": [4178, 4260]}], "container": true, "attrs": {"id": "boxroundness"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [4260, 4268], "body": [{"type": "para", "indent": 4, "text": ["Radius of the sphere along the local X, Y, and Z axes. Equal values create a sphere. Unequal values create an ellipsoid."], "extent": [4290, 4416]}], "container": true, "attrs": {"id": "sphereradius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Torus Radius"], "extent": [4416, 4430], "body": [{"type": "para", "indent": 4, "text": ["Major radius and tube radius of the torus."], "extent": [4451, 4503]}], "container": true, "attrs": {"id": "torusradius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Link Length"], "extent": [4503, 4516], "body": [{"type": "para", "indent": 4, "text": ["Stretches the torus into a chain link shape. A value of ", {"type": "code", "text": ["0"]}, " creates a regular torus."], "extent": [4536, 4626]}], "container": true, "attrs": {"id": "linklength"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Length"], "extent": [4626, 4634], "body": [{"type": "para", "indent": 4, "text": ["Length of the tube along its local axis."], "extent": [4654, 4700]}], "container": true, "attrs": {"id": "tubelength"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [4700, 4708], "body": [{"type": "para", "indent": 4, "text": ["Radii at the two ends of the tube. Matching values create a straight tube; different values create a tapered tube."], "extent": [4728, 4852]}], "container": true, "attrs": {"id": "tuberadius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Radius Scale"], "extent": [4852, 4866], "body": [{"type": "para", "indent": 4, "text": ["Uniform scale applied to the tube radii."], "extent": [4888, 4935]}], "container": true, "attrs": {"id": "tuberadscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Round Caps"], "extent": [4935, 4947], "body": [{"type": "para", "indent": 4, "text": ["Rounds the tube ends. With matching radii this creates a capsule-like segment. With different radii this creates a rounded tapered capsule."], "extent": [4966, 5111]}], "container": true, "attrs": {"id": "roundcaps"}, "role": "item"}], "container": true, "role": "item_group"}]}]}], "text": "Parameters"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [5111, 5120], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Implicit Surface"], "extent": [5120, 5139], "body": [{"type": "para", "indent": 4, "text": ["A single implicit surface operation point. Merge multiple core nodes to build a complete implicit surface expression."], "extent": [5139, 5271]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [5271, 5280], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/implicitsurface", "type": "link", "text": "", "fullpath": "/nodes/sop/implicitsurface.html"}], "extent": [5280, 5309]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/implicitsurface_operation", "type": "link", "text": "", "fullpath": "/nodes/sop/implicitsurface_operation.html"}], "extent": [5309, 5348]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/implicitsurface_convert", "type": "link", "text": "", "fullpath": "/nodes/sop/implicitsurface_convert.html"}], "extent": [5348, 5385]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Vex", "value": "/vex/functions/implicitsurface", "type": "link", "text": "", "fallback_text": "implicitsurface()", "fullpath": "/vex/functions/implicitsurface.html"}], "extent": [5385, 5409]}], "container": true}], "text": "Related"}], "title": ["Implicit Surface Core"], "summary": ["Creates one implicit surface operation."]}