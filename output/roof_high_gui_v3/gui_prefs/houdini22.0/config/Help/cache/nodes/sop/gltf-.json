{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "gltf", "icon": "COMMON/gltf", "since": "17.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["glTF"], "extent": [75, 84]}, {"type": "para", "indent": 0, "text": ["The glTF SOP can load geometry and flattened hierarchy data from a glTF file.\nSee the following link for further information about the ", {"scheme": null, "value": "https://www.khronos.org/gltf/", "type": "link", "text": ["glTF format"], "exists": true}, "."], "extent": [84, 266]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [266, 272], "body": [{"type": "para", "indent": 4, "text": ["See the following link for an ", {"scheme": null, "value": "/io/gltf", "type": "link", "text": ["overview of importing and exporting GLTF files to and from Houdini."], "fullpath": "/io/gltf.html"}], "extent": [272, 386]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["The follow table provides further details about which glTF features and extensions are supported, plus any relevant notes about how they are supported:"], "extent": [386, 539]}, {"type": "table", "thead": [], "body": [{"type": "row", "body": [{"type": "cell", "indent": 0, "text": [{"tag": "b", "attrs": {}, "type": "xml", "text": ["glTF Property or Extension"]}, " "], "role": "td", "extent": [539, 575], "container": true}, {"type": "cell", "indent": 4, "text": [{"tag": "b", "attrs": {}, "type": "xml", "text": ["Supported"]}, " "], "role": "td", "extent": [575, 598], "container": true}, {"type": "cell", "role": "td", "body": [{"tag": "b", "attrs": {}, "type": "xml", "text": ["Notes"]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Scene "], "role": "td", "extent": [620, 628], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/sop/MISC/checkmark.html"}, " "], "role": "td", "extent": [628, 656], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["A scene can be imported by setting ", {"type": "ui", "text": ["Load By"]}, " to ", {"type": "ui", "text": ["Scene"]}, ". Depending on the configuration of ", {"type": "ui", "text": ["Geometry Type"]}, ", nodes will be imported either as packed primitives or as flattened geometry where transforms are baked into the geometry\u2019s points."], "extent": [656, 910]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Node "], "role": "td", "extent": [910, 917], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/sop/MISC/checkmark.html"}, " "], "role": "td", "extent": [917, 945], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Specific nodes can be imported by setting ", {"type": "ui", "text": ["Load By"]}, " to ", {"type": "ui", "text": ["Node"]}, ". The selected node along with all its child nodes in the scene will be imported. Depending on the configuration of ", {"type": "ui", "text": ["Geometry Type"]}, ", the nodes will be imported either as packed primitives or as flattened geometry where transforms are baked into the geometry\u2019s points."], "extent": [945, 1289]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh "], "role": "td", "extent": [1289, 1296], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/sop/MISC/checkmark.html"}, " "], "role": "td", "extent": [1296, 1324], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["A single mesh can be imported by setting ", {"type": "ui", "text": ["Load By"]}, " to ", {"type": "ui", "text": ["Mesh"]}, "."], "extent": [1324, 1399]}, {"type": "para", "indent": 8, "text": ["Meshes will also be imported when ", {"type": "ui", "text": ["Load By"]}, " is set to ", {"type": "ui", "text": ["Scene"]}, " or ", {"type": "ui", "text": ["Node"]}, "."], "extent": [1399, 1487]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh Primitive (Points) "], "role": "td", "extent": [1487, 1513], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [1513, 1540], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [1540, 1551]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh Primitive (Lines) "], "role": "td", "extent": [1551, 1576], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [1576, 1603], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [1603, 1614]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh Primitive (Triangles) "], "role": "td", "extent": [1614, 1643], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/sop/MISC/checkmark.html"}, " "], "role": "td", "extent": [1643, 1671], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["A single mesh primitive of triangles can be imported by setting ", {"type": "ui", "text": ["Load By"]}, " to ", {"type": "ui", "text": ["Primitive"]}, "."], "extent": [1671, 1774]}, {"type": "para", "indent": 8, "text": ["Mesh primitives will also be imported when ", {"type": "ui", "text": ["Load By"]}, " is set to ", {"type": "ui", "text": ["Scene"]}, ", ", {"type": "ui", "text": ["Node"]}, ", or ", {"type": "ui", "text": ["Primitive"]}, "."], "extent": [1774, 1887]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Camera "], "role": "td", "extent": [1887, 1896], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [1896, 1923], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [1923, 1934]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Skin "], "role": "td", "extent": [1934, 1941], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [1941, 1968], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [1968, 1979]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Morph Target "], "role": "td", "extent": [1979, 1994], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [1994, 2021], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2021, 2032]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Animation (Transform Target) "], "role": "td", "extent": [2032, 2063], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2063, 2090], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2090, 2101]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Animation (Weight Target) "], "role": "td", "extent": [2101, 2129], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2129, 2156], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2156, 2167]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Material "], "role": "td", "extent": [2167, 2178], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2178, 2205], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Material import is not supported but the material assignments of geometry will be imported and stored in the ", {"type": "code", "text": ["shop_materialpath"]}, " attribute."], "extent": [2205, 2354]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Texture "], "role": "td", "extent": [2354, 2364], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2364, 2391], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2391, 2402]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["KHR_draco_mesh_compression Extension "], "role": "td", "extent": [2402, 2441], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2441, 2468], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2468, 2479]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["KHR_lights_punctual Extension "], "role": "td", "extent": [2479, 2511], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/sop/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2511, 2538], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2538, 2549]}]}], "divider": false}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [2549, 2561], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["File Name"], "extent": [2561, 2573], "body": [{"type": "para", "indent": 4, "text": ["Load this glTF file.  The loading method depends on the extension of the file loaded.  "], "extent": [2592, 2693]}, {"type": "para", "indent": 4, "text": ["Files with a ", {"type": "code", "text": [".glb"]}, " extension are treated as binary GLB files."], "extent": [2693, 2769]}, {"type": "para", "indent": 4, "text": ["Files with a ", {"type": "code", "text": [".gltf"]}, " extension are treated as normal JSON data."], "extent": [2769, 2838]}], "container": true, "attrs": {"id": "filename"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Load By"], "extent": [2838, 2847], "body": [{"type": "para", "indent": 4, "text": ["Use this type of glTF object to use as the root of the imported data."], "extent": [2864, 2939]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Primitive"], "extent": [2939, 2954], "body": [{"type": "para", "indent": 12, "text": ["Load the geometry from the selected primitive.  Transforms or names are not preserved."], "extent": [2954, 3054]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Node"], "extent": [3054, 3064], "body": [{"type": "para", "indent": 12, "text": ["Load the geometry from the selected node.  Hierarchy, names, and transforms are represented as packed primitives."], "extent": [3064, 3191]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Scene"], "extent": [3191, 3202], "body": [{"type": "para", "indent": 12, "text": ["Load the geometry from the selected scene.  Hierarchy, names, and transforms are represented as packed primitives."], "extent": [3202, 3346]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "loadby"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Mesh ID"], "extent": [3346, 3355], "body": [{"type": "para", "indent": 4, "text": ["Load geometry data from the mesh at this index of the glTF mesh array."], "extent": [3372, 3448]}], "container": true, "attrs": {"id": "meshid"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Primitive Index"], "extent": [3448, 3465], "body": [{"type": "para", "indent": 4, "text": ["Load geometry data from the primitive at this index of the mesh\u2019s primitive array."], "extent": [3490, 3578]}], "container": true, "attrs": {"id": "primitiveIndex"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Root Node"], "extent": [3578, 3589], "body": [{"type": "para", "indent": 4, "text": ["Load the node at this index of the glTF node array.  Additionally, load all descendant nodes.  "], "extent": [3606, 3707]}], "container": true, "attrs": {"id": "nodeid"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Scene"], "extent": [3707, 3714], "body": [{"type": "para", "indent": 4, "text": ["Load all nodes in the scene at this index of the glTF scene array."], "extent": [3730, 3802]}], "container": true, "attrs": {"id": "scene"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Geometry Type"], "extent": [3802, 3817], "body": [{"type": "para", "indent": 4, "text": ["Store glTF geometry data in this type of object."], "extent": [3835, 3889]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Flattened Geometry"], "extent": [3889, 3913], "body": [{"type": "para", "indent": 12, "text": ["Store the geometry as flat Houdini geometry.  Transforms and hierarchy are baked in and not stored.  Names are represented by primitive attributes and are only stored for meshes, not internal nodes."], "extent": [3913, 4125]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Packed Primitive"], "extent": [4125, 4147], "body": [{"type": "para", "indent": 12, "text": ["Load the geometry as a hierarchy of packed primitives.  Hierarchy, names, and transforms are represented as attributes on the packed primitives."], "extent": [4147, 4305]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "geotype"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Promote Point Attributes To Vertex"], "extent": [4305, 4341], "body": [{"type": "para", "indent": 4, "text": ["Promote all point attributes (excluding P) to vertex attributes."], "extent": [4369, 4439]}], "container": true, "attrs": {"id": "promotepointattrs"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Points Merge Distance"], "extent": [4439, 4462], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Promote Point Attributes To Vertex"]}, " is enabled, points within this distance to each other will be merged."], "extent": [4493, 4612]}], "container": true, "attrs": {"id": "pointconsolidatedist"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Import Custom Attributes"], "extent": [4612, 4638], "body": [{"type": "para", "indent": 4, "text": ["Enable this option to load all custom attributes from imported primitives.  "], "extent": [4665, 4751]}, {"type": "para", "indent": 4, "text": ["Custom attributes in glTF are prefixed with an underscore ", {"type": "code", "text": ["_"]}, ", which will be stripped during the import process. "], "extent": [4751, 4870]}], "container": true, "attrs": {"id": "usecustomattribs"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Import Names"], "extent": [4870, 4884], "body": [{"type": "para", "indent": 4, "text": ["Assigns node, scene, and mesh names as attributes on the imported geometry."], "extent": [4904, 4985]}, {"type": "para", "indent": 4, "text": ["The scene name is assigned to the ", {"type": "code", "text": ["scene_name"]}, " detail attribute."], "extent": [4985, 5055]}, {"type": "para", "indent": 4, "text": ["Node and mesh names are assigned to the ", {"type": "code", "text": ["name"]}, " attribute on imported packed primitives."], "extent": [5055, 5148]}], "container": true, "attrs": {"id": "loadnames"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Import Material Assignments"], "extent": [5148, 5177], "body": [{"type": "para", "indent": 4, "text": ["Assigns materials as primitive attributes to the imported geometry."], "extent": [5207, 5280]}, {"type": "para", "indent": 4, "text": ["Assignments point to the ", {"type": "code", "text": ["../../materials/"]}, " path."], "extent": [5280, 5339]}, {"type": "para", "indent": 4, "text": ["If the material name is unique, the assigned material name will simply be the name of the glTF material.\n    When the name is non_unique, the name will be of the format ", {"type": "code", "text": ["Material_i"]}, ", where ", {"type": "code", "text": ["i"]}, " is the index of the material in the glTF global materials array.  If the material is nameless, the name will simply be ", {"type": "code", "text": ["_i"]}, ", where i is again the index."], "extent": [5339, 5690]}], "container": true, "attrs": {"id": "materialassignments"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Add Path Attribute"], "extent": [5690, 5710], "body": [{"type": "para", "indent": 4, "text": ["When this toggle is enabled, a primitive attribute will be added to the geometry which records the GLTF node hierarchy for each primitive."], "extent": [5737, 5881]}], "container": true, "attrs": {"id": "addpathattribute"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Path Attribute"], "extent": [5881, 5897], "body": [{"type": "para", "indent": 4, "text": ["This parameter controls the name of the primitive attribute when ", {"type": "strong", "text": ["Add Path Attribute"]}, " is enabled."], "extent": [5921, 6023]}], "container": true, "attrs": {"id": "pathattribute"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}], "title": ["glTF"]}