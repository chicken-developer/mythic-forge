{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "bump", "icon": "COP2/bump", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Bump"], "extent": [72, 81]}, {"type": "summary", "indent": 0, "text": ["Builds a bump map from a plane."], "extent": [81, 121]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Builds a bump map from an image. The bump map can either be created as a\nnew plane, or it can replace the plane it was built from."], "extent": [164, 296]}, {"type": "para", "indent": 0, "text": ["A bump map is built by detecting luminance edges in the image. These\nedges become the bumps. The effect can be scaled up to mimic the effect\nof a rough surface, or reduced to add only a slight amount of lighting\nvariation."], "extent": [296, 520]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Usage"], "extent": [520, 532], "body": [{"type": "para", "indent": 4, "text": ["Bump maps can be used by the Lighting COP to produce semi-realistic\n    lighting on ordinary images."], "extent": [532, 640]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [640, 652], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Bump"], "extent": [652, 668], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Bump"], "extent": [668, 683], "body": [{"type": "para", "indent": 12, "text": ["The bumps are computed by variations in luminance; this\n            determines how to compute that luminance."], "extent": [683, 805]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Scale"], "extent": [805, 820], "body": [{"type": "para", "indent": 12, "text": ["Scales the bumps after generation."], "extent": [850, 897]}], "container": true, "attrs": {"channels": "scale"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Simple Bump Map"], "extent": [897, 922], "body": [{"type": "para", "indent": 12, "text": ["If on, only 5 pixels are used to determine the bump map,\n            otherwise all 8 neighbors plus the current pixel is used."], "extent": [922, 1061]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Generate Bump Map"], "extent": [1061, 1088], "body": [{"type": "para", "indent": 12, "text": ["If on, instead of converting planes to bump maps, a source\n            plane is used and the output bump map is added to the plane\n            list."], "extent": [1088, 1249]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Source Plane"], "extent": [1249, 1271], "body": [{"type": "para", "indent": 12, "text": ["The plane to use as the bump source."], "extent": [1271, 1320]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Bump Name"], "extent": [1320, 1339], "body": [{"type": "para", "indent": 12, "text": ["The name of the new bump plane, if a new plane is being\n            generated."], "extent": [1339, 1430]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scope"], "extent": [484, 501], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Plane Scope"], "extent": [501, 523], "body": [{"type": "para", "indent": 12, "text": ["Specifies the scope for both the RGB components of Color,\n            Alpha, and other planes. The (C)RGBA mask only affects Color\n            components and Alpha. 'C' will toggle all the RGB\n            components."], "extent": [523, 753]}, {"type": "para", "indent": 12, "text": ["For planes other than Color and Alpha, the plane name (plus\n            component, if applicable) should be specified in the string\n            field. The pulldown menu can be used to select planes or\n            components present in this node."], "extent": [753, 1012]}, {"type": "para", "indent": 12, "text": ["A plane is specified by its name. A component is specified\n            by both its plane and component name. The '*' wildcard may\n            be used to scope all extra planes. Any number of planes or\n            components can be specified, separated by spaces."], "extent": [1012, 1288]}, {"type": "para", "indent": 12, "text": ["Examples:"], "extent": [1288, 1311]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            P\n            N.x N.y\n            P N Pz\n            "], "extent": [1311, 1396]}], "container": true, "role": "item"}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Frame Scope"], "extent": [1396, 1419], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Frame Scope"], "extent": [1419, 1441], "body": [{"type": "para", "indent": 12, "text": ["Allows scoping of specific frames in the frame range. This\n            is in addition to the plane scope (so a plane at a certain\n            frame must be both plane scoped and frame scoped to be\n            modified)."], "extent": [1441, 1674]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["All Frames"], "extent": [1674, 1698], "body": [{"type": "para", "indent": 16, "text": ["All frames are scoped."], "extent": [1698, 1737]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Inside Range"], "extent": [1737, 1763], "body": [{"type": "para", "indent": 16, "text": ["All frames inside a subrange are scoped."], "extent": [1763, 1820]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Outside Range"], "extent": [1820, 1847], "body": [{"type": "para", "indent": 16, "text": ["All frames outside a subrange are scoped."], "extent": [1847, 1905]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Even Frames"], "extent": [1905, 1930], "body": [{"type": "para", "indent": 16, "text": ["Even numbered frames are scoped."], "extent": [1930, 1979]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Odd Frames"], "extent": [1979, 2003], "body": [{"type": "para", "indent": 16, "text": ["Odd numbered frames are scoped."], "extent": [2003, 2051]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Specific Frames"], "extent": [2051, 2080], "body": [{"type": "para", "indent": 16, "text": ["A user-defined list of frames are scoped."], "extent": [2080, 2138]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [2138, 2159], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside range, this parameter specifies the\n            subrange of the sequence to scope (or unscope). This can be\n            edited in Timeline viewer mode (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2201, 2409]}], "container": true, "attrs": {"channels": "/frange1 /frange2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Dropoff"], "extent": [2409, 2432], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside Range, this parameter specifies certain\n            number of frames before and after to slowly ramp up to\n            scoped. The operation will be blended with its input to\n            'ease in' or 'ease out' the scoping effect over a number of\n            frames. This can be edited in Timeline viewer mode\n            (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2478, 2857]}], "container": true, "attrs": {"channels": "/fdropoff1 /fdropoff2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Non-scoped Effect"], "extent": [2857, 2884], "body": [{"type": "para", "indent": 12, "text": ["For unscoped frames, this sets the blend factor between the\n            input and modified images. Normally this is zero (use the\n            input image). By setting this to a non-zero value, you can\n            make unscoped frames be 'slightly' unscoped. The value can\n            vary between 0 (unscoped) and 1 (scoped)."], "extent": [2918, 3256]}], "container": true, "attrs": {"channels": "/foutside"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame List"], "extent": [3256, 3276], "body": [{"type": "para", "indent": 12, "text": ["The frame list for 'Specific Frames'. Frame numbers should\n            be separated by spaces."], "extent": [3307, 3414]}], "container": true, "attrs": {"channels": "/flist"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Automatically Adjust for Length Changes"], "extent": [3414, 3463], "body": [{"type": "para", "indent": 12, "text": ["If the sequence range changes, enabling this parameter will\n            adjust the subrange and frame dropoff lengths to fit the new\n            range."], "extent": [3463, 3627]}], "container": true, "role": "item"}], "container": true}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1468, 1476], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1502, 1511], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/light", "type": "link", "text": "", "fullpath": "/nodes/cop2/light.html"}], "extent": [1511, 1536]}], "container": true}], "text": "Related"}], "title": ["Bump"], "summary": ["Builds a bump map from a plane."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/pixelparms"]}