{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_buoyancy", "icon": "COP/pyro_buoyancy", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Buoyancy"], "extent": [102, 120]}, {"type": "summary", "indent": 0, "text": ["Applies a Buoyancy force."], "extent": [120, 154]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [154, 160], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [160, 380]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation applies a buoyancy force to a velocity VDB."], "extent": [380, 440]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [440, 452], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Signature"], "extent": [452, 464], "body": [{"type": "para", "indent": 4, "text": ["The VDB type that the source accepts."], "extent": [488, 531]}, {"type": "para", "indent": 4, "text": ["See ", {"scheme": null, "value": "/copernicus/glossary#signatures", "type": "link", "text": ["Signatures"], "fullpath": "/copernicus/glossary.html#signatures", "fragment": "#signatures"}, " for more information."], "extent": [531, 611]}], "container": true, "attrs": {"id": "signature"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Force"], "extent": [611, 623], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Operation"], "extent": [623, 635], "body": [{"type": "para", "indent": 4, "text": ["How to mix the force in with the incoming velocities."], "extent": [655, 718]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Set"], "extent": [718, 727], "body": [{"type": "para", "indent": 8, "text": ["Replace the velocities with the force value."], "extent": [727, 789]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Force"], "extent": [789, 800], "body": [{"type": "para", "indent": 8, "text": ["Add the force to the incoming velocities."], "extent": [800, 855]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "operation"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Scale"], "extent": [855, 862], "body": [{"type": "para", "indent": 4, "text": ["A global scale on the amount of buoyancy to apply."], "extent": [878, 943]}], "container": true, "attrs": {"id": "scale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Direction"], "extent": [943, 954], "body": [{"type": "para", "indent": 4, "text": ["The direction in which temperatures hotter than the ambient temperature will be forced."], "extent": [974, 1076]}], "container": true, "attrs": {"id": "direction"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Ambient Temperature"], "extent": [1076, 1097], "body": [{"type": "para", "indent": 4, "text": ["Temperature values above this ambient temperature will rise, and below it will fall.  Since newly activated areas have zero temperature, this usually needs to be zero to leave dead-space unaffected."], "extent": [1115, 1328]}], "container": true, "attrs": {"id": "ambient"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Mask by Threshold Field"], "extent": [1328, 1358], "body": [{"type": "para", "indent": 0, "text": ["Mask out the effect of the force by the threshold field. Threshold fields are intended to provide harsh on/off effects, but the range can be used to soften the transition."], "extent": [1358, 1536]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Mask by Control Field"], "extent": [1536, 1564], "body": [{"type": "para", "indent": 0, "text": ["Mask out the effect of the force by the control field. Control fields are usually used the same way as masks, so represent a smooth engagement of the effect."], "extent": [1564, 1728]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Mask along Axis"], "extent": [1728, 1750], "body": [{"type": "para", "indent": 0, "text": ["It is common for effects to be scaled along one particular axis. Rather than requiring the construction of VDBs to represent this; this allows the direct specification of the world space range over which the effect is to be scaled."], "extent": [1750, 1988]}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [1988, 1996], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["v"], "extent": [1996, 2003], "body": [{"type": "para", "indent": 8, "text": ["Vector VDB to use as the original velocities."], "extent": [2003, 2058]}], "container": true}, {"type": "dt", "indent": 4, "text": ["temperature"], "extent": [2058, 2075], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB representing the temperature values."], "extent": [2075, 2133]}], "container": true}, {"type": "dt", "indent": 4, "text": ["direction"], "extent": [2133, 2148], "body": [{"type": "para", "indent": 8, "text": ["A Vector VDB allowing per-voxel control of the up direction."], "extent": [2148, 2218]}], "container": true}, {"type": "dt", "indent": 4, "text": ["threshold"], "extent": [2218, 2233], "body": [{"type": "para", "indent": 8, "text": ["A Float or Vector VDB to use as a threshold field.  If it is a Vector VDB, its length is used."], "extent": [2233, 2337]}], "container": true}, {"type": "dt", "indent": 4, "text": ["control"], "extent": [2337, 2350], "body": [{"type": "para", "indent": 8, "text": ["A Float or Vector VDB to use as a control field.  If it is a Vector VDB, its length is used."], "extent": [2350, 2452]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [2452, 2461], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["v"], "extent": [2461, 2468], "body": [{"type": "para", "indent": 8, "text": ["The modified velocities after buoyancy is applied."], "extent": [2468, 2528]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2528, 2537], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_axisforce", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_axisforce.html"}], "extent": [2537, 2565]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_uniformforce", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_uniformforce.html"}], "extent": [2565, 2596]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_turbulence", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_turbulence.html"}], "extent": [2596, 2625]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_disturbance", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_disturbance.html"}], "extent": [2625, 2656]}], "container": true}], "text": "Related"}], "title": ["Pyro Buoyancy"], "summary": ["Applies a Buoyancy force."]}