{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_configure", "icon": "COP/pyro_configure", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Configure"], "extent": [104, 123]}, {"type": "summary", "indent": 0, "text": ["Configures a Pyro simulation."], "extent": [123, 161]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [161, 167], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [167, 387]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This node provides initial configuration of a Pyro simulation.  This generates placeholder VDBs to provide the standard fields used."], "extent": [387, 521]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [521, 533], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Divisions"], "extent": [533, 545], "body": [{"type": "para", "indent": 4, "text": ["How to specify the resolution or size of the simulation."], "extent": [565, 631]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Voxel Size"], "extent": [631, 647], "body": [{"type": "para", "indent": 8, "text": ["Voxels are specified by world space coordinates.  This works best for fully 3d simulations where these represent real units."], "extent": [647, 789]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Resolution"], "extent": [789, 805], "body": [{"type": "para", "indent": 8, "text": ["Voxels are specified according to a resolution of the default imaging plane.  This is a 2-unit wide square.  This is useful if producing effects in a canonical imaging plane as you can tell how many voxels you have per pixel."], "extent": [805, 1048]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "divmethod"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Voxel Size"], "extent": [1048, 1060], "body": [{"type": "para", "indent": 4, "text": ["The size of a voxel in world coordinates."], "extent": [1080, 1136]}], "container": true, "attrs": {"id": "voxelsize"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Resolution"], "extent": [1136, 1148], "body": [{"type": "para", "indent": 4, "text": ["The resolution the simulation will have if it fills the standard imaging plane.  ", {"type": "code", "text": ["2/Resolution"]}, " is the voxel size."], "extent": [1169, 1298]}], "container": true, "attrs": {"id": "resolution"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Origin"], "extent": [1298, 1306], "body": [{"type": "para", "indent": 4, "text": ["Because VDBs are sparse, their origin is often immaterial.\n    However, for small simulations it can be faster if the simulation entirely is in one octant of the index space.   Biasing the origin can accomplish this."], "extent": [1323, 1545]}, {"type": "para", "indent": 4, "text": ["There is also currently a 8192 maximum resolution, so for high resolution simulations away from the origin it may be necessary to adjust the origin."], "extent": [1545, 1703]}], "container": true, "attrs": {"id": "origin"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Leaf Padding"], "extent": [1703, 1717], "body": [{"type": "para", "indent": 4, "text": ["If activation points are provided, this is the number of leaves to expand the activated voxels by."], "extent": [1740, 1844]}, {"type": "para", "indent": 4, "text": ["The largest of ", {"type": "ui", "text": ["Leaf Padding"]}, " and ", {"type": "ui", "text": ["Padding Distance"]}, " will be used."], "extent": [1844, 1924]}], "container": true, "attrs": {"id": "leafdilation"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Padding Distance"], "extent": [1924, 1942], "body": [{"type": "para", "indent": 4, "text": ["If activation points are provided, this is the world distance to expand the activation.  It will be rounded up to the nearest leaf."], "extent": [1969, 2110]}, {"type": "para", "indent": 4, "text": ["The largest of ", {"type": "ui", "text": ["Leaf Padding"]}, " and ", {"type": "ui", "text": ["Padding Distance"]}, " will be used."], "extent": [2110, 2190]}], "container": true, "attrs": {"id": "leafdilationdist"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [2190, 2198], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["activate_pts"], "extent": [2198, 2216], "body": [{"type": "para", "indent": 8, "text": ["Optional geometry whose points will activate leaves in the initial simulation."], "extent": [2216, 2304]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [2304, 2313], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["density"], "extent": [2313, 2326], "body": [{"type": "para", "indent": 8, "text": ["A float VDB for an initial density field."], "extent": [2326, 2377]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [2377, 2384], "body": [{"type": "para", "indent": 8, "text": ["A vector VDB for an initial velocity field."], "extent": [2384, 2437]}], "container": true}, {"type": "dt", "indent": 4, "text": ["temperature"], "extent": [2437, 2454], "body": [{"type": "para", "indent": 8, "text": ["A float VDB for an initial vector field."], "extent": [2454, 2504]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2504, 2513], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_block_begin", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_block_begin.html"}], "extent": [2513, 2543]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_block_end", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_block_end.html"}], "extent": [2543, 2572]}], "container": true}], "text": "Related"}], "title": ["Pyro Configure"], "summary": ["Configures a Pyro simulation."]}