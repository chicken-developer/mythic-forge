{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_advect", "icon": "COP/pyro_advect", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Advect"], "extent": [98, 114]}, {"type": "summary", "indent": 0, "text": ["Advects VDBs by Velocity."], "extent": [114, 148]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [148, 154], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [154, 374]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Pyro Advect will move the contents of VDBs according to the provided velocity VDB."], "extent": [374, 458]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [458, 470], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Scale"], "extent": [470, 478], "body": [{"type": "para", "indent": 4, "text": ["A global scale on the velocity values."], "extent": [494, 542]}], "container": true, "attrs": {"id": "scale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Scale by Timestep"], "extent": [542, 561], "body": [{"type": "para", "indent": 4, "text": ["Scale the velocity values by the timestep."], "extent": [582, 634]}], "container": true, "attrs": {"id": "usetimeinc"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Integrator"], "extent": [634, 646], "body": [{"type": "para", "indent": 4, "text": ["The method used to compute the flow map of the velocity VDB."], "extent": [667, 737]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Path Trace"], "extent": [737, 753], "body": [{"type": "para", "indent": 8, "text": ["The velocity VDB is traced using the the CFL condition to control the step size.  This can handle large velocities in a single step."], "extent": [753, 903]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Average of Two"], "extent": [903, 923], "body": [{"type": "para", "indent": 8, "text": ["The velocity VDB is sampled twice, once at the location, and once where that would have come from.  The average is used. "], "extent": [923, 1062]}, {"type": "para", "indent": 8, "text": ["This provides a fixed-cost and does a better job preserving rotations, but will break up with large velocities."], "extent": [1062, 1187]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "integrator"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["CFL Condition"], "extent": [1187, 1202], "body": [{"type": "para", "indent": 4, "text": ["How big of a step should be used.  This is approximately how many voxels will be stepped during path tracing."], "extent": [1220, 1339]}], "container": true, "attrs": {"id": "cflcond"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Maximum Steps"], "extent": [1339, 1354], "body": [{"type": "para", "indent": 4, "text": ["Global clamp on how many steps can be performed.  For extremely fast motion, this may need to be increased; but it might be better to raise the CFL condition instead."], "extent": [1372, 1548]}], "container": true, "attrs": {"id": "maxstep"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Ambient Velocity"], "extent": [1548, 1566], "body": [{"type": "para", "indent": 4, "text": ["A constant global velocity that the VDBs will also be moved by, in addition to the values in the velocity VDB.  This can be used as a wind-effect as it allows the wind to alter speed without affecting local dynamics."], "extent": [1588, 1814]}], "container": true, "attrs": {"id": "ambient"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Data"], "extent": [1814, 1825], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Method"], "extent": [1825, 1834], "body": [{"type": "para", "indent": 4, "text": ["The method used to advect the data VDBs."], "extent": [1856, 1906]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["BFECC"], "extent": [1906, 1917], "body": [{"type": "para", "indent": 8, "text": ["Perform backwards-forward error correction.  This requires considerable time and memory; but does the best job of preserving the sharpness of features."], "extent": [1917, 2086]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler + Sharpen"], "extent": [2086, 2107], "body": [{"type": "para", "indent": 8, "text": ["Combines the simplest form of advection with a dynamic sharpen field that combats the diffusion introduced by the trilinear operation."], "extent": [2107, 2259]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler"], "extent": [2259, 2270], "body": [{"type": "para", "indent": 8, "text": ["The simplest and fastest form of advection, but tends to cause excessive blurring."], "extent": [2270, 2375]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "data_method"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Sharpen"], "extent": [2375, 2384], "body": [{"type": "para", "indent": 4, "text": ["How much to sharpen the VDB.  This is automatically adjusted per voxel based on how the VDB was sampled.  While the sharpening kernel is clamped, a value that is too high will create grid artifacts."], "extent": [2407, 2620]}], "container": true, "attrs": {"id": "data_sharpen"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Velocity"], "extent": [2620, 2635], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Enable Velocity Advection"], "extent": [2635, 2663], "body": [{"type": "para", "indent": 4, "text": ["The velocity VDB has to be advected specially as it has to advect with respect to itself.  It has its own controls and also can be turned off if you do not need to advect it; for example, if it had already been advected by another Pyro Advect COP."], "extent": [2682, 2939]}], "container": true, "attrs": {"id": "v_enable"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Method"], "extent": [2939, 2947], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["BFECC"], "extent": [2970, 2981], "body": [{"type": "para", "indent": 8, "text": ["Perform backwards-forward error correction.  This requires considerable time and memory; but does the best job of preserving the sharpness of features."], "extent": [2981, 3150]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler + Sharpen"], "extent": [3150, 3171], "body": [{"type": "para", "indent": 8, "text": ["Combines the simplest form of advection with a dynamic sharpen field that combats the diffusion introduced by the trilinear operation."], "extent": [3171, 3323]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler"], "extent": [3323, 3334], "body": [{"type": "para", "indent": 8, "text": ["The simplest and fastest form of advection, but tends to cause excessive blurring."], "extent": [3334, 3439]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "v_method"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Sharpen"], "extent": [3439, 3448], "body": [{"type": "para", "indent": 4, "text": ["How much to sharpen the VDB.  This is automatically adjusted per voxel based on how the VDB was sampled.  While the sharpening kernel is clamped, a value that is too high will create grid artifacts."], "extent": [3472, 3680]}], "container": true, "attrs": {"id": "v_sharpen"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [3680, 3688], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["data"], "extent": [3688, 3698], "body": [{"type": "para", "indent": 8, "text": ["A cable of all the VDBs to advect."], "extent": [3698, 3742]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [3742, 3749], "body": [{"type": "para", "indent": 8, "text": ["A vector VDB to advect the data VDBs by.  Can also be\n        optionally self-advected."], "extent": [3749, 3846]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [3846, 3855], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["data"], "extent": [3855, 3865], "body": [{"type": "para", "indent": 8, "text": ["A cable of all the advected VDBs."], "extent": [3865, 3908]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [3908, 3915], "body": [{"type": "para", "indent": 8, "text": ["The vector VDB of the velocity, possibly self-advected."], "extent": [3915, 3980]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [3980, 3989], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_block_begin", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_block_begin.html"}], "extent": [3989, 4019]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_advectbymap", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_advectbymap.html"}], "extent": [4019, 4049]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_buildadvectionmap", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_buildadvectionmap.html"}], "extent": [4049, 4086]}], "container": true}], "text": "Related"}], "title": ["Pyro Advect"], "summary": ["Advects VDBs by Velocity."]}