{"type": "root", "attrs": {"type": "node", "context": "vop", "icon": "COMMON/materialx", "index": "no", "internal": "_materialx", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["MaterialX"], "extent": [0, 14]}, {"type": "summary", "indent": 0, "text": ["MaterialX VOP nodes let you build MaterialX shaders for use with the Karma renderer."], "extent": [76, 168]}, {"type": "para", "indent": 0, "text": ["For help with individual MaterialX nodes, see the official MaterialX documentation."], "extent": [168, 253]}, {"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "https://www.materialx.org/assets/MaterialX.v1.38.Spec.pdf", "type": "link", "text": ["Specification (PDF)"], "exists": true}], "extent": [253, 335], "body": [], "container": true, "attrs": {"glyph": "fa-file-pdf-o"}}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "http://www.materialx.org/assets/MaterialX.v1.38.PBRSpec.pdf", "type": "link", "text": ["Physically Based Shading Nodes (PDF)"], "exists": true}], "extent": [362, 463], "body": [], "container": true, "attrs": {"glyph": "fa-file-pdf-o"}}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "http://www.materialx.org/assets/MaterialX.v1.38.Supplement.pdf", "type": "link", "text": ["Supplemental Notes (PDF)"], "exists": true}], "extent": [490, 582], "body": [], "container": true, "attrs": {"glyph": "fa-file-pdf-o"}}], "container": true}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [610, 619], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/solaris/materialx", "type": "link", "text": ["MaterialX in Houdini"], "fullpath": "/solaris/materialx.html"}], "extent": [619, 666]}], "container": true}], "text": "Related"}, {"level": 1, "id": "karma_unsupported_disney_brdf", "container": true, "type": "karma_unsupported_disney_brdf_section", "indent": 0, "role": "section", "extent": [666, 697], "body": [{"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [697, 706], "body": [{"type": "para", "indent": 4, "text": ["Not implemented by KarmaXPU. Use the ", {"scheme": "Node", "value": "/nodes/vop/principledshader", "type": "link", "text": ["Principled Shader"], "fullpath": "/nodes/vop/principledshader.html"}, " if you wish to use a Disney BRDF/BSDF and KarmaCPU."], "extent": [706, 847]}], "container": true}], "container": true, "role": "item_group"}], "text": "Karma_unsupported_disney_brdf"}, {"level": 1, "id": "karma_unsupported", "container": true, "type": "karma_unsupported_section", "indent": 0, "role": "section", "extent": [847, 866], "body": [{"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [866, 875], "body": [{"type": "para", "indent": 4, "text": ["Not supported by KarmaXPU or KarmaCPU."], "extent": [875, 920]}], "container": true}], "container": true, "role": "item_group"}], "text": "Karma_unsupported"}, {"level": 1, "id": "karmaxpu_unsupported", "container": true, "type": "karmaxpu_unsupported_section", "indent": 0, "role": "section", "extent": [920, 942], "body": [{"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [942, 951], "body": [{"type": "para", "indent": 4, "text": ["Not supported by KarmaXPU."], "extent": [951, 984]}], "container": true}], "container": true, "role": "item_group"}], "text": "Karmaxpu_unsupported"}, {"level": 1, "id": "karmacpu_unsupported", "container": true, "type": "karmacpu_unsupported_section", "indent": 0, "role": "section", "extent": [984, 1006], "body": [{"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [1006, 1015], "body": [{"type": "para", "indent": 4, "text": ["Not supported by KarmaCPU."], "extent": [1015, 1048]}], "container": true}], "container": true, "role": "item_group"}], "text": "Karmacpu_unsupported"}, {"level": 1, "id": "lama_unsupported", "container": true, "type": "lama_unsupported_section", "indent": 0, "role": "section", "extent": [1048, 1066], "body": [{"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [1066, 1075], "body": [{"tag": "div", "attrs": {"style": "position: relative;"}, "type": "xml", "text": ["\n    ", {"tag": "div", "attrs": {"style": "float: left; width: 5em;"}, "type": "xml", "text": ["\n        ", {"scheme": "Image", "value": "/images/beta.svg", "type": "link", "text": "", "fullpath": "/images/beta.svg.html"}, "\n    "]}, "\n    ", {"tag": "div", "attrs": {"style": "margin-left: 5em; padding-left: 1em; min-height: 4em;"}, "type": "xml", "text": ["\n        Lama MaterialX has begun to appear in MaterialX, but the open source implementation is not complete. The nodes have been hidden, to avoid confusion about expectations and workflow. Once the definitions are more complete, Lama support will be announced.\n    "]}, "\n    "]}], "container": true}], "container": true, "role": "item_group"}], "text": "Lama_unsupported"}, {"level": 1, "id": "mtlx_color4_merge", "container": true, "type": "mtlx_color4_merge_section", "indent": 0, "role": "section", "extent": [1561, 1580], "body": [{"type": "para", "indent": 0, "text": ["MaterialX Merge nodes take two Color4 inputs and use their built-in alpha channel(s) to control how the ", {"type": "code", "text": ["fg"]}, " and ", {"type": "code", "text": ["bg"]}, " inputs are combined. These merge nodes only apply to Color4 input types. They optionally support a ", {"type": "code", "text": ["mix"]}, " input Float. This allows for blending the original ", {"type": "code", "text": ["bg"]}, " (where ", {"type": "code", "text": ["mix"]}, " is 0) with the result of the operation (where ", {"type": "code", "text": ["mix"]}, " is 1)."], "extent": [1580, 1932]}, {"type": "table", "thead": [{"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Merge Operator "], "role": "th", "extent": [1932, 1950], "container": true}, {"type": "cell", "indent": 4, "text": ["RGB Result "], "role": "th", "extent": [1950, 1968], "container": true}, {"type": "cell", "indent": 8, "text": ["Alpha Result "], "role": "th", "extent": [1968, 1992]}], "divider": false}], "body": [{"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Disjointover "], "role": "td", "extent": [1992, 2012], "container": true}, {"type": "cell", "indent": 4, "text": [{"type": "code", "text": ["F+B"]}, " if ", {"type": "code", "text": ["f+b<=1"]}, ", and\n    ", {"type": "code", "text": ["F+B(1-f)/b"]}, " if ", {"type": "code", "text": ["f+b>1"]}, " "], "role": "td", "extent": [2012, 2069], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 12, "text": [{"type": "code", "text": ["min(f+b,1)"]}], "extent": [2069, 2094]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX In "], "role": "td", "extent": [2094, 2104], "container": true}, {"type": "cell", "indent": 4, "text": [{"type": "code", "text": ["Fb"]}, " "], "role": "td", "extent": [2104, 2115], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": [{"type": "code", "text": ["fb"]}], "extent": [2115, 2128]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Mask "], "role": "td", "extent": [2128, 2140], "container": true}, {"type": "cell", "indent": 4, "text": [{"type": "code", "text": ["Bf"]}, " "], "role": "td", "extent": [2140, 2151], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": [{"type": "code", "text": ["bf"]}], "extent": [2151, 2164]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Matte "], "role": "td", "extent": [2164, 2177], "container": true}, {"type": "cell", "indent": 4, "text": [{"type": "code", "text": ["Ff+B(1-f)"]}, " "], "role": "td", "extent": [2177, 2195], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": [{"type": "code", "text": ["f+b(1-f)"]}], "extent": [2195, 2214]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Out "], "role": "td", "extent": [2214, 2225], "container": true}, {"type": "cell", "indent": 4, "text": [{"type": "code", "text": ["F(1-b) "]}, " "], "role": "td", "extent": [2225, 2241], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": [{"type": "code", "text": ["f(1-b)"]}], "extent": [2241, 2258]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Over "], "role": "td", "extent": [2258, 2270], "container": true}, {"type": "cell", "indent": 4, "text": [{"type": "code", "text": ["F+B(1-f)"]}, " "], "role": "td", "extent": [2270, 2287], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": [{"type": "code", "text": ["f+b(1-f)"]}], "extent": [2287, 2324]}]}], "divider": false}]}], "text": "Mtlx_color4_merge"}, {"level": 1, "id": "mtlx_blends", "container": true, "type": "mtlx_blends_section", "indent": 0, "role": "section", "extent": [2324, 2337], "body": [{"type": "para", "indent": 0, "text": ["MaterialX Blend nodes take two 1-4 Channel inputs and apply the same operation to all channels. The math for Alpha is the same as for R or RGB."], "extent": [2337, 2482]}, {"type": "para", "indent": 0, "text": ["In the Blend Operator tabel, ", {"type": "q", "text": ["F"]}, " and ", {"type": "q", "text": ["B"]}, " refer to any individual channel of the ", {"type": "code", "text": ["fg"]}, " and ", {"type": "code", "text": ["bg"]}, " inputs respectively. They optionally support a ", {"type": "code", "text": ["mix"]}, " input Float. This allows for blending the original ", {"type": "code", "text": ["bg"]}, " (where ", {"type": "code", "text": ["mix"]}, " is 0) with the result of the operation (where ", {"type": "code", "text": ["mix"]}, " is 1)."], "extent": [2482, 2759]}, {"type": "table", "thead": [{"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Blend Operator "], "role": "th", "extent": [2759, 2777], "container": true}, {"type": "cell", "indent": 4, "text": ["Result per Channel "], "role": "th", "extent": [2777, 2803]}], "divider": false}], "body": [{"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Plus "], "role": "td", "extent": [2803, 2815], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["B+F "]}], "extent": [2815, 2826]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Minus "], "role": "td", "extent": [2826, 2839], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["B-F "]}], "extent": [2839, 2850]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Difference "], "role": "td", "extent": [2850, 2868], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["abs(B-F)"]}], "extent": [2868, 2883]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Burn "], "role": "td", "extent": [2883, 2895], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["1-(1-B)/F"]}], "extent": [2895, 2911]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Dodge "], "role": "td", "extent": [2911, 2924], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["B/(1-F) "]}], "extent": [2924, 2939]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Screen "], "role": "td", "extent": [2939, 2953], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["1-(1-F)(1-B) "]}], "extent": [2953, 2973]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["MtlX Overlay "], "role": "td", "extent": [2973, 2988], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 4, "text": [{"type": "code", "text": ["2FB"]}, " if ", {"type": "code", "text": ["F<0.5"]}, ", and ", {"type": "code", "text": ["1-(1-F)(1-B)"]}, " if ", {"type": "code", "text": ["F>=0.5"]}], "extent": [2988, 3042]}]}], "divider": false}]}], "text": "Mtlx_blends"}, {"level": 1, "id": "mtlx_common_image_parms", "container": true, "type": "mtlx_common_image_parms_section", "indent": 0, "role": "section", "extent": [3042, 3067], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["File Name"], "extent": [3067, 3078], "body": [{"type": "para", "indent": 4, "text": ["The URI or path of an image file."], "extent": [3093, 3132]}, {"type": "warning_group", "body": [{"type": "warning", "indent": 4, "role": "item", "extent": [3132, 3145], "body": [{"type": "para", "indent": 8, "text": ["UsdMaterialX does not currently support the filename substitution tokens that MaterialX provides."], "extent": [3145, 3252]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "file"}}, {"type": "dt", "indent": 0, "text": ["Default"], "extent": [3252, 3261], "body": [{"type": "para", "indent": 4, "text": ["A default value to use if the given ", {"type": "ui", "text": ["file"]}, " can not be resolved, or if the specified ", {"type": "ui", "text": ["layer"]}, " does not exist in the file. The default value must be the same type as the ", {"type": "em", "text": ["image"]}, " element itself, and must be a constant color (i.e. it cannot be a varying primvar or some other pattern or image)."], "extent": [3279, 3578]}, {"type": "para", "indent": 4, "text": ["If default is not defined, the default color value will be 0.0 in all channels."], "extent": [3578, 3663]}], "container": true, "attrs": {"id": "default"}}, {"type": "dt", "indent": 0, "text": ["Texture Coordinate"], "extent": [3663, 3683], "body": [{"type": "para", "indent": 4, "text": ["The name of a vector2-type node specifying the 2D texture coordinate at which the image data is read. Default is to use the current u,v coordinate."], "extent": [3706, 3859]}], "container": true, "attrs": {"id": "texcoord"}}, {"type": "dt", "indent": 0, "text": ["UV Address Mode"], "extent": [3859, 3876], "body": [{"type": "para", "indent": 4, "text": ["Determines how UV coordinates outside the 0-1 range are processed before sampling the image. Each UV component can be set independently to one of these modes:"], "extent": [3900, 4064]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/mtlx_uvaddress_modes.jpg", "type": "img", "text": ""}], "extent": [4064, 4120]}, {"type": "table", "thead": [], "body": [{"type": "row", "body": [{"type": "cell", "indent": 4, "text": [{"type": "em", "text": ["Constant"]}, " "], "role": "td", "extent": [4120, 4137], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Texture coordinates outside the 0-1 range return the value of the node\u2019s ", {"type": "em", "text": ["default"]}, " color or float parameter."], "extent": [4137, 4254]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 4, "text": [{"type": "em", "text": ["Clamp"]}, " "], "role": "td", "extent": [4254, 4268], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Texture coordinates are clamped to the 0-1 range before sampling the image."], "extent": [4268, 4352]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 4, "text": [{"type": "em", "text": ["Periodic"]}, " "], "role": "td", "extent": [4352, 4369], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Texture coordinates outside the 0-1 range ", {"type": "q", "text": ["wrap around"]}, ", effectively being processed by a modulo 1 operation before sampling the image."], "extent": [4369, 4513]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 4, "text": [{"type": "em", "text": ["Mirror"]}, " "], "role": "td", "extent": [4513, 4528], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Texture coordinates outside the 0-1 range will be mirrored back into the 0-1 range, e.g. u=-0.01 will return the u=0.01 texture coordinate value, and u=1.01 will return the u=0.99 texture coordinate value."], "extent": [4528, 4743]}]}], "divider": false}]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["U Address Mode"], "extent": [4743, 4763], "body": [{"type": "para", "indent": 8, "text": ["Determines how U coordinates outside the 0-1 range are processed before sampling the image. Default is ", {"type": "em", "text": ["periodic"]}, "."], "extent": [4790, 4914]}], "container": true, "attrs": {"id": "uaddressmode"}}, {"type": "dt", "indent": 4, "text": ["V Address Mode"], "extent": [4914, 4934], "body": [{"type": "para", "indent": 8, "text": ["Determines how V coordinates outside the 0-1 range are processed before sampling the image. Default is ", {"type": "em", "text": ["periodic"]}, "."], "extent": [4961, 5085]}], "container": true, "attrs": {"id": "vaddressmode"}}], "container": true}], "container": true, "attrs": {"id": "uvaddressmode"}}, {"type": "dt", "indent": 0, "text": ["Filter Type"], "extent": [5085, 5098], "body": [{"type": "para", "indent": 4, "text": ["The type of texture filtering to use; standard values include 'closest' (nearest-neighbor single-sample), 'linear', and 'cubic'.  If not specified, an application may use its own default texture filtering method."], "extent": [5123, 5341]}], "container": true, "attrs": {"id": "filtertype"}}, {"type": "dt", "indent": 0, "text": ["Frame Range"], "extent": [5341, 5354], "body": [{"type": "para", "indent": 4, "text": ["A string 'minframe-maxframe', e.g. '10-99', to specify the range of frames that the image file is allowed to have, usually the range of image files on disk.  Default is unbounded"], "extent": [5379, 5563]}], "container": true, "attrs": {"id": "framerange"}}, {"type": "dt", "indent": 0, "text": ["Frame Offset"], "extent": [5563, 5577], "body": [{"type": "para", "indent": 4, "text": ["A number that is added to the current frame number to get the image file frame number.  E.g. if frameoffset is 25, then processing frame 100 will result in reading frame 125 from the imagefile sequence.  Default is no frame offset."], "extent": [5603, 5840]}], "container": true, "attrs": {"id": "frameoffset"}}, {"type": "dt", "indent": 0, "text": ["Frame End Action"], "extent": [5840, 5858], "body": [{"type": "para", "indent": 4, "text": ["What to do when the resolved image frame number is outside the framerange range."], "extent": [5887, 5973]}], "container": true, "attrs": {"id": "frameendaction"}}], "container": true}], "text": "Mtlx_common_image_parms"}, {"level": 1, "id": "mtlx_common_2dpattern_parms", "container": true, "type": "mtlx_common_2dpattern_parms_section", "indent": 0, "role": "section", "extent": [5973, 6002], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Texcoord"], "extent": [6002, 6012], "body": [{"type": "para", "indent": 4, "text": ["Input Texture Coordinates."], "extent": [6031, 6063]}], "container": true, "attrs": {"id": "texcoord"}}, {"type": "dt", "indent": 0, "text": ["Uvtiling"], "extent": [6063, 6073], "body": [{"type": "para", "indent": 4, "text": ["Frequency of the pattern in texture space."], "extent": [6092, 6140]}], "container": true, "attrs": {"id": "uvtiling"}}, {"type": "dt", "indent": 0, "text": ["Uvoffset"], "extent": [6140, 6150], "body": [{"type": "para", "indent": 4, "text": ["Offset the pattern in texture space."], "extent": [6169, 6211]}], "container": true, "attrs": {"id": "uvoffset"}}, {"type": "dt", "indent": 0, "text": ["Size"], "extent": [6211, 6217], "body": [{"type": "para", "indent": 4, "text": ["The size of the shape being repeated."], "extent": [6232, 6275]}], "container": true, "attrs": {"id": "size"}}, {"type": "dt", "indent": 0, "text": ["Staggered"], "extent": [6275, 6286], "body": [{"type": "para", "indent": 4, "text": ["Shifts alternating rows of the pattern."], "extent": [6306, 6351]}], "container": true, "attrs": {"id": "staggered"}}], "container": true}], "text": "Mtlx_common_2dpattern_parms"}, {"level": 1, "id": "mtlx_common_2dshape_parms", "container": true, "type": "mtlx_common_2dshape_parms_section", "indent": 0, "role": "section", "extent": [6351, 6378], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Texcoord"], "extent": [6378, 6388], "body": [{"type": "para", "indent": 4, "text": ["Input Texture Coordinates."], "extent": [6407, 6439]}], "container": true, "attrs": {"id": "texcoord"}}, {"type": "dt", "indent": 0, "text": ["Center"], "extent": [6439, 6447], "body": [{"type": "para", "indent": 4, "text": ["Shape center in the texture coordinates."], "extent": [6464, 6510]}], "container": true, "attrs": {"id": "center"}}, {"type": "dt", "indent": 0, "text": ["Radius"], "extent": [6510, 6518], "body": [{"type": "para", "indent": 4, "text": ["The size of the shape in texture space."], "extent": [6535, 6581]}], "container": true, "attrs": {"id": "radius"}}], "container": true}], "text": "Mtlx_common_2dshape_parms"}, {"level": 1, "id": "spaces", "container": true, "type": "spaces_section", "indent": 0, "role": "section", "extent": [6581, 6589], "body": [{"type"