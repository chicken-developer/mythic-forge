{"type": "root", "attrs": {"type": "include"}, "body": [{"level": 3, "type": "sep", "indent": 0, "text": [" Prototypes "], "extent": [20, 39], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Prototype Source"], "extent": [64, 86], "body": [{"type": "para", "indent": 8, "text": ["Whether the prim(s) you want to reference/instance onto the points is/are in the first input or the second input."], "extent": [116, 239]}], "container": true, "attrs": {"id": "protosourcemode"}}], "container": true}, {"level": 3, "type": "sep", "indent": 4, "text": [" Source "], "extent": [239, 258], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Use Entire Stage as Prototype"], "extent": [258, 298], "body": [{"type": "para", "indent": 12, "text": ["If ", {"type": "ui", "text": ["Prototype Source"]}, " is ", {"type": "ui", "text": ["Second Input"]}, " and this is on, the node copies everything from the second input\u2019s scene graph tree under a new prim and uses that as the prototype. This lets you build a node chain that builds the prototype and connect it to the second input, and not have to specify which prim in the second input to use."], "extent": [329, 677]}, {"type": "para", "indent": 12, "text": ["Using this option implies that there is only one prototype, because this node has no multi-input. If you have several full stages you want to use as prototypes, combine them with a ", {"scheme": "Node", "value": "/nodes/lop/graftstages", "type": "link", "text": ["Graft Stages LOP"], "fullpath": "/nodes/lop/graftstages.html"}, " first, and feed the result into the second input, but with this option turned off."], "extent": [677, 994]}], "container": true, "attrs": {"id": "protouseroot"}}, {"type": "dt", "indent": 8, "text": ["Prototype Primitives"], "extent": [994, 1024], "body": [{"type": "para", "indent": 12, "text": ["The scene graph path(s) of the primitive(s) you want to use as prototype(s). You can use ", {"scheme": null, "value": "/solaris/pattern", "type": "link", "text": ["pattern syntax"], "fullpath": "/solaris/pattern.html"}, " to select multiple primitives."], "extent": [1055, 1222]}], "container": true, "attrs": {"id": "protopattern"}}, {"type": "dt", "indent": 8, "text": ["Handle Missing Prototypes"], "extent": [1222, 1257], "body": [{"type": "para", "indent": 12, "text": ["If a point specifies a prototype that doesn\u2019t exist, this parameter controls whether the node will present a warning, enter an error state or create the missing primitives. The default is to enter an error state, which can be useful to catch accidental use of missing prototypes. The warning mode is useful for scenarios where prototypes may be added to the instancer later in the LOP network or through USD composition.  The create mode will create placeholder prims in the scene to use as prototypes."], "extent": [1299, 1815]}], "container": true, "attrs": {"id": "handlemissingprototypes"}}], "container": true}], "container": true}, {"level": 3, "type": "sep", "indent": 4, "text": [" Destination "], "extent": [1815, 1839], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Create Prototypes Area"], "extent": [1839, 1872], "body": [{"type": "para", "indent": 12, "text": ["If ", {"type": "ui", "text": ["Prototype Source"]}, " is ", {"type": "ui", "text": ["First Input"]}, ", this toggle controls whether to create a ", {"type": "q", "text": ["Prototypes"]}, " scope under the specified ", {"type": "ui", "text": ["Primitive Path"]}, " or not."], "extent": [1906, 2070]}, {"type": "para", "indent": 12, "text": ["If enabled, the primitive will be populated with references (see ", {"type": "ui", "text": ["Prototype Reference Type"]}, " below) to the original source primitives, and these references will be used for the instances. If disabled, the instances will be directly connected to the original source primitives. It is standard practice, but not required, to have this enabled when the ", {"type": "ui", "text": ["Method"]}, " is set to ", {"type": "ui", "text": ["PointInstancer"]}, "."], "extent": [2070, 2476]}], "container": true, "attrs": {"id": "createprotoarea"}}, {"type": "dt", "indent": 7, "text": ["Make Prototype Source Primitives Invisible"], "extent": [2476, 2527], "body": [{"type": "para", "indent": 11, "text": ["If ", {"type": "ui", "text": ["Prototype Source"]}, " is ", {"type": "ui", "text": ["First Input"]}, " and ", {"type": "ui", "text": ["Create Prototypes Area"]}, " is enabled and this is on, the node sets the visibility of the prims used as primitives to ", {"type": "q", "text": ["hidden"]}, " in the output. The default is on."], "extent": [2565, 2785]}], "container": true, "attrs": {"id": "hideprotosourceprims"}}, {"type": "dt", "indent": 7, "text": ["Root Prim"], "extent": [2785, 2803], "body": [{"type": "para", "indent": 13, "text": ["The scene graph path to the root prim for the prototype area.  This prim will be created if it doesn\u2019t already exist."], "extent": [2840, 2972]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 13, "text": ["This parm has access to the following local variables"], "extent": [2972, 3040], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 16, "text": [{"type": "code", "text": ["@primpath"]}], "extent": [3040, 3069], "body": [{"type": "para", "indent": 20, "text": ["The currently targeted prim path."], "extent": [3069, 3124]}], "container": true}], "container": true}], "container": true}], "container": true}], "container": true, "attrs": {"id": "protodestrootprim"}}, {"type": "dt", "indent": 7, "text": ["Root Prim Kind"], "extent": [3124, 3147], "body": [{"type": "para", "indent": 11, "text": ["When ", {"type": "ui", "text": ["Use Entire Stage"]}, " is on, this sets the ", {"scheme": null, "value": "/solaris/glossary#kind", "type": "link", "text": ["kind"], "fullpath": "/solaris/glossary.html#kind", "fragment": "#kind"}, " of the prim the node creates as a parent for root prims from the second input. The default is ", {"type": "ui", "text": ["None"]}, "."], "extent": [3178, 3371]}], "container": true, "attrs": {"id": "protorootkind"}}, {"type": "dt", "indent": 7, "text": ["Name"], "extent": [3371, 3384], "body": [{"type": "para", "indent": 12, "text": ["The name for the prototype prims to be created under the prototype destination root prim."], "extent": [3420, 3523]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["This parm has access to the following local variables"], "extent": [3523, 3590], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 16, "text": [{"type": "code", "text": ["@primpath"]}], "extent": [3590, 3619], "body": [{"type": "para", "indent": 20, "text": ["The currently targeted prim path."], "extent": [3619, 3673]}], "container": true}, {"type": "dt", "indent": 16, "text": [{"type": "code", "text": ["@protoprimpath"]}], "extent": [3673, 3707], "body": [{"type": "para", "indent": 20, "text": ["The source primpath for the current prototype."], "extent": [3707, 3774]}], "container": true}, {"type": "dt", "indent": 16, "text": [{"type": "code", "text": ["@protoprimname"]}], "extent": [3774, 3808], "body": [{"type": "para", "indent": 20, "text": ["The name of the source prototype prim."], "extent": [3808, 3867]}], "container": true}, {"type": "dt", "indent": 16, "text": [{"type": "code", "text": ["@protoindex"]}], "extent": [3867, 3898], "body": [{"type": "para", "indent": 20, "text": ["The index for the current prototype."], "extent": [3898, 3956]}], "container": true}], "container": true}], "container": true}], "container": true}], "container": true, "attrs": {"id": "protoareadestprim"}}, {"type": "dt", "indent": 7, "text": ["Only Copy Specified Prototype Prims"], "extent": [3956, 4000], "body": [{"type": "para", "indent": 12, "text": ["If ", {"type": "ui", "text": ["Prototype Source"]}, " is ", {"type": "ui", "text": ["Second Input"]}, " and ", {"type": "ui", "text": ["Use Entire Stage as Prototype"]}, " is off, this controls whether to only copy the prototype primitives specified by ", {"type": "ui", "text": ["Prototype Primitives"]}, ", or the entire stage. The default is on."], "extent": [4037, 4279]}, {"type": "para", "indent": 12, "text": ["Using this option can result in a smaller stage, but requires that the prototype sources are fully self-contained (for example they cannot refer to materials that sit elsewhere in the prim hierarchy)."], "extent": [4279, 4493]}], "container": true, "attrs": {"id": "onlycopyprotoprims"}}, {"type": "dt", "indent": 7, "text": ["Prototype Reference Type"], "extent": [4493, 4526], "body": [{"type": "para", "indent": 11, "text": ["If ", {"type": "ui", "text": ["Prototype Source"]}, " is ", {"type": "ui", "text": ["First Input"]}, " and ", {"type": "ui", "text": ["Create Prototypes Area"]}, " is enabled, this parameter controls the composition type to use when creating references to the source primitives from within the ", {"type": "code", "text": ["Prototypes"]}, " folder in the scene graph. This parameter can be ", {"type": "ui", "text": ["Reference"]}, ", ", {"type": "ui", "text": ["Inherit"]}, ", or ", {"type": "ui", "text": ["Specialize"]}, ". See ", {"scheme": null, "value": "/solaris/glossary#inherits", "type": "link", "text": ["inherits and specializes"], "fullpath": "/solaris/glossary.html#inherits", "fragment": "#inherits"}, " for more information about how these choices differ from a simple reference."], "extent": [4556, 5017]}], "container": true, "attrs": {"id": "protoreftype"}}], "container": true}], "container": true}], "container": true, "attrs": {"id": "prototypeparms"}}, {"level": 3, "type": "sep", "indent": 0, "text": [" Prototype Index "], "extent": [5017, 5041], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Prototype Index"], "extent": [5071, 5092], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Random"], "extent": [5120, 5136], "body": [{"type": "para", "indent": 12, "text": ["Choose the prototype at each point randomly."], "extent": [5136, 5194]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Index"], "extent": [5194, 5209], "body": [{"type": "para", "indent": 12, "text": ["Specify a single prototype to use at each point in a parameter. This lets you drive the parameter using an expression (for example, based on a context option)."], "extent": [5209, 5382]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Index Attribute"], "extent": [5382, 5407], "body": [{"type": "para", "indent": 12, "text": ["Use the value of an integer attribute on the target point as an index into the list of prototypes."], "extent": [5407, 5519]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Name Attribute"], "extent": [5519, 5543], "body": [{"type": "para", "indent": 12, "text": ["Use the value of a string attribute to select the prototype by name. (The name of each prototype is copied from the original prim used to create the prototype. The node may add numbers to the prototype names to make them unique.)"], "extent": [5543, 5786]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Path Attribute"], "extent": [5786, 5810], "body": [{"type": "para", "indent": 12, "text": ["Use the value of a string attribute to select the prototype by path."], "extent": [5810, 5892]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "protoindexsrc"}}, {"type": "dt", "indent": 4, "text": ["Seed"], "extent": [5892, 5902], "body": [{"type": "para", "indent": 8, "text": ["When ", {"type": "ui", "text": ["Prototype Index"]}, " is ", {"type": "ui", "text": ["Random"]}, ", the seed for the random number generator."], "extent": [5921, 6012]}], "container": true, "attrs": {"id": "seed"}}, {"type": "dt", "indent": 4, "text": ["Index"], "extent": [6012, 6023], "body": [{"type": "para", "indent": 8, "text": ["When ", {"type": "ui", "text": ["Prototype Index"]}, " is ", {"type": "ui", "text": ["Index"]}, ", the index of the prototype to use, from the list of primitives in ", {"type": "ui", "text": ["Prototype Primitives"]}, ". You can use an expression to choose the index based on some other factor."], "extent": [6043, 6257]}], "container": true, "attrs": {"id": "index"}}, {"type": "dt", "indent": 4, "text": ["Index Attribute"], "extent": [6257, 6278], "body": [{"type": "para", "indent": 8, "text": ["An integer attribute on the target points that specifies the prototype to use."], "extent": [6302, 6398]}, {"type": "note_group", "body": [{"type": "note", "indent": 8, "role": "item", "extent": [6398, 6412], "body": [{"type": "para", "indent": 12, "text": ["When ", {"type": "ui", "text": ["Location Source"]}, " is ", {"type": "ui", "text": ["First Input\u2019s Points"]}, ", the USD Prim(s) will be checked first for a matching attribute and, failing that, a matching primvar."], "extent": [6412, 6581]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "indexattr"}}, {"type": "dt", "indent": 4, "text": ["Name Attribute"], "extent": [6581, 6601], "body": [{"type": "para", "indent": 8, "text": ["A string attribute on the target points that specifies the name of the prototype to use."], "extent": [6624, 6730]}, {"type": "note_group", "body": [{"type": "note", "indent": 8, "role": "item", "extent": [6730, 6744], "body": [{"type": "para", "indent": 12, "text": ["When ", {"type": "ui", "text": ["Location Source"]}, " is ", {"type": "ui", "text": ["First Input\u2019s Points"]}, ", the USD Prim(s) will be checked first for a matching attribute and, failing that, a matching primvar."], "extent": [6744, 6913]}], "container": true}, {"type": "note", "indent": 8, "role": "item", "extent": [6913, 6927], "body": [{"type": "para", "indent": 12, "text": ["USD PointInstancer primitives don\u2019t inherently have the ability to address prototypes by name. This node finds the prototype by name, then sets the corresponding index in the ", {"type": "code", "text": ["protoIndices"]}, " array attribute on the point instancer prim."], "extent": [6927, 7175]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "nameattr"}}, {"type": "dt", "indent": 4, "text": ["Path Attribute"], "extent": [7175, 7195], "body": [{"type": "para", "indent": 8, "text": ["A string attribute on the target points that specifies the path of the prototype to use."], "extent": [7218, 7324]}, {"type": "note_group", "body": [{"type": "note", "indent": 8, "role": "item", "extent": [7324, 7338], "body": [{"type": "para", "indent": 12, "text": ["When ", {"type": "ui", "text": ["Location Source"]}, " is ", {"type": "ui", "text": ["First Input\u2019s Points"]}, ", the USD Prim(s) will be checked first for a matching attribute and, failing that, a matching primvar."], "extent": [7338, 7507]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "pathattr"}}, {"type": "dt", "indent": 4, "text": ["Warn on Skipped Instances"], "extent": [7507, 7538], "body": [{"type": "para", "indent": 8, "text": ["When ", {"type": "ui", "text": ["Prototype Index"]}, " is ", {"type": "ui", "text": ["Index Attribute"]}, ", ", {"type": "ui", "text": ["Name Attribute"]}, " or ", {"type": "ui", "text": ["Path Attribute"]}, ", this toggle controls whether or not to emit a warning when an instance is skipped due to there being no match between the attribute data and the prototype list."], "extent": [7566, 7825]}], "container": true, "attrs": {"id": "warnonskipped"}}], "container": true}], "container": true, "attrs": {"id": "prototypeindexparms"}}]}