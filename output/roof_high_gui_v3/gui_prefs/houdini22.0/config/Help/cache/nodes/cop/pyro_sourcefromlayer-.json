{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_sourcefromlayer", "icon": "COP/pyro_sourcefromlayer", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Source from Layer"], "extent": [116, 143]}, {"type": "summary", "indent": 0, "text": ["Sources from a layer\u2019s envelope into a VDB."], "extent": [143, 195]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [195, 201], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [201, 421]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation will update a Float VDB according to an envelope described by Mono layers."], "extent": [421, 512]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [512, 518], "body": [{"type": "para", "indent": 4, "text": ["This does not activate any voxels, so any sources outside of activated areas will have no effect."], "extent": [518, 621]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [621, 633], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Method"], "extent": [633, 642], "body": [{"type": "para", "indent": 4, "text": ["How to update the VDB from the envelope values."], "extent": [663, 720]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Set"], "extent": [720, 729], "body": [{"type": "para", "indent": 8, "text": ["Replace the value."], "extent": [729, 765]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Add"], "extent": [765, 774], "body": [{"type": "para", "indent": 8, "text": ["Add to the current value."], "extent": [774, 817]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Minimum"], "extent": [817, 830], "body": [{"type": "para", "indent": 8, "text": ["Take the minimum of the current value with the envelope values."], "extent": [830, 911]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Maximum"], "extent": [911, 924], "body": [{"type": "para", "indent": 8, "text": ["Take the maximum of the current value with the envelope values."], "extent": [924, 1010]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "method"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Border"], "extent": [1010, 1018], "body": [{"type": "para", "indent": 4, "text": ["The wrapping mode of the reference layers can be used to make tiling sources.  However, it is often expected for the source to not be present past the layer, so this allows just in time overriding of the border type."], "extent": [1035, 1257]}, {"type": "para", "indent": 4, "text": ["Auto will use the input\u2019s border type."], "extent": [1257, 1301]}, {"type": "para", "indent": 4, "text": ["See ", {"scheme": null, "value": "/copernicus/glossary#border", "type": "link", "text": ["Border types"], "fullpath": "/copernicus/glossary.html#border", "fragment": "#border"}, " for more information."], "extent": [1301, 1379]}], "container": true, "attrs": {"id": "border"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Shape"], "extent": [1379, 1391], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Thickness"], "extent": [1391, 1403], "body": [{"type": "para", "indent": 4, "text": ["A global scale on the ", {"type": "code", "text": ["thickness"]}, " input, allowing a 0-1 layer to be rescaled to world units."], "extent": [1427, 1529]}], "container": true, "attrs": {"id": "thickness"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Scale by Timestep"], "extent": [1529, 1548], "body": [{"type": "para", "indent": 4, "text": ["Scale the envelope values by the current timestep.  In ", {"type": "ui", "text": ["Add"]}, " mode, this ensures the same amount will be added over a second even if substepping occurs."], "extent": [1573, 1736]}], "container": true, "attrs": {"id": "dotimestep"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Amount"], "extent": [1736, 1744], "body": [{"type": "para", "indent": 4, "text": ["The density to use for voxels in the envelope.  This is scaled by the ", {"type": "code", "text": ["density"]}, " input."], "extent": [1765, 1861]}], "container": true, "attrs": {"id": "amount"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Falloff"], "extent": [1861, 1870], "body": [{"type": "para", "indent": 4, "text": ["The density is scaled by the falloff ramp.  The left side is the outer surface of the envelope.  The distance along the ramp is based on the distance from the surface scaled by the global thickness (rather than the local thickness). This ensures that thin areas also decrease in magnitude."], "extent": [1888, 2197]}], "container": true, "attrs": {"id": "falloff"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Enable Noise"], "extent": [2197, 2216], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Noise Enable"], "extent": [2216, 2231], "body": [{"type": "para", "indent": 4, "text": ["Enable scaling the value by a noise function."], "extent": [2258, 2309]}], "container": true, "attrs": {"id": "noise_enable"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Noise Scale"], "extent": [2309, 2322], "body": [{"type": "para", "indent": 4, "text": ["How much to scale the value by."], "extent": [2348, 2389]}], "container": true, "attrs": {"id": "noise_scale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Element Size"], "extent": [2389, 2403], "body": [{"type": "para", "indent": 4, "text": ["The size in world space of the feature size of the noise."], "extent": [2432, 2499]}], "container": true, "attrs": {"id": "noise_elemsize"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Element Scale"], "extent": [2499, 2514], "body": [{"type": "para", "indent": 4, "text": ["The anisotropic scaling of the noise feature sizes."], "extent": [2544, 2605]}], "container": true, "attrs": {"id": "noise_elemscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Noise Offset"], "extent": [2605, 2619], "body": [{"type": "para", "indent": 4, "text": ["The offset of the noise in noise-space, the first three are the spatial offset and the fourth the time offset."], "extent": [2646, 2766]}], "container": true, "attrs": {"id": "noise_offset"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Noise Pulse"], "extent": [2766, 2779], "body": [{"type": "para", "indent": 4, "text": ["The time in seconds for the feature size of the noise\u2019s change over time.  This is roughly the rate at which it will seem to pulse."], "extent": [2805, 2951]}], "container": true, "attrs": {"id": "noise_pulse"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Enable Distortion"], "extent": [2951, 2975], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Distort Enable"], "extent": [2975, 2992], "body": [{"type": "para", "indent": 4, "text": ["Enable distorting of the shape of the sphere by a noise function."], "extent": [3017, 3092]}], "container": true, "attrs": {"id": "distort_enable"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Distort Scale"], "extent": [3092, 3107], "body": [{"type": "para", "indent": 4, "text": ["How far to distort in worldspace."], "extent": [3131, 3179]}], "container": true, "attrs": {"id": "distort_scale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Element Size"], "extent": [3179, 3193], "body": [{"type": "para", "indent": 4, "text": ["The size in world space of the feature size of the noise."], "extent": [3224, 3291]}], "container": true, "attrs": {"id": "distort_elemsize"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Element Scale"], "extent": [3291, 3306], "body": [{"type": "para", "indent": 4, "text": ["The anisotropic scaling of the noise feature sizes."], "extent": [3338, 3399]}], "container": true, "attrs": {"id": "distort_elemscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Distort Offset"], "extent": [3399, 3415], "body": [{"type": "para", "indent": 4, "text": ["The offset of the noise in noise-space, the first three are the spatial offset and the fourth the time offset."], "extent": [3444, 3564]}], "container": true, "attrs": {"id": "distort_offset"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Distort Pulse"], "extent": [3564, 3579], "body": [{"type": "para", "indent": 4, "text": ["The time in seconds for the feature size of the noise\u2019s change over time.  This is roughly the rate at which it will seem to pulse."], "extent": [3607, 3748]}], "container": true, "attrs": {"id": "distort_pulse"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [3748, 3756], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["source"], "extent": [3756, 3768], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB to apply the source to."], "extent": [3768, 3813]}], "container": true}, {"type": "dt", "indent": 4, "text": ["thickness"], "extent": [3813, 3828], "body": [{"type": "para", "indent": 8, "text": ["A Mono layer specifying how thick the envelope is at each pixel."], "extent": [3828, 3902]}], "container": true}, {"type": "dt", "indent": 4, "text": ["height"], "extent": [3902, 3914], "body": [{"type": "para", "indent": 8, "text": ["A Mono layer specifying where the envelope\u2019s center line will be, as measured from the layer itself."], "extent": [3914, 4024]}], "container": true}, {"type": "dt", "indent": 4, "text": ["density"], "extent": [4024, 4037], "body": [{"type": "para", "indent": 8, "text": ["A Mono layer specifying the density of the envelope."], "extent": [4037, 4099]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [4099, 4108], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["result"], "extent": [4108, 4120], "body": [{"type": "para", "indent": 8, "text": ["The source VDB modified by the layer source."], "extent": [4120, 4174]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [4174, 4183], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_sourcefromlayer", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_sourcefromlayer.html"}], "extent": [4183, 4217]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/layertovdbleafpoints", "type": "link", "text": "", "fullpath": "/nodes/cop/layertovdbleafpoints.html"}], "extent": [4217, 4252]}], "container": true}], "text": "Related"}], "title": ["Pyro Source from Layer"], "summary": ["Sources from a layer\u2019s envelope into a VDB."]}