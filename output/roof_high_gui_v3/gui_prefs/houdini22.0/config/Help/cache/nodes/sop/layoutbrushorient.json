{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "layoutbrushorient", "icon": "SOP/layoutbrushorient", "tags": "paintinstancesbrush", "allow_hidden": "true", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Orient (Paint Instances brush)"], "extent": [0, 35]}, {"type": "summary", "indent": 0, "text": ["Turns the assets you brush over toward a certain direction."], "extent": [167, 234]}, {"type": "box_group", "body": [{"ext": null, "type": "box", "indent": 0, "role": "item", "extent": [16, 22], "body": [{"type": "para", "indent": 4, "text": ["This node is designed to customize the behavior of the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["Paint Instances LOP"], "fullpath": "/nodes/lop/paintinstances.html"}, ". See the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["help for Paint Instances"], "fullpath": "/nodes/lop/paintinstances.html"}, " for more information."], "extent": [51, 238]}], "container": true, "attrs": {"id": "see_paintinstances"}}], "container": true, "role": "item_group"}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [285, 291], "body": [{"type": "para", "indent": 4, "text": ["This brush can only affect assets that were added in the current Paint Instances node."], "extent": [291, 384]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [384, 396], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Brush"], "extent": [396, 410], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Shape"], "extent": [410, 418], "body": [], "container": true, "attrs": {"id": "mode"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [479, 487], "body": [{"type": "para", "indent": 4, "text": ["The radius of the brush."], "extent": [487, 517]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Soft Radius"], "extent": [517, 530], "body": [{"type": "para", "indent": 4, "text": ["The fraction of the brush radius where it starts to fall off to 0.0 at the edge. For example, if you set this to ", {"type": "code", "text": ["0.5"]}, ", the brush is at full strength in the inner half of the radius, and falls off from the halfway point to the outer edge."], "extent": [530, 775]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Transform"], "extent": [775, 791], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Rotation Mode"], "extent": [791, 807], "body": [{"type": "para", "indent": 3, "text": ["Set to ", {"type": "code", "text": ["Absolute"]}, " to replace the scale of each instance with the value in ", {"type": "ui", "text": ["Scale"]}, ". ", {"type": "code", "text": ["Incremental"]}, " multiplies the current scale by the value in ", {"type": "ui", "text": ["Scale"]}, " with each move of the brush."], "extent": [823, 1010]}], "container": true, "attrs": {"id": "rmode"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rotate"], "extent": [1010, 1018], "body": [{"type": "para", "indent": 4, "text": ["The absolute rotation value to which each instance is set."], "extent": [1030, 1094]}], "container": true, "attrs": {"id": "r"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rotate"], "extent": [1094, 1102], "body": [{"type": "para", "indent": 4, "text": ["The incremental rotation that is added to the current rotation of each instance."], "extent": [1117, 1203]}], "container": true, "attrs": {"id": "rinc"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1203, 1212], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": "", "fullpath": "/nodes/lop/paintinstances.html"}], "extent": [1212, 1241]}], "container": true}], "text": "Related"}], "title": ["Orient (Paint Instances brush)"], "summary": ["Turns the assets you brush over toward a certain direction."], "included": ["/nodes/sop/_paintinstancesbrush"]}