{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_activate", "icon": "COP/pyro_activate", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Activate"], "extent": [102, 120]}, {"type": "summary", "indent": 0, "text": ["Changes the activation of VDBs in a Pyro simulation."], "extent": [120, 181]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [181, 187], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [187, 407]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This node will update the activation of voxels in the VDBs of a Pyro simulation.  The solve only occurs where the voxels are active, so it is important to keep both the volume to be solved active, but also\nenough of a buffer so the surrounding air field will be present."], "extent": [407, 679]}, {"type": "para", "indent": 0, "text": ["The ", {"scheme": "Node", "value": "/nodes/cop/vdbvisualizetree", "type": "link", "text": ["VDB Visualize Tree COP"], "fullpath": "/nodes/cop/vdbvisualizetree.html"}, " can be used to inspect what regions are activated."], "extent": [679, 786]}, {"type": "para", "indent": 0, "text": ["Activation is done at the ", {"type": "q", "text": ["leaf"]}, " level, which are blocks of 8\u00d78\u00d78 voxels."], "extent": [786, 861]}, {"type": "para", "indent": 0, "text": ["The fewer the active leaves, the less memory and the faster the simulation runs."], "extent": [861, 944]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [944, 956], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Density Cutoff"], "extent": [956, 973], "body": [{"type": "para", "indent": 4, "text": ["Any leaf whose maximum density is below the cutoff will be eligible to be deactivated."], "extent": [990, 1086]}], "container": true, "attrs": {"id": "cutoff"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Leaf Dilation"], "extent": [1086, 1101], "body": [{"type": "para", "indent": 4, "text": ["Expand the active region a fixed number of leaves."], "extent": [1124, 1180]}, {"type": "para", "indent": 4, "text": ["The maximum of ", {"type": "ui", "text": ["Leaf Dilation Dist"]}, " and ", {"type": "ui", "text": ["Leaf Dilation"]}, " are used."], "extent": [1180, 1259]}], "container": true, "attrs": {"id": "leafdilation"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Leaf Dilation Dist"], "extent": [1259, 1279], "body": [{"type": "para", "indent": 4, "text": ["Expand the active region a fixed distance in world space; this is raised to the nearest leaf.  "], "extent": [1306, 1407]}, {"type": "para", "indent": 4, "text": ["The maximum of ", {"type": "ui", "text": ["Leaf Dilation Dist"]}, " and ", {"type": "ui", "text": ["Leaf Dilation"]}, " are used."], "extent": [1407, 1486]}], "container": true, "attrs": {"id": "leafdilationdist"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Velocity Dilation"], "extent": [1486, 1505], "body": [{"type": "para", "indent": 4, "text": ["Each leaf\u2019s maximum velocity in each of the directions is measured, and the leaf expanded to cover that distance."], "extent": [1525, 1644]}, {"type": "para", "indent": 4, "text": ["This can ensure the air field is present for the incoming air."], "extent": [1644, 1721]}], "container": true, "attrs": {"id": "veldilate"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Velocity Scale"], "extent": [1721, 1737], "body": [{"type": "para", "indent": 4, "text": ["Scale the velocity used for velocity dilation.  This also scaled by the timestep."], "extent": [1756, 1852]}], "container": true, "attrs": {"id": "velscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Tangential Scale"], "extent": [1852, 1870], "body": [{"type": "para", "indent": 4, "text": ["Also dilate in the perpendicular directions to the velocity by this portion of the velocity dilation.  Usually fluid is turbulent, so if it needs to extend in one direction the neighboring directions are also likely important."], "extent": [1890, 2126]}], "container": true, "attrs": {"id": "tangscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Ambient Velocity"], "extent": [2126, 2144], "body": [{"type": "para", "indent": 4, "text": ["A global constant velocity term to add to all the velocities for the purpose of dilation.  This is important to match any ambient velocity on the advection."], "extent": [2162, 2333]}], "container": true, "attrs": {"id": "ambient"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Min X"], "extent": [2333, 2345], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions less than this in X."], "extent": [2364, 2437]}], "container": true, "attrs": {"id": "clipminx"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Min Y"], "extent": [2437, 2449], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions less than this in Y."], "extent": [2472, 2545]}], "container": true, "attrs": {"id": "clipminy"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Min Z"], "extent": [2545, 2557], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions less than this in Z."], "extent": [2580, 2649]}], "container": true, "attrs": {"id": "clipminz"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Max X"], "extent": [2649, 2661], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions greater than this in X."], "extent": [2684, 2756]}], "container": true, "attrs": {"id": "clipmaxx"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Max Y"], "extent": [2756, 2768], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions greater than this in Y."], "extent": [2787, 2863]}], "container": true, "attrs": {"id": "clipmaxy"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Max Z"], "extent": [2863, 2875], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions greater than this in Z."], "extent": [2898, 2974]}], "container": true, "attrs": {"id": "clipmaxz"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [2974, 2982], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["density"], "extent": [2982, 2995], "body": [{"type": "para", "indent": 8, "text": ["A float VDB used both as the reference size for activation, and to provide the density values to cull inactive leaves."], "extent": [2995, 3123]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [3123, 3130], "body": [{"type": "para", "indent": 8, "text": ["A vector VDB providing the velocities for doing velocity dilation."], "extent": [3130, 3206]}], "container": true}, {"type": "dt", "indent": 4, "text": ["activate_pts"], "extent": [3206, 3224], "body": [{"type": "para", "indent": 8, "text": ["Additional points to activate with. Any leaf which contains the point will be activated."], "extent": [3224, 3322]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [3322, 3331], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["float"], "extent": [3331, 3342], "body": [{"type": "para", "indent": 8, "text": ["A representative float VDB with leaves activated by the rules."], "extent": [3342, 3414]}], "container": true}, {"type": "dt", "indent": 4, "text": ["vector"], "extent": [3414, 3426], "body": [{"type": "para", "indent": 8, "text": ["A representative vector VDB with leaves activated by the rules."], "extent": [3426, 3499]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [3499, 3508], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/vdbactivatefrompoints", "type": "link", "text": "", "fullpath": "/nodes/cop/vdbactivatefrompoints.html"}], "extent": [3508, 3543]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/vdbvisualizetree", "type": "link", "text": "", "fullpath": "/nodes/cop/vdbvisualizetree.html"}], "extent": [3543, 3573]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_block_begin", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_block_begin.html"}], "extent": [3573, 3604]}], "container": true}], "text": "Related"}], "title": ["Pyro Activate"], "summary": ["Changes the activation of VDBs in a Pyro simulation."]}