{"type": "root", "attrs": {"type": "node", "context": "sop", "namespace": "apex", "internal": "autorigcomponent", "icon": "SOP/apex-autorigcomponent", "tags": "apex", "version": "2.0", "since": "20.5"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["APEX Autorig Component"], "extent": [144, 171]}, {"type": "summary", "indent": 0, "text": ["Procedurally adds a rig component to an APEX rig."], "extent": [171, 229]}, {"type": "para", "indent": 0, "text": ["This node procedurally augments an APEX character, and most commonly an APEX rig, using rig components. Rig components are either pre-built components shipped with Houdini, or you can create your own components to be reused in different rigs."], "extent": [229, 473]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [473, 485], "body": [{"level": 3, "type": "sep", "indent": 0, "text": [" Component "], "extent": [485, 504], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Component Source"], "extent": [504, 527], "body": [{"type": "para", "indent": 8, "text": ["The source of the component. The options are:"], "extent": [556, 611]}, {"type": "bullet_group", "body": [{"blevel": 10, "type": "bullet", "indent": 8, "text": ["Choose from the list of available rig components in your components library, including ", {"scheme": null, "value": "/character/kinefx/rigcomponentslist", "type": "link", "text": ["pre-built components"], "fullpath": "/character/kinefx/rigcomponentslist.html"}, " and your custom components."], "extent": [611, 796]}, {"blevel": 10, "type": "bullet", "indent": 8, "text": ["If set to ", {"type": "ui", "text": ["Use Second Input"]}, ", the rig component script from the second input is used."], "extent": [796, 895]}, {"blevel": 10, "type": "bullet", "indent": 8, "text": ["If set to ", {"type": "ui", "text": ["Use Snippet"]}, ", you can write ", {"scheme": null, "value": "/character/kinefx/apexscriptbasics", "type": "link", "text": ["APEX Script"], "fullpath": "/character/kinefx/apexscriptbasics.html"}, " code in the ", {"type": "ui", "text": ["Snippet"]}, " text block to create your own custom component."], "extent": [895, 1068]}, {"blevel": 10, "type": "bullet", "indent": 8, "text": ["If set to ", {"type": "ui", "text": ["Use File"]}, ", uses the component in the ", {"type": "ui", "text": ["Component File"]}, "."], "extent": [1068, 1149]}, {"blevel": 10, "type": "bullet", "indent": 8, "text": ["If set to ", {"type": "ui", "text": ["Deprecated"]}, ", choose from the list of deprecated components in the drop-down menu that appears beside the ", {"type": "ui", "text": ["Component Source"]}, " drop-down. "], "extent": [1149, 1311]}], "container": true}], "container": true, "attrs": {"id": "componentsource"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Component Source Reload ", {"scheme": "Icon", "value": "BUTTONS/reload", "type": "link", "text": "", "fullpath": "/nodes/sop/BUTTONS/reload.html"}], "extent": [1311, 1362], "body": [{"type": "para", "indent": 8, "text": ["Reloads/updates your library of components."], "extent": [1397, 1450]}], "container": true, "attrs": {"id": "componentsourcereload"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Component File"], "extent": [1450, 1470], "body": [{"type": "para", "indent": 8, "text": ["When ", {"type": "ui", "text": ["Component Source"]}, " is set to ", {"type": "ui", "text": ["Use File"]}, ", this is the path of the file to use. "], "extent": [1497, 1594]}], "container": true, "attrs": {"id": "componentfile"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Edit Source Script as Snippet"], "extent": [1594, 1629], "body": [{"type": "para", "indent": 8, "text": ["Sets the ", {"type": "ui", "text": ["Component Source"]}, " to ", {"type": "ui", "text": ["Use Snippet"]}, ", fetches the source code of the component script, and inserts the code into the ", {"type": "ui", "text": ["Snippet"]}, " parameter. This is useful if you want to use a component\u2019s code as a starting point for creating a custom component."], "extent": [1659, 1926]}], "container": true, "attrs": {"id": "editsourcescript"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 4, "text": [" Save New Component "], "extent": [1926, 1957], "body": [{"type": "para", "indent": 8, "text": ["These parameter are available when ", {"type": "ui", "text": ["Component Source"]}, " is set to ", {"type": "ui", "text": ["Use Second Input"]}, ", ", {"type": "ui", "text": ["Use Snippet"]}, " or ", {"type": "ui", "text": ["Use File"]}, "."], "extent": [1957, 2087]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Component Name"], "extent": [2087, 2111], "body": [{"type": "para", "indent": 12, "text": ["The name of the component. For example, if you set the namespace field to ", {"type": "code", "text": ["test"]}, ", the name field to ", {"type": "code", "text": ["hello"]}, ", and version to ", {"type": "code", "text": ["2.0"]}, ", your component will be named ", {"type": "code", "text": ["test::hello::2.0"]}, "."], "extent": [2150, 2343]}], "container": true, "attrs": {"id": "newcomponentnamespace"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Component Label"], "extent": [2343, 2368], "body": [{"type": "para", "indent": 12, "text": ["A user-friendly label for the component. This label is used in the ", {"type": "ui", "text": ["Component Source"]}, " drop-down menu."], "extent": [2403, 2520]}], "container": true, "attrs": {"id": "newcomponentlabel"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Deprecated"], "extent": [2520, 2540], "body": [{"type": "para", "indent": 12, "text": ["When turned on, marks the component as deprecated. After saving the component, it appears in a drop-down menu of deprecated components when ", {"type": "ui", "text": ["Component Source"]}, " is set to ", {"type": "ui", "text": ["Deprecated"]}, "."], "extent": [2580, 2780]}], "container": true, "attrs": {"id": "newcomponentdeprecated"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Component Output File"], "extent": [2780, 2811], "body": [{"type": "para", "indent": 12, "text": ["The file path to save the component to."], "extent": [2838, 2891]}, {"type": "note_group", "body": [{"type": "note", "indent": 12, "role": "item", "extent": [2891, 2909], "body": [{"type": "para", "indent": 16, "text": ["The component must be stored in a folder named ", {"type": "code", "text": ["apexcomponent"]}, " in the ", {"scheme": null, "value": "/ref/env", "type": "link", "text": ["HOUDINI_PATH"], "fullpath": "/ref/env.html"}, "."], "extent": [2909, 3021]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "sopoutput"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Save to Disk"], "extent": [3021, 3043], "body": [{"type": "para", "indent": 12, "text": ["Saves the component script to ", {"type": "ui", "text": ["Component Output File"]}, ". "], "extent": [3068, 3139]}, {"type": "note_group", "body": [{"type": "note", "indent": 12, "role": "item", "extent": [3139, 3157], "body": [{"type": "para", "indent": 16, "text": ["If you store the component script under $HIP/apexcomponents/ or $HOME/apexcomponents/, it is automatically picked up by ", {"type": "ui", "text": ["Component Source"]}, "."], "extent": [3157, 3316]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "execute"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}], "container": true}, {"level": 3, "type": "sep", "indent": 0, "text": [" Rig "], "extent": [3316, 3328], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Rig Source"], "extent": [3328, 3345], "body": [{"type": "para", "indent": 8, "text": ["The operation to perform on the rig in the CharacterStream input."], "extent": [3368, 3443]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Add or Update"], "extent": [3443, 3466], "body": [{"type": "para", "indent": 12, "text": ["Adds/updates the specified rig in the CharacterStream input. If no rig exists, one is created if possible."], "extent": [3466, 3586]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Add or Replace"], "extent": [3586, 3610], "body": [{"type": "para", "indent": 12, "text": ["Adds/replaces the specified rig in the CharacterStream input."], "extent": [3610, 3685]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "rigsource"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Name"], "extent": [3685, 3695], "body": [{"type": "para", "indent": 8, "text": ["The name of the rig in the CharacterStream input."], "extent": [3721, 3780]}], "container": true, "attrs": {"id": "inputrigname"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"level": 3, "type": "sep", "indent": 0, "text": [" Advanced "], "extent": [3780, 3797], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Enable Partial Evaluation"], "extent": [3797, 3829], "body": [{"type": "para", "indent": 8, "text": ["When turned on, provides partial evaluation optimizations on the component script graph by only executing the portions of the graph that:"], "extent": [3854, 4001]}, {"type": "bullet_group", "body": [{"blevel": 10, "type": "bullet", "indent": 8, "text": ["Depend on input parameters that have changed."], "extent": [4001, 4058], "body": [{"type": "para", "indent": 12, "text": [{"type": "em", "text": ["and"]}], "extent": [4058, 4077]}], "container": true}, {"blevel": 10, "type": "bullet", "indent": 8, "text": ["Contribute to the outputs requested by this node."], "extent": [4077, 4138]}], "container": true}], "container": true, "attrs": {"id": "partialeval"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Color New Nodes"], "extent": [4138, 4159], "body": [{"type": "para", "indent": 8, "text": ["When turned on, colors the nodes added with the current component script in the specified color. This color is added to the output graph. It can be used for debugging to easily associate each node with a source component script. "], "extent": [4188, 4428]}], "container": true, "attrs": {"id": "usenewnodecolor"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"level": 3, "type": "sep", "indent": 0, "text": [" Component Parameters "], "extent": [4428, 4457], "body": [{"type": "para", "indent": 4, "text": ["This section contains parameters specific to the current rig component, and will look different depending on the selected ", {"type": "ui", "text": ["Component Source"]}, " option. The parameters are derived from the inputs of the component script. In this way, the APEX Autorig Component SOP serves as an interface for configuring component script inputs. "], "extent": [4457, 4791]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["View Log ", {"scheme": "Icon", "value": "BUTTONS/debug", "type": "link", "text": "", "fullpath": "/nodes/sop/BUTTONS/debug.html"}], "extent": [624, 656], "body": [{"type": "para", "indent": 4, "text": ["Opens the ", {"scheme": null, "value": "/character/kinefx/apexscriptlanguage#logging", "type": "link", "text": ["log viewer"], "fullpath": "/character/kinefx/apexscriptlanguage.html#logging", "fragment": "#logging"}, ". "], "extent": [673, 748]}], "container": true, "attrs": {"id": "viewlog"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Reset Animation Parms ", {"scheme": "Icon", "value": "BUTTONS/clear", "type": "link", "text": "", "fullpath": "/nodes/sop/BUTTONS/clear.html"}], "extent": [4838, 4886], "body": [{"type": "para", "indent": 8, "text": ["Removes all the spare parameters used as inputs for the component script."], "extent": [4910, 4993]}], "container": true, "attrs": {"id": "resetparms"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Reload Setup Parms ", {"scheme": "Icon", "value": "BUTTONS/reload", "type": "link", "text": "", "fullpath": "/nodes/sop/BUTTONS/reload.html"}], "extent": [4993, 5039], "body": [{"type": "para", "indent": 8, "text": ["Updates the parameters in this section to those of the current component. This is useful if the input component script parameters have changed. "], "extent": [5064, 5218]}], "container": true, "attrs": {"id": "updateparms"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"level": 3, "type": "sep", "indent": 0, "text": [" Component Snippet "], "extent": [5218, 5244], "body": [{"type": "para", "indent": 4, "text": ["This section is available when ", {"type": "ui", "text": ["Component"]}, " is set to ", {"type": "ui", "text": ["Use Snippet"]}, "."], "extent": [5262, 5339]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Snippet"], "extent": [1172, 1181], "body": [{"type": "para", "indent": 4, "text": ["The APEX Script snippet to execute. "], "extent": [1198, 1240]}], "container": true, "attrs": {"id": "snippet"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Script "], "extent": [1240, 1255], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Inspect Line"], "extent": [1273, 1291], "body": [{"type": "para", "indent": 8, "text": ["When turned on, the specified line of code in the ", {"type": "ui", "text": ["Snippet"]}, " is colored red. This helps with debugging."], "extent": [1319, 1433]}], "container": true, "attrs": {"id": "highlightlines"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Show Traceback"], "extent": [1433, 1453], "body": [{"type": "para", "indent": 8, "text": ["When turned on, shows all the error messages with a full traceback. "], "extent": [1476, 1554]}], "container": true, "attrs": {"id": "traceback"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "folder0"}}, {"level": 3, "type": "sep", "indent": 4, "text": [" Decompile "], "extent": [5433, 5455], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Convert To Snippet"], "extent": [5455, 5484], "body": [{"type": "para", "indent": 12, "text": ["Converts the pre-shipped component script or graph input (in the second input of this node) to an APEX Script snippet. The functionality of the APEX Script snippet and the input graph are exactly the same."], "extent": [5518, 5737]}], "container": true, "attrs": {"id": "converttosnippet"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Keep Node Positions"], "extent": [5737, 5766], "body": [{"type": "para", "indent": 12, "text": ["When turned on, adds the position metadata of all the nodes from the input graph to the decompiled APEX Script snippet. This generates considerably more lines of code. "], "extent": [5801, 5983]}], "container": true, "attrs": {"id": "decompileposition"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Keep Node Color"], "extent": [5983, 6008], "body": [{"type": "para", "indent": 12, "text": ["When turned on, adds the color metadata of all the nodes from the input graph to the decompiled APEX Script snippet. This generates considerably more lines of code. "], "extent": [6040, 6219]}], "container": true, "attrs": {"id": "decompilecolor"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"type": "include_group", "body": [{"ext": "/nodes/sop/apex--script#folder2", "type": "include", "indent": 4, "role": "item", "extent": [6219, 6266]}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "folder1"}}, {"level": 3, "type": "sep", "indent": 0, "text": [" Visualizer "], "extent": [6266, 6284], "body": [{"type": "para", "indent": 4, "text": ["The visualizer options allow you to specify the graph to show in the APEX network view, as well as set color highlights to facilitate debugging. The colors are not applied to the actual output data. "], "extent": [6284, 6490]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Show"], "extent": [6490, 6500], "body": [{"type": "para", "indent": 8, "text": ["Defines which graph to show in the APEX network view. "], "extent": [6523, 6587]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Rig"], "extent": [6587, 6601], "body": [{"type": "para", "indent": 12, "text": ["The resulting rig graph extracted from the packed character."], "extent": [6601, 6675]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Component Script"], "extent": [6675, 6702], "body": [{"type": "para", "indent": 12, "text": ["The current component script that modifies the character. "], "extent": [6702, 6774]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "showgraph"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Highlight Added Nodes"], "extent": [6774, 6801], "body": [{"type": "para", "indent": 8, "text": ["When turned on, highlights all the newly added nodes in green, and greys out the other existing nodes. This makes it easier to see the changes made to the graph by this rig component. "], "extent": [6823, 7017]}], "container": true, "attrs": {"id": "colornew"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Highlight Reconnected Nodes"], "extent": [7017, 7050], "body": [{"type": "para", "indent": 8, "text": ["When turned on, highlights all the nodes that had connections added, modified, or removed on the current rig graph. "], "extent": [7080, 7206]}], "container": true, "attrs": {"id": "colorreconnected"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Layout Graph"], "extent": [7206, 7224], "body": [{"type": "para", "indent": 8, "text": ["When turned on, applies an automatic layout to the current rig graph. "], "extent": [7244, 7324]}], "container": true, "attrs": {"id": "layout"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [7324, 7332], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["CharacterStream"], "extent": [7332, 7350], "body": [{"type": "para", "indent": 4, "text": ["The APEX character geometry to modify."], "extent": [7350, 7394]}], "container": true}, {"type": "dt", "indent": 0, "text": ["ComponentScript"], "extent": [7394, 7411], "body": [{"type": "para", "indent": 4, "text": ["The geometry containing an APEX graph to invoke for the component. Changes to the parameter layout of the ", {"type": "ui", "text": ["Component Parameters"]}, " are stored as metadata in the ", {"type": "code", "text": ["parmoptions"]}, " detail attribute."], "extent": [7411, 7609]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [7609, 7618], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["CharacterStream"], "extent": [7618, 7636], "body": [{"type": "para", "indent": 4, "text": ["The modified APEX character geometry."], "extent": [7636, 7679]}], "container": true}, {"type": "dt", "indent": 0, "text": ["ComponentScript"], "extent": [7679, 7696], "body": [{"type": "para", "indent": 4, "text": ["The component\u2019s APEX graph that was invoked, including the metadata containing basic information about the parameter layout of the component (stored in the ", {"type": "code", "text": ["parmoptions"]}, " detail attribute). Provided for wiring convenience."], "extent": [7696, 7923]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [7923, 7932], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/rigsimplegeometry", "type": "link", "text": ["Rigging a simple geometry"], "fullpath": "/character/kinefx/rigsimplegeometry.html"}], "extent": [7932, 7998]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/rigcharacter", "type": "link", "text": ["Rigging a character"], "fullpath": "/character/kinefx/rigcharacter.html"}], "extent": [7998, 8053]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--rigscriptcomponent", "type": "link", "text": "", "fullpath": "/nodes/sop/apex--rigscriptcomponent.html"}], "extent": [8053, 8091]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/apex--configurecontrols", "type": "link", "text": "", "fullpath": "/nodes/sop/apex--configurecontrols.html"}], "extent": [8091, 8128]}], "container": true}], "text": "Related"}], "title": ["APEX Autorig Component"], "summary": ["Procedurally adds a rig component to an APEX rig."], "included": ["/nodes/sop/apex--script"]}