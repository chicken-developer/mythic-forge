{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "agentconstraintnetwork", "icon": "SOP/agentconstraintnetwork", "since": "14.5", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Agent Constraint Network"], "extent": [108, 137]}, {"type": "summary", "indent": 0, "text": ["Builds a constraint network to hold an agent\u2019s limbs together."], "extent": [137, 208]}, {"type": "para", "indent": 0, "text": ["This node will create a ", {"scheme": "Node", "value": "/nodes/dop/constraintnetwork", "type": "link", "text": ["constraint"], "fullpath": "/nodes/dop/constraintnetwork.html"}, " for each transform in the agent\u2019s collision layer that has a shape attached to it.\nThe rotation limits set up by the ", {"scheme": "Node", "value": "/nodes/sop/agentconfigurejoints", "type": "link", "text": ["Agent Configure Joints"], "fullpath": "/nodes/sop/agentconfigurejoints.html"}, " node will be used to set up ", {"scheme": "Node", "value": "/nodes/dop/conetwistconrel", "type": "link", "text": ["cone twist constraints"], "fullpath": "/nodes/dop/conetwistconrel.html"}, ".\nFor any transforms where the rotation limits were not set (or if there are multiple root collision shapes), ", {"scheme": "Node", "value": "/nodes/dop/hardconrel", "type": "link", "text": ["pin constraints"], "fullpath": "/nodes/dop/hardconrel.html"}, " will be created to prevent the ragdoll from immediately separating."], "extent": [208, 738]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [738, 750], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Group"], "extent": [750, 762], "body": [{"type": "para", "indent": 8, "text": ["The agents to create constraints for."], "extent": [762, 808]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Pin Root Collision Shapes"], "extent": [808, 839], "body": [{"type": "para", "indent": 8, "text": ["If there are multiple root collision shapes, pin constraints will be created to hold those objects together."], "extent": [866, 983]}], "container": true, "attrs": {"id": "pinrootshapes"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Pin Shapes With No Rotation Limits"], "extent": [983, 1023], "body": [{"type": "para", "indent": 8, "text": ["If there is a shape whose joint did not have a rotation limit set, a pin constraint will be created to attach it to its parent."], "extent": [1058, 1194]}], "container": true, "attrs": {"id": "pinunconfiguredshapes"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Random Seed"], "extent": [1194, 1211], "body": [{"type": "para", "indent": 8, "text": ["Seed used when adding random variation to the cone twist constraints' parameters."], "extent": [1211, 1301]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Softness"], "extent": [1301, 1315], "body": [{"type": "para", "indent": 8, "text": ["Once an angle is greater than softness times the maximum angle, the constraint begins to take effect.\n        Lowering the value of softness softens the constraint boundaries."], "extent": [1670, 1855]}], "container": true, "attrs": {"id": "softness"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Randomness"], "extent": [1395, 1411], "body": [{"type": "para", "indent": 8, "text": ["Specifies how much the ", {"type": "ui", "text": ["Softness"]}, " can be randomly varied by."], "extent": [1443, 1514]}], "container": true, "attrs": {"id": "softnessrandomness"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Constraint Force Mixing"], "extent": [1514, 1543], "body": [{"type": "para", "indent": 8, "text": ["Increase this to make the constraint spongier, and potentially increase the stability of the simulation.\n        The angular component of the constraint may be violated by an amount proportional to the force required to re-establish the constraint, times this parameter."], "extent": [2257, 2537]}], "container": true, "attrs": {"id": "constraintforcemixing"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Randomness"], "extent": [1631, 1647], "body": [{"type": "para", "indent": 8, "text": ["Specifies how much the ", {"type": "ui", "text": ["Constraint Force Mixing"]}, " can be randomly varied by."], "extent": [1692, 1778]}], "container": true, "attrs": {"id": "constraintforcemixingrandomness"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Bias Factor"], "extent": [1778, 1795], "body": [{"type": "para", "indent": 8, "text": ["The rate at which the constraint corrects errors in orientation.\n        A value of 1 will ensure that the constraint is always obeyed.\n        It is recommended to keep bias between 0.2 and 0.5."], "extent": [2579, 2784]}], "container": true, "attrs": {"id": "biasfactor"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Randomness"], "extent": [1880, 1896], "body": [{"type": "para", "indent": 8, "text": ["Specifies how much the ", {"type": "ui", "text": ["Bias Factor"]}, " can be randomly varied by."], "extent": [1930, 2004]}], "container": true, "attrs": {"id": "biasfactorrandomness"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Relaxation Factor"], "extent": [2004, 2027], "body": [{"type": "para", "indent": 8, "text": ["The rate at which the angular velocity is changed by the\n        constraint. A low value means the constraint will modify\n        the velocities slowly, leaving the boundaries appearing\n        softer."], "extent": [2838, 3049]}], "container": true, "attrs": {"id": "relaxationfactor"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Randomness"], "extent": [2124, 2140], "body": [{"type": "para", "indent": 8, "text": ["Specifies how much the ", {"type": "ui", "text": ["Relaxation Factor"]}, " can be randomly varied by."], "extent": [2180, 2261]}], "container": true, "attrs": {"id": "relaxationfactorrandomness"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Position CFM"], "extent": [4397, 4415], "body": [{"type": "para", "indent": 8, "text": ["Increase this to make the constraint spongier, and potentially increase the stability of the simulation.\n        The position component of the constraint may be violated by an amount proportional to the force required to re-establish the constraint, times this parameter."], "extent": [4440, 4721]}], "container": true, "attrs": {"id": "positioncfm"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Randomness"], "extent": [2315, 2331], "body": [{"type": "para", "indent": 8, "text": ["Specifies how much the ", {"type": "ui", "text": ["Position CFM"]}, " can be randomly varied by."], "extent": [2366, 2442]}], "container": true, "attrs": {"id": "positioncfmrandomness"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Position ERP"], "extent": [4721, 4739], "body": [{"type": "para", "indent": 8, "text": ["Specifies what proportion of the position error will be fixed during the next simulation step.\n        A value between 0.1 and 0.8 is recommended for most simulation."], "extent": [4764, 4940]}], "container": true, "attrs": {"id": "positionerp"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Randomness"], "extent": [2496, 2512], "body": [{"type": "para", "indent": 8, "text": ["Specifies how much the ", {"type": "ui", "text": ["Position ERP"]}, " can be randomly varied by."], "extent": [2547, 2623]}], "container": true, "attrs": {"id": "positionerprandomness"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2623, 2632], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agent", "type": "link", "text": "", "fullpath": "/nodes/sop/agent.html"}], "extent": [2632, 2651]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agentcollisionlayer", "type": "link", "text": "", "fullpath": "/nodes/sop/agentcollisionlayer.html"}], "extent": [2651, 2684]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agentconfigurejoints", "type": "link", "text": "", "fullpath": "/nodes/sop/agentconfigurejoints.html"}], "extent": [2684, 2718]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/bulletrbdsolver", "type": "link", "text": "", "fullpath": "/nodes/dop/bulletrbdsolver.html"}], "extent": [2718, 2747]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/conetwistconrel", "type": "link", "text": "", "fullpath": "/nodes/dop/conetwistconrel.html"}], "extent": [2747, 2776]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/constraintnetwork", "type": "link", "text": "", "fullpath": "/nodes/dop/constraintnetwork.html"}], "extent": [2776, 2807]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/hardconrel", "type": "link", "text": "", "fullpath": "/nodes/dop/hardconrel.html"}], "extent": [2807, 2831]}], "container": true}], "text": "Related"}], "title": ["Agent Constraint Network"], "summary": ["Builds a constraint network to hold an agent\u2019s limbs together."], "included": ["/nodes/dop/conetwistconrel", "/nodes/dop/standard_bulletconstraint_parm", "/nodes/dop/standard_conetwistconrelguide_parms", "/nodes/dop/standard_data_idparms", "/nodes/dop/standard_data_inputs", "/nodes/dop/standard_data_locals", "/nodes/dop/standard_data_outputs", "/nodes/dop/standard_data_parms", "/nodes/dop/standard_dataactive_parms", "/nodes/dop/standard_datagroup_parms", "/nodes/dop/standard_dataname_parms", "/nodes/dop/standard_dataop_parms", "/nodes/dop/standard_datashare_parms", "/nodes/dop/standard_locals"]}