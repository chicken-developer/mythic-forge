{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "shuffle", "icon": "COP2/shuffle", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Shuffle"], "extent": [78, 90]}, {"type": "summary", "indent": 0, "text": ["Shuffle frames around to do out-of-order editing."], "extent": [90, 148]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation allows you to shuffle frames around to do out-of-order\nediting. It does not use any cache memory."], "extent": [191, 305]}, {"type": "para", "indent": 0, "text": ["This is intended to be an interactive operation, most easily manipulated\nin the timeline. Drag a frame handle to its new position to move it, and\nSHIFT-drag a handle to another frame to swap it with that frame."], "extent": [305, 518]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [518, 530], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Shuffle Frames"], "extent": [530, 550], "body": [{"type": "para", "indent": 8, "text": ["A string specifying how the frames are to be moved about. The\n        format is as follows:"], "extent": [550, 651]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["A-B"], "extent": [651, 664], "body": [{"type": "para", "indent": 12, "text": ["Move frame A to frame B, moving all frames in between by 1."], "extent": [664, 736]}], "container": true}, {"type": "dt", "indent": 8, "text": ["A:B"], "extent": [736, 749], "body": [{"type": "para", "indent": 12, "text": ["Swap frames A and B."], "extent": [749, 783]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [783, 792], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/shift", "type": "link", "text": "", "fullpath": "/nodes/cop2/shift.html"}], "extent": [792, 816]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/sequence", "type": "link", "text": "", "fullpath": "/nodes/cop2/sequence.html"}], "extent": [816, 843]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/snip", "type": "link", "text": "", "fullpath": "/nodes/cop2/snip.html"}], "extent": [843, 866]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/trim", "type": "link", "text": "", "fullpath": "/nodes/cop2/trim.html"}], "extent": [866, 890]}], "container": true}], "text": "Related"}], "title": ["Shuffle"], "summary": ["Shuffle frames around to do out-of-order editing."], "included": ["/composite/_old_cops_deprecated"]}