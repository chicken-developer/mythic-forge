{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "interleave", "icon": "COP2/shuffle", "since": "11.0", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Interleave"], "extent": [94, 109]}, {"type": "summary", "indent": 0, "text": ["Interleaves image sequences."], "extent": [109, 146]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Interleave will take two to four image sequences and interleave them.  The\nresulting image sequence will have the same start frame as the first of the\ninputs.  The additional inputs will be trimmed to match the first input.  The\nresulting sequence will be the total length of all the inputs, after trimming."], "extent": [189, 498]}, {"type": "para", "indent": 0, "text": ["For example, if you have two inputs, one ABCDE and the other 12345, the result of interleave will be A1B2C3D4E5."], "extent": [498, 612]}, {"type": "para", "indent": 0, "text": ["This is useful to prepare sequences for the ", {"scheme": "Node", "value": "/nodes/cop2/mosaic", "type": "link", "text": ["Mosaic COP"], "fullpath": "/nodes/cop2/mosaic.html"}, "."], "extent": [612, 688]}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [688, 697], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/mosaic", "type": "link", "text": "", "fullpath": "/nodes/cop2/mosaic.html"}], "extent": [697, 723]}], "container": true}], "text": "Related"}], "title": ["Interleave"], "summary": ["Interleaves image sequences."], "included": ["/composite/_old_cops_deprecated"]}