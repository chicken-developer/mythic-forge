{"type": "root", "attrs": {"type": "include"}, "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Source"], "extent": [16, 24], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Source Type"]}, " is ", {"type": "ui", "text": ["Primitive"]}, ", the scene graph path to the prim to use."], "extent": [41, 126]}], "container": true, "attrs": {"id": "source"}}, {"type": "dt", "indent": 0, "text": ["Source Instances"], "extent": [126, 144], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Source Type"]}, " is ", {"type": "ui", "text": ["PointInstancer"]}, ", the point instance to use, using ", {"type": "code", "text": ["/", {"type": "var", "text": ["path"]}, "[", {"type": "var", "text": ["instance_index"]}, "]"]}, " syntax (for example, ", {"type": "code", "text": ["/geometry/instancer[1]"]}, ")."], "extent": [170, 332]}], "container": true, "attrs": {"id": "sourceinstances"}}, {"type": "dt", "indent": 0, "text": ["Target"], "extent": [332, 340], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Target Type"]}, " is ", {"type": "ui", "text": ["Primitive"]}, ", the scene graph path to the prim to use."], "extent": [357, 442]}], "container": true, "attrs": {"id": "target"}}, {"type": "dt", "indent": 0, "text": ["Target Instance"], "extent": [442, 459], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Target Type"]}, " is ", {"type": "ui", "text": ["PointInstancer"]}, ", the point instance to use, using ", {"type": "code", "text": ["/", {"type": "var", "text": ["path"]}, "[", {"type": "var", "text": ["instance_index"]}, "]"]}, " syntax (for example, ", {"type": "code", "text": ["/geometry/instancer[1]"]}, ")."], "extent": [484, 646]}], "container": true, "attrs": {"id": "targetinstance"}}, {"type": "dt", "indent": 0, "text": ["Hide Target"], "extent": [646, 659], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Target Source"]}, " is ", {"type": "ui", "text": ["First Input"]}, " and ", {"type": "ui", "text": ["Type"]}, " is ", {"type": "ui", "text": ["Primitive"]}, ", whether to hide set the path\u2019s visibility to ", {"type": "q", "text": ["hidden"]}, "."], "extent": [680, 813]}], "container": true, "attrs": {"id": "hidetarget"}}, {"type": "dt", "indent": 0, "text": ["Import Time"], "extent": [813, 826], "body": [{"type": "para", "indent": 4, "text": ["Specify the frame at which the source and/or target geometry are imported into the embedded SOP network to build the constraints."], "extent": [847, 986]}, {"type": "para", "indent": 4, "text": ["The default ", {"type": "code", "text": ["$FF"]}, " expression forces the constraint LOP to be time dependent, which is needed when operating on a non time-dependent\n    network that has time samples driving the source or target primitives."], "extent": [986, 1202]}, {"type": "para", "indent": 4, "text": ["However, for better performance with a non time-dependent network with no time samples, it is recommended to use a static value instead."], "extent": [1202, 1345]}], "container": true, "attrs": {"id": "importtime"}}], "container": true}, {"level": 2, "id": "about", "container": true, "type": "h", "indent": 0, "text": ["Solaris constraints"], "extent": [1345, 1379], "body": [{"type": "para", "indent": 0, "text": ["Currently, USD does not support constraints. Parametric constraints are probably antithetical to USD\u2019s design mission of being descriptive, immutable, and idempotent."], "extent": [1379, 1548]}, {"type": "para", "indent": 0, "text": ["As a layer above USD, that generates USD, the LOP network can compute dynamic constraints, and ", {"type": "q", "text": ["bake"]}, " the results as time samples when it writes the USD to disk."], "extent": [1548, 1709]}]}]}