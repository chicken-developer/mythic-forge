{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "layoutbrushmove", "icon": "SOP/layoutbrushmove", "tags": "paintinstancesbrush", "allow_hidden": "true", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Nudge (Paint Instances brush)"], "extent": [0, 34]}, {"type": "summary", "indent": 0, "text": ["Translates assets as you brush over them."], "extent": [162, 211]}, {"type": "box_group", "body": [{"ext": null, "type": "box", "indent": 0, "role": "item", "extent": [16, 22], "body": [{"type": "para", "indent": 4, "text": ["This node is designed to customize the behavior of the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["Paint Instances LOP"], "fullpath": "/nodes/lop/paintinstances.html"}, ". See the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["help for Paint Instances"], "fullpath": "/nodes/lop/paintinstances.html"}, " for more information."], "extent": [51, 238]}], "container": true, "attrs": {"id": "see_paintinstances"}}], "container": true, "role": "item_group"}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [262, 268], "body": [{"type": "para", "indent": 4, "text": ["This brush can only affect assets that were added in the current Paint Instances node."], "extent": [268, 360]}], "container": true}], "container": true, "role": "item_group"}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [360, 365], "body": [{"type": "para", "indent": 4, "text": ["When moving in screen space, you can easily move assets off the ground plane if you're not working in an orthographic view (the brush does not automatically snap to the XZ plane or construction plane or anything like that). If the input has a ", {"type": "q", "text": ["ground"]}, " surface, you can turn on ", {"type": "ui", "text": ["Snap to geometry"]}, " to keep the assets snapped to the ground."], "extent": [365, 711]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [711, 723], "body": [{"level": 3, "type": "sep", "indent": 0, "text": [" Brush "], "extent": [723, 738]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [738, 747], "body": [{"type": "para", "indent": 4, "text": ["Radius of the nudge brush."], "extent": [764, 796]}], "container": true, "attrs": {"id": "radius"}, "role": "item"}], "container": true, "role": "item_group"}, {"type": "include_group", "body": [{"ext": "_paintinstancesbrushes#mode", "type": "include", "indent": 0, "role": "item", "extent": [796, 836]}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Intersection "], "extent": [836, 857]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Snap To Geometry"], "extent": [857, 876], "body": [{"type": "para", "indent": 4, "text": ["Snap the nudged assets to geometry controlled by the ", {"type": "ui", "text": ["Mode"]}, " parameter below: the input geometry (usually the ground), existing assets placed by the current Paint Instances node, or both."], "extent": [896, 1090]}], "container": true, "attrs": {"id": "snaptogeo"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Mode"], "extent": [1090, 1096], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Snap To Geometry"]}, " is on, whether the assets should snap to the input geometry (usually the ground), existing assets placed by the current Paint Instances node, or both."], "extent": [1123, 1306]}], "container": true, "attrs": {"id": "intersectionmode"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1306, 1315], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": "", "fullpath": "/nodes/lop/paintinstances.html"}], "extent": [1315, 1344]}], "container": true}], "text": "Related"}], "title": ["Nudge (Paint Instances brush)"], "summary": ["Translates assets as you brush over them."], "included": ["/nodes/sop/_paintinstancesbrush"]}