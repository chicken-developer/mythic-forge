{"type": "root", "attrs": {"type": "node", "context": "lop", "internal": "editlayer_begin", "icon": "LOP/editlayer_begin", "since": "21.0", "allow_hidden": "true", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Edit Layer Block"], "extent": [0, 21]}, {"type": "summary", "indent": 0, "text": ["Sets the targeted layer as the current edit target."], "extent": [144, 204]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [204, 219], "body": [{"type": "para", "indent": 0, "text": ["The Edit Layer Block allows you to specify the layer you want all edits within the block to go to.  At the end of the block the edit target is reset back to the top of the layer stack, as usual."], "extent": [219, 416]}, {"type": "para", "indent": 0, "text": ["Only sublayers in the local sublayer stack are available to be targeted."], "extent": [416, 490]}, {"type": "para", "indent": 0, "text": ["Edit Layer Blocks can be nested, with inner blocks only being able to target sublayers of their containing block."], "extent": [490, 606]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["How to"], "extent": [606, 619], "body": [{"type": "task_group", "body": [{"ext": null, "type": "task", "indent": 0, "text": [" Edit a Specific SubLayer"], "role": "item", "extent": [619, 654], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": ["Add an Edit Layer Block to your network."], "extent": [654, 702]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Specify the ", {"type": "ui", "text": ["Target Layer"]}, "."], "extent": [702, 739]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Add more nodes between the ", {"type": "ui", "text": ["Edit Layer Begin"]}, " and ", {"type": "ui", "text": ["Edit Layer End"]}, " nodes to edit the ", {"type": "ui", "text": ["Target Layer"]}], "extent": [739, 852]}], "container": true}], "container": true}], "container": true, "role": "item_group"}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [852, 864], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Target Layer"], "extent": [864, 879], "body": [{"type": "para", "indent": 4, "text": ["This parameter sets the target layer for edits within the Edit Layer Block.  If there this node in another Edit Layer Block, then this can be any layer in the local sublayer stack.  Otherwise, it must be a sublayer, or descendent sublayer, of the current active layer."], "extent": [901, 1175]}], "container": true, "attrs": {"id": "targetlayer"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Parent Layer"], "extent": [1175, 1189], "body": [{"type": "para", "indent": 4, "text": ["With ", {"type": "ui", "text": ["Create New Layer"]}, " on, this specifies the layer in which to make the new 'target' layer a sublayer of."], "extent": [1211, 1326]}], "container": true, "attrs": {"id": "parentlayer"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clear Source Layer"], "extent": [1326, 1346], "body": [{"type": "para", "indent": 4, "text": ["Whether to clear the incoming source layer.  With this on, the targeted layer will be cleared of any existing USD data.  If this is off, the targeted layer will keep all of it\u2019s USD data, applying edits overtop."], "extent": [1373, 1590]}], "container": true, "attrs": {"id": "clearsourcelayer"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Create New Layer"], "extent": [1590, 1608], "body": [{"type": "para", "indent": 4, "text": ["Turning this parameter on will create a new layer, as a sublayer of the specified ", {"type": "ui", "text": ["Parent Layer"]}, ".  This new layer will become the active edit target for the block."], "extent": [1633, 1804]}], "container": true, "attrs": {"id": "createnewlayer"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["New Layer Index"], "extent": [1804, 1821], "body": [{"type": "para", "indent": 4, "text": ["With ", {"type": "ui", "text": ["createnewlayer"]}, " on this specifies the index in the ", {"type": "ui", "text": ["Parent Layer"]}, "'s sublayer list at which to add the new layer."], "extent": [1845, 1973]}], "container": true, "attrs": {"id": "newlayerindex"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["New Layer"], "extent": [1973, 1984], "body": [{"type": "para", "indent": 4, "text": ["With ", {"type": "ui", "text": ["createnewlayer"]}, " on this specifies the ", {"type": "ui", "text": ["output path"]}, " for the newly created layer."], "extent": [2002, 2098]}], "container": true, "attrs": {"id": "newlayer"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2098, 2107], "body": [{"type": "related_item_group", "body": [{"ext": null, "type": "related_item", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/shotlayeredit", "type": "link", "text": "", "fullpath": "/nodes/lop/shotlayeredit.html"}], "role": "item", "extent": [2107, 2135]}, {"ext": null, "type": "related_item", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/edittargetlayer", "type": "link", "text": "", "fullpath": "/nodes/lop/edittargetlayer.html"}], "role": "item", "extent": [2135, 2163]}], "container": true, "role": "item_group"}], "text": "Related"}], "title": ["Edit Layer Block"], "summary": ["Sets the targeted layer as the current edit target."]}