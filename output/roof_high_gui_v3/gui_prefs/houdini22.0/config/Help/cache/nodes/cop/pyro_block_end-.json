{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_block_end", "icon": "COP/pyro_block_end", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Block End"], "extent": [104, 123]}, {"type": "summary", "indent": 0, "text": ["End of a Pyro simulation block."], "extent": [123, 163]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [163, 169], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [169, 389]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This node marks the end of a Pyro simulation block."], "extent": [389, 442]}, {"type": "para", "indent": 0, "text": ["It should be paired with a ", {"scheme": "Node", "value": "/nodes/cop/pyro_block_begin", "type": "link", "text": ["Pyro Block Begin COP"], "fullpath": "/nodes/cop/pyro_block_begin.html"}, ".  "], "extent": [442, 522]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [522, 528], "body": [{"type": "para", "indent": 0, "text": ["Compiled COP networks don\u2019t support simulation."], "extent": [53, 103]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [579, 591], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Reset Simulation"], "extent": [591, 610], "body": [{"type": "para", "indent": 4, "text": ["Clears the entire simulation cache."], "extent": [635, 680]}], "container": true, "attrs": {"id": "resimulate"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Start Frame"], "extent": [680, 693], "body": [{"type": "para", "indent": 4, "text": ["The frame on the Houdini playbar where the simulation starts."], "extent": [718, 789]}], "container": true, "attrs": {"id": "startframe"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Simulation"], "extent": [789, 806], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Correct Collisions"], "extent": [806, 827], "body": [{"type": "para", "indent": 4, "text": ["Zero out the density and temperature that are inside the collision SDF, avoiding any leaking of smoke."], "extent": [854, 971]}], "container": true, "attrs": {"id": "correctcollision"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Output Velocity Corrected by Timescale"], "extent": [971, 1011], "body": [{"type": "para", "indent": 4, "text": ["The output velocity VDB ", {"type": "code", "text": ["v"]}, " will be scaled by timescale, ensuring it will motion blur correctly.  However, if this is to be used by another simulation, you may want the raw velocity values."], "extent": [1047, 1251]}], "container": true, "attrs": {"id": "correctvelocity_timescale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Output Velocity Corrected by Ambient"], "extent": [1251, 1289], "body": [{"type": "para", "indent": 4, "text": ["The output velocity VDB ", {"type": "code", "text": ["v"]}, " will be adjusted by ambient velocity, ensuring it will motion blur correctly.  However, if this is to be used by another simulation, you may want the raw velocity values."], "extent": [1323, 1536]}], "container": true, "attrs": {"id": "correctvelocity_ambient"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Ambient Velocity"], "extent": [1536, 1554], "body": [{"type": "para", "indent": 4, "text": ["A global ambient velocity that the simulation operates within.\n    All the fields will advect with this velocity, allowing it to provide a global wind effect that can be directly keyframed.  However, the actual velocity VDB doesn\u2019t contain this."], "extent": [1572, 1832]}], "container": true, "attrs": {"id": "ambient"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Time Scale"], "extent": [1832, 1844], "body": [{"type": "para", "indent": 4, "text": ["The amount to scale the time inside the block. A value of ", {"type": "code", "text": ["1"]}, " maintains the normal speed, a value greater than ", {"type": "code", "text": ["1"]}, " speeds up the simulation, and a value less than ", {"type": "code", "text": ["1"]}, " slows down the simulation."], "extent": [1868, 2071]}], "container": true, "attrs": {"id": "timescale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Substeps"], "extent": [2071, 2081], "body": [{"type": "para", "indent": 4, "text": ["Each frame is broken into a series of substeps.  This can give more accurate results for fast moving simulations, but at the cost of increased time."], "extent": [2100, 2258]}], "container": true, "attrs": {"id": "substeps"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Live Simulation"], "extent": [2258, 2275], "body": [{"type": "para", "indent": 4, "text": ["Turns on live simulation to provide an interactive, non-deterministic simulation mode. It simulates independent of the playbar and isn\u2019t associated with any keyframes or caching."], "extent": [2300, 2488]}, {"type": "para", "indent": 4, "text": ["This parameter (and its associated parameters) is intended as a sandbox mode where you don\u2019t have to rely on the playbar."], "extent": [2488, 2615]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 4, "role": "item", "extent": [2615, 2624], "body": [{"type": "para", "indent": 8, "text": [{"type": "ui", "text": ["Live Simulation"]}, " doesn\u2019t save the results like other simulation types in Houdini, so use a ", {"scheme": "Node", "value": "/nodes/cop/stash", "type": "link", "text": ["Stash\n        COP"], "fullpath": "/nodes/cop/stash.html"}, " to save results."], "extent": [2624, 2779]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "continuouscook"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Time Scale"], "extent": [2779, 2791], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Simulate"]}, " is on, this is the amount to scale the time inside the block. A value of ", {"type": "code", "text": ["1"]}, " maintains the normal speed, a value greater than ", {"type": "code", "text": ["1"]}, " speeds up the simulation, and a value less than ", {"type": "code", "text": ["1"]}, " slows down the simulation."], "extent": [2811, 3043]}], "container": true, "attrs": {"id": "timescale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Toggle Live Simulation"], "extent": [3043, 3067], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Live Simulation"]}, " is on, this lets you pause and resume the live simulation."], "extent": [3103, 3196]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 4, "role": "item", "extent": [3196, 3205], "body": [{"type": "para", "indent": 8, "text": ["You can also use the ", {"scheme": "Icon", "value": "BUTTONS/live_disable", "type": "link", "text": "", "fullpath": "/nodes/cop/BUTTONS/live_disable.html"}, " Live Simulation button to pause and resume live simulation. See ", {"scheme": null, "value": "/basics/cooking#cooking-controls", "type": "link", "text": ["Cooking controls"], "fullpath": "/basics/cooking.html#cooking-controls", "fragment": "#cooking-controls"}, " for more information."], "extent": [3205, 3410]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "continuouscook_toggle"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Live Tick"], "extent": [3410, 3421], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Live Simulation"]}, " is on, this is the current tick (frame) within the live simulation."], "extent": [3455, 3557]}], "container": true, "attrs": {"id": "continuouscook_tick"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Cache Simulation"], "extent": [3557, 3582], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Cache Simulation"], "extent": [3582, 3601], "body": [{"type": "para", "indent": 4, "text": ["Enables the caching of the simulation.  If the simulation is uncached, it will always have to\n    cook from the start frame on any new frame."], "extent": [3628, 3779]}], "container": true, "attrs": {"id": "cacheenabled"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Cached Frames"], "extent": [3779, 3794], "body": [{"type": "para", "indent": 4, "text": ["How many frames behind the current frame to keep cached."], "extent": [3821, 3887]}], "container": true, "attrs": {"id": "cachedframes"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Checkpoint Rate"], "extent": [3887, 3904], "body": [{"type": "para", "indent": 4, "text": ["The rate at which the node continually caches a single frame."], "extent": [3935, 4006]}, {"type": "para", "indent": 4, "text": ["For example, set this to ", {"type": "code", "text": ["24"]}, " to cache frames ", {"type": "code", "text": ["24"]}, ", ", {"type": "code", "text": ["48"]}, ", ", {"type": "code", "text": ["72"]}, ", and such.  This allows random-scrubbing to be faster as it only has to re-cook from the checkpoint frame."], "extent": [4006, 4181]}, {"type": "para", "indent": 4, "text": ["Set to ", {"type": "code", "text": ["0"]}, " to turn off checkpointing."], "extent": [4181, 4228]}], "container": true, "attrs": {"id": "checkpointframes"}, "role": "item"}], "container": true, "role": "item_group"}]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Pressure Projection"], "extent": [4228, 4254], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Iterations"], "extent": [4254, 4267], "body": [{"type": "para", "indent": 4, "text": ["The projection process is repeated this number of times.\n    Increased iterations takes longer, but will produce a more accurate result.  It will also increase the faithfulness of the collision operation."], "extent": [4292, 4506]}], "container": true, "attrs": {"id": "iterations"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Voxel Kernel Size"], "extent": [4506, 4525], "body": [{"type": "para", "indent": 4, "text": ["Size of the kernel to apply at the voxel size.  Larger will be higher quality but at a rapidly increasing cost in time."], "extent": [4546, 4675]}], "container": true, "attrs": {"id": "kernel"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Double Voxel Pass"], "extent": [4675, 4694], "body": [{"type": "para", "indent": 4, "text": ["Apply two voxel kernel passes before performing a block pass."], "extent": [4720, 4791]}], "container": true, "attrs": {"id": "doublevoxel"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Block Pass"], "extent": [4791, 4803], "body": [{"type": "para", "indent": 4, "text": ["Enable the block pass.  In this pass, divergence is reduced to dipoles in large blocks, allowing action at distance without having to increase the voxel kernel size."], "extent": [4826, 5001]}], "container": true, "attrs": {"id": "useblock"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Block Kernel Size"], "extent": [5001, 5020], "body": [{"type": "para", "indent": 4, "text": ["The size, in blocks, to accumulate the surrounding block\u2019s dipoles when updating a voxel. Larger will be higher quality but at a rapidly increasing cost in time."], "extent": [5043, 5214]}], "container": true, "attrs": {"id": "blockrad"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Feather Blocks"], "extent": [5214, 5230], "body": [{"type": "para", "indent": 4, "text": ["Reduce the strength of the block correction over the farthest blocks.  This avoids sharp transitions in the corrected velocity if there are strong impulses, but will require more iterations or time to correct divergence fully."], "extent": [5253, 5489]}], "container": true, "attrs": {"id": "blockfeather"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Point Pass"], "extent": [5489, 5501], "body": [{"type": "para", "indent": 4, "text": ["Combine the block dipoles into an even coarser set of points.\n    These are then applied to every voxel.  This ensures global effect of divergence in a single pass."], "extent": [5524, 5698]}], "container": true, "attrs": {"id": "usepoint"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Hourglass Filter"], "extent": [5698, 5716], "body": [{"type": "para", "indent": 4, "text": ["Projecting using corner-sampled divergences can miss certain modes of the velocity.   The hourglass filter applies a smoothing operation to ensure these are correctly filtered; this can reduce jaggy artifacts."], "extent": [5736, 5960]}], "container": true, "attrs": {"id": "hourglass"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [5960, 5968], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["density"], "extent": [5968, 5981], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB of the current voxel densities, fedback to the input."], "extent": [5981, 6056]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [6056, 6063], "body": [{"type": "para", "indent": 8, "text": ["A Vector VDB of the current voxel velocities.  This is projected to a non-divergent values and fedback to the input."], "extent": [6063, 6189]}], "container": true}, {"type": "dt", "indent": 4, "text": ["temperature"], "extent": [6189, 6206], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB of the current voxel temperatures, fedback to the input."], "extent": [6206, 6284]}], "container": true}, {"type": "dt", "indent": 4, "text": ["feedback"], "extent": [6284, 6298], "body": [{"type": "para", "indent": 8, "text": ["A Cable of the current feedback data.  This is fedback to the input.  The structure of this cable must match the initial structure provided on the block begin."], "extent": [6298, 6467]}], "container": true}, {"type": "dt", "indent": 4, "text": ["divergence"], "extent": [6467, 6483], "body": [{"type": "para", "indent": 8, "text": ["An optional Float VDB providing a goal divergence for the velocity, allowing the fluid to expand or contract."], "extent": [6483, 6602]}], "container": true}, {"type": "dt", "indent": 4, "text": ["collision"], "extent": [6602, 6617], "body": [{"type": "para", "indent": 8, "text": ["An optional Float VDB providing a signed distance field (SDF) of a collider. Negative voxels will act like colliders."], "extent": [6617, 6744]}], "container": true}, {"type": "dt", "indent": 4, "text": ["collisionv"], "extent": [6744, 6760], "body": [{"type": "para", "indent": 8, "text": ["An optional Vector VDB providing a velocity of the collision objects.  These are in world space, so will be internally adjusted by ", {"type": "ui", "text": ["Ambient Velocity"]}, "."], "extent": [6760, 6922]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [6922, 6931], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["density"], "extent": [6931, 6944], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB of the current voxel densities."], "extent": [6944, 6997]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [6997, 7004], "body": [{"type": "para", "indent": 8, "text": ["A Vector VDB of the current voxel velocities.  This may have been optional adjusted by timescale and ambient velocity."], "extent": [7004, 7132]}], "container": true}, {"type": "dt", "indent": 4, "text": ["temperature"], "extent": [7132, 7149], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB of the current voxel temperatures."], "extent": [7149, 7205]}], "container": true}, {"type": "dt", "indent": 4, "text": ["feedback"], "extent": [7205, 7219], "body": [{"type": "para", "indent": 8, "text": ["A Cable of the current feedback data."], "extent": [7219, 7266]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [7266, 7275], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_block_begin", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_block_begin.html"}], "extent": [7275, 7305]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_configure", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_configure.html"}], "extent": [7305, 7334]}], "container": true}], "text": "Related"}], "title": ["Pyro Block End"], "summary": ["End of a Pyro simulation block."], "included": ["/copernicus/_common_notes"]}