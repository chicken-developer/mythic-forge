{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "layer", "icon": "COP2/layer", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Layer"], "extent": [74, 84]}, {"type": "summary", "indent": 0, "text": ["Layers a series of inputs together by compositing them one by one on\nthe background image (input 1)."], "extent": [84, 193]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation does a series of composite operations (over, under,\ninside, add, etc.) on the background image (input 1) using the foreground\nimages (inputs 2 and up). The compositing operation may be changed per\nforeground input, and each foreground input has its own transform. The\nfirst input is always the background image, and subsequent inputs are\ncomposited in order. The size of the resulting image is the size of the\nbackground image."], "extent": [236, 680]}, {"type": "para", "indent": 0, "text": ["In the case of an over, the result image is:"], "extent": [680, 726]}, {"lang": null, "type": "pre", "indent": 0, "text": ["\n4 over (3 over (2 over 1))\n"], "extent": [726, 761]}, {"type": "para", "indent": 0, "text": ["for four inputs, 1 to 4."], "extent": [761, 788]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [788, 793], "body": [{"type": "para", "indent": 4, "text": ["Tip: For a more traditional A over B method, use the ", {"scheme": "Node", "value": "/nodes/cop2/composite", "type": "link", "text": ["Composite\n    COP"], "fullpath": "/nodes/cop2/composite.html"}, "."], "extent": [793, 893]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [893, 905], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Composite"], "extent": [905, 926], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Operation"], "extent": [926, 946], "body": [{"type": "para", "indent": 12, "text": ["Specifies the global compositing operation:"], "extent": [946, 1003]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Over"], "extent": [1003, 1021], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground over the background."], "extent": [1021, 1080]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Under"], "extent": [1080, 1099], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground under the background\u2019s alpha."], "extent": [1099, 1167]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Atop"], "extent": [1167, 1185], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground over the background only where the\n                background alpha exists."], "extent": [1185, 1299]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Inside"], "extent": [1299, 1319], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground inside the background\u2019s alpha."], "extent": [1319, 1388]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Outside"], "extent": [1388, 1409], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground outside the background\u2019s alpha."], "extent": [1409, 1479]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Screen"], "extent": [1479, 1499], "body": [{"type": "para", "indent": 16, "text": ["Acts as a saturating add, much like photographic\n                addition."], "extent": [1499, 1590]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Add"], "extent": [1590, 1607], "body": [{"type": "para", "indent": 16, "text": ["Adds the foreground to the background."], "extent": [1607, 1662]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Subtract"], "extent": [1662, 1684], "body": [{"type": "para", "indent": 16, "text": ["Subtracts the foreground from the background."], "extent": [1684, 1746]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Diff"], "extent": [1746, 1764], "body": [{"type": "para", "indent": 16, "text": ["Takes the absolute difference between the foreground and\n                the background."], "extent": [1764, 1869]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Multiply"], "extent": [1869, 1891], "body": [{"type": "para", "indent": 16, "text": ["Multiplies the background by the foreground."], "extent": [1891, 1952]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Minimum"], "extent": [1952, 1973], "body": [{"type": "para", "indent": 16, "text": ["Takes the minimum of the foreground and background."], "extent": [1973, 2041]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Maximum"], "extent": [2041, 2062], "body": [{"type": "para", "indent": 16, "text": ["Takes the maximum of the foreground and background."], "extent": [2062, 2130]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Average"], "extent": [2130, 2151], "body": [{"type": "para", "indent": 16, "text": ["Takes the average of the foreground and background."], "extent": [2151, 2219]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Xor"], "extent": [2219, 2236], "body": [{"type": "para", "indent": 16, "text": ["Takes the exclusive or of the two alpha planes, so that\n                alpha areas that overlap are removed."], "extent": [2236, 2362]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Alpha Operation"], "extent": [2362, 2387], "body": [{"type": "para", "indent": 12, "text": ["Specifies the compositing operation for the alpha plane,\n            which is normally the same as the global compositing\n            operations (see above)."], "extent": [2387, 2557]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Units"], "extent": [2557, 2578], "body": [{"type": "para", "indent": 12, "text": ["Selects pixels or UV units for the transforms."], "extent": [2578, 2637]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Filter"], "extent": [2637, 2659], "body": [{"type": "para", "indent": 12, "text": ["Specifies the filter to use when transforming."], "extent": [2659, 2718]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur"], "extent": [2718, 2739], "body": [{"type": "para", "indent": 12, "text": ["Toggles on motion blur, and specifies the time range around\n            the current frame to blur."], "extent": [2739, 2850]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Frame Bias"], "extent": [2850, 2877], "body": [{"type": "para", "indent": 12, "text": ["Shifts the time range for the blur."], "extent": [2877, 2925]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Segments"], "extent": [2925, 2955], "body": [{"type": "para", "indent": 12, "text": ["Number of samples to blur together in the specified time\n            range."], "extent": [2955, 3043]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Method"], "extent": [3043, 3072], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Velocity"], "extent": [3072, 3094], "body": [{"type": "para", "indent": 16, "text": ["Only uses the current frame and the transform to compute\n                past and future positions."], "extent": [3094, 3210]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Deformation"], "extent": [3210, 3235], "body": [{"type": "para", "indent": 16, "text": ["Cooks the images at all time samples."], "extent": [3235, 3290]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Transform (1 set per foreground input)"], "extent": [3290, 3339], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Operation"], "extent": [3339, 3359], "body": [{"type": "para", "indent": 12, "text": ["Specifies the composite operation for this input. The\n            default compositing operation is ", {"type": "q", "text": ["global"]}, " which uses the\n            operation specified on the Layer page."], "extent": [3359, 3545]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Alpha Operation"], "extent": [3545, 3570], "body": [{"type": "para", "indent": 12, "text": ["Specifies the composite operation for the alpha channel of\n            this input. By default, this input\u2019s compositing operation\n            is used (which also may point to the global compositing\n            operation)."], "extent": [3570, 3804]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Wrap"], "extent": [3804, 3824], "body": [{"type": "para", "indent": 12, "text": ["What this input shows when data outside its image bounds is\n            needed."], "extent": [3824, 3917]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Repeat"], "extent": [3917, 3937], "body": [{"type": "para", "indent": 16, "text": ["Repeat the image again, as if tiled."], "extent": [3937, 3990]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Clamp"], "extent": [3990, 4009], "body": [{"type": "para", "indent": 16, "text": ["Holds the edge pixels' values (useful for ramps)."], "extent": [4009, 4075]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Decal"], "extent": [4075, 4094], "body": [{"type": "para", "indent": 16, "text": ["Use black and zero alpha."], "extent": [4094, 4136]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Mirror"], "extent": [4136, 4156], "body": [{"type": "para", "indent": 16, "text": ["Repeat the image again, reversing it every other time."], "extent": [4156, 4227]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Translate, Rotate, Scale, Pivot"], "extent": [4227, 4268], "body": [{"type": "para", "indent": 12, "text": ["Transforms this foreground in X,Y relative to the\n            background."], "extent": [4268, 4355]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Merge"], "extent": [4355, 4371], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Overview"], "extent": [4371, 4390], "body": [{"type": "para", "indent": 12, "text": ["These parameters specify how to build the output sequence\n            when there are differences between the input sequences."], "extent": [4390, 4528]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Plane Merge"], "extent": [4528, 4549], "body": [{"type": "para", "indent": 12, "text": ["If the planes in the inputs differ, this specifies what the\n            output planes should be."], "extent": [4549, 4658]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Raster Depth"], "extent": [4658, 4680], "body": [{"type": "para", "indent": 12, "text": ["If the raster depth for a given plane differs between\n            inputs, this specifies what the output raster depth for the\n            plane should be."], "extent": [4680, 4847]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [4847, 4868], "body": [{"type": "para", "indent": 12, "text": ["If the frame ranges of the inputs differ, this determines\n            what the output range should be."], "extent": [4868, 4983]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Rate"], "extent": [4983, 5003], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            what the output frame rate should be."], "extent": [5003, 5122]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Match"], "extent": [5122, 5143], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            which input frame to pick when the cook time doesn\u2019t reside\n            on a frame boundary."], "extent": [5143, 5317]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [5317, 5325], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [5351, 5360], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/composite", "type": "link", "text": "", "fullpath": "/nodes/cop2/composite.html"}], "extent": [5360, 5388]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/add", "type": "link", "text": "", "fullpath": "/nodes/cop2/add.html"}], "extent": [5388, 5410]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/atop", "type": "link", "text": "", "fullpath": "/nodes/cop2/atop.html"}], "extent": [5410, 5433]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/average", "type": "link", "text": "", "fullpath": "/nodes/cop2/average.html"}], "extent": [5433, 5459]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/diff", "type": "link", "text": "", "fullpath": "/nodes/cop2/diff.html"}], "extent": [5459, 5482]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/inside", "type": "link", "text": "", "fullpath": "/nodes/cop2/inside.html"}], "extent": [5482, 5507]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/max", "type": "link", "text": "", "fullpath": "/nodes/cop2/max.html"}], "extent": [5507, 5529]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/min", "type": "link", "text": "", "fullpath": "/nodes/cop2/min.html"}], "extent": [5529, 5551]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/over", "type": "link", "text": "", "fullpath": "/nodes/cop2/over.html"}], "extent": [5551, 5574]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/screen", "type": "link", "text": "", "fullpath": "/nodes/cop2/screen.html"}], "extent": [5574, 5599]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/subtract", "type": "link", "text": "", "fullpath": "/nodes/cop2/subtract.html"}], "extent": [5599, 5626]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/under", "type": "link", "text": "", "fullpath": "/nodes/cop2/under.html"}], "extent": [5626, 5650]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/xor", "type": "link", "text": "", "fullpath": "/nodes/cop2/xor.html"}], "extent": [5650, 5673]}], "container": true}], "text": "Related"}], "title": ["Layer"], "summary": ["Layers a series of inputs together by compositing them one by one on\nthe background image (input 1)."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}