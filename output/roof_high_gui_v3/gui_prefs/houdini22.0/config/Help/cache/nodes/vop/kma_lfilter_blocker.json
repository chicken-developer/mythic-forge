{"type": "root", "attrs": {"type": "node", "context": "vop", "internal": "kma_lfilter_blocker", "icon": "VOP/kma_lfilter_blocker", "since": "22.0", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Karma Light Filter Blocker"], "extent": [0, 31]}, {"type": "summary", "indent": 0, "text": ["Karma Light Filter that blocks or shapes portions of a light using simple blocker volumes."], "extent": [134, 233]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [233, 248], "body": [{"type": "para", "indent": 0, "text": ["A light filter prim can be assigned to a light to modify the light rays sent by the light. See ", {"scheme": null, "value": "/solaris/support/light_filters", "type": "link", "text": ["Karma light filters"], "fullpath": "/solaris/support/light_filters.html"}, " for more information."], "extent": [248, 420]}, {"type": "para", "indent": 0, "text": ["This filter uses simple geometric blocker shapes to remove or reduce light contribution in parts of the beam. You can use it to art direct cutoffs and shadowing with spherical, capsule, or box-shaped blockers."], "extent": [420, 631]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [631, 636], "body": [{"type": "para", "indent": 4, "text": ["You can find more information on how to apply light filters in general on the ", {"scheme": null, "value": "/solaris/support/light_filters", "type": "link", "text": ["Karma light filters"], "fullpath": "/solaris/support/light_filters.html"}, " support page."], "extent": [636, 786]}], "container": true}], "container": true, "role": "item_group"}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [786, 798], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Intensity"], "extent": [798, 810], "body": [{"type": "para", "indent": 4, "text": ["Scales the intensity of the light source."], "extent": [830, 877]}], "container": true, "attrs": {"id": "intensity"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Exposure"], "extent": [877, 887], "body": [{"type": "para", "indent": 4, "text": ["Adjusts the exposure of the light source."], "extent": [906, 953]}], "container": true, "attrs": {"id": "exposure"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Tint"], "extent": [953, 959], "body": [{"type": "para", "indent": 4, "text": ["Multiplies the resulting light by this color."], "extent": [974, 1025]}], "container": true, "attrs": {"id": "tint"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Invert Blockers"], "extent": [1025, 1042], "body": [{"type": "para", "indent": 4, "text": ["Inverts the effect so the blocker shape defines the area where light is allowed through instead of the area that is blocked."], "extent": [1059, 1189]}], "container": true, "attrs": {"id": "invert"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Shape"], "extent": [1189, 1196], "body": [{"type": "para", "indent": 4, "text": ["The blocker shape to use."], "extent": [1212, 1243]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Sphere"], "extent": [1243, 1255], "body": [{"type": "para", "indent": 8, "text": ["Uses a spherical blocker volume."], "extent": [1255, 1297]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Capsule"], "extent": [1297, 1310], "body": [{"type": "para", "indent": 8, "text": ["Uses a capsule-shaped blocker volume."], "extent": [1310, 1357]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Box"], "extent": [1357, 1366], "body": [{"type": "para", "indent": 8, "text": ["Uses a box-shaped blocker volume."], "extent": [1366, 1409]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "shape"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [1409, 1417], "body": [{"type": "para", "indent": 4, "text": ["The radius of the spherical or capsule blocker."], "extent": [1434, 1487]}], "container": true, "attrs": {"id": "radius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Width"], "extent": [1487, 1494], "body": [{"type": "para", "indent": 4, "text": ["The width of the box blocker."], "extent": [1510, 1545]}], "container": true, "attrs": {"id": "width"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Height"], "extent": [1545, 1553], "body": [{"type": "para", "indent": 4, "text": ["The height of the box or capsule blocker."], "extent": [1570, 1617]}], "container": true, "attrs": {"id": "height"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Depth"], "extent": [1617, 1624], "body": [{"type": "para", "indent": 4, "text": ["The depth of the box blocker."], "extent": [1640, 1675]}], "container": true, "attrs": {"id": "depth"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rounded Corner"], "extent": [1675, 1691], "body": [{"type": "para", "indent": 4, "text": ["Rounds the corners of the box blocker. Higher values produce softer, more beveled box edges."], "extent": [1715, 1813]}], "container": true, "attrs": {"id": "roundedcorner"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Falloff"], "extent": [1813, 1822], "body": [{"type": "para", "indent": 4, "text": ["Softens the blocker edge. Higher values create a broader transition between blocked and unblocked regions."], "extent": [1840, 1953]}], "container": true, "attrs": {"id": "falloff"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1953, 1962], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/vop/kma_lfilter_gel", "type": "link", "text": "", "fullpath": "/nodes/vop/kma_lfilter_gel.html"}], "extent": [1962, 1992]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/vop/kma_lfilter_gobo", "type": "link", "text": "", "fullpath": "/nodes/vop/kma_lfilter_gobo.html"}], "extent": [1992, 2022]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/vop/kma_lfilter_barndoor", "type": "link", "text": "", "fullpath": "/nodes/vop/kma_lfilter_barndoor.html"}], "extent": [2022, 2056]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/lightfilterlibrary", "type": "link", "text": "", "fullpath": "/nodes/lop/lightfilterlibrary.html"}], "extent": [2056, 2088]}], "container": true}], "text": "Related"}], "title": ["Karma Light Filter Blocker"], "summary": ["Karma Light Filter that blocks or shapes portions of a light using simple blocker volumes."]}