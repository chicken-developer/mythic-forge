{"type": "root", "attrs": {"type": "include"}, "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Joint Group"], "extent": [16, 29], "body": [{"type": "para", "indent": 4, "text": ["The name of the group of joints whose transforms to serialize. If no group name is specified, then all joint transforms are processed."], "extent": [49, 189]}], "container": true, "attrs": {"id": "jointgroup"}}, {"type": "dt", "indent": 0, "text": ["Mode"], "extent": [189, 195], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Subskeleton"], "extent": [210, 228], "body": [{"type": "para", "indent": 8, "text": ["Treat the skeleton as the subskeleton that has only the joints specified in ", {"type": "ui", "text": ["Joint Group"]}, ". For each joint of ", {"type": "ui", "text": ["Joint Group"]}, " that has a parent also in ", {"type": "ui", "text": ["Joint Group"]}, ", the local transformation is processed. The processing of joints of ", {"type": "ui", "text": ["Joint Group"]}, " without a parent in ", {"type": "ui", "text": ["Joint Group"]}, " is controlled by the ", {"type": "ui", "text": ["Include World Rotation"]}, " option."], "extent": [228, 582]}], "container": true}, {"type": "dt", "indent": 4, "text": ["All Joints as Local"], "extent": [582, 607], "body": [{"type": "para", "indent": 8, "text": ["Process only the local transformation of each joint of ", {"type": "ui", "text": ["Joint Group"]}, ". Which components of each local transformation is considered depends on the parameters ", {"type": "ui", "text": ["Include Rotation"]}, ", ", {"type": "ui", "text": ["Local Rotation Group"]}, ", ", {"type": "ui", "text": ["Include Translation"]}, ", and ", {"type": "ui", "text": ["Local Translation Group"]}, "."], "extent": [607, 880]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "mode"}}, {"type": "dt", "indent": 0, "text": ["Include World Rotation"], "extent": [880, 904], "body": [{"type": "para", "indent": 4, "text": ["Process the world transformation of the subskeleton root(s). This means for each joint of ", {"type": "ui", "text": ["Joint Group"]}, " that does not have a parent in ", {"type": "ui", "text": ["Joint Group"]}, " (a root of the subskeleton) the world transformation is processed. When off, then these subskeleton roots are not processed at all."], "extent": [946, 1236]}], "container": true, "attrs": {"id": "subskeletonincludeworldrotation"}}, {"type": "dt", "indent": 0, "text": ["Include Rotation"], "extent": [1236, 1254], "body": [{"type": "para", "indent": 4, "text": ["Of each local transformation, include the rotation component when it\u2019s processed."], "extent": [1281, 1368]}], "container": true, "attrs": {"id": "alllocalrotation"}}, {"type": "dt", "indent": 0, "text": ["Local Rotation Group"], "extent": [1368, 1390], "body": [{"type": "para", "indent": 4, "text": ["Limit the local transformations for which the rotation component is processed to this group of joints."], "extent": [1419, 1527]}], "container": true, "attrs": {"id": "localrotationgroup"}}, {"type": "dt", "indent": 0, "text": ["Include Translation"], "extent": [1527, 1548], "body": [{"type": "para", "indent": 4, "text": ["Of each local transformation, include the translation component when it\u2019s processed."], "extent": [1578, 1668]}], "container": true, "attrs": {"id": "alllocaltranslation"}}, {"type": "dt", "indent": 0, "text": ["Local Translation Group"], "extent": [1668, 1693], "body": [{"type": "para", "indent": 4, "text": ["Limit the local transformations for which the translation component is processed to this group of joints."], "extent": [1725, 1835]}], "container": true, "attrs": {"id": "localtranslationgroup"}}], "container": true}]}