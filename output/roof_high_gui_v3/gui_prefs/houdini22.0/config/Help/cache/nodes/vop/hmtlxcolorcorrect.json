{"type": "root", "attrs": {"type": "node", "context": "vop", "internal": "hmtlxcolorcorrect", "icon": "VOP/hmtlxcolorcorrect", "since": "19.5", "version": null, "namespace": null}, "body": [{"type": "summary", "indent": 0, "text": ["Adjust colors in MaterialX shading graphs."], "extent": [98, 148]}, {"level": 0, "type": "title", "indent": 0, "text": ["MtlX Color Correct"], "extent": [148, 171]}, {"type": "para", "indent": 0, "text": ["This node provides a one-stop tool for color correcting textures, or other color signals. It is a nodegraph, that combines various MaterialX operators for color correction into a single tool. Internally, the operations are applied in top-to-bottom order they are presented in the parameter UI."], "extent": [171, 467]}, {"type": "warning_group", "body": [{"type": "warning", "indent": 0, "role": "item", "extent": [467, 476], "body": [{"type": "para", "indent": 4, "text": ["This node is deprecated. The ", {"scheme": "Node", "value": "/nodes/vop/mtlxcolorcorrect", "type": "link", "text": ["MtlX Color Correct"], "fullpath": "/nodes/vop/mtlxcolorcorrect.html"}, " should be used instead."], "extent": [476, 581]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [581, 593], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Hue"], "extent": [593, 599], "body": [{"type": "para", "indent": 4, "text": ["Rotates the color hue, with values wrapping at 0-1 boundaries."], "extent": [613, 681]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_hue.jpg", "type": "img", "text": ""}], "extent": [681, 742]}], "container": true, "attrs": {"id": "hue"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Saturation"], "extent": [742, 754], "body": [{"type": "para", "indent": 4, "text": ["Adjust the color saturation."], "extent": [775, 809]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_saturation.jpg", "type": "img", "text": ""}], "extent": [809, 873]}], "container": true, "attrs": {"id": "saturation"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Gamma"], "extent": [873, 880], "body": [{"type": "para", "indent": 4, "text": ["Applies a gamma correction to the color."], "extent": [896, 942]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_gamma.jpg", "type": "img", "text": ""}], "extent": [942, 1001]}], "container": true, "attrs": {"id": "gamma"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Lift"], "extent": [1001, 1007], "body": [{"type": "para", "indent": 4, "text": ["Raise the dark color values, leaving the white values unchanged."], "extent": [1022, 1092]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_lift.jpg", "type": "img", "text": ""}], "extent": [1092, 1150]}], "container": true, "attrs": {"id": "lift"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Gain"], "extent": [1150, 1156], "body": [{"type": "para", "indent": 4, "text": ["Multiplies lighter colors, leaving black values unchanged."], "extent": [1171, 1235]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_gain.jpg", "type": "img", "text": ""}], "extent": [1235, 1293]}], "container": true, "attrs": {"id": "gain"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Contrast"], "extent": [1293, 1303], "body": [{"type": "para", "indent": 4, "text": ["Linearly increase or decrease the color contrast."], "extent": [1322, 1377]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_contrast.jpg", "type": "img", "text": ""}], "extent": [1377, 1439]}], "container": true, "attrs": {"id": "contrast"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Contrast Pivot"], "extent": [1439, 1455], "body": [{"type": "para", "indent": 4, "text": ["Pivot value around which contrast applies. This value will not change as contrast is adjusted."], "extent": [1479, 1579]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_contrastpivot.jpg", "type": "img", "text": ""}], "extent": [1579, 1646]}], "container": true, "attrs": {"id": "contrastpivot"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Exposure"], "extent": [1646, 1656], "body": [{"type": "para", "indent": 4, "text": ["Multplier which increases or decreases color brightness by 2^value."], "extent": [1675, 1748]}, {"type": "para", "indent": 4, "text": [{"scheme": "Image", "value": "/images/nodes/vop/hmtlxcolorcorrect_exposure.jpg", "type": "img", "text": ""}], "extent": [1748, 1810]}], "container": true, "attrs": {"id": "exposure"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [1810, 1818], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Input Color"], "extent": [1818, 1832], "body": [{"type": "para", "indent": 4, "text": ["The RGB signal to be color corrected."], "extent": [1832, 1875]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [1875, 1884], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Out"], "extent": [1884, 1890], "body": [{"type": "para", "indent": 4, "text": ["Adjusted RGB signal."], "extent": [1890, 1916]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": t