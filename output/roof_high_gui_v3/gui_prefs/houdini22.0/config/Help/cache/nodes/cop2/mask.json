{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "mask", "icon": "COP2/mask", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Mask"], "extent": [72, 81]}, {"type": "summary", "indent": 0, "text": ["Masks out an area of an image."], "extent": [81, 120]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Uses a plane from the mask input to mask out an area of the first\ninput. The mask may be applied to any planes and their components."], "extent": [163, 297]}, {"type": "para", "indent": 0, "text": ["A mask is applied to an image by multiplying the image by the mask. The\nmask may also be inverted or scaled (brightened or dimmed)."], "extent": [297, 430]}, {"type": "para", "indent": 0, "text": ["This operation is useful for removing or isolating image elements."], "extent": [430, 499]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [499, 511], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Mask"], "extent": [511, 527], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Effect Amount"], "extent": [527, 551], "body": [{"type": "para", "indent": 12, "text": ["If no mask is present, this blends the output with the input\n            by a constant amount (0 = all input, 1 = all output)."], "extent": [589, 729]}, {"type": "para", "indent": 12, "text": ["If a mask is present, this amount multiplies the mask."], "extent": [729, 797]}], "container": true, "attrs": {"channels": "/effectamount"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Mask Plane"], "extent": [797, 817], "body": [{"type": "para", "indent": 12, "text": ["Selects the mask plane to use as a mask from the mask input"], "extent": [852, 925]}, {"type": "para", "indent": 12, "text": ["A mask can be a component of a plane or an entire plane. If\n            a vector plane is supplied as a mask, its components are\n            multiplied by the images' components."], "extent": [925, 1117]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Scalar Mask ('A', 'C.r')"]}], "extent": [1117, 1157]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M\n            C.g = I.g * M\n            C.b = I.b * M\n            \n            "], "extent": [1157, 1280]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Vector Mask ('C')"]}], "extent": [1280, 1313]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M.r\n            C.g = I.g * M.g\n            C.b = I.b * M.b\n            \n            "], "extent": [1313, 1442]}], "container": true, "attrs": {"channels": "/maskplane"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Invert Mask"], "extent": [1442, 1463], "body": [{"type": "para", "indent": 12, "text": ["Inverts the mask so that all fully 'masked' portions become\n            unmasked. This saves you from inserting an Invert COP."], "extent": [1463, 1602]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scope"], "extent": [484, 501], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Plane Scope"], "extent": [501, 523], "body": [{"type": "para", "indent": 12, "text": ["Specifies the scope for both the RGB components of Color,\n            Alpha, and other planes. The (C)RGBA mask only affects Color\n            components and Alpha. 'C' will toggle all the RGB\n            components."], "extent": [523, 753]}, {"type": "para", "indent": 12, "text": ["For planes other than Color and Alpha, the plane name (plus\n            component, if applicable) should be specified in the string\n            field. The pulldown menu can be used to select planes or\n            components present in this node."], "extent": [753, 1012]}, {"type": "para", "indent": 12, "text": ["A plane is specified by its name. A component is specified\n            by both its plane and component name. The '*' wildcard may\n            be used to scope all extra planes. Any number of planes or\n            components can be specified, separated by spaces."], "extent": [1012, 1288]}, {"type": "para", "indent": 12, "text": ["Examples:"], "extent": [1288, 1311]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            P\n            N.x N.y\n            P N Pz\n            "], "extent": [1311, 1396]}], "container": true, "role": "item"}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Frame Scope"], "extent": [1396, 1419], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Frame Scope"], "extent": [1419, 1441], "body": [{"type": "para", "indent": 12, "text": ["Allows scoping of specific frames in the frame range. This\n            is in addition to the plane scope (so a plane at a certain\n            frame must be both plane scoped and frame scoped to be\n            modified)."], "extent": [1441, 1674]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["All Frames"], "extent": [1674, 1698], "body": [{"type": "para", "indent": 16, "text": ["All frames are scoped."], "extent": [1698, 1737]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Inside Range"], "extent": [1737, 1763], "body": [{"type": "para", "indent": 16, "text": ["All frames inside a subrange are scoped."], "extent": [1763, 1820]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Outside Range"], "extent": [1820, 1847], "body": [{"type": "para", "indent": 16, "text": ["All frames outside a subrange are scoped."], "extent": [1847, 1905]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Even Frames"], "extent": [1905, 1930], "body": [{"type": "para", "indent": 16, "text": ["Even numbered frames are scoped."], "extent": [1930, 1979]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Odd Frames"], "extent": [1979, 2003], "body": [{"type": "para", "indent": 16, "text": ["Odd numbered frames are scoped."], "extent": [2003, 2051]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Specific Frames"], "extent": [2051, 2080], "body": [{"type": "para", "indent": 16, "text": ["A user-defined list of frames are scoped."], "extent": [2080, 2138]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [2138, 2159], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside range, this parameter specifies the\n            subrange of the sequence to scope (or unscope). This can be\n            edited in Timeline viewer mode (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2201, 2409]}], "container": true, "attrs": {"channels": "/frange1 /frange2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Dropoff"], "extent": [2409, 2432], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside Range, this parameter specifies certain\n            number of frames before and after to slowly ramp up to\n            scoped. The operation will be blended with its input to\n            'ease in' or 'ease out' the scoping effect over a number of\n            frames. This can be edited in Timeline viewer mode\n            (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2478, 2857]}], "container": true, "attrs": {"channels": "/fdropoff1 /fdropoff2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Non-scoped Effect"], "extent": [2857, 2884], "body": [{"type": "para", "indent": 12, "text": ["For unscoped frames, this sets the blend factor between the\n            input and modified images. Normally this is zero (use the\n            input image). By setting this to a non-zero value, you can\n            make unscoped frames be 'slightly' unscoped. The value can\n            vary between 0 (unscoped) and 1 (scoped)."], "extent": [2918, 3256]}], "container": true, "attrs": {"channels": "/foutside"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame List"], "extent": [3256, 3276], "body": [{"type": "para", "indent": 12, "text": ["The frame list for 'Specific Frames'. Frame numbers should\n            be separated by spaces."], "extent": [3307, 3414]}], "container": true, "attrs": {"channels": "/flist"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Automatically Adjust for Length Changes"], "extent": [3414, 3463], "body": [{"type": "para", "indent": 12, "text": ["If the sequence range changes, enabling this parameter will\n            adjust the subrange and frame dropoff lengths to fit the new\n            range."], "extent": [3463, 3627]}], "container": true, "role": "item"}], "container": true}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [1640, 1648], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Image to Mask"], "extent": [1648, 1667], "body": [{"type": "para", "indent": 8, "text": ["The image that the mask is applied to."], "extent": [1667, 1714]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Mask Input"], "extent": [1714, 1730], "body": [{"type": "para", "indent": 8, "text": ["The input that the mask is chosen from."], "extent": [1730, 1778]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1778, 1786], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1812, 1821], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/multiply", "type": "link", "text": "", "fullpath": "/nodes/cop2/multiply.html"}], "extent": [1821, 1848]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/xor", "type": "link", "text": "", "fullpath": "/nodes/cop2/xor.html"}], "extent": [1848, 1871]}], "container": true}], "text": "Related"}], "title": ["Mask"], "summary": ["Masks out an area of an image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/pixelparms"]}