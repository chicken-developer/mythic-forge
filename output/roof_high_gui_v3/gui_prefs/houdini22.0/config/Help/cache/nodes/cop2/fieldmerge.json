{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "fieldmerge", "icon": "COP2/fieldmerge", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Field Merge"], "extent": [84, 100]}, {"type": "summary", "indent": 0, "text": ["Merges two fields into one Interlaced Frame."], "extent": [100, 153]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Merges two fields into one Interlaced Frame.The resulting sequence is\nhalf as long as the input sequence."], "extent": [196, 304]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [304, 316], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Detect Field Type from Input"], "extent": [316, 350], "body": [{"type": "para", "indent": 8, "text": ["If on, the type of the sequence will be read from the sequence\n        information of the input. Field Split and the generator\n        Interlace parameters set this information. It is not\n        automatically detected from loaded files."], "extent": [350, 596]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Others"], "extent": [596, 608], "body": [{"type": "para", "indent": 8, "text": ["The next two parameters are for manually specifying the field\n        type."], "extent": [608, 692]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Field Dominance"], "extent": [692, 713], "body": [{"type": "para", "indent": 8, "text": ["The field dominance of the input sequence."], "extent": [713, 765]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Odd Dominant (Field 1)"], "extent": [765, 797], "body": [{"type": "para", "indent": 12, "text": ["The odd scanlines (1,3,5\u2026) appear in the first field of\n            the video pair."], "extent": [797, 895]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Even Dominant (Field 2)"], "extent": [895, 928], "body": [{"type": "para", "indent": 12, "text": ["The even scanlines (2,4,6\u2026) appear in the first field of\n            the video pair."], "extent": [928, 1028]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1028, 1037], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldsplit", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldsplit.html"}], "extent": [1037, 1066]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldswap", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldswap.html"}], "extent": [1066, 1094]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pulldown", "type": "link", "text": "", "fullpath": "/nodes/cop2/pulldown.html"}], "extent": [1094, 1121]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pushup", "type": "link", "text": "", "fullpath": "/nodes/cop2/pushup.html"}], "extent": [1121, 1147]}], "container": true}], "text": "Related"}], "title": ["Field Merge"], "summary": ["Merges two fields into one Interlaced Frame."], "included": ["/composite/_old_cops_deprecated"]}