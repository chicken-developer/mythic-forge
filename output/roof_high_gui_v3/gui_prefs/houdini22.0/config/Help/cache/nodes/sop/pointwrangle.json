{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "pointwrangle", "icon": "SOP/pointwrangle", "tags": "points, attrs, core, tech", "since": "12.5", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Point Wrangle"], "extent": [0, 18]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Deprecated"], "role": "item", "extent": [140, 161], "body": [{"type": "para", "indent": 4, "text": ["The Point Wrangle SOP is now deprecated. Please use ", {"scheme": "Node", "value": "/nodes/sop/attribwrangle", "type": "link", "text": ["Attribute Wrangle"], "fullpath": "/nodes/sop/attribwrangle.html"}, " instead."], "extent": [161, 270]}], "container": true}], "container": true, "role": "item_group"}, {"type": "summary", "indent": 0, "text": ["Runs a VEX snippet to modify point attributes, including position."], "extent": [270, 344]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [344, 359], "body": [{"type": "para", "indent": 0, "text": ["This is a very powerful, low-level node that lets experts who are\nfamiliar with VEX tweak point attributes using code."], "extent": [359, 480]}, {"type": "para", "indent": 0, "text": ["This node corresponds to the ", {"scheme": "Node", "value": "/nodes/sop/vopsop", "type": "link", "text": ["VOP SOP"], "fullpath": "/nodes/sop/vopsop.html"}, ",\nbut uses a textual VEX snippet instead of a VOP network."], "extent": [480, 594]}, {"type": "para", "indent": 0, "text": ["This node ", {"type": "em", "text": ["runs the snippet on every point"]}, " in the input geometry.\nThe snippet can edit the input geometry by changing attributes.\nIt can access information from other geometry using attributes and VEX functions."], "extent": [594, 808]}, {"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["Press ", {"keys": ["MMB"], "type": "keys", "text": null}, " on the node to see any error output from the snippet."], "extent": [808, 879]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["You can use the VEX function ", {"type": "code", "text": ["ch"]}, " to evaluate parameters.\n  The path is relative to this node (", {"type": "code", "text": ["ch(\"parm\")"]}, " will evaluate the parameter ", {"type": "code", "text": ["parm"]}, " on this node).\n  This evaluation will be done at the current time."], "extent": [879, 1092]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Unlike the ", {"scheme": "Node", "value": "/nodes/sop/point", "type": "link", "text": ["Point SOP"], "fullpath": "/nodes/sop/point.html"}, ", this does not use local variables.\n  Further, all backtick expressions and ", {"type": "code", "text": ["$F"]}, " variables will be evaluated at frame 1,\n  not the current time.\n  Use ", {"type": "code", "text": ["Frame"]}, ", ", {"type": "code", "text": ["Time"]}, ", or ", {"type": "code", "text": ["TimeInc"]}, " instead."], "extent": [1092, 1324]}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Context"], "extent": [1324, 1338], "body": [{"type": "para", "indent": 0, "text": ["This node runs the VEX snippet in the ", {"type": "strong", "text": ["SOP context"]}, "."], "extent": [1338, 1394]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Syntax"], "extent": [1394, 1407], "body": [{"type": "para", "indent": 0, "text": ["The ", {"type": "ui", "text": ["VEX snippet"]}, " parameter lets you enter a snippet of ", {"scheme": null, "value": "/vex/", "type": "link", "text": ["VEX code"], "fullpath": "/vex/index.html"}, " to run on the input geometry.\nSee ", {"scheme": null, "value": "/vex/snippets", "type": "link", "text": ["VEX snippets"], "fullpath": "/vex/snippets.html"}, " for basic information on the syntax available in the snippet parameter.\nSee ", {"scheme": null, "value": "/vex/", "type": "link", "text": ["the VEX chapter"], "fullpath": "/vex/index.html"}, " for general information on the VEX language."], "extent": [16, 299]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["VEX variables"], "extent": [1435, 1455], "body": [{"type": "para", "indent": 0, "text": ["You can create temporary VEX variables.\nNormal VEX variables do not have a ", {"type": "code", "text": ["@"]}, " prefix.\nFor example, the following code swaps ", {"type": "code", "text": ["P"]}, " and ", {"type": "code", "text": ["Cd"]}, "."], "extent": [1455, 1596]}, {"lang": "vex", "type": "pre", "indent": 0, "text": ["\nvector temp = @P;\n@P = @Cd;\n@Cd = temp;\n"], "extent": [1596, 1650]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Global Variables"], "extent": [1650, 1674], "body": [{"type": "para", "indent": 0, "text": ["The VEX ", {"type": "code", "text": ["sop"]}, " context provides several global variables you can access,\nsuch as ", {"type": "code", "text": ["P"]}, ", that correspond to attributes.\nWhile you can access these directly, we recommend you use the ", {"type": "code", "text": ["@"]}, " prefix\nfor clarity."], "extent": [1674, 1878]}, {"type": "para", "indent": 0, "text": ["The following global variables do not correspond to attributes\nand may be useful in snippets."], "extent": [1878, 1973]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": [{"type": "code", "text": ["Npt"]}], "extent": [1973, 1980], "body": [{"type": "para", "indent": 4, "text": ["Total number of points."], "extent": [1980, 2008]}], "container": true}, {"type": "dt", "indent": 0, "text": [{"type": "code", "text": ["Time"]}], "extent": [2008, 2016], "body": [{"type": "para", "indent": 4, "text": ["Current time in seconds."], "extent": [2016, 2045]}], "container": true}, {"type": "dt", "indent": 0, "text": [{"type": "code", "text": ["Frame"]}], "extent": [2045, 2054], "body": [{"type": "para", "indent": 4, "text": ["Current time in frames."], "extent": [2054, 2082]}], "container": true}, {"type": "dt", "indent": 0, "text": [{"type": "code", "text": ["TimeInc"]}], "extent": [2082, 2093], "body": [{"type": "para", "indent": 4, "text": ["Time increment between frames, in seconds."], "extent": [2093, 2140]}], "container": true}, {"type": "dt", "indent": 0, "text": [{"type": "code", "text": ["OpInput1"]}, ", ", {"type": "code", "text": ["OpInput2"]}, ", ", {"type": "code", "text": ["OpInput3"]}, ", ", {"type": "code", "text": ["OpInput4"]}], "extent": [2140, 2188], "body": [{"type": "para", "indent": 4, "text": ["A string that can be used to refer to the corresponding input\n    of this SOP in vex operations that take file parameters."], "extent": [2188, 2316]}], "container": true}], "container": true}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [2316, 2328], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Point group"], "extent": [2328, 2342], "body": [{"type": "para", "indent": 4, "text": ["A subset of points in the input geometry to run the program on.\n    Leave this blank to affect all points in the input."], "extent": [2342, 2467]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["VEXpression"], "extent": [2467, 2480], "body": [{"type": "para", "indent": 4, "text": ["A snippet of VEX code that will manipulate the point attributes.\n    You can use ", {"type": "code", "text": ["@", {"type": "var", "text": ["variable_name"]}]}, " syntax to access geometry attributes."], "extent": [2498, 2643]}], "container": true, "attrs": {"id": "snippet"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Attributes to Create"], "extent": [2643, 2665], "body": [{"type": "para", "indent": 4, "text": ["Only create attributes if their names match this pattern.\n    The default pattern allows any attribute to be created."], "extent": [2686, 2813]}, {"type": "para", "indent": 4, "text": ["You can restrict the created attributes by replacing the ", {"type": "code", "text": ["*"]}, " with a list of allowed names.\n    Global attributes, such as ", {"type": "code", "text": ["Cd"]}, ", ", {"type": "code", "text": ["v"]}, ", and ", {"type": "code", "text": ["id"]}, ", will be created even if they are not in this list."], "extent": [2813, 3012]}], "container": true, "attrs": {"id": "exportlist"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [3012, 3021], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/attribwrangle", "type": "link", "text": "", "fullpath": "/nodes/sop/attribwrangle.html"}], "extent": [3021, 3049]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/volumewrangle", "type": "link", "text": "", "fullpath": "/nodes/sop/volumewrangle.html"}], "extent": [3049, 3076]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/attribvop", "type": "link", "text": "", "fullpath": "/nodes/sop/attribvop.html"}], "extent": [3076, 3099]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/point", "type": "link", "text": "", "fullpath": "/nodes/sop/point.html"}], "extent": [3099, 3118]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/vopsop", "type": "link", "text": "", "fullpath": "/nodes/sop/vopsop.html"}], "extent": [3118, 3139]}], "container": true}], "text": "Related"}], "title": ["Point Wrangle"], "summary": ["Runs a VEX snippet to modify point attributes, including position."], "included": ["/nodes/sop/wrangle_syntax"]}