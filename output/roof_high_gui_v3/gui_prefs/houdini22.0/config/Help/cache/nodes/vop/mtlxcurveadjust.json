{"type": "root", "attrs": {"type": "node", "context": "vop", "internal": "mtlxcurveadjust", "icon": "COMMON/materialx", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["MtlX Curveadjust"], "extent": [78, 99]}, {"type": "para", "indent": 0, "text": ["Output a smooth remapping of input values using the centripetal Catmull-Rom cubic spline curve defined by specified knot values, using an inverse spline lookup on input knot values and a forward spline through output knot values.  All channels of the input will be remapped using the same curve."], "extent": [99, 398]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [398, 410], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["in"], "extent": [410, 414], "body": [{"type": "para", "indent": 5, "text": ["The list of input values defining the curve for the remapping.  At least 2 values must be provided."], "extent": [414, 519]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["knots"], "extent": [519, 526], "body": [{"type": "para", "indent": 4, "text": ["The list of output values defining the curve for the remapping.  Must be the same length as knots."], "extent": [526, 629]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [629, 638], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["out"], "extent": [638, 643], "body": [{"type": "para", "indent": 4, "text": ["float"], "extent": [643, 653]}], "container": true}], "container": true}], "text": "Outputs"}], "title": ["MtlX Curveadjust"]}