{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "rop_gltf", "icon": "COMMON/gltf", "since": "17.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["glTF ROP output driver"], "extent": [79, 106]}, {"level": 0, "type": "title", "indent": 0, "text": ["glTF"], "extent": [75, 84]}, {"type": "para", "indent": 0, "text": ["The glTF ROP can export your scene as a GLTF file. See the following link for further information about the ", {"scheme": null, "value": "https://www.khronos.org/gltf/", "type": "link", "text": ["glTF format"], "exists": true}, "."], "extent": [84, 239]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [239, 245], "body": [{"type": "para", "indent": 4, "text": ["See the following link for an ", {"scheme": null, "value": "/io/gltf", "type": "link", "text": ["overview of importing and exporting GLTF files to and from Houdini"], "fullpath": "/io/gltf.html"}, "."], "extent": [245, 359]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["The glTF ROP can do the following:"], "extent": [359, 395]}, {"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": ["Export cameras."], "extent": [395, 413]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Export lights via the ", {"type": "code", "text": ["KHR_lights_punctual"]}, " Khronos extension."], "extent": [413, 478]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Export mesh names and node names."], "extent": [478, 514]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Export Object-level Null nodes as glTF Null nodes."], "extent": [514, 567]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Export Object-level transform animations."], "extent": [567, 611]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Export SOP animations to glTF, including packed primitives and instances."], "extent": [611, 687]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Support ambient occlusion textures."], "extent": [687, 725]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Support frame ranges and takes."], "extent": [725, 759]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Optimize exported file sizes for geometry that requires point splitting."], "extent": [759, 834]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Create intermediate directories."], "extent": [834, 869]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Maintain the vertex order if the mesh being exported only has one glTF primitive."], "extent": [869, 953]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Culls empty geometry nodes when the ", {"scheme": null, "value": "#cullempty", "type": "link", "text": ["Cull Empty Node"], "fullpath": "/nodes/out/gltf-.html#cullempty", "fragment": "#cullempty"}, " parameter is turned on."], "extent": [953, 1044]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Preserves the original textures specified on the material when the ", {"type": "ui", "text": [{"scheme": null, "value": "#texturesource", "type": "link", "text": ["Texture Source"], "fullpath": "/nodes/out/gltf-.html#texturesource", "fragment": "#texturesource"}]}, " parameter is set to ", {"type": "ui", "text": ["Copy Original Textures"]}, "."], "extent": [1044, 1197]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Preserves the original file formats of material textures when the ", {"type": "ui", "text": [{"scheme": null, "value": "#imageformat", "type": "link", "text": ["Texture Format"], "fullpath": "/nodes/out/gltf-.html#imageformat", "fragment": "#imageformat"}]}, " parameter is set to ", {"type": "ui", "text": ["Original Format or PNG"]}, " or ", {"type": "ui", "text": ["Original Format or JPEG"]}, "."], "extent": [1197, 1378]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": ["Supports connecting inputs to the node to create a dependency graph."], "extent": [1378, 1450]}], "container": true}, {"type": "para", "indent": 0, "text": ["The follow table provides further details about which glTF features and extensions are supported, plus any relevant notes about how they are supported:"], "extent": [1450, 1603]}, {"type": "table", "thead": [], "body": [{"type": "row", "body": [{"type": "cell", "indent": 0, "text": [{"tag": "b", "attrs": {}, "type": "xml", "text": ["glTF Property or Extension"]}, " "], "role": "td", "extent": [1603, 1639], "container": true}, {"type": "cell", "indent": 4, "text": [{"tag": "b", "attrs": {}, "type": "xml", "text": ["Supported"]}, " "], "role": "td", "extent": [1639, 1662], "container": true}, {"type": "cell", "role": "td", "body": [{"tag": "b", "attrs": {}, "type": "xml", "text": ["Notes"]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Scene "], "role": "td", "extent": [1684, 1692], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [1692, 1720], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["All nodes are exported to a single scene."], "extent": [1720, 1771]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Node "], "role": "td", "extent": [1771, 1778], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [1778, 1806], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["When exporting a SOP node, a single node will be exported. When exporting an OBJ network, a glTF node will be exported for each OBJ node."], "extent": [1806, 1953]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh "], "role": "td", "extent": [1953, 1960], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [1960, 1988], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["SOP geometry will be exported to a glTF mesh. Sometimes exported geometry needs to be processed to make it compatible with glTF, such as by triangulating the geometry or splitting points when vertices sharing that point have different attribute values."], "extent": [1988, 2250]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh Primitive (Points) "], "role": "td", "extent": [2250, 2276], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/out/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2276, 2303], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2303, 2314]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh Primitive (Lines) "], "role": "td", "extent": [2314, 2339], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/out/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2339, 2366], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2366, 2377]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Mesh Primitive (Triangles) "], "role": "td", "extent": [2377, 2406], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [2406, 2434], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Only supports exporting mesh primitives with a mode of TRIANGLES."], "extent": [2434, 2509]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Camera "], "role": "td", "extent": [2509, 2518], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [2518, 2546], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["OBJ cameras will be exported, but SOP primitive cameras are not supported."], "extent": [2546, 2630]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Skin "], "role": "td", "extent": [2630, 2637], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/out/TOP/pdg_error.html"}, " "], "role": "td", "extent": [2637, 2664], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [2664, 2675]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Morph Target "], "role": "td", "extent": [2675, 2690], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [2690, 2718], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Deforming meshes are exported by creating a morph target for each frame along with an animation that linearly interpolates between each morph target. "], "extent": [2718, 2878]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Animation (Transform Target) "], "role": "td", "extent": [2878, 2909], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [2909, 2937], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Animated OBJ node transforms will be exported to a glTF animation."], "extent": [2937, 3013]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Animation (Weight Target) "], "role": "td", "extent": [3013, 3041], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [3041, 3069], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Deforming meshes will be exported by creating a morph target for each frame and an animation that linearly interpolates the morph target weights between each frame. The point count of the source mesh must not change as it deforms."], "extent": [3069, 3309]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Material "], "role": "td", "extent": [3309, 3320], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [3320, 3348], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Supports exporting Principled Shaders to a glTF material."], "extent": [3348, 3415]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["Texture "], "role": "td", "extent": [3415, 3425], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [3425, 3453], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Supported texture maps (base color, roughness, metallic, normal, emissive, occlusion) used by any Principled Shaders in the scene will be exported as well as any textures specified by the ", {"type": "ui", "text": ["Additional Textures"]}, " parameter."], "extent": [3453, 3685]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["KHR_draco_mesh_compression Extension "], "role": "td", "extent": [3685, 3724], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "TOP/pdg_error", "type": "link", "text": "", "fullpath": "/nodes/out/TOP/pdg_error.html"}, " "], "role": "td", "extent": [3724, 3751], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["-"], "extent": [3751, 3762]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 0, "text": ["KHR_lights_punctual Extension "], "role": "td", "extent": [3762, 3794], "container": true}, {"type": "cell", "indent": 4, "text": [{"scheme": "Icon", "value": "MISC/checkmark", "type": "link", "text": "", "fullpath": "/nodes/out/MISC/checkmark.html"}, " "], "role": "td", "extent": [3794, 3822], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 8, "text": ["Any OBJ lights in the scene will be exported."], "extent": [3822, 3877]}]}], "divider": false}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [3877, 3889], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Save to Disk"], "extent": [49, 67], "body": [{"type": "para", "indent": 8, "text": ["Begins the render with the last render control settings."], "extent": [89, 155]}], "container": true, "attrs": {"id": "execute"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Controls"], "extent": [155, 169], "body": [{"type": "para", "indent": 8, "text": ["Opens the ", {"scheme": null, "value": "/ref/windows/rendercontrol", "type": "link", "text": ["Render Control window"], "fullpath": "/ref/windows/rendercontrol.html"}, ", which \n        allows you to adjust the render parameters before rendering."], "extent": [196, 343]}], "container": true, "attrs": {"id": "renderdialog"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Valid Frame Range"], "extent": [1958, 1981], "body": [{"type": "para", "indent": 8, "text": ["Controls whether this render node outputs the current frame or the image sequence specified in the ", {"type": "ui", "text": ["Start/End/Inc"]}, " parameters."], "extent": [2013, 2151]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Render Current Frame"], "extent": [2151, 2181], "body": [{"type": "para", "indent": 12, "text": ["Export only the current frame."], "extent": [2181, 2225]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Render Frame Range"], "extent": [2225, 2253], "body": [{"type": "para", "indent": 12, "text": ["Export the frames in the ", {"type": "ui", "text": ["Start/End/Inc"]}, " frame range, \n            but also allow exporting of frames referenced by in-range frames."], "extent": [2253, 2401]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Render Frame Range Only (Strict)"], "extent": [2401, 2443], "body": [{"type": "para", "indent": 12, "text": ["Only export the frames in the ", {"type": "ui", "text": ["Start/End/Inc"]}, " frame range. \n            Do not allow exporting of other frames, including frames referenced by\n            in-range frames."], "extent": [2443, 2630]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "valid_frame_range"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Start/End/Inc"], "extent": [2630, 2649], "body": [{"type": "para", "indent": 8, "text": ["Specifies the range of frames to render (start frame, end frame, and\n        increment). All of the values can be floating point values. The range\n        is inclusive. "], "extent": [2665, 2844]}, {"type": "para", "indent": 8, "text": ["The ", {"type": "ui", "text": ["Start/End/Inc"]}, " parameters determine the values of the below \n        ", {"scheme": null, "value": "/network/expressions#render", "type": "link", "text": ["local variables"], "fullpath": "/network/expressions.html#render", "fragment": "#render"}, " for the output driver."], "extent": [2844, 2998]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": [{"type": "code", "text": ["$NRENDER"]}], "extent": [2998, 3018], "body": [{"type": "para", "indent": 12, "text": ["The number of frames to be rendered by the output driver."], "extent": [3018, 3089]}], "container": true}, {"type": "dt", "indent": 8, "text": [{"type": "code", "text": ["$N"]}], "extent": [3089, 3103], "body": [{"type": "para", "indent": 12, "text": ["The current frame being rendered (starting at 1 and going to\n            ", {"type": "code", "text": ["$NRENDER"]}, ")."], "extent": [3103, 3210]}], "container": true}], "container": true}, {"type": "para", "indent": 8, "text": ["For example, if the parameters are set to:"], "extent": [3210, 3270]}, {"type": "table", "thead": [{"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["Start "], "role": "th", "extent": [3270, 3287], "container": true}, {"type": "cell", "indent": 12, "text": ["End "], "role": "th", "extent": [3287, 3306], "container": true}, {"type": "cell", "indent": 16, "text": ["Inc "], "role": "th", "extent": [3306, 3329]}], "divider": false}], "body": [{"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["10.5 "], "role": "td", "extent": [3329, 3344], "container": true}, {"type": "cell", "indent": 12, "text": ["12 "], "role": "td", "extent": [3344, 3361], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 16, "text": ["0.5 "], "extent": [3361, 3383]}]}], "divider": false}]}, {"type": "para", "indent": 8, "text": ["\u2026 there will be 4 frames rendered (10.5, 11, 11.5, and 12), so ", {"type": "code", "text": ["$NRENDER"]}, " will have a value of 4. "], "extent": [3383, 3493]}, {"type": "para", "indent": 8, "text": [{"type": "code", "text": ["$N"]}, " will have the following values at each frame:"], "extent": [3493, 3561]}, {"type": "table", "thead": [{"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["Frame "], "role": "th", "extent": [3561, 3578], "container": true}, {"type": "cell", "indent": 12, "text": [{"type": "code", "text": ["$N"]}, " "], "role": "th", "extent": [3578, 3598]}], "divider": false}], "body": [{"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["10.5 "], "role": "td", "extent": [3598, 3613], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 12, "text": ["1"], "extent": [3613, 3627]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["11 "], "role": "td", "extent": [3627, 3640], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 12, "text": ["2"], "extent": [3640, 3654]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["11.5 "], "role": "td", "extent": [3654, 3669], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 12, "text": ["3"], "extent": [3669, 3683]}]}], "divider": false}, {"type": "row", "body": [{"type": "cell", "indent": 8, "text": ["12 "], "role": "td", "extent": [3683, 3696], "container": true}, {"type": "cell", "role": "td", "body": [{"type": "para", "indent": 12, "text": ["4"], "extent": [3696, 3711]}]}], "divider": false}]}], "container": true, "attrs": {"id": "f"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Render with Take"], "extent": [343, 365], "body": [{"type": "para", "indent": 8, "text": ["Uses the settings in a particular take while rendering. Choose\n        ", {"type": "ui", "text": ["Current"]}, " to use the current take when rendering."], "extent": [384, 516]}], "container": true, "attrs": {"id": "take"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Output File"], "extent": [4036, 4049], "body": [{"type": "para", "indent": 4, "text": ["The path of the file to generate.  The extension determines the type of file to generate."], "extent": [4063, 4158]}, {"type": "para", "indent": 4, "text": ["A path with a ", {"type": "code", "text": [".glb"]}, " extension generates a single binary GLB file and stores all resources internally."], "extent": [4158, 4266]}, {"type": "para", "indent": 4, "text": ["A path with a ", {"type": "code", "text": [".gltf"]}, " extension may store some resources externally.  Exported resources are stored in the same folder as the file and are referenced relatively. "], "extent": [4266, 4434]}], "container": true, "attrs": {"id": "file"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Type"], "extent": [4434, 4447], "body": [{"type": "para", "indent": 8, "text": ["The file format to export. "], "extent": [4471, 4508]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Detect From Filename"], "extent": [4508, 4534], "body": [{"type": "para", "indent": 8, "text": ["The file format is dependent on the extension in ", {"type": "ui", "text": ["Output File"]}, "."], "extent": [4534, 4609]}], "container": true}, {"type": "dt", "indent": 4, "text": ["glTF"], "extent": [4609, 4619], "body": [{"type": "para", "indent": 8, "text": ["Export as a file with the ", {"type": "code", "text": [".gltf"]}, " format, and store some resources externally."], "extent": [4619, 4707]}], "container": true}, {"type": "dt", "indent": 4, "text": ["glb"], "extent": [4707, 4716], "body": [{"type": "para", "indent": 8, "text": ["Export as a single binary file with the ", {"type": "code", "text": [".glb"]}, " format."], "extent": [4716, 4780]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "exporttype"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Create Intermediate Directories"], "extent": [4780, 4813], "body": [{"type": "para", "indent": 4, "text": ["When turned on, creates intermediate directories for the output file if the specified ", {"type": "ui", "text": ["Output File"]}, " path contains directories that ", {"type": "em", "text": ["do not"]}, " yet exist. For example, if you specify ", {"type": "code", "text": ["$HIP/output/gltf_output/owl/tropical_screech.gltf"]}, " as the ", {"type": "ui", "text": ["Output File"]}, " path, and the ", {"type": "code", "text": ["/gltf_output"]}, " and ", {"type": "code", "text": ["/owl"]}, " directories do not exist, then the ", {"type": "code", "text": ["/gltf_output"]}, " and ", {"type": "code", "text": ["/owl"]}, " directories will be created automatically when you export your character."], "extent": [4829, 5265]}, {"type": "para", "indent": 4, "text": ["When turned off, and the ", {"type": "ui", "text": ["Output File"]}, " path contains directories that do not exist, then the export will silently fail."], "extent": [5265, 5392]}], "container": true, "attrs": {"id": "mkpath"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Use SOP Path"], "extent": [5392, 5406], "body": [{"type": "para", "indent": 4, "text": ["When turned on, exports a single geometry detail specified in ", {"type": "ui", "text": ["SOP Path"]}, " instead of exporting objects contained under a root object."], "extent": [5426, 5566]}], "container": true, "attrs": {"id": "usesoppath"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["SOP Path"], "extent": [5566, 5576], "body": [{"type": "para", "indent": 4, "text": ["The path to the geometry detail to include in the glTF scene."], "extent": [5593, 5660]}], "container": true, "attrs": {"id": "soppath"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Root Object"], "extent": [5660, 5673], "body": [{"type": "para", "indent": 4, "text": ["The root object of the scene. All objects contained under this node will be included in the glTF scene."], "extent": [5687, 5796]}], "container": true, "attrs": {"id": "root"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Objects"], "extent": [5796, 5805], "body": [{"type": "para", "indent": 4, "text": ["A pattern/bundle of objects to include in the glTF scene."], "extent": [5822, 5885]}], "container": true, "attrs": {"id": "objects"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Force Objects"], "extent": [5885, 5900], "body": [{"type": "para", "indent": 4, "text": ["The objects that match the names or patterns of this\n    parameter should always appear in the scene, even if their display flag is off."], "extent": [5922, 6068]}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [6068, 6078], "body": [{"type": "para", "indent": 8, "text": ["This overrides the ", {"type": "ui", "text": ["Objects"]}, " and ", {"type": "ui", "text": ["Exclude Objects"]}, " parameters."], "extent": [6078, 6154]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "forceobjects"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Exclude Objects"], "extent": [6154, 6171], "body": [{"type": "para", "indent": 4, "text": ["Do not include objects in the scene if they match the names or patterns given by this parameter. This overrides the ", {"type": "ui", "text": ["Objects"]}, " parameter."], "extent": [6195, 6339]}], "container": true, "attrs": {"id": "excludeobjects"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Copyright"], "extent": [6339, 6350], "body": [{"type": "para", "indent": 4, "text": ["Sets the copyright information in the exported GLTF file."], "extent": [6369, 6432]}], "container": true, "attrs": {"id": "copyright"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Texture Source"], "extent": [6432, 6448], "body": [{"type": "para", "indent": 4, "text": ["Controls the origin of the textures that are included in the exported GLTF file."], "extent": [6471, 6557]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Export from Material"], "extent": [6557, 6583], "body": [{"type": "para", "indent": 8, "text": ["New texture images will be exported based on the parameters of the\n        material shader and the parameters on the GLTF output node."], "extent": [6583, 6727]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Copy Original Textures"], "extent": [6727, 6755], "body": [{"type": "para", "indent": 8, "text": ["Any supported texture images specified in the material shader will be\n        copied directly to the exported GLTF file, preserving the exact images\n        that were used to build the material."], "extent": [6755, 6959]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "texturesource"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Texture Format"], "extent": [6959, 6975], "body": [{"type": "para", "indent": 4, "text": ["Controls the file format of the exported material textures."], "extent": [6996, 7061]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Original Format or PNG"], "extent": [7061, 7089], "body": [{"type": "para", "indent": 8, "text": ["Textures will be exported in their original formats or as a PNG if a\n        texture\u2019s format is not specified or is unsupported by GLTF."], "extent": [7089, 7236]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Original Format or JPEG"], "extent": [7236, 7265], "body": [{"type": "para", "indent": 8, "text": ["Textures will be exported in their original formats or as a JPEG if a\n        texture\u2019s format is not specified or is unsupported by GLTF."], "extent": [7265, 7413]}], "container": true}, {"type": "dt", "indent": 4, "text": ["PNG"], "extent": [7413, 7422], "body": [{"type": "para", "indent": 8, "text": ["Textures will be exported as PNGs."], "extent": [7422, 7466]}], "container": true}, {"type": "dt", "indent": 4, "text": ["JPEG"], "extent": [7466, 7476], "body": [{"type": "para", "indent": 8, "text": ["Textures will be exported as JPEGs."], "extent": [7476, 7521]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "imageformat"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Texture Quality"], "extent": [7521, 7538], "body": [{"type": "para", "indent": 4, "text": ["The level of compression to apply to outputted textures.  Only applies to lossy image formats (", {"type": "ui", "text": ["Texture Format"]}, " is set to ", {"type": "ui", "text": ["Original Format or JPEG"]}, " or ", {"type": "ui", "text": ["JPEG"]}, ")."], "extent": [7560, 7731]}], "container": true, "attrs": {"id": "imagequality"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Max Texture Resolution"], "extent": [7731, 7755], "body": [{"type": "para", "indent": 4, "text": ["If any texture is larger than this resolution, then downsize it to this resolution.  Useful for quickly reducing the file size."], "extent": [7778, 7911]}], "container": true, "attrs": {"id": "maxresolution"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rescale Texture as Power of Two"], "extent": [7911, 7944], "body": [{"type": "para", "indent": 4, "text": ["When turned on, rescales exported images so that the final image has dimensions that are powers of two (for example, 512\u00d71024, 2048\u00d72048)."], "extent": [7964, 8112]}, {"type": "para", "indent": 4, "text": ["This is required by some low-spec glTF implementations as well as WebGL implementations in older browsers."], "extent": [8112, 8224]}], "container": true, "attrs": {"id": "poweroftwo"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Additional Textures"], "extent": [8224, 8245], "body": [{"type": "para", "indent": 4, "text": ["This multiparm can be used to specify additional textures to include in the exported glTF file. This is useful when you want to export images that aren\u2019t a texture map of any of the materials in the scene that are being exported."], "extent": [8278, 8513]}], "container": true, "attrs": {"id": "additionaltextures"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Texture Name"], "extent": [8513, 8527], "body": [{"type": "para", "indent": 4, "text": ["Optionally specifies the name of the exported texture."], "extent": [8560, 8620]}], "container": true, "attrs": {"id": "additonaltexture#_name"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Texture Image Path"], "extent": [8620, 8640], "body": [{"type": "para", "indent": 4, "text": ["Specifies the path to the texture\u2019s image."], "extent": [8677, 8725]}], "container": true, "attrs": {"id": "additiontexture#_imagepath"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Animation Name"], "extent": [8725, 8741], "body": [{"type": "para", "indent": 4, "text": ["The name of the exported animation."], "extent": [8764, 8805]}], "container": true, "attrs": {"id": "animationname"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Flip Normal Map Y"], "extent": [8805, 8824], "body": [{"type": "para", "indent": 4, "text": ["When turned on, inverts the y-coordinate on the normal texture map for each exported mesh.  glTF\u2019s orientation expects an upwards facing y-axis."], "extent": [8848, 8998]}], "container": true, "attrs": {"id": "flipnormalmapy"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Cull Empty Nodes"], "extent": [8998, 9016], "body": [{"type": "para", "indent": 4, "text": ["When turned on, any object node with no descendants containing geometry is ignored."], "extent": [9035, 9124]}], "container": true, "attrs": {"id": "cullempty"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Custom Attributes"], "extent": [9124, 9150], "body": [{"type": "para", "indent": 4, "text": ["When turned on, all public attributes are exported. When turned off, only attributes defined in the glTF standard are exported."], "extent": [9172, 9305]}, {"type": "para", "indent": 4, "text": ["Attributes are exported with their original types whenever possible.  However, glTF allows a maximum of 32 bits for floats and integers.  Integers are also required to be unsigned. Attempting to export a datatype larger than this will narrow the type and print a warning."], "extent": [9305, 9582]}, {"type": "para", "indent": 4, "text": ["Exported custom attribute names are the original names plus an ", {"type": "code", "text": ["_"]}, " (underscore) prefix."], "extent": [9582, 9675]}, {"type": "para", "indent": 4, "text": ["As glTF only supports point attributes, name collisions will be resolved using the normal attribute resolution order."], "extent": [9675, 9798]}], "container": true, "attrs": {"id": "exportcustom"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Node Names"], "extent": [9798, 9817], "body": [{"type": "para", "indent": 4, "text": ["Assigns Houdini node names to the name field of glTF objects. The name attribute on packed primitives will also be exported."], "extent": [9838, 9968]}, {"type": "para", "indent": 4, "text": ["Names are assigned to materials, transformation nodes, and geometry."], "extent": [9968, 10042]}], "container": true, "attrs": {"id": "exportnames"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Mesh Names"], "extent": [10042, 10061], "body": [{"type": "para", "indent": 4, "text": ["When turned on, mesh names will be exported to the GLTF mesh name fields. The ", {"type": "ui", "text": ["Mesh Names Source"]}, " parameter controls the naming of the mesh."], "extent": [10086, 10234]}], "container": true, "attrs": {"id": "exportmeshnames"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Mesh Names Source"], "extent": [10234, 10253], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Node Name"], "extent": [10279, 10294], "body": [{"type": "para", "indent": 8, "text": ["The GLTF mesh name will be assigned the name of the SOP node of the exported mesh."], "extent": [10294, 10386]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Attribute"], "extent": [10386, 10401], "body": [{"type": "para", "indent": 8, "text": ["The GLTF mesh name will be assigned the name stored in the attribute specified by the ", {"type": "ui", "text": ["Mesh Name Attribute"]}, " parameter. It can be any type of attribute, but it must have a consistent value."], "extent": [10401, 10601]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "meshnamessource"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Mesh Name Attribute"], "extent": [10601, 10622], "body": [{"type": "para", "indent": 4, "text": ["The name of the attribute that contains the mesh name\u2019s value."], "extent": [10651, 10719]}], "container": true, "attrs": {"id": "meshnamesattribute"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Materials"], "extent": [10719, 10737], "body": [{"type": "para", "indent": 4, "text": ["When turned on, this option exports Principled Shader materials. Materials are exported as a combination of emissive maps, normal maps, and pbrMetallicRoughness materials. All associated textures and images used by the material are exported alongside the material. Some Principled Shader options such as ambient occlusion and subsurface scattering are not exported.  "], "extent": [10762, 11135]}, {"type": "para", "indent": 4, "text": ["Materials that do not use the Principled Shader will be ignored."], "extent": [11135, 11205]}], "container": true, "attrs": {"id": "exportmaterials"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Cameras"], "extent": [11205, 11221], "body": [{"type": "para", "indent": 4, "text": ["When turned on, includes camera objects matching the ", {"type": "ui", "text": ["Objects"]}, " pattern/bundle in the glTF scene."], "extent": [11244, 11348]}], "container": true, "attrs": {"id": "exportcameras"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Export Lights"], "extent": [11348, 11363], "body": [{"type": "para", "indent": 4, "text": ["When turned on, includes light objects matching the ", {"type": "ui", "text": ["Objects"]}, " pattern/bundle in the glTF scene. "], "extent": [11385, 11489]}, {"type": "para", "indent": 4, "text": ["Importers for this scene will need to support the KHR_lights_punctual glTF extension in order to include the lights. This extension only supports 3 light types: directional, point, and spot."], "extent": [11489, 11685]}], "container": true, "attrs": {"id": "exportlights"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Scripts "], "extent": [11685, 11701]}, {"type": "para", "indent": 4, "text": ["A script command can be specified for execution at various execution\n    points. The expression language selected for the script parameter determines\n    whether the command is in hscript or python."], "extent": [7064, 7269]}, {"type": "para", "indent": 4, "text": ["Prior to execution, this node is automatically set as the global current\n    node."], "extent": [7269, 7357]}, {"type": "para", "indent": 4, "text": ["To run statements from a file, specify the path to the file with\n    either a ", {"type": "code", "text": [".cmd"]}, " extension (when the language is set to ", {"type": "ui", "text": ["Hscript"]}, ") or a ", {"type": "code", "text": [".py"]}, "\n    extension (when the language is set to ", {"type": "ui", "text": ["Python"]}, "). Additional arguments to the\n    script can also be supplied. They will be parsed in a shell-like manner."], "extent": [7357, 7671]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Pre-Render Script"], "extent": [7671, 7694], "body": [{"type": "para", "indent": 8, "text": ["Run this script before any rendering."], "extent": [7717, 7764]}], "container": true, "attrs": {"id": "prerender"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Pre-Frame Script"], "extent": [7764, 7786], "body": [{"type": "para", "indent": 8, "text": ["Run this script before each frame."], "extent": [7808, 7852]}], "container": true, "attrs": {"id": "preframe"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Post-Frame Script"], "extent": [7852, 7875], "body": [{"type": "para", "indent": 8, "text": ["Run this script after each frame."], "extent": [7898, 7941]}], "container": true, "attrs": {"id": "postframe"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Post-Write Script"], "extent": [7941, 7964], "body": [{"type": "para", "indent": 8, "text": ["Run this script after each frame\u2019s data finishes writing to disk."], "extent": [7987, 8062]}], "container": true, "attrs": {"id": "postwrite"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Post-Render Script"], "extent": [8062, 8086], "body": [{"type": "para", "indent": 8, "text": ["Run this script after all rendering."], "extent": [8110, 8156]}], "container": true, "attrs": {"id": "postrender"}, "role": "item"}], "container": true}], "text": "Parameters"}], "title": ["glTF ROP output driver"], "included": ["/nodes/out/gltf-", "/nodes/out/standard"]}