{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "diff", "icon": "COP2/diff", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Diff"], "extent": [72, 81]}, {"type": "summary", "indent": 0, "text": ["Computes the difference between the foreground image and the\nbackground image."], "extent": [81, 168]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Produces a difference matte of the two images by subtracting one from\nthe other, and taking the absolute value of the difference (ensuring\nthat the difference is always positive). The Diff operation is defined\nas:"], "extent": [211, 426]}, {"type": "para", "indent": 0, "text": [{"type": "code", "text": ["C = |C2 - C1|"]}], "extent": [426, 443]}, {"type": "para", "indent": 0, "text": ["Diff is sometimes preferable to Subtract because no negative values are\nproduced, making it easier to spot differences."], "extent": [443, 565]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [565, 570], "body": [{"type": "para", "indent": 4, "text": ["The Layer COP allows multiple inputs to be composited instead of\n    just two, each with its own compositing operation. The Composite COP\n    is the more general version of this COP, allowing you to choose any\n    compositing operation, and an optionally different operation for\n    alpha."], "extent": [570, 865]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Masking"], "extent": [56, 74], "body": [{"type": "para", "indent": 8, "text": ["This operation may be masked, which restricts the operation to\n        an area of the image. The mask may be inverted, brightened or\n        dimmed."], "extent": [74, 233]}, {"type": "para", "indent": 8, "text": ["The mask input is on the side of the node. The label on the\n        connector indicates the plane being used as a mask."], "extent": [233, 362]}, {"type": "para", "indent": 8, "text": ["The mask input can also be scaled to fit the output image\u2019s resolution, if they differ. If this node is changing constantly, and the mask is not, it is somewhat faster to put a ", {"scheme": "Node", "value": "/nodes/cop2/scale", "type": "link", "text": ["Scale COP"], "fullpath": "/nodes/cop2/scale.html"}, " down to do the resize for the mask image. Otherwise, the scale will occur every time this node cooks."], "extent": [362, 678]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [907, 919], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Composite"], "extent": [919, 940], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Image Units"], "extent": [940, 962], "body": [{"type": "para", "indent": 12, "text": ["Selects pixels or UV units for the transform."], "extent": [962, 1020]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Translate, Rotate, Scale, Pivot"], "extent": [1020, 1061], "body": [{"type": "para", "indent": 12, "text": ["Transforms the foreground in X,Y relative to the\n            background."], "extent": [1061, 1146]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Filter"], "extent": [1146, 1168], "body": [{"type": "para", "indent": 12, "text": ["Specifies the filter to use when transforming."], "extent": [1168, 1227]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Wrap"], "extent": [1227, 1247], "body": [{"type": "para", "indent": 12, "text": ["Specifies the foreground image\u2019s wrapping style."], "extent": [1247, 1308]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur"], "extent": [1308, 1329], "body": [{"type": "para", "indent": 12, "text": ["Toggles on motion blur, and specifies the time range around\n            the current frame to blur."], "extent": [1329, 1440]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Frame Bias"], "extent": [1440, 1467], "body": [{"type": "para", "indent": 12, "text": ["Shifts the time range for the blur."], "extent": [1467, 1515]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Segments"], "extent": [1515, 1545], "body": [{"type": "para", "indent": 12, "text": ["Number of samples to blur together in the specified time\n            range."], "extent": [1545, 1633]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Method"], "extent": [1633, 1662], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Velocity"], "extent": [1662, 1684], "body": [{"type": "para", "indent": 16, "text": ["Only uses the current frame and the transform to compute\n                past and future positions."], "extent": [1684, 1800]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Deformation"], "extent": [1800, 1825], "body": [{"type": "para", "indent": 16, "text": ["Cooks the images at all time samples."], "extent": [1825, 1880]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Merge"], "extent": [1880, 1896], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Overview"], "extent": [1896, 1915], "body": [{"type": "para", "indent": 12, "text": ["These parameters specify how to build the output sequence\n            when there are differences between the input sequences."], "extent": [1915, 2053]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Plane Merge"], "extent": [2053, 2074], "body": [{"type": "para", "indent": 12, "text": ["If the planes in the inputs differ, this specifies what the\n            output planes should be."], "extent": [2074, 2183]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Raster Depth"], "extent": [2183, 2205], "body": [{"type": "para", "indent": 12, "text": ["If the raster depth for a given plane differs between\n            inputs, this specifies what the output raster depth for the\n            plane should be."], "extent": [2205, 2372]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [2372, 2393], "body": [{"type": "para", "indent": 12, "text": ["If the frame ranges of the inputs differ, this determines\n            what the output range should be."], "extent": [2393, 2508]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Rate"], "extent": [2508, 2528], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            what the output frame rate should be."], "extent": [2528, 2647]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Match"], "extent": [2647, 2668], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            which input frame to pick when the cook time doesn\u2019t reside\n            on a frame boundary."], "extent": [2668, 2842]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Mask"], "extent": [706, 722], "body": [{"type": "para", "indent": 8, "text": ["A mask can be chosen to limit the effect of the operator to\n        areas defined by the mask. The mask can be taken from the mask\n        input (side input) or from the first input itself."], "extent": [722, 922]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Effect Amount"], "extent": [922, 945], "body": [{"type": "para", "indent": 12, "text": ["If no mask is present, this blends the output with the input\n            by a constant amount (0 = all input, 1 = all output)."], "extent": [983, 1123]}, {"type": "para", "indent": 12, "text": ["If a mask is present, this amount multiplies the mask."], "extent": [1123, 1191]}], "container": true, "attrs": {"channels": "/effectamount"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Operation Mask"], "extent": [1191, 1215], "body": [{"type": "para", "indent": 12, "text": ["Selects the mask plane to use as a mask from the mask input.\n            The mask can be selected from:"], "extent": [1261, 1378]}, {"type": "para", "indent": 12, "text": ["A mask can be a component of a plane or an entire plane. If\n            a vector plane is supplied as a mask, its components are\n            multiplied by the images' components."], "extent": [1378, 1570]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Scalar Mask ('A', 'C.r')"]}], "extent": [1570, 1610]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M\n            C.g = I.g * M\n            C.b = I.b * M\n            \n            "], "extent": [1610, 1733]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Vector Mask ('C')"]}], "extent": [1733, 1766]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M.r\n            C.g = I.g * M.g\n            C.b = I.b * M.b\n            \n            "], "extent": [1766, 1895]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["First Input"], "extent": [1895, 1921], "body": [{"type": "para", "indent": 16, "text": ["Useful for masking the operation to the image\u2019s own\n                alpha plane."], "extent": [1921, 2018]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Mask Input"], "extent": [2018, 2042], "body": [{"type": "para", "indent": 16, "text": ["Selects the mask from the side mask input."], "extent": [2042, 2101]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Off"], "extent": [2101, 2118], "body": [{"type": "para", "indent": 16, "text": ["Turns off masking, without requiring disconnection of\n                the mask input (useful for temporarily disabling the\n                mask)."], "extent": [2118, 2280]}], "container": true}], "container": true}], "container": true, "attrs": {"channels": "/maskinput /maskplane"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Resize Mask to Fit Image"], "extent": [2280, 2314], "body": [{"type": "para", "indent": 12, "text": ["If the mask image is a different resolution than the output\n            image, turning on this parameter will scale the mask to the\n            output image\u2019s resolution."], "extent": [2314, 2498]}, {"type": "para", "indent": 12, "text": ["If this node is changing constantly, and the mask is not, it\n            is somewhat faster to put a Scale COP down to do the resize\n            for the mask image. Otherwise, the scale will occur every\n            time this node cooks."], "extent": [2498, 2748]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Invert Mask"], "extent": [2748, 2769], "body": [{"type": "para", "indent": 12, "text": ["Inverts the mask so that all fully 'masked' portions become\n            unmasked. This saves you from inserting an Invert COP after\n            the node with the mask."], "extent": [2769, 2949]}], "container": true, "role": "item"}], "container": true}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [2878, 2886], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2912, 2921], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/subtract", "type": "link", "text": "", "fullpath": "/nodes/cop2/subtract.html"}], "extent": [2921, 2948]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/composite", "type": "link", "text": "", "fullpath": "/nodes/cop2/composite.html"}], "extent": [2948, 2976]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/layer", "type": "link", "text": "", "fullpath": "/nodes/cop2/layer.html"}], "extent": [2976, 3001]}], "container": true}], "text": "Related"}], "title": ["Diff"], "summary": ["Computes the difference between the foreground image and the\nbackground image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/maskparms"]}