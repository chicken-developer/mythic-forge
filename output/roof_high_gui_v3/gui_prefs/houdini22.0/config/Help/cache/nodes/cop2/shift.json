{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "shift", "icon": "COP2/shift", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Shift"], "extent": [74, 84]}, {"type": "summary", "indent": 0, "text": ["Shifts an image sequence in time."], "extent": [84, 126]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation shifts an image sequence in time. An optional second\ninput can be used as a reference, so that this sequence becomes 'linked'\nto the start or end of the reference sequence and shifts if they\nchange."], "extent": [169, 384]}, {"type": "para", "indent": 0, "text": ["This operation does not use any cache memory."], "extent": [384, 431]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [431, 437], "body": [{"type": "para", "indent": 4, "text": ["This operator\u2019s parameters can not be animated (as they affect time)."], "extent": [437, 513]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [513, 525], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Shift Method"], "extent": [525, 543], "body": [{"type": "para", "indent": 8, "text": ["Sequences can be shifted in several ways if no reference input\n        is connected."], "extent": [543, 637]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Relative Shift"], "extent": [637, 661], "body": [{"type": "para", "indent": 12, "text": ["Shifts the amount specified by the Shift Value."], "extent": [661, 721]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Shift Start to Shift Value"], "extent": [721, 757], "body": [{"type": "para", "indent": 12, "text": ["Starts at the point specified by Shift Value."], "extent": [757, 815]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Shift End to Shift Value"], "extent": [815, 849], "body": [{"type": "para", "indent": 12, "text": ["Shifts the image sequence such that it ends at the point\n            specified by the Shift Value."], "extent": [849, 960]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Input Shift"], "extent": [960, 977], "body": [{"type": "para", "indent": 8, "text": ["If a reference input is connected, several different ways of\n        linking the two sequences together can be used. The sequence\n        will always follow any changes in the reference sequence\u2019s start\n        or end time."], "extent": [977, 1210]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Align Start with 2nd Input\u2019s Start"], "extent": [1210, 1254], "body": [{"type": "para", "indent": 12, "text": ["Make the output sequence start at the same time as the sequence attached to input #2."], "extent": [1254, 1365]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Align End with 2nd Input\u2019s End"], "extent": [1365, 1405], "body": [{"type": "para", "indent": 12, "text": ["Make the output sequence end at the same time as the sequence attached to input #2."], "extent": [1405, 1514]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Shift To Precede 2nd Input"], "extent": [1514, 1550], "body": [{"type": "para", "indent": 12, "text": ["Output sequence will end on the frame just before the second input starts."], "extent": [1550, 1650]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Shift To Follow 2nd Input"], "extent": [1650, 1685], "body": [{"type": "para", "indent": 12, "text": ["Output sequence will start on the frame after 2nd input ends."], "extent": [1685, 1768]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Shift Value"], "extent": [1768, 1785], "body": [{"type": "para", "indent": 8, "text": ["The amount to shift by, in either frames or seconds."], "extent": [1785, 1846]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Units"], "extent": [1846, 1857], "body": [{"type": "para", "indent": 8, "text": ["The shift units, either Frames or Seconds."], "extent": [1857, 1908]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1908, 1916], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1942, 1951], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/shuffle", "type": "link", "text": "", "fullpath": "/nodes/cop2/shuffle.html"}], "extent": [1951, 1977]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/sequence", "type": "link", "text": "", "fullpath": "/nodes/cop2/sequence.html"}], "extent": [1977, 2004]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/snip", "type": "link", "text": "", "fullpath": "/nodes/cop2/snip.html"}], "extent": [2004, 2027]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/timescale", "type": "link", "text": "", "fullpath": "/nodes/cop2/timescale.html"}], "extent": [2027, 2055]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/trim", "type": "link", "text": "", "fullpath": "/nodes/cop2/trim.html"}], "extent": [2055, 2079]}], "container": true}], "text": "Related"}], "title": ["Shift"], "summary": ["Shifts an image sequence in time."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}