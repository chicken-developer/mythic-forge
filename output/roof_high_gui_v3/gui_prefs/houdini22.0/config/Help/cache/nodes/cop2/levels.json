{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "levels", "icon": "COP2/levels", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Levels"], "extent": [76, 87]}, {"type": "summary", "indent": 0, "text": ["Adjusts black point, white point, and midrange to increase, balance,\nor decrease contrast."], "extent": [87, 186]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["You can adjust levels globally (affecting all channels) with the\n", {"type": "ui", "text": ["Value"]}, " tab, or per-channel adjustments with the ", {"type": "ui", "text": ["R"]}, ", ", {"type": "ui", "text": ["G"]}, ", ", {"type": "ui", "text": ["B"]}, ",\nor ", {"type": "ui", "text": ["Comp 4"]}, " tabs."], "extent": [229, 387]}, {"type": "para", "indent": 0, "text": ["This operator applies component adjustments before global adjustments."], "extent": [387, 459]}, {"type": "para", "indent": 0, "text": ["Input Levels are used to compress the black and white point range,\nincreasing contrast. Gamma is applied as a midrange adjustment on the\nrange specified using Input Levels. Output Levels stretch the black and\nwhite point range, decreasing contrast."], "extent": [459, 709]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [709, 721], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Levels"], "extent": [721, 735], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Value"], "extent": [735, 751], "body": [{"type": "para", "indent": 4, "text": ["Adjust tonal range across all channels."], "extent": [751, 797]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Input Levels"], "extent": [797, 815], "body": [{"type": "para", "indent": 8, "text": ["Adjust black and white points to increase contrast."], "extent": [853, 914]}], "container": true, "attrs": {"channels": "/frommax /frommin"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Gamma"], "extent": [914, 925], "body": [{"type": "para", "indent": 8, "text": ["Adjust midrange balance. Note that the histogram\n        viewport gamma slider maps from 10.0 \u2013> 0.1\n        logarithmically, thus behaving as a midrange adjustment,\n        whereas the parameter dialog sliders map gamma\n        logarithmically from 0.1 \u2013> 10.0."], "extent": [952, 1226]}], "container": true, "attrs": {"channels": "/gamma"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Levels"], "extent": [1226, 1245], "body": [{"type": "para", "indent": 8, "text": ["Remaps the result of Input Levels and Gamma to reduce\n        contrast."], "extent": [1279, 1361]}], "container": true, "attrs": {"channels": "/tomax /tomin"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["R"], "extent": [1361, 1371], "body": [{"type": "para", "indent": 4, "text": ["Adjust tonal range for Red channel."], "extent": [1371, 1413]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Input Levels"], "extent": [1413, 1431], "body": [{"type": "para", "indent": 8, "text": ["Adjust black and white points to increase contrast."], "extent": [1475, 1536]}], "container": true, "attrs": {"channels": "/redfrommax /redfrommin"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Gamma"], "extent": [1536, 1547], "body": [{"type": "para", "indent": 8, "text": ["Adjust midrange balance."], "extent": [1572, 1606]}], "container": true, "attrs": {"channels": "/red"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Levels"], "extent": [1606, 1625], "body": [{"type": "para", "indent": 8, "text": ["Remaps the result of Input Levels and Gamma to reduce\n        contrast."], "extent": [1665, 1747]}], "container": true, "attrs": {"channels": "/redtomax /redtomin"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["G"], "extent": [1747, 1757], "body": [{"type": "para", "indent": 4, "text": ["Adjust tonal range for Green channel."], "extent": [1757, 1801]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Input Levels"], "extent": [1801, 1819], "body": [{"type": "para", "indent": 8, "text": ["Adjust black and white points to increase contrast."], "extent": [1867, 1928]}], "container": true, "attrs": {"channels": "/greenfrommax /greenfrommin"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Gamma"], "extent": [1928, 1939], "body": [{"type": "para", "indent": 8, "text": ["Adjust midrange balance."], "extent": [1966, 2000]}], "container": true, "attrs": {"channels": "/green"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Levels"], "extent": [2000, 2019], "body": [{"type": "para", "indent": 8, "text": ["Remaps the result of Input Levels and Gamma to reduce\n        contrast."], "extent": [2063, 2145]}], "container": true, "attrs": {"channels": "/greentomax /greentomin"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["B"], "extent": [2145, 2155], "body": [{"type": "para", "indent": 4, "text": ["Adjust tonal range for Blue channel."], "extent": [2155, 2198]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Input Levels"], "extent": [2198, 2216], "body": [{"type": "para", "indent": 8, "text": ["Adjust black and white points to increase contrast."], "extent": [2262, 2323]}], "container": true, "attrs": {"channels": "/bluefrommax /bluefrommin"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Gamma"], "extent": [2323, 2334], "body": [{"type": "para", "indent": 8, "text": ["Adjust midrange balance."], "extent": [2360, 2394]}], "container": true, "attrs": {"channels": "/blue"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Levels"], "extent": [2394, 2413], "body": [{"type": "para", "indent": 8, "text": ["Remaps the result of Input Levels and Gamma to reduce\n        contrast."], "extent": [2455, 2537]}], "container": true, "attrs": {"channels": "/bluetomax /bluetomin"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["A"], "extent": [2537, 2547], "body": [{"type": "para", "indent": 4, "text": ["Adjust tonal range for Alpha channel."], "extent": [2547, 2591]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Input Levels"], "extent": [2591, 2609], "body": [{"type": "para", "indent": 8, "text": ["Adjust black and white points to increase contrast."], "extent": [2657, 2718]}], "container": true, "attrs": {"channels": "/alphafrommax /alphafrommin"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Gamma"], "extent": [2718, 2729], "body": [{"type": "para", "indent": 8, "text": ["Adjust midrange balance."], "extent": [2756, 2790]}], "container": true, "attrs": {"channels": "/alpha"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Levels"], "extent": [2790, 2809], "body": [{"type": "para", "indent": 8, "text": ["Remaps the result of Input Levels and Gamma to reduce\n        contrast."], "extent": [2853, 2935]}], "container": true, "attrs": {"channels": "/alphatomax /alphatomin"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Comp 4"], "extent": [2935, 2950], "body": [{"type": "para", "indent": 4, "text": ["Adjust tonal range for Component 4 channel."], "extent": [2950, 3000]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Input Levels"], "extent": [3000, 3018], "body": [{"type": "para", "indent": 8, "text": ["Adjust black and white points to increase contrast."], "extent": [3066, 3127]}], "container": true, "attrs": {"channels": "/comp4frommax /comp4frommin"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Gamma"], "extent": [3127, 3138], "body": [{"type": "para", "indent": 8, "text": ["Adjust midrange balance."], "extent": [3165, 3199]}], "container": true, "attrs": {"channels": "/comp4"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Levels"], "extent": [3199, 3218], "body": [{"type": "para", "indent": 8, "text": ["Remaps the result of Input Levels and Gamma to reduce\n        contrast."], "extent": [3262, 3343]}], "container": true, "attrs": {"channels": "/comp4tomax /comp4tomin"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Show Color Curves"], "extent": [3343, 3362], "body": [{"type": "para", "indent": 4, "text": ["Pops up a viewer showing the color curves applied to the\n    image."], "extent": [3362, 3435]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Show Histogram"], "extent": [3435, 3451], "body": [{"type": "para", "indent": 4, "text": ["Pops up a viewer showing the histogram of the image, with\n    sliders to control the levels."], "extent": [3451, 3549]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}, {"tag": "div", "attrs": {"id": "coppixelopdescription"}, "type": "pxml", "indent": 0, "extent": [26, 59], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Collapsible Pixel Operation"], "extent": [59, 97], "body": [{"type": "para", "indent": 8, "text": ["This is a collapsible pixel operation. When placed in sequence\n        with other collapsible pixel operations, the operations are\n        combined into one operation at the final node in the pixel\n        operation sequence. This is known as a collapsible pixel\n        operation chain."], "extent": [97, 395]}, {"type": "para", "indent": 8, "text": ["Image data flowing through the chain is only quantized at the\n        end of the chain. This allows the intermediate operations to\n        produce and carry values outside the normal range of the pixels'\n        data format, with floating point precision. The net result of\n        this is a reduction in quantization error and black/white\n        clipping (especially useful for integer formats)."], "extent": [395, 802]}, {"type": "para", "indent": 8, "text": ["Collapsible pixel operations are recognizable by the light blue\n        background color of the node\u2019s icon. If a node of a different\n        color is inserted between two collapsible COPs, the chain will\n        be broken at that point and the operations will not collapse\n        anymore."], "extent": [802, 1102]}, {"type": "para", "indent": 8, "text": ["Collapsible pixel operations are maskable and scopable. If one\n        operation in the chain is masked, but the others are not (or do\n        not share the same mask), the chain will be 'broken' at that\n        point and quantization will occur at that node. Differences in\n        scoping does not cause a break in the chain."], "extent": [1102, 1439]}]}], "container": true}, {"tag": "parameters", "attrs": {"id": "pixelopparms"}, "type": "pxml", "indent": 0, "extent": [1439, 1470], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Collapsible Pixel Operation Parameters"], "extent": [1470, 1520], "body": [{"type": "para", "indent": 8, "text": ["Collapsible pixel operations can be combined with other\n        collapsible pixel operations and have the result computed in one\n        pass, rather than at each node. The operations must be in\n        sequence, without other nodes between them."], "extent": [1520, 1777]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Do Operation in Unpremultiplied Space"], "extent": [1777, 1824], "body": [{"type": "para", "indent": 12, "text": ["The Color plane will the divided by the input alpha, and\n            multiplied by the output alpha so that the color operation\n            is done in unpremultiplied space. If this operation is in a\n            collapsible chain, all the nodes in the chain must have the\n            same setting of this parameter to avoid breaking the chain\n            and quantizing."], "extent": [1824, 2207]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Quantize"], "extent": [2207, 2225], "body": [{"type": "para", "indent": 12, "text": ["If this node is in the middle of a collapsible pixel chain,\n            you can force this node to quantize and store the images at\n            this node."], "extent": [2225, 2392]}], "container": true, "role": "item"}], "container": true}]}], "container": true}, {"tag": "div", "attrs": {"id": "copmaskdescription"}, "type": "pxml", "indent": 0, "extent": [26, 56], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Masking"], "extent": [56, 74], "body": [{"type": "para", "indent": 8, "text": ["This operation may be masked, which restricts the operation to\n        an area of the image. The mask may be inverted, brightened or\n        dimmed."], "extent": [74, 233]}, {"type": "para", "indent": 8, "text": ["The mask input is on the side of the node. The label on the\n        connector indicates the plane being used as a mask."], "extent": [233, 362]}, {"type": "para", "indent": 8, "text": ["The mask input can also be scaled to fit the output image\u2019s resolution, if they differ. If this node is changing constantly, and the mask is not, it is somewhat faster to put a ", {"scheme": "Node", "value": "/nodes/cop2/scale", "type": "link", "text": ["Scale COP"], "fullpath": "/nodes/cop2/scale.html"}, " down to do the resize for the mask image. Otherwise, the scale will occur every time this node cooks."], "extent": [362, 678]}]}], "container": true}, {"tag": "parameters", "attrs": {"id": "maskparms"}, "type": "pxml", "indent": 0, "extent": [678, 706], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Mask"], "extent": [706, 722], "body": [{"type": "para", "indent": 8, "text": ["A mask can be chosen to limit the effect of the operator to\n        areas defined by the mask. The mask can be taken from the mask\n        input (side input) or from the first input itself."], "extent": [722, 922]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Effect Amount"], "extent": [922, 945], "body": [{"type": "para", "indent": 12, "text": ["If no mask is present, this blends the output with the input\n            by a constant amount (0 = all input, 1 = all output)."], "extent": [983, 1123]}, {"type": "para", "indent": 12, "text": ["If a mask is present, this amount multiplies the mask."], "extent": [1123, 1191]}], "container": true, "attrs": {"channels": "/effectamount"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Operation Mask"], "extent": [1191, 1215], "body": [{"type": "para", "indent": 12, "text": ["Selects the mask plane to use as a mask from the mask input.\n            The mask can be selected from:"], "extent": [1261, 1378]}, {"type": "para", "indent": 12, "text": ["A mask can be a component of a plane or an entire plane. If\n            a vector plane is supplied as a mask, its components are\n            multiplied by the images' components."], "extent": [1378, 1570]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Scalar Mask ('A', 'C.r')"]}], "extent": [1570, 1610]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M\n            C.g = I.g * M\n            C.b = I.b * M\n            \n            "], "extent": [1610, 1733]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Vector Mask ('C')"]}], "extent": [1733, 1766]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M.r\n            C.g = I.g * M.g\n            C.b = I.b * M.b\n            \n            "], "extent": [1766, 1895]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["First Input"], "extent": [1895, 1921], "body": [{"type": "para", "indent": 16, "text": ["Useful for masking the operation to the image\u2019s own\n                alpha plane."], "extent": [1921, 2018]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Mask Input"], "extent": [2018, 2042], "body": [{"type": "para", "indent": 16, "text": ["Selects the mask from the side mask input."], "extent": [2042, 2101]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Off"], "extent": [2101, 2118], "body": [{"type": "para", "indent": 16, "text": ["Turns off masking, without requiring disconnection of\n                the mask input (useful for temporarily disabling the\n                mask)."], "extent": [2118, 2280]}], "container": true}], "container": true}], "container": true, "attrs": {"channels": "/maskinput /maskplane"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Resize Mask to Fit Image"], "extent": [2280, 2314], "body": [{"type": "para", "indent": 12, "text": ["If the mask image is a different resolution than the output\n            image, turning on this parameter will scale the mask to the\n            output image\u2019s resolution."], "extent": [2314, 2498]}, {"type": "para", "indent": 12, "text": ["If this node is changing constantly, and the mask is not, it\n            is somewhat faster to put a Scale COP down to do the resize\n            for the mask image. Otherwise, the scale will occur every\n            time this node cooks."], "extent": [2498, 2748]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Invert Mask"], "extent": [2748, 2769], "body": [{"type": "para", "indent": 12, "text": ["Inverts the mask so that all fully 'masked' portions become\n            unmasked. This saves you from inserting an Invert COP after\n            the node with the mask."], "extent": [2769, 2949]}], "container": true, "role": "item"}], "container": true}]}], "container": true}, {"tag": "div", "attrs": {"id": "coppixeldescription"}, "type": "pxml", "indent": 0, "extent": [26, 57], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scoping"], "extent": [57, 75], "body": [{"type": "para", "indent": 8, "text": ["This operation may be restricted to certain planes, or\n        components of planes. In addition, the operation may be applied\n        to a subset of frames within the sequence. An image must have\n        both its frame and plane scoped to be modified."], "extent": [75, 338]}, {"type": "para", "indent": 8, "text": ["Images that are not modified are passed through, which does not\n        take any memory or processing time."], "extent": [338, 455]}]}], "container": true}, {"tag": "parameters", "attrs": {"id": "pixelparms"}, "type": "pxml", "indent": 0, "extent": [455, 484], "body": [{"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scope"], "extent": [484, 501], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Plane Scope"], "extent": [501, 523], "body": [{"type": "para", "indent": 12, "text": ["Specifies the scope for both the RGB components of Color,\n            Alpha, and other planes. The (C)RGBA mask only affects Color\n            components and Alpha. 'C' will toggle all the RGB\n            components."], "extent": [523, 753]}, {"type": "para", "indent": 12, "text": ["For planes other than Color and Alpha, the plane name (plus\n            component, if applicable) should be specified in the string\n            field. The pulldown menu can be used to select planes or\n            components present in this node."], "extent": [753, 1012]}, {"type": "para", "indent": 12, "text": ["A plane is specified by its name. A component is specified\n            by both its plane and component name. The '*' wildcard may\n            be used to scope all extra planes. Any number of planes or\n            components can be specified, separated by spaces."], "extent": [1012, 1288]}, {"type": "para", "indent": 12, "text": ["Examples:"], "extent": [1288, 1311]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            P\n            N.x N.y\n            P N Pz\n            "], "extent": [1311, 1396]}], "container": true, "role": "item"}], "container": true}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Frame Scope"], "extent": [1396, 1419], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Frame Scope"], "extent": [1419, 1441], "body": [{"type": "para", "indent": 12, "text": ["Allows scoping of specific frames in the frame range. This\n            is in addition to the plane scope (so a plane at a certain\n            frame must be both plane scoped and frame scoped to be\n            modified)."], "extent": [1441, 1674]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["All Frames"], "extent": [1674, 1698], "body": [{"type": "para", "indent": 16, "text": ["All frames are scoped."], "extent": [1698, 1737]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Inside Range"], "extent": [1737, 1763], "body": [{"type": "para", "indent": 16, "text": ["All frames inside a subrange are scoped."], "extent": [1763, 1820]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Outside Range"], "extent": [1820, 1847], "body": [{"type": "para", "indent": 16, "text": ["All frames outside a subrange are scoped."], "extent": [1847, 1905]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Even Frames"], "extent": [1905, 1930], "body": [{"type": "para", "indent": 16, "text": ["Even numbered frames are scoped."], "extent": [1930, 1979]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Odd Frames"], "extent": [1979, 2003], "body": [{"type": "para", "indent": 16, "text": ["Odd numbered frames are scoped."], "extent": [2003, 2051]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Specific Frames"], "extent": [2051, 2080], "body": [{"type": "para", "indent": 16, "text": ["A user-defined list of frames are scoped."], "extent": [2080, 2138]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [2138, 2159], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside range, this parameter specifies the\n            subrange of the sequence to scope (or unscope). This can be\n            edited in Timeline viewer mode (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2201, 2409]}], "container": true, "attrs": {"channels": "/frange1 /frange2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Dropoff"], "extent": [2409, 2432], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside Range, this parameter specifies certain\n            number of frames before and after to slowly ramp up to\n            scoped. The operation will be blended with its input to\n            'ease in' or 'ease out' the scoping effect over a number of\n            frames. This can be edited in Timeline viewer mode\n            (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2478, 2857]}], "container": true, "attrs": {"channels": "/fdropoff1 /fdropoff2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Non-scoped Effect"], "extent": [2857, 2884], "body": [{"type": "para", "indent": 12, "text": ["For unscoped frames, this sets the blend factor between the\n            input and modified images. Normally this is zero (use the\n            input image). By setting this to a non-zero value, you can\n            make unscoped frames be 'slightly' unscoped. The value can\n            vary between 0 (unscoped) and 1 (scoped)."], "extent": [2918, 3256]}], "container": true, "attrs": {"channels": "/foutside"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame List"], "extent": [3256, 3276], "body": [{"type": "para", "indent": 12, "text": ["The frame list for 'Specific Frames'. Frame numbers should\n            be separated by spaces."], "extent": [3307, 3414]}], "container": true, "attrs": {"channels": "/flist"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Automatically Adjust for Length Changes"], "extent": [3414, 3463], "body": [{"type": "para", "indent": 12, "text": ["If the sequence range changes, enabling this parameter will\n            adjust the subrange and frame dropoff lengths to fit the new\n            range."], "extent": [3463, 3627]}], "container": true, "role": "item"}], "container": true}]}], "container": true}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [3616, 3624], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [3647, 3656], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop2/colorcorrect", "type": "link", "text": "", "fullpath": "/nod