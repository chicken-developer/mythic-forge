{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "fieldswap", "icon": "COP2/fieldswap", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Field Swap"], "extent": [82, 97]}, {"type": "summary", "indent": 0, "text": ["Swaps the two fields containing the even and odd scanlines of the\nframe."], "extent": [97, 178]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation swaps the two fields containing the even and odd\nscanlines of the frame. If the sequence is interlaced or has already\nbeen interlaced with a Field Split operation, then it will just swap the\nframes representing even and odd scanlines. If the sequence is not\ninterlaced, then the even and odd scanlines are swapped within a frame."], "extent": [221, 569]}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [569, 578], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldmerge", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldmerge.html"}], "extent": [578, 607]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldsplit", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldsplit.html"}], "extent": [607, 636]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pulldown", "type": "link", "text": "", "fullpath": "/nodes/cop2/pulldown.html"}], "extent": [636, 663]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pushup", "type": "link", "text": "", "fullpath": "/nodes/cop2/pushup.html"}], "extent": [663, 689]}], "container": true}], "text": "Related"}], "title": ["Field Swap"], "summary": ["Swaps the two fields containing the even and odd scanlines of the\nframe."], "included": ["/composite/_old_cops_deprecated"]}