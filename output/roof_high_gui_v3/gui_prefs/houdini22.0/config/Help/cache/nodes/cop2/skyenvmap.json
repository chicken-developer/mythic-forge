{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "skyenvmap", "icon": "COP2/skyenvmap", "since": "11.0", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Sky Environment Map"], "extent": [95, 119]}, {"type": "summary", "indent": 0, "text": ["Creates sky and ground images for use as environment maps."], "extent": [119, 186]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This node generates a multi-plane image. The image has named planes ", {"type": "code", "text": ["Left"]}, ",\n", {"type": "code", "text": ["Top"]}, ", ", {"type": "code", "text": ["Bottom"]}, ", ", {"type": "code", "text": ["Front"]}, ", and ", {"type": "code", "text": ["Back"]}, ". The ", {"type": "code", "text": ["C"]}, " plane contains the ", {"type": "q", "text": ["right"]}, "\nplane."], "extent": [229, 386]}, {"type": "para", "indent": 0, "text": ["You can use this image in shaders with ", {"type": "code", "text": ["Environment map"]}, " or ", {"type": "code", "text": ["Reflection map"]}, "\nparameters. You can render the image to disk using a\n", {"scheme": "Node", "value": "/nodes/out/comp", "type": "link", "text": ["Composite output node"], "fullpath": "/nodes/out/comp.html"}, ", or refer to this node\u2019s output\ndirectly using ", {"type": "code", "text": ["op:"]}, ". For example, if you have a Sky environment map node\nat ", {"type": "code", "text": ["/img/skyenvmap1"]}, ", you can refer to its output in a shader parameter using\n", {"type": "code", "text": ["op:/img/skyenvmap1"]}, "."], "extent": [386, 761]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [761, 767], "body": [{"type": "para", "indent": 4, "text": ["Sky environment map is a ", {"scheme": null, "value": "/assets/", "type": "link", "text": ["digital asset"], "fullpath": "/assets/index.html"}, ". You can double-click\n    it to go inside and find two lower-level asserts, skycube (for ramp-based\n    images) and skycubedaylight (for simulated images). These assets may be\n    interesting to technical users as examples of VEX-based compositing nodes."], "extent": [767, 1077]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [1077, 1089], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Sun"], "extent": [1089, 1100], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Use"], "extent": [1100, 1106], "body": [{"type": "para", "indent": 4, "text": ["Controls which of the following parameters are available to set the position of the sun in the image."], "extent": [1106, 1213]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rotate"], "extent": [1213, 1221], "body": [{"type": "para", "indent": 4, "text": ["The Euler rotation angles to align -Z axis vector towards the sun."], "extent": [1221, 1293]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Direction Vector"], "extent": [1293, 1311], "body": [{"type": "para", "indent": 4, "text": ["The explicit vector that points towards the sun."], "extent": [1311, 1365]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Azimuth"], "extent": [1365, 1374], "body": [{"type": "para", "indent": 4, "text": ["Azimuth of the sun in the image. Note that the default plane (", {"type": "code", "text": ["C"]}, ") shows the\n    ", {"type": "em", "text": ["right"]}, " view, so ", {"type": "code", "text": ["90"]}, " will put the sun straight ahead in that view."], "extent": [1374, 1528]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Elevation"], "extent": [1528, 1539], "body": [{"type": "para", "indent": 4, "text": ["Elevation of the sun in the image."], "extent": [1539, 1579]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Latitude"], "extent": [1579, 1589], "body": [{"type": "para", "indent": 4, "text": ["Latitude of the observer, used to compute the position of the sun based on the\n    date when ", {"type": "ui", "text": ["Use"]}, " is not ", {"type": "ui", "text": ["Angle and elevation"]}, "."], "extent": [1589, 1727]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Longitude"], "extent": [1727, 1738], "body": [{"type": "para", "indent": 4, "text": ["Longitude of the observer, used to compute the position of the sun based on the\n    date when ", {"type": "ui", "text": ["Use"]}, " is not ", {"type": "ui", "text": ["Angle and elevation"]}, "."], "extent": [1738, 1877]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Date"], "extent": [1877, 1883], "body": [{"type": "para", "indent": 4, "text": ["Date of observation, used to compute the position of the sun when ", {"type": "ui", "text": ["Use"]}, " is\n    ", {"type": "ui", "text": ["Location, date, and time"]}, "."], "extent": [1883, 1999]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Time"], "extent": [1999, 2005], "body": [{"type": "para", "indent": 4, "text": ["Time of observation, used to compute the position of the sun when ", {"type": "ui", "text": ["Use"]}, " is\n    ", {"type": "ui", "text": ["Location, date, and time"]}, "."], "extent": [2005, 2121]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Day of Year"], "extent": [2121, 2134], "body": [{"type": "para", "indent": 4, "text": ["A (fractional) day of the year (for example, 0.5 would be noon on January 1),\n    used to compute the position of the sun when ", {"type": "ui", "text": ["Use"]}, " is ", {"type": "ui", "text": ["Location, date, and time"]}, "."], "extent": [2134, 2307]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Sky"], "extent": [2307, 2317], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Use"], "extent": [2317, 2323], "body": [{"type": "para", "indent": 4, "text": ["Controls whether the sun is rendered using a physically realistic simulation\n    or using an artistically controllable color ramp."], "extent": [2323, 2463]}, {"type": "para", "indent": 4, "text": ["The ", {"type": "ui", "text": ["Realistic"]}, " option is especially useful when animating the time of day,\n    since it automatically produces realistic colors for sunrise, sunset, high\n    noon, and so on. The ", {"type": "ui", "text": ["Ramp"]}, " option gives you artistic control of the colors,\n    but does not simulate atmospheric effects, for example along the horizon."], "extent": [2463, 2786]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Haziness"], "extent": [2786, 2796], "body": [{"type": "para", "indent": 4, "text": ["Controls how sunlight scatters in the air, used when ", {"type": "ui", "text": ["Use"]}, " is ", {"type": "ui", "text": ["Realistic"]}, "."], "extent": [2796, 2880]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Brightness"], "extent": [2880, 2892], "body": [{"type": "para", "indent": 4, "text": ["Controls the brightness of the sky, used when ", {"type": "ui", "text": ["Use"]}, " is ", {"type": "ui", "text": ["Realistic"]}, "."], "extent": [2892, 2969]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Color ramp"], "extent": [2969, 2981], "body": [{"type": "para", "indent": 4, "text": ["Manually sets a color ramp from the sun to the surrounding sky, used when\n    ", {"type": "ui", "text": ["Use"]}, " is ", {"type": "ui", "text": ["Ramp"]}, "."], "extent": [2981, 3086]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Ground"], "extent": [3086, 3099], "body": [{"type": "para", "indent": 0, "text": ["Render Ground As;"], "extent": [3099, 3117], "body": [{"type": "para", "indent": 4, "text": ["Sets the method by which the ground plane will be rendered."], "extent": [3117, 3182]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Albedo"], "extent": [3182, 3194], "body": [{"type": "para", "indent": 8, "text": ["The ground will be rendered using the albedo as the color."], "extent": [3194, 3261]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Infinite horizon"], "extent": [3261, 3283], "body": [{"type": "para", "indent": 8, "text": ["The horizon color is repeated as the ground plane color."], "extent": [3283, 3357]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Mirror"], "extent": [3357, 3369], "body": [{"type": "para", "indent": 8, "text": ["The sky above the horizon is mirrored below."], "extent": [3369, 3431]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["None"], "extent": [3431, 3441], "body": [{"type": "para", "indent": 8, "text": ["No ground will be rendered. The color will be set to black\n        with alpha zero."], "extent": [3441, 3534]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Albedo"], "extent": [3534, 3542], "body": [{"type": "para", "indent": 4, "text": ["Sets the albedo of the ground."], "extent": [3542, 3578]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Normal"], "extent": [3578, 3586], "body": [{"type": "para", "indent": 4, "text": ["Sets the orientation of the ground plane. Only used when ", {"type": "ui", "text": ["Use"]}, " is \n    ", {"type": "ui", "text": ["Ramp"]}, "."], "extent": [3586, 3674]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Horizon elevation"], "extent": [3674, 3693], "body": [{"type": "para", "indent": 4, "text": ["Sets the horizontal elevation of the viewer. Only used when ", {"type": "ui", "text": ["Use"]}, " is \n    ", {"type": "ui", "text": ["Ramp"]}, "."], "extent": [3693, 3785]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [3785, 3793], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}], "title": ["Sky Environment Map"], "summary": ["Creates sky and ground images for use as environment maps."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}