{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "pulldown", "icon": "COP2/pulldown", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pulldown"], "extent": [80, 93]}, {"type": "summary", "indent": 0, "text": ["Performs a pulldown (cine-expand) on the input sequence."], "extent": [93, 158]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["A pulldown converts non-interlaced film to interlaced video sequences."], "extent": [201, 273]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [273, 285], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Film Rate"], "extent": [285, 300], "body": [{"type": "para", "indent": 8, "text": ["The frame rate of the film sequence (normally 24fps)"], "extent": [300, 370]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Video Rate"], "extent": [370, 386], "body": [{"type": "para", "indent": 8, "text": ["The frame rate of the output video (30fps for NTSC, 25fps for\n        PAL)"], "extent": [386, 478]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Field Offset"], "extent": [478, 496], "body": [{"type": "para", "indent": 8, "text": ["The frame offset where the pulldown pattern begins."], "extent": [496, 565]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Field Dominance"], "extent": [565, 586], "body": [{"type": "para", "indent": 8, "text": ["The field dominance of the video."], "extent": [586, 629]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Odd Dominant (Field 1)"], "extent": [629, 661], "body": [{"type": "para", "indent": 12, "text": ["The odd scanlines (1,3,5\u2026) appear in the first field of\n            the video pair."], "extent": [661, 772]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Even Dominant (Field 2)"], "extent": [772, 805], "body": [{"type": "para", "indent": 12, "text": ["The even scanlines (2,4,6\u2026) appear in the first field of\n            the video pair."], "extent": [805, 905]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [905, 914], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldmerge", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldmerge.html"}], "extent": [914, 943]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldsplit", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldsplit.html"}], "extent": [943, 972]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldswap", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldswap.html"}], "extent": [972, 1000]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pushup", "type": "link",