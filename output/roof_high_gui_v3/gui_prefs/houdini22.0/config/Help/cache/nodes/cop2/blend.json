{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "blend", "icon": "COP2/blend", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Blend"], "extent": [74, 84]}, {"type": "summary", "indent": 0, "text": ["Blends frames from two sequences together using a simple linear\nblend."], "extent": [84, 163]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operations blends frames from two sequences together using a simple\nlinear blend. An optional third sequence can be used to specify the\nblend factor on a per-pixel basis."], "extent": [206, 384]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [384, 396], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Blend"], "extent": [396, 413], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Blend Method"], "extent": [413, 436], "body": [{"type": "para", "indent": 12, "text": ["When a third input is not attached, a global blend is\n            applied between the 2 inputs."], "extent": [436, 545]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Use Blend Factor"], "extent": [545, 575], "body": [{"type": "para", "indent": 16, "text": ["Out = (1-Blend) ", {"type": "strong", "text": [" Input1 + Blend "]}, " Input2"], "extent": [575, 633]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Use Blend Weights"], "extent": [633, 664], "body": [{"type": "para", "indent": 16, "text": ["Out = Weight1 ", {"type": "strong", "text": [" Input1 + Weight2 "]}, " Input2"], "extent": [664, 722]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Blend Factor"], "extent": [722, 744], "body": [{"type": "para", "indent": 12, "text": ["Globally blends between input one (0) and two (1)."], "extent": [744, 807]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Input 1 Weight"], "extent": [807, 831], "body": [{"type": "para", "indent": 12, "text": ["If using blend weights, this specifies the factor to\n            multiply input 1 by."], "extent": [831, 929]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Input 2 Weight"], "extent": [929, 953], "body": [{"type": "para", "indent": 12, "text": ["This specifies the factor to multiply input 2 by."], "extent": [953, 1015]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Normalize Weights"], "extent": [1015, 1042], "body": [{"type": "para", "indent": 12, "text": ["If on, the weights will always be scaled to sum up to 1."], "extent": [1042, 1111]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Blend Mask"], "extent": [1111, 1131], "body": [{"type": "para", "indent": 12, "text": ["If a third input is used to control the blending, this menu\n            selects the plane or component to use as the blend mask.\n            Black is input 1, white is input 2."], "extent": [1131, 1320]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Invert Blend Mask"], "extent": [1320, 1347], "body": [{"type": "para", "indent": 12, "text": ["If on, black is input 2, while white is input 1."], "extent": [1347, 1409]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Merge"], "extent": [1409, 1425], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Overview"], "extent": [1425, 1444], "body": [{"type": "para", "indent": 12, "text": ["These parameters specify how to build the output sequence\n            when there are differences between the input sequences."], "extent": [1444, 1582]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Plane Merge"], "extent": [1582, 1603], "body": [{"type": "para", "indent": 12, "text": ["If the planes in the inputs differ, this specifies what the\n            output planes should be."], "extent": [1603, 1712]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Raster Depth"], "extent": [1712, 1734], "body": [{"type": "para", "indent": 12, "text": ["If the raster depth for a given plane differs between\n            inputs, this specifies what the output raster depth for the\n            plane should be."], "extent": [1734, 1901]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [1901, 1922], "body": [{"type": "para", "indent": 12, "text": ["If the frame ranges of the inputs differ, this determines\n            what the output range should be."], "extent": [1922, 2037]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Rate"], "extent": [2037, 2057], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            what the output frame rate should be."], "extent": [2057, 2176]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Match"], "extent": [2176, 2197], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            which input frame to pick when the cook time doesn\u2019t reside\n            on a frame boundary."], "extent": [2197, 2371]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [2371, 2379], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2405, 2414], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/composite", "type": "link", "text": "", "fullpath": "/nodes/cop2/composite.html"}], "extent": [2414, 2442]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/sequence", "type": "link", "text": "", "fullpath": "/nodes/cop2/sequence.html"}], "extent": [2442, 2470]}], "container": true}], "text": "Related"}], "title": ["Blend"], "summary": ["Blends frames from two sequences together using a simple linear\nblend."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}