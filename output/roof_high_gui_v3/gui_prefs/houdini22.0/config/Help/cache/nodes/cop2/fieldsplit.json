{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "fieldsplit", "icon": "COP2/fieldsplit", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Field Split"], "extent": [84, 100]}, {"type": "summary", "indent": 0, "text": ["Splits an interlaced frame into two fields per frame (odd and even\nfields)."], "extent": [100, 184]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation splits a frame into 2 fields containing the even and odd\nscanlines of the frame. The resulting sequence will be twice as long as\nthe original."], "extent": [227, 386]}, {"type": "para", "indent": 0, "text": ["Alternatively, only the even or odd scanlines can be extracted from the\nframe, in which case the resulting sequence will be as long as the input\nsequence."], "extent": [386, 543]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [543, 555], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Split"], "extent": [555, 566], "body": [{"type": "para", "indent": 8, "text": ["The split operation."], "extent": [566, 596]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Frame to 2 Fields"], "extent": [596, 623], "body": [{"type": "para", "indent": 12, "text": ["Splits each frame into 2 fields. The sequence will be twice\n            as long."], "extent": [623, 716]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Odd Fields"], "extent": [716, 736], "body": [{"type": "para", "indent": 12, "text": ["Extracts the odd scanlines from each frame. The sequence\n            length remains unaffected."], "extent": [736, 844]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Even Fields"], "extent": [844, 865], "body": [{"type": "para", "indent": 12, "text": ["Extracts the even scanlines from each frame. The sequence\n            length remains unaffected."], "extent": [865, 974]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Field Dominance"], "extent": [974, 995], "body": [{"type": "para", "indent": 8, "text": ["The field dominance of the new sequence."], "extent": [995, 1045]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Odd Dominant (Field 1)"], "extent": [1045, 1077], "body": [{"type": "para", "indent": 12, "text": ["The odd scanlines (1,3,5\u2026) appear in the first field of\n            the video pair."], "extent": [1077, 1175]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Even Dominant (Field 2)"], "extent": [1175, 1208], "body": [{"type": "para", "indent": 12, "text": ["The even scanlines (2,4,6\u2026) appear in the first field of\n            the video pair."], "extent": [1208, 1308]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1308, 1317], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldmerge", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldmerge.html"}], "extent": [1317, 1346]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/fieldswap", "type": "link", "text": "", "fullpath": "/nodes/cop2/fieldswap.html"}], "extent": [1346, 1374]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pulldown", "type": "link", "text": "", "fullpath": "/nodes/cop2/pulldown.html"}], "extent": [1374, 1401]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pushup", "type": "link", "text": "", "fullpath": "/nodes/cop2/pushup.html"}], "extent": [1401, 1427]}], "container": true}], "text": "Related"}], "title": ["Field Split"], "summary": ["Splits an interlaced frame into two fields per frame (odd and even\nfields)."], "included": ["/composite/_old_cops_deprecated"]}