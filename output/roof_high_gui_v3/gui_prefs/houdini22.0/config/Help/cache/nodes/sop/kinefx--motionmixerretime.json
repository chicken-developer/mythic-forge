{"type": "root", "attrs": {"type": "node", "context": "sop", "namespace": "kinefx", "internal": "motionmixerretime", "icon": "SOP/kinefx-motionmixerretime", "tags": "animation", "since": "21.0", "allow_hidden": "true", "version": null}, "body": [{"tag": "div", "attrs": {"style": "position: relative;"}, "type": "xml", "text": ["\n    ", {"tag": "div", "attrs": {"style": "float: left; width: 5em;"}, "type": "xml", "text": ["\n        ", {"scheme": "Image", "value": "/images/beta.svg", "type": "link", "text": "", "fullpath": "/images/beta.svg.html"}, "\n    "]}, "\n    ", {"tag": "div", "attrs": {"style": "margin-left: 5em; padding-left: 1em; min-height: 4em;"}, "type": "xml", "text": ["\n        This feature is still under development. The current functionality is\n        unfinished and subject to change, and may have thin or no documentation.\n        Please bear this in mind when using it.\n    "]}, "\n"]}, {"level": 0, "type": "title", "indent": 0, "text": ["Motion Mixer Retime"], "extent": [184, 208]}, {"type": "summary", "indent": 0, "text": ["Defines a retime effect for the motion mixer."], "extent": [208, 262]}, {"type": "para", "indent": 0, "text": ["The motion mixer\u2019s retime effect allows you to change the playback speed of the animation. This node defines an APEX graph that performs a retime effect on the MixerAnim.skel of a single character. MixerAnim.skel is a skeleton that contains the control transforms of the character, and is output by the motion mixer."], "extent": [262, 580]}, {"type": "para", "indent": 0, "text": ["This effect is invoked internally by the ", {"scheme": "Node", "value": "/nodes/sop/kinefx--motionmixer", "type": "link", "text": ["Motion Mixer SOP"], "fullpath": "/nodes/sop/kinefx--motionmixer.html"}, ". See ", {"scheme": null, "value": "/character/kinefx/motionmixer#retimeeffect", "type": "link", "text": ["retime effect"], "fullpath": "/character/kinefx/motionmixer.html#retimeeffect", "fragment": "#retimeeffect"}, " for more information."], "extent": [580, 756]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [756, 768], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Retime"], "extent": [768, 777], "body": [{"type": "para", "indent": 4, "text": ["Defines how the effect performs retiming."], "extent": [791, 842]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["By Frame"], "extent": [842, 856], "body": [{"type": "para", "indent": 8, "text": ["Uses the animated frame parameter, ", {"type": "ui", "text": ["Frame"]}, "."], "extent": [856, 911]}], "container": true}, {"type": "dt", "indent": 4, "text": ["By Time"], "extent": [911, 924], "body": [{"type": "para", "indent": 8, "text": ["Uses the animated time parameter, ", {"type": "ui", "text": ["Time"]}, "."], "extent": [924, 977]}], "container": true}, {"type": "dt", "indent": 4, "text": ["By Speed"], "extent": [977, 991], "body": [{"type": "para", "indent": 8, "text": ["Uses the animated speed parameter, ", {"type": "ui", "text": ["Speed"]}, ". "], "extent": [991, 1055]}], "container": true}, {"type": "dt", "indent": 4, "text": ["By Holding"], "extent": [1055, 1071], "body": [{"type": "para", "indent": 8, "text": ["Uses the animated hold parameter, ", {"type": "ui", "text": ["Hold"]}, ". "], "extent": [1071, 1129]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "mode"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Frame"], "extent": [1129, 1136], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Retime"]}, " is set to ", {"type": "ui", "text": ["By Frame"]}, ", this is an animated frame parameter. Use an expression such as ", {"type": "code", "text": ["$FF"]}, ", or manually set keyframes. For example, to double the speed of the playback, set ", {"type": "ui", "text": ["Frame"]}, " to ", {"type": "code", "text": ["$FF*2"]}, "."], "extent": [1151, 1373]}], "container": true, "attrs": {"id": "frame"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Time"], "extent": [1373, 1379], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Retime"]}, " is set to ", {"type": "ui", "text": ["By Time"]}, ", this is an animated time parameter. Use an expression such as ", {"type": "code", "text": ["$T"]}, ", or manually set keyframes. For example, to double the speed of the playback, set ", {"type": "ui", "text": ["Time"]}, " to ", {"type": "code", "text": ["$T*2"]}, "."], "extent": [1393, 1606]}], "container": true, "attrs": {"id": "time"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Speed"], "extent": [1606, 1613], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Retime"]}, " is set to ", {"type": "ui", "text": ["By Speed"]}, ", this is a speed parameter that can be animated to perform slowdowns and speedups. For example, to double the speed of the playback, set ", {"type": "ui", "text": ["Speed"]}, " to ", {"type": "code", "text": ["2"]}, "."], "extent": [1628, 1827]}, {"type": "para", "indent": 4, "text": ["The ", {"type": "ui", "text": ["Rate"]}, " parameter is used to perform time steps within the frame range. The time step value is multiplied by the sampled speed at that time."], "extent": [1827, 1978]}], "container": true, "attrs": {"id": "speed"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Hold"], "extent": [1978, 1984], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Retime"]}, " is set to ", {"type": "ui", "text": ["By Holding"]}, ", this is an animated hold parameter. If ", {"type": "ui", "text": ["Hold"]}, " is set to ", {"type": "code", "text": ["1"]}, ", playback freezes at that frame, and the same frame is repeated until ", {"type": "ui", "text": ["Hold"]}, " is set to ", {"type": "code", "text": ["0"]}, ". By default, a key is set for ", {"type": "ui", "text": ["Hold"]}, " = ", {"type": "code", "text": ["0"]}, " at frame 1. See ", {"scheme": null, "value": "/character/kinefx/motionmixer#holdpose", "type": "link", "text": ["hold a pose"], "fullpath": "/character/kinefx/motionmixer.html#holdpose", "fragment": "#holdpose"}, " for more information."], "extent": [1998, 2336]}, {"type": "para", "indent": 4, "text": ["The ", {"type": "ui", "text": ["Rate"]}, "  parameter is used to perform time steps within the frame range. "], "extent": [2336, 2420]}], "container": true, "attrs": {"id": "hold"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Frame Range"], "extent": [2420, 2433], "body": [{"type": "para", "indent": 4, "text": ["The frame range to perform the retiming."], "extent": [2449, 2495]}], "container": true, "attrs": {"id": "frange"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rate"], "extent": [2495, 2501], "body": [{"type": "para", "indent": 4, "text": ["The rate, in frames per second, when doing time steps."], "extent": [2515, 2575]}], "container": true, "attrs": {"id": "rate"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2575, 2584], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/character/kinefx/motionmixer", "type": "link", "text": ["Motion mixer"], "fullpath": "/character/kinefx/motionmixer.html"}], "extent": [2584, 2631]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": null, "value": "/ref/panes/motionmixer", "type": "link", "text": ["Motion mixer pane"], "fullpath": "/ref/panes/motionmixer.html"}], "extent": [2631, 2676]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/kinefx--motionmixer", "type": "link", "text"