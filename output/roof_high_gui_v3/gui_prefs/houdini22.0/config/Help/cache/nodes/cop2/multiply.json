{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "multiply", "icon": "COP2/multiply", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Multiply"], "extent": [80, 93]}, {"type": "summary", "indent": 0, "text": ["Multiplies the foreground image with the background image."], "extent": [93, 160]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Multiplies the foreground image with the background image. The Multiply\noperation is defined as:"], "extent": [203, 301]}, {"type": "para", "indent": 0, "text": [{"type": "code", "text": ["C = C2 * C1"]}], "extent": [301, 316]}, {"type": "para", "indent": 0, "text": ["Multiply is often used with grayscale mattes or ramps, when the matte or\nramp is in the Color plane rather than the Alpha plane (if it were in\nthe Alpha plane, Inside would be used)"], "extent": [316, 500]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [500, 505], "body": [{"type": "para", "indent": 4, "text": ["The Layer COP allows multiple inputs to be composited instead of\n    just two, each with its own compositing operation. The Composite COP\n    is the more general version of this COP, allowing you to choose any\n    compositing operation, and an optionally different operation for\n    alpha."], "extent": [505, 800]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scoping"], "extent": [57, 75], "body": [{"type": "para", "indent": 8, "text": ["This operation may be restricted to certain planes, or\n        components of planes. In addition, the operation may be applied\n        to a subset of frames within the sequence. An image must have\n        both its frame and plane scoped to be modified."], "extent": [75, 338]}, {"type": "para", "indent": 8, "text": ["Images that are not modified are passed through, which does not\n        take any memory or processing time."], "extent": [338, 455]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Masking"], "extent": [56, 74], "body": [{"type": "para", "indent": 8, "text": ["This operation may be masked, which restricts the operation to\n        an area of the image. The mask may be inverted, brightened or\n        dimmed."], "extent": [74, 233]}, {"type": "para", "indent": 8, "text": ["The mask input is on the side of the node. The label on the\n        connector indicates the plane being used as a mask."], "extent": [233, 362]}, {"type": "para", "indent": 8, "text": ["The mask input can also be scaled to fit the output image\u2019s resolution, if they differ. If this node is changing constantly, and the mask is not, it is somewhat faster to put a ", {"scheme": "Node", "value": "/nodes/cop2/scale", "type": "link", "text": ["Scale COP"], "fullpath": "/nodes/cop2/scale.html"}, " down to do the resize for the mask image. Otherwise, the scale will occur every time this node cooks."], "extent": [362, 678]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [885, 897], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Composite"], "extent": [897, 918], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Image Units"], "extent": [918, 940], "body": [{"type": "para", "indent": 12, "text": ["Selects pixels or UV units for the transform."], "extent": [940, 998]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Translate, Rotate, Scale, Pivot"], "extent": [998, 1039], "body": [{"type": "para", "indent": 12, "text": ["Transforms the foreground in X,Y relative to the\n            background."], "extent": [1039, 1124]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Filter"], "extent": [1124, 1146], "body": [{"type": "para", "indent": 12, "text": ["Specifies the filter to use when transforming."], "extent": [1146, 1205]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Wrap"], "extent": [1205, 1225], "body": [{"type": "para", "indent": 12, "text": ["Specifies the foreground image\u2019s wrapping style."], "extent": [1225, 1286]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur"], "extent": [1286, 1307], "body": [{"type": "para", "indent": 12, "text": ["Toggles on motion blur, and specifies the time range around\n            the current frame to blur."], "extent": [1307, 1418]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Frame Bias"], "extent": [1418, 1445], "body": [{"type": "para", "indent": 12, "text": ["Shifts the time range for the blur."], "extent": [1445, 1493]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Segments"], "extent": [1493, 1523], "body": [{"type": "para", "indent": 12, "text": ["Number of samples to blur together in the specified time\n            range."], "extent": [1523, 1611]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Method"], "extent": [1611, 1640], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Velocity"], "extent": [1640, 1662], "body": [{"type": "para", "indent": 16, "text": ["Only uses the current frame and the transform to compute\n                past and future positions."], "extent": [1662, 1778]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Deformation"], "extent": [1778, 1803], "body": [{"type": "para", "indent": 16, "text": ["Cooks the images at all time samples."], "extent": [1803, 1858]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Merge"], "extent": [1858, 1874], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Overview"], "extent": [1874, 1893], "body": [{"type": "para", "indent": 12, "text": ["These parameters specify how to build the output sequence\n            when there are differences between the input sequences."], "extent": [1893, 2031]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Plane Merge"], "extent": [2031, 2052], "body": [{"type": "para", "indent": 12, "text": ["If the planes in the inputs differ, this specifies what the\n            output planes should be."], "extent": [2052, 2161]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Raster Depth"], "extent": [2161, 2183], "body": [{"type": "para", "indent": 12, "text": ["If the raster depth for a given plane differs between\n            inputs, this specifies what the output raster depth for the\n            plane should be."], "extent": [2183, 2350]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [2350, 2371], "body": [{"type": "para", "indent": 12, "text": ["If the frame ranges of the inputs differ, this determines\n            what the output range should be."], "extent": [2371, 2486]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Rate"], "extent": [2486, 2506], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            what the output frame rate should be."], "extent": [2506, 2625]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Match"], "extent": [2625, 2646], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            which input frame to pick when the cook time doesn\u2019t reside\n            on a frame boundary."], "extent": [2646, 2820]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Mask"], "extent": [706, 722], "body": [{"type": "para", "indent": 8, "text": ["A mask can be chosen to limit the effect of the operator to\n        areas defined by the mask. The mask can be taken from the mask\n        input (side input) or from the first input itself."], "extent": [722, 922]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Effect Amount"], "extent": [922, 945], "body": [{"type": "para", "indent": 12, "text": ["If no mask is present, this blends the output with the input\n            by a constant amount (0 = all input, 1 = all output)."], "extent": [983, 1123]}, {"type": "para", "indent": 12, "text": ["If a mask is present, this amount multiplies the mask."], "extent": [1123, 1191]}], "container": true, "attrs": {"channels": "/effectamount"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Operation Mask"], "extent": [1191, 1215], "body": [{"type": "para", "indent": 12, "text": ["Selects the mask plane to use as a mask from the mask input.\n            The mask can be selected from:"], "extent": [1261, 1378]}, {"type": "para", "indent": 12, "text": ["A mask can be a component of a plane or an entire plane. If\n            a vector plane is supplied as a mask, its components are\n            multiplied by the images' components."], "extent": [1378, 1570]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Scalar Mask ('A', 'C.r')"]}], "extent": [1570, 1610]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M\n            C.g = I.g * M\n            C.b = I.b * M\n            \n            "], "extent": [1610, 1733]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Vector Mask ('C')"]}], "extent": [1733, 1766]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M.r\n            C.g = I.g * M.g\n            C.b = I.b * M.b\n            \n            "], "extent": [1766, 1895]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["First Input"], "extent": [1895, 1921], "body": [{"type": "para", "indent": 16, "text": ["Useful for masking the operation to the image\u2019s own\n                alpha plane."], "extent": [1921, 2018]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Mask Input"], "extent": [2018, 2042], "body": [{"type": "para", "indent": 16, "text": ["Selects the mask from the side mask input."], "extent": [2042, 2101]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Off"], "extent": [2101, 2118], "body": [{"type": "para", "indent": 16, "text": ["Turns off masking, without requiring disconnection of\n                the mask input (useful for temporarily disabling the\n                mask)."], "extent": [2118, 2280]}], "container": true}], "container": true}], "container": true, "attrs": {"channels": "/maskinput /maskplane"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Resize Mask to Fit Image"], "extent": [2280, 2314], "body": [{"type": "para", "indent": 12, "text": ["If the mask image is a different resolution than the output\n            image, turning on this parameter will scale the mask to the\n            output image\u2019s resolution."], "extent": [2314, 2498]}, {"type": "para", "indent": 12, "text": ["If this node is changing constantly, and the mask is not, it\n            is somewhat faster to put a Scale COP down to do the resize\n            for the mask image. Otherwise, the scale will occur every\n            time this node cooks."], "extent": [2498, 2748]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Invert Mask"], "extent": [2748, 2769], "body": [{"type": "para", "indent": 12, "text": ["Inverts the mask so that all fully 'masked' portions become\n            unmasked. This saves you from inserting an Invert COP after\n            the node with the mask."], "extent": [2769, 2949]}], "container": true, "role": "item"}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scope"], "extent": [484, 501], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Plane Scope"], "extent": [501, 523], "body": [{"type": "para", "indent": 12, "text": ["Specifies the scope for both the RGB components of Color,\n            Alpha, and other planes. The (C)RGBA mask only affects Color\n            components and Alpha. 'C' will toggle all the RGB\n            components."], "extent": [523, 753]}, {"type": "para", "indent": 12, "text": ["For planes other than Color and Alpha, the plane name (plus\n            component, if applicable) should be specified in the string\n            field. The pulldown menu can be used to select planes or\n            components present in this node."], "extent": [753, 1012]}, {"type": "para", "indent": 12, "text": ["A plane is specified by its name. A component is specified\n            by both its plane and component name. The '*' wildcard may\n            be used to scope all extra planes. Any number of planes or\n            components can be specified, separated by spaces."], "extent": [1012, 1288]}, {"type": "para", "indent": 12, "text": ["Examples:"], "extent": [1288, 1311]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            P\n            N.x N.y\n            P N Pz\n            "], "extent": [1311, 1396]}], "container": true, "role": "item"}], "container": true}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Frame Scope"], "extent": [1396, 1419], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Frame Scope"], "extent": [1419, 1441], "body": [{"type": "para", "indent": 12, "text": ["Allows scoping of specific frames in the frame range. This\n            is in addition to the plane scope (so a plane at a certain\n            frame must be both plane scoped and frame scoped to be\n            modified)."], "extent": [1441, 1674]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["All Frames"], "extent": [1674, 1698], "body": [{"type": "para", "indent": 16, "text": ["All frames are scoped."], "extent": [1698, 1737]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Inside Range"], "extent": [1737, 1763], "body": [{"type": "para", "indent": 16, "text": ["All frames inside a subrange are scoped."], "extent": [1763, 1820]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Outside Range"], "extent": [1820, 1847], "body": [{"type": "para", "indent": 16, "text": ["All frames outside a subrange are scoped."], "extent": [1847, 1905]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Even Frames"], "extent": [1905, 1930], "body": [{"type": "para", "indent": 16, "text": ["Even numbered frames are scoped."], "extent": [1930, 1979]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Odd Frames"], "extent": [1979, 2003], "body": [{"type": "para", "indent": 16, "text": ["Odd numbered frames are scoped."], "extent": [2003, 2051]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Specific Frames"], "extent": [2051, 2080], "body": [{"type": "para", "indent": 16, "text": ["A user-defined list of frames are scoped."], "extent": [2080, 2138]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [2138, 2159], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside range, this parameter specifies the\n            subrange of the sequence to scope (or unscope). This can be\n            edited in Timeline viewer mode (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2201, 2409]}], "container": true, "attrs": {"channels": "/frange1 /frange2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Dropoff"], "extent": [2409, 2432], "body": [{"type": "para", "indent": 12, "text": ["For Inside/Outside Range, this parameter specifies certain\n            number of frames before and after to slowly ramp up to\n            scoped. The operation will be blended with its input to\n            'ease in' or 'ease out' the scoping effect over a number of\n            frames. This can be edited in Timeline viewer mode\n            (", {"keys": ["Ctrl", "2"], "type": "keys", "text": null}, " in viewer)."], "extent": [2478, 2857]}], "container": true, "attrs": {"channels": "/fdropoff1 /fdropoff2"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Non-scoped Effect"], "extent": [2857, 2884], "body": [{"type": "para", "indent": 12, "text": ["For unscoped frames, this sets the blend factor between the\n            input and modified images. Normally this is zero (use the\n            input image). By setting this to a non-zero value, you can\n            make unscoped frames be 'slightly' unscoped. The value can\n            vary between 0 (unscoped) and 1 (scoped)."], "extent": [2918, 3256]}], "container": true, "attrs": {"channels": "/foutside"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame List"], "extent": [3256, 3276], "body": [{"type": "para", "indent": 12, "text": ["The frame list for 'Specific Frames'. Frame numbers should\n            be separated by spaces."], "extent": [3307, 3414]}], "container": true, "attrs": {"channels": "/flist"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Automatically Adjust for Length Changes"], "extent": [3414, 3463], "body": [{"type": "para", "indent": 12, "text": ["If the sequence range changes, enabling this parameter will\n            adjust the subrange and frame dropoff lengths to fit the new\n            range."], "extent": [3463, 3627]}], "container": true, "role": "item"}], "container": true}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [2894, 2902], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2928, 2937], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/inside", "type": "link", "text": "", "fullpath": "/nodes/cop2/inside.html"}], "extent": [2937, 2962]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/composite", "type": "link", "text": "", "fullpath": "/nodes/cop2/composite.html"}], "extent": [2962, 2990]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/layer", "type": "link", "text": "", "fullpath": "/nodes/cop2/layer.html"}], "extent": [2990, 3015]}], "container": true}], "text": "Related"}], "title": ["Multiply"], "summary": ["Multiplies the foreground image with the background image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/maskparms", "/nodes/cop2/pixelparms"]}