{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "composite", "icon": "COP2/composite", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Composite"], "extent": [82, 96]}, {"type": "summary", "indent": 0, "text": ["Does a composite (over, under, inside, add, etc) between two\nimages."], "extent": [96, 173]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation does a composite (over, under, inside, add, etc) between\ntwo images. The first image is the foreground, which may be translated\nrelative to the second input, the background. The size of the resulting\nimage is the size of the background image. This cop supports\nmulti-channel alpha ( ", {"type": "em", "text": ["A{r, g, b}"]}, ")."], "extent": [216, 531]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [531, 536], "body": [{"type": "para", "indent": 4, "text": ["The Layer COP allows multiple inputs to be composited instead of\n    just two."], "extent": [536, 620]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Masking"], "extent": [56, 74], "body": [{"type": "para", "indent": 8, "text": ["This operation may be masked, which restricts the operation to\n        an area of the image. The mask may be inverted, brightened or\n        dimmed."], "extent": [74, 233]}, {"type": "para", "indent": 8, "text": ["The mask input is on the side of the node. The label on the\n        connector indicates the plane being used as a mask."], "extent": [233, 362]}, {"type": "para", "indent": 8, "text": ["The mask input can also be scaled to fit the output image\u2019s resolution, if they differ. If this node is changing constantly, and the mask is not, it is somewhat faster to put a ", {"scheme": "Node", "value": "/nodes/cop2/scale", "type": "link", "text": ["Scale COP"], "fullpath": "/nodes/cop2/scale.html"}, " down to do the resize for the mask image. Otherwise, the scale will occur every time this node cooks."], "extent": [362, 678]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [662, 674], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Composite"], "extent": [674, 695], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Operation"], "extent": [695, 715], "body": [{"type": "para", "indent": 12, "text": ["Specifies the compositing operation:"], "extent": [715, 765]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Over"], "extent": [765, 783], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground over the background."], "extent": [783, 842]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Under"], "extent": [842, 861], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground under the background\u2019s alpha."], "extent": [861, 929]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Atop"], "extent": [929, 947], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground over the background only where the\n                background alpha exists."], "extent": [947, 1061]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Inside"], "extent": [1061, 1081], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground inside the background\u2019s alpha."], "extent": [1081, 1150]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Outside"], "extent": [1150, 1171], "body": [{"type": "para", "indent": 16, "text": ["Places the foreground outside the background\u2019s alpha."], "extent": [1171, 1241]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Screen"], "extent": [1241, 1261], "body": [{"type": "para", "indent": 16, "text": ["Acts as a saturating add, much like photographic\n                addition."], "extent": [1261, 1352]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Add"], "extent": [1352, 1369], "body": [{"type": "para", "indent": 16, "text": ["Adds the foreground to the background."], "extent": [1369, 1424]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Subtract"], "extent": [1424, 1446], "body": [{"type": "para", "indent": 16, "text": ["Subtracts the foreground from the background."], "extent": [1446, 1508]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Diff"], "extent": [1508, 1526], "body": [{"type": "para", "indent": 16, "text": ["Takes the absolute difference between the foreground and\n                the background."], "extent": [1526, 1631]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Multiply"], "extent": [1631, 1653], "body": [{"type": "para", "indent": 16, "text": ["Multiplies the background by the foreground."], "extent": [1653, 1714]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Minimum"], "extent": [1714, 1735], "body": [{"type": "para", "indent": 16, "text": ["Takes the minimum of the foreground and background."], "extent": [1735, 1803]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Maximum"], "extent": [1803, 1824], "body": [{"type": "para", "indent": 16, "text": ["Takes the maximum of the foreground and background."], "extent": [1824, 1892]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Average"], "extent": [1892, 1913], "body": [{"type": "para", "indent": 16, "text": ["Takes the average of the foreground and background."], "extent": [1913, 1981]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Xor"], "extent": [1981, 1998], "body": [{"type": "para", "indent": 16, "text": ["Takes the exclusive or of the two alpha planes, so that\n                alpha areas that overlap are removed."], "extent": [1998, 2124]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Units"], "extent": [2124, 2145], "body": [{"type": "para", "indent": 12, "text": ["Selects pixels or UV units for the transform."], "extent": [2145, 2203]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Translate, Rotate, Scale, Pivot"], "extent": [2203, 2244], "body": [{"type": "para", "indent": 12, "text": ["Transforms the foreground in X,Y relative to the\n            background."], "extent": [2244, 2329]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Filter"], "extent": [2329, 2351], "body": [{"type": "para", "indent": 12, "text": ["Specifies the filter to use when transforming."], "extent": [2351, 2410]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Image Wrap"], "extent": [2410, 2430], "body": [{"type": "para", "indent": 12, "text": ["Specifies the foreground image\u2019s wrapping style."], "extent": [2430, 2491]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur"], "extent": [2491, 2512], "body": [{"type": "para", "indent": 12, "text": ["Toggles on motion blur, and specifies the time range around\n            the current frame to blur."], "extent": [2512, 2623]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Frame Bias"], "extent": [2623, 2650], "body": [{"type": "para", "indent": 12, "text": ["Shifts the time range for the blur."], "extent": [2650, 2698]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Segments"], "extent": [2698, 2728], "body": [{"type": "para", "indent": 12, "text": ["Number of samples to blur together in the specified time\n            range."], "extent": [2728, 2816]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Motion Blur Method"], "extent": [2816, 2845], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Velocity"], "extent": [2845, 2867], "body": [{"type": "para", "indent": 16, "text": ["Only uses the current frame and the transform to compute\n                past and future positions."], "extent": [2867, 2983]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Deformation"], "extent": [2983, 3008], "body": [{"type": "para", "indent": 16, "text": ["Cooks the images at all time samples."], "extent": [3008, 3063]}], "container": true}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Merge"], "extent": [3063, 3079], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Overview"], "extent": [3079, 3098], "body": [{"type": "para", "indent": 12, "text": ["These parameters specify how to build the output sequence\n            when there are differences between the input sequences."], "extent": [3098, 3236]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Plane Merge"], "extent": [3236, 3257], "body": [{"type": "para", "indent": 12, "text": ["If the planes in the inputs differ, this specifies what the\n            output planes should be."], "extent": [3257, 3366]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Raster Depth"], "extent": [3366, 3388], "body": [{"type": "para", "indent": 12, "text": ["If the raster depth for a given plane differs between\n            inputs, this specifies what the output raster depth for the\n            plane should be."], "extent": [3388, 3555]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Range"], "extent": [3555, 3576], "body": [{"type": "para", "indent": 12, "text": ["If the frame ranges of the inputs differ, this determines\n            what the output range should be."], "extent": [3576, 3691]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Rate"], "extent": [3691, 3711], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            what the output frame rate should be."], "extent": [3711, 3830]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Frame Match"], "extent": [3830, 3851], "body": [{"type": "para", "indent": 12, "text": ["If the frame rates of the inputs differ, this determines\n            which input frame to pick when the cook time doesn\u2019t reside\n            on a frame boundary."], "extent": [3851, 4025]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Mask"], "extent": [706, 722], "body": [{"type": "para", "indent": 8, "text": ["A mask can be chosen to limit the effect of the operator to\n        areas defined by the mask. The mask can be taken from the mask\n        input (side input) or from the first input itself."], "extent": [722, 922]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Effect Amount"], "extent": [922, 945], "body": [{"type": "para", "indent": 12, "text": ["If no mask is present, this blends the output with the input\n            by a constant amount (0 = all input, 1 = all output)."], "extent": [983, 1123]}, {"type": "para", "indent": 12, "text": ["If a mask is present, this amount multiplies the mask."], "extent": [1123, 1191]}], "container": true, "attrs": {"channels": "/effectamount"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Operation Mask"], "extent": [1191, 1215], "body": [{"type": "para", "indent": 12, "text": ["Selects the mask plane to use as a mask from the mask input.\n            The mask can be selected from:"], "extent": [1261, 1378]}, {"type": "para", "indent": 12, "text": ["A mask can be a component of a plane or an entire plane. If\n            a vector plane is supplied as a mask, its components are\n            multiplied by the images' components."], "extent": [1378, 1570]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Scalar Mask ('A', 'C.r')"]}], "extent": [1570, 1610]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M\n            C.g = I.g * M\n            C.b = I.b * M\n            \n            "], "extent": [1610, 1733]}, {"type": "para", "indent": 12, "text": [{"type": "strong", "text": ["Vector Mask ('C')"]}], "extent": [1733, 1766]}, {"lang": null, "type": "pre", "indent": 12, "text": ["\n            C.r = I.r * M.r\n            C.g = I.g * M.g\n            C.b = I.b * M.b\n            \n            "], "extent": [1766, 1895]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["First Input"], "extent": [1895, 1921], "body": [{"type": "para", "indent": 16, "text": ["Useful for masking the operation to the image\u2019s own\n                alpha plane."], "extent": [1921, 2018]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Mask Input"], "extent": [2018, 2042], "body": [{"type": "para", "indent": 16, "text": ["Selects the mask from the side mask input."], "extent": [2042, 2101]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Off"], "extent": [2101, 2118], "body": [{"type": "para", "indent": 16, "text": ["Turns off masking, without requiring disconnection of\n                the mask input (useful for temporarily disabling the\n                mask)."], "extent": [2118, 2280]}], "container": true}], "container": true}], "container": true, "attrs": {"channels": "/maskinput /maskplane"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Resize Mask to Fit Image"], "extent": [2280, 2314], "body": [{"type": "para", "indent": 12, "text": ["If the mask image is a different resolution than the output\n            image, turning on this parameter will scale the mask to the\n            output image\u2019s resolution."], "extent": [2314, 2498]}, {"type": "para", "indent": 12, "text": ["If this node is changing constantly, and the mask is not, it\n            is somewhat faster to put a Scale COP down to do the resize\n            for the mask image. Otherwise, the scale will occur every\n            time this node cooks."], "extent": [2498, 2748]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Invert Mask"], "extent": [2748, 2769], "body": [{"type": "para", "indent": 12, "text": ["Inverts the mask so that all fully 'masked' portions become\n            unmasked. This saves you from inserting an Invert COP after\n            the node with the mask."], "extent": [2769, 2949]}], "container": true, "role": "item"}], "container": true}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [4061, 4069], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [4095, 4104], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/layer", "type": "link", "text": "", "fullpath": "/nodes/cop2/layer.html"}], "extent": [4104, 4128]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/add", "type": "link", "text": "", "fullpath": "/nodes/cop2/add.html"}], "extent": [4128, 4150]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/atop", "type": "link", "text": "", "fullpath": "/nodes/cop2/atop.html"}], "extent": [4150, 4173]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/average", "type": "link", "text": "", "fullpath": "/nodes/cop2/average.html"}], "extent": [4173, 4199]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/diff", "type": "link", "text": "", "fullpath": "/nodes/cop2/diff.html"}], "extent": [4199, 4222]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/inside", "type": "link", "text": "", "fullpath": "/nodes/cop2/inside.html"}], "extent": [4222, 4247]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/max", "type": "link", "text": "", "fullpath": "/nodes/cop2/max.html"}], "extent": [4247, 4269]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/min", "type": "link", "text": "", "fullpath": "/nodes/cop2/min.html"}], "extent": [4269, 4291]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/over", "type": "link", "text": "", "fullpath": "/nodes/cop2/over.html"}], "extent": [4291, 4314]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/screen", "type": "link", "text": "", "fullpath": "/nodes/cop2/screen.html"}], "extent": [4314, 4339]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/subtract", "type": "link", "text": "", "fullpath": "/nodes/cop2/subtract.html"}], "extent": [4339, 4366]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/under", "type": "link", "text": "", "fullpath": "/nodes/cop2/under.html"}], "extent": [4366, 4390]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/xor", "type": "link", "text": "", "fullpath": "/nodes/cop2/xor.html"}], "extent": [4390, 4413]}], "container": true}], "text": "Related"}], "title": ["Composite"], "summary": ["Does a composite (over, under, inside, add, etc) between two\nimages."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/maskparms"]}