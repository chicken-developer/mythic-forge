{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "warp", "icon": "COP2/warp", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Time Warp"], "extent": [72, 86]}, {"type": "summary", "indent": 0, "text": ["Warps time by slowing or speeding it up throughout the sequence."], "extent": [86, 159]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation warps time by slowing or speeding it up throughout the\nsequence. This operation does not use any cache memory as long as 'Frame\nRound' is not set to 'Blend Frames'."], "extent": [202, 384]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [384, 389], "body": [{"type": "para", "indent": 4, "text": ["Try an index expression of $I + sin($I*5)."], "extent": [389, 438]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [438, 450], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Warp Method"], "extent": [450, 467], "body": [{"type": "para", "indent": 8, "text": ["Allows you to control the warping using either an expression or\n        a CHOP channel."], "extent": [467, 563]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Index"], "extent": [563, 574], "body": [{"type": "para", "indent": 8, "text": ["The expression to control the amount of warping. Try: $I +\n        sin($I*5)"], "extent": [601, 686]}], "container": true, "attrs": {"channels": "/index"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["CHOP"], "extent": [686, 696], "body": [{"type": "para", "indent": 8, "text": ["If you've set the Warp Method to CHOP, you should specify the\n        CHOP path here."], "extent": [696, 790]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Round"], "extent": [790, 807], "body": [{"type": "para", "indent": 8, "text": ["Rounds to the: Nearest, Previous, or Next Frame. If you select\n        Blend Frame, it will perform the necessary temporal aliasing to\n        provide a smooth result."], "extent": [807, 983]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [983, 991], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1017, 1026], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/timefilter", "type": "link", "text": "", "fullpath": "/nodes/cop2/timefilter.html"}], "extent": [1026, 1055]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/tima", "type": "link", "text": "", "fullpath": "/nodes/cop2/tima.html"}], "extent": [1055, 1078]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/timescale", "type": "link", "text": "", "fullpath": "/nodes/cop2/timescale.html"}], "extent": [1078, 1107]}], "container": true}], "text": "Related"}], "title": ["Time Warp"], "summary": ["Warps time by slowing or speeding it up throughout the sequence."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}