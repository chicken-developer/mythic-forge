{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "sequence", "icon": "COP2/sequence", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Sequence"], "extent": [80, 93]}, {"type": "summary", "indent": 0, "text": ["Sequences two or more inputs end to end."], "extent": [93, 142]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation sequences two or more inputs end to end. This operation\ndoes not use any cache memory if all the input resolutions match;\notherwise for inputs that do not match the output resolution must be\nscaled or cropped."], "extent": [185, 412]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [412, 424], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Plane Merge"], "extent": [424, 441], "body": [{"type": "para", "indent": 8, "text": ["If the planes in the inputs differ, this specifies what the\n        output planes should be."], "extent": [441, 542]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Raster Depth"], "extent": [542, 560], "body": [{"type": "para", "indent": 8, "text": ["If the raster depth for a given plane differs between inputs,\n        this specifies what the output raster depth for the plane should\n        be."], "extent": [560, 715]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Resolution Match"], "extent": [715, 737], "body": [{"type": "para", "indent": 8, "text": ["If the image resolutions do not match, this parameter specifies\n        what the output resolution should be."], "extent": [737, 855]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Size"], "extent": [855, 865], "body": [{"type": "para", "indent": 8, "text": ["If 'Resolution Match' is set to 'Specify Resolution', this\n        parameter specifies the image size."], "extent": [865, 976]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Scale to New Size"], "extent": [976, 999], "body": [{"type": "para", "indent": 8, "text": ["If an input\u2019s resolution differs from the output, it will be\n        cropped or extended with black unless this option is selected."], "extent": [999, 1139]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Scale Filter"], "extent": [1139, 1157], "body": [{"type": "para", "indent": 8, "text": ["The filter to use when scaling."], "extent": [1157, 1197]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Rate"], "extent": [1197, 1213], "body": [{"type": "para", "indent": 8, "text": ["If the frame rates of the inputs differ, this determines what\n        the output frame rate should be."], "extent": [1213, 1324]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1324, 1332], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], 