{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "layoutbrushpaint", "icon": "SOP/layoutbrushpaint", "tags": "paintinstancesbrush", "allow_hidden": "true", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Paint (Paint Instances brush)"], "extent": [0, 34]}, {"type": "summary", "indent": 0, "text": ["Quickly paint assets onto surfaces."], "extent": [164, 207]}, {"type": "box_group", "body": [{"ext": null, "type": "box", "indent": 0, "role": "item", "extent": [16, 22], "body": [{"type": "para", "indent": 4, "text": ["This node is designed to customize the behavior of the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["Paint Instances LOP"], "fullpath": "/nodes/lop/paintinstances.html"}, ". See the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["help for Paint Instances"], "fullpath": "/nodes/lop/paintinstances.html"}, " for more information."], "extent": [51, 238]}], "container": true, "attrs": {"id": "see_paintinstances"}}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [258, 273], "body": [{"type": "para", "indent": 0, "text": ["This brush is a general purpose paint brush to quickly scatter assets along a surface. Under the hood it uses the ", {"scheme": "Node", "value": "/nodes/sop/scatteralign", "type": "link", "text": ["Scatter and Align SOP"], "fullpath": "/nodes/sop/scatteralign.html"}, " and has many of the same parameters."], "extent": [273, 473]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [473, 485], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Brush"], "extent": [485, 498], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [498, 507], "body": [{"type": "para", "indent": 4, "text": ["Radius of the paint brush, in world units. Shift+Ctrl+LMB drag in the viewer, or use the mouse wheel to interactively resize."], "extent": [524, 655]}], "container": true, "attrs": {"id": "radius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Spacing"], "extent": [655, 664], "body": [{"type": "para", "indent": 4, "text": ["The minimum distance the brush has to move before another dab of assets is placed, as a fraction of ", {"type": "ui", "text": ["Radius"]}, ". For example, at ", {"type": "code", "text": ["0.5"]}, ", you need to move half the brush radius from the last dab before the brush triggers again. Lower values place dabs more densely along a stroke; higher values space them further apart."], "extent": [685, 1008]}], "container": true, "attrs": {"id": "softradius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Normal Blend"], "extent": [1008, 1022], "body": [{"type": "para", "indent": 4, "text": ["A blend factor between the world up direction and the surface normal at each scattered point. At ", {"type": "code", "text": ["1.0"]}, " (the default) the scattered assets are fully aligned to the surface normal. At ", {"type": "code", "text": ["0.0"]}, " they point straight up regardless of the surface they're painted on. Values in between blend between the two."], "extent": [1044, 1348]}], "container": true, "attrs": {"id": "normalblend"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Instances"], "extent": [1348, 1364], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Point Count Method"], "extent": [1364, 1385], "body": [{"type": "para", "indent": 4, "text": ["How the brush decides how many assets to scatter inside the brush footprint per dab."], "extent": [1412, 1502]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["By Size"], "extent": [1502, 1515], "body": [{"type": "para", "indent": 8, "text": ["Assigns a random size to each point, based on the given minimum and maximum radius of the assets, and spaces the points such that the assets will not overlap. See the ", {"type": "ui", "text": ["Size"]}, " section below."], "extent": [1515, 1715]}], "container": true}, {"type": "dt", "indent": 4, "text": ["By Density"], "extent": [1715, 1731], "body": [{"type": "para", "indent": 8, "text": ["Generates a base density of points across the brush footprint, falling off according to the ", {"type": "ui", "text": ["Density Profile"]}, " ramp. See the ", {"type": "ui", "text": ["Density"]}, " section below."], "extent": [1731, 1893]}], "container": true}, {"type": "dt", "indent": 4, "text": ["By Point Spacing"], "extent": [1893, 1915], "body": [{"type": "para", "indent": 8, "text": ["Derives the number of points from a desired spacing between them. See the ", {"type": "ui", "text": ["Spacing"]}, " section below."], "extent": [1915, 2025]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Number of Points"], "extent": [2025, 2047], "body": [{"type": "para", "indent": 8, "text": ["Scatters a fixed number of points inside the brush footprint per dab. See the ", {"type": "ui", "text": ["Number of Points"]}, " section below."], "extent": [2047, 2170]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "pointcountmethod"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Size "], "extent": [2170, 2183]}, {"type": "para", "indent": 0, "text": ["These parameters are visible when ", {"type": "ui", "text": ["Point Count Method"]}, " is ", {"type": "ui", "text": ["By Size"]}, "."], "extent": [2183, 2258]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Min Asset Radius"], "extent": [2258, 2276], "body": [{"type": "para", "indent": 4, "text": ["The smallest radius of the assets that will be copied onto the points. Used by the scatter to space points so the smallest assets won\u2019t overlap."], "extent": [2296, 2446]}], "container": true, "attrs": {"id": "minradius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Max Asset Radius"], "extent": [2446, 2464], "body": [{"type": "para", "indent": 4, "text": ["The largest radius of the assets that will be copied onto the points. Used by the scatter to space points so the largest assets won\u2019t overlap."], "extent": [2484, 2632]}], "container": true, "attrs": {"id": "maxradius"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Uniform Scale"], "extent": [2632, 2647], "body": [{"type": "para", "indent": 4, "text": ["A value to scale all point sizes by."], "extent": [2670, 2713]}], "container": true, "attrs": {"id": "uniformscale"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Density "], "extent": [2713, 2729]}, {"type": "para", "indent": 0, "text": ["These parameters are visible when ", {"type": "ui", "text": ["Point Count Method"]}, " is ", {"type": "ui", "text": ["By Density"]}, "."], "extent": [2729, 2807]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Density Scale"], "extent": [2807, 2822], "body": [{"type": "para", "indent": 4, "text": ["Scales the base density of scattered points. Higher values place more assets per dab; lower values place fewer."], "extent": [2845, 2962]}], "container": true, "attrs": {"id": "densityscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Density Profile"], "extent": [2962, 2979], "body": [{"type": "para", "indent": 4, "text": ["A ramp controlling how density falls off from the center of the brush (left side of the ramp) to the edge (right side). The default is a linear falloff from full density at the center to zero at the edge, giving a soft brush profile. Flatten the ramp for a hard-edged brush, or shape it to bias dabs toward the center or the rim."], "extent": [3001, 3337]}], "container": true, "attrs": {"id": "densityramp"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Spacing "], "extent": [3337, 3353]}, {"type": "para", "indent": 0, "text": ["These parameters are visible when ", {"type": "ui", "text": ["Point Count Method"]}, " is ", {"type": "ui", "text": ["By Point Spacing"]}, "."], "extent": [3353, 3437]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Spacing"], "extent": [3437, 3446], "body": [{"type": "para", "indent": 4, "text": ["The desired space between scattered points. The brush will set the density so points end up no closer than this distance after relaxation."], "extent": [3464, 3608]}], "container": true, "attrs": {"id": "spacing"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Use Minimum Spacing"], "extent": [3608, 3629], "body": [{"type": "para", "indent": 4, "text": ["Turn on the checkbox next to ", {"type": "ui", "text": ["Minimum Spacing"]}, " to enforce a hard minimum distance between scattered points."], "extent": [3653, 3768]}], "container": true, "attrs": {"id": "useminspacing"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Minimum Spacing"], "extent": [3768, 3785], "body": [{"type": "para", "indent": 4, "text": ["A minimum allowed distance between points. Any points that would be closer than this are spaced out to this distance. This guards against parameter combinations that would cause a sudden spike in point density."], "extent": [3806, 4022]}], "container": true, "attrs": {"id": "minspacing"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Number of Points "], "extent": [4022, 4047]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Total Points"], "extent": [4047, 4062], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Point Count Method"]}, " is ", {"type": "ui", "text": ["Number of Points"]}, ", this is the number of points to generate per brush dab."], "extent": [4077, 4192]}], "container": true, "attrs": {"id": "npts"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Orientation "], "extent": [4192, 4212]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Max Random Cone Angle"], "extent": [4212, 4236], "body": [{"type": "para", "indent": 4, "text": ["Rotates each scattered asset away from its ", {"type": "q", "text": ["up"]}, " direction (the surface normal blended with world up by ", {"type": "ui", "text": ["Normal Blend"]}, ") by a random amount, up to this maximum number of degrees. Creates variation in the tilt of the painted assets."], "extent": [4258, 4495]}], "container": true, "attrs": {"id": "uniformrand"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Rotation Around Normal"], "extent": [4495, 4520], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Min Angle"], "extent": [4520, 4535], "body": [{"type": "para", "indent": 8, "text": ["The minimum random rotation around each asset\u2019s up direction."], "extent": [4564, 4635]}], "container": true, "attrs": {"id": "perprotrandmin"}}, {"type": "dt", "indent": 4, "text": ["Max Angle"], "extent": [4635, 4650], "body": [{"type": "para", "indent": 8, "text": ["The maximum random rotation around each asset\u2019s up direction. The default range of 0-360 gives fully random spin."], "extent": [4679, 4802]}], "container": true, "attrs": {"id": "perprotrandmax"}}, {"type": "dt", "indent": 4, "text": ["Round Rotation Around Normal"], "extent": [4802, 4836], "body": [{"type": "para", "indent": 8, "text": ["When on, the random rotation around the up direction is rounded to the nearest integer multiple of ", {"type": "ui", "text": ["Round to Multiple Of"]}, ". Useful for instancing buildings or other assets that should only rotate by fixed steps (for example, multiples of 90 degrees)."], "extent": [4863, 5124]}], "container": true, "attrs": {"id": "roundperprot"}}, {"type": "dt", "indent": 4, "text": ["Round to Multiple Of"], "extent": [5124, 5150], "body": [{"type": "para", "indent": 8, "text": ["When ", {"type": "ui", "text": ["Round Rotation Around Normal"]}, " is on, the random rotation is rounded to the nearest multiple of this angle (in degrees)."], "extent": [5177, 5314]}], "container": true, "attrs": {"id": "perprandstep"}}, {"type": "dt", "indent": 4, "text": ["Offset Angle"], "extent": [5314, 5332], "body": [{"type": "para", "indent": 8, "text": ["An additional fixed rotation, in degrees, applied to every asset around its up direction after the random rotation has been calculated."], "extent": [5354, 5500]}], "container": true, "attrs": {"id": "basenml"}}], "container": true}], "container": true, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "text": [" Scale "], "extent": [5500, 5514]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Use Scale from Scatter"], "extent": [5514, 5539], "body": [{"type": "para", "indent": 4, "text": ["When on, the scale assigned to each asset during the scatter process is multiplied by the uniform or random values specified in the other scale parameters. ."], "extent": [5561, 5724]}], "container": true, "attrs": {"id": "usescatters"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Use Random Scale"], "extent": [5724, 5742], "body": [{"type": "para", "indent": 4, "text": ["When on, each scattered asset is given a random uniform scale between ", {"type": "ui", "text": ["Minimum"]}, " and ", {"type": "ui", "text": ["Maximum"]}, ". When off, all assets get the same scale from ", {"type": "ui", "text": ["Uniform Scale"]}, "."], "extent": [5763, 5931]}], "container": true, "attrs": {"id": "userandoms"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Uniform Scale"], "extent": [5931, 5946], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Use Random Scale"]}, " is off, every scattered asset is scaled uniformly by this value."], "extent": [5958, 6054]}], "container": true, "attrs": {"id": "s"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Minimum"], "extent": [6054, 6063], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Use Random Scale"]}, " is on, the smallest random scale factor an asset can receive."], "extent": [6078, 6171]}], "container": true, "attrs": {"id": "mins"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Maximum"], "extent": [6171, 6180], "body": [{"type": "para", "indent": 4, "text": ["When ", {"type": "ui", "text": ["Use Random Scale"]}, " is on, the largest random scale factor an asset can receive."], "extent": [6195, 6288]}], "container": true, "attrs": {"id": "maxs"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [6288, 6297], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": "", "fullpath": "/nodes/lop/paintinstances.html"}], "extent": [6297, 6325]}], "container": true}], "text": "Related"}], "title": ["Paint (Paint Instances brush)"], "summary": ["Quickly paint assets onto surfaces."], "included": ["/nodes/sop/_paintinstancesbrush"]}