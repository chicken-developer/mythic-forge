{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "unpin", "icon": "COP2/unpin", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Unpin"], "extent": [74, 84]}, {"type": "summary", "indent": 0, "text": ["Extracts an arbitrary quadrilateral area out of the input image."], "extent": [84, 157]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation allows you to extract an arbitrary quadrilateral area out\nof the input image and stretch it to fill the full resolution of the\noutput. It is the opposite of corner pin."], "extent": [200, 385]}, {"type": "para", "indent": 0, "text": ["Four points are used to define the desired area of the input image.\nImage data outside the desired area is discarded."], "extent": [385, 504]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Scoping"], "extent": [57, 75], "body": [{"type": "para", "indent": 8, "text": ["This operation may be restricted to certain planes, or\n        components of planes. In addition, the operation may be applied\n        to a subset of frames within the sequence. An image must have\n        both its frame and plane scoped to be modified."], "extent": [75, 338]}, {"type": "para", "indent": 8, "text": ["Images that are not modified are passed through, which does not\n        take any memory or processing time."], "extent": [338, 455]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Masking"], "extent": [56, 74], "body": [{"type": "para", "indent": 8, "text": ["This operation may be masked, which restricts the operation to\n        an area of the image. The mask may be inverted, brightened or\n        dimmed."], "extent": [74, 233]}, {"type": "para", "indent": 8, "text": ["The mask input is on the side of the node. The label on the\n        connector indicates the plane being used as a mask."], "extent": [233, 362]}, {"type": "para", "indent": 8, "text": ["The mask input can also be scaled to fit the output image\u2019s resolution, if they differ. If this node is changing constantly, and the mask is not, it is somewhat faster to put a ", {"scheme": "Node", "value": "/nodes/cop2/scale", "type": "link", "text": ["Scale COP"], "fullpath": "/nodes/cop2/scale.html"}, " down to do the resize for the mask image. Otherwise, the scale will occur every time this node cooks."], "extent": [362, 678]}]}, {"type": "para", "indent": 0, "text": ["In the viewport:"], "extent": [589, 607]}, {"tag": "steps", "attrs": {}, "type": "pxml", "indent": 0, "extent": [607, 615], "body": [{"type": "ord_group", "body": [{"blevel": 6, "type": "ord", "indent": 4, "text": [{"keys": ["RMB"], "type": "keys", "text": null}, " click or press ", {"keys": ["E"], "type": "keys", "text": null}, " (default hotkey) to edit the handles\n      on the input image. The viewed image will change to that of the\n      input."], "extent": [615, 771]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["Adjust the handles by ", {"keys": ["LMB"], "type": "keys", "text": null}, " dragging them to the corners of the\n      area you wish to unpin."], "extent": [771, 874]}, {"blevel": 6, "type": "ord", "indent": 4, "text": ["You can ", {"keys": ["Alt", "LMB"], "type": "keys", "text": null}, " click a handle to select it, or\n      ", {"keys": ["Alt", "LMB"], "type": "keys", "text": null}, " drag around handle to select them and move the\n      selected handles as a group.", {"keys": ["Alt", "LMB"], "type": "keys", "text": null}, " click empty space to\n      deselect the handles."], "extent": [874, 1099]}, {"blevel": 6, "type": "ord", "indent": 4, "text": [{"keys": ["RMB"], "type": "keys", "text": null}, " click again or press 'e' to return to viewing the output\n      of this node."], "extent": [1099, 1191]}], "container": true}], "container": true}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [1191, 1197], "body": [{"type": "para", "indent": 4, "text": ["Unpin will be temporarily bypassed while you select the input area.\n    It will automatically un-bypass again when you finish selecting the\n    area."], "extent": [1197, 1353]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [1353, 1365], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["UnPin"], "extent": [1365, 1382], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Units"], "extent": [1382, 1398], "body": [{"type": "para", "indent": 12, "text": ["Specifies the units of the point coordinates."], "extent": [1398, 1456]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Bottom Left, Bottom Right, Top Left, Top Right"], "extent": [1456, 1512], "body": [{"type": "para", "indent": 12, "text": ["The four corner points of the input area."], "extent": [1574, 1628]}], "container": true, "attrs": {"channels": "/botleft /botright /topleft /topright"}, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Filter"], "extent": [1628, 1644], "body": [{"type": "para", "indent": 12, "text": ["The filter to use when scaling the image to fit the new\n            area."], "extent": [1644, 1730]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1730, 1738], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1764, 1773], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/pin", "type": "link", "text": "", "fullpath": "/nodes/cop2/pin.html"}], "extent": [1773, 1796]}], "container": true}], "text": "Related"}], "title": ["Unpin"], "summary": ["Extracts an arbitrary quadrilateral area out of the input image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars", "/nodes/cop2/maskparms", "/nodes/cop2/pixelparms"]}