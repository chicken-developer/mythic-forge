{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "metadata", "icon": "COP2/metadata", "since": "16.0", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Metadata"], "extent": [93, 106]}, {"type": "summary", "indent": 0, "text": ["Applies metadata to an image sequence."], "extent": [106, 153]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Metadata applied to an image sequence can be read via the ", {"type": "code", "text": ["copmeta"]}, " or ", {"type": "code", "text": ["copmetas"]}, " expression functions in other parameters. Metadata can be in a variety of different formats, such as scalar float, vectors, matrices, and strings. Metadata cannot be animated. Metadata is created and accessed by name."], "extent": [196, 497]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [497, 509], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Add Metadata"], "extent": [509, 527], "body": [{"type": "para", "indent": 8, "text": ["Controls the number of metadata elements added to the sequence."], "extent": [527, 600]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Metadata #"], "extent": [600, 620], "body": [{"type": "para", "indent": 12, "text": ["Toggle to disable this metadata element."], "extent": [620, 673]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Name"], "extent": [673, 687], "body": [{"type": "para", "indent": 12, "text": ["Name of the metadata element. Must be alphanumeric."], "extent": [687, 751]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Type"], "extent": [751, 765], "body": [{"type": "para", "indent": 12, "text": ["Specifies the type of the data."], "extent": [765, 810]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": ["Float"], "extent": [810, 829], "body": [{"type": "para", "indent": 16, "text": ["Single floating point value."], "extent": [829, 874]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Integer"], "extent": [874, 895], "body": [{"type": "para", "indent": 16, "text": ["Single integer value."], "extent": [895, 933]}], "container": true}, {"type": "dt", "indent": 12, "text": ["String"], "extent": [933, 953], "body": [{"type": "para", "indent": 16, "text": ["String value."], "extent": [953, 983]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Vector 2"], "extent": [983, 1005], "body": [{"type": "para", "indent": 16, "text": ["Two floating point values."], "extent": [1005, 1048]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Vector 3"], "extent": [1048, 1070], "body": [{"type": "para", "indent": 16, "text": ["Three floating point values."], "extent": [1070, 1115]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Vector 4"], "extent": [1115, 1137], "body": [{"type": "para", "indent": 16, "text": ["Four floating point values."], "extent": [1137, 1181]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Integer Vector 2"], "extent": [1181, 1211], "body": [{"type": "para", "indent": 16, "text": ["Two integer values."], "extent": [1211, 1247]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Integer Vector 3"], "extent": [1247, 1277], "body": [{"type": "para", "indent": 16, "text": ["Three integer values."], "extent": [1277, 1315]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Integer Vector 4"], "extent": [1315, 1345], "body": [{"type": "para", "indent": 16, "text": ["Four integer values."], "extent": [1345, 1382]}], "container": true}, {"type": "dt", "indent": 12, "text": ["2\u00d72 Matrix"], "extent": [1382, 1406], "body": [{"type": "para", "indent": 16, "text": ["A 2\u00d72 matrix for simple 2D rotation and scale."], "extent": [1406, 1469]}], "container": true}, {"type": "dt", "indent": 12, "text": ["3\u00d73 Matrix"], "extent": [1469, 1493], "body": [{"type": "para", "indent": 16, "text": ["A 3\u00d73 matrix for 2D rotation, scale, and translation."], "extent": [1493, 1563]}], "container": true}, {"type": "dt", "indent": 12, "text": ["4\u00d74 Matrix"], "extent": [1563, 1587], "body": [{"type": "para", "indent": 16, "text": ["A 4\u00d74 matrix for 3D rotation, scale, and translation."], "extent": [1587, 1657]}], "container": true}, {"type": "dt", "indent": 12, "text": ["Quaternion"], "extent": [1657, 1681], "body": [{"type": "para", "indent": 16, "text": ["A quaternion for representing a rotation or orientation."], "extent": [1681, 1755]}], "container": true}], "container": true}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Delete Metadata"], "extent": [1755, 1776], "body": [{"type": "para", "indent": 8, "text": ["Metadata to remove from the image sequence, specified by name.\n        Wildcards are accepted (*,?) as are multiple names."], "extent": [1776, 1907]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1907, 1915], "body": [{"type": "dt_group", "body":