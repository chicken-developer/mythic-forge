{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "rename", "icon": "COP2/rename", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Rename"], "extent": [76, 87]}, {"type": "summary", "indent": 0, "text": ["Change the name a plane."], "extent": [87, 120]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation allows you to change the name a plane. This operation\ndoes not use any cache memory."], "extent": [163, 264]}, {"type": "para", "indent": 0, "text": ["If Color or Alpha is renamed, a new plane will be created with the new\nname, and Color or Alpha will be cleared."], "extent": [264, 379]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [379, 391], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Rename Planes From"], "extent": [391, 415], "body": [{"type": "para", "indent": 8, "text": ["The input planes to rename."], "extent": [415, 451]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Rename Planes To"], "extent": [451, 473], "body": [{"type": "para", "indent": 8, "text": ["The new plane names, which should have a one to one\n        correspondence to the input planes."], "extent": [473, 578]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [578, 587], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/delete", "type": "link", "text": "", "fullpath": "/nodes/cop2/delete.html"}], "extent": [587, 612]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/merge", "type": "link", "text": "", "fullpath": "/nodes/cop2/merge.html"}], "extent": [612, 637]}], "container": true}], "text": "Related"}], "title": ["Rename"], "summary": ["Change the name a plane."], "included": ["/composite/_old_cops_deprecated"]}