{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "agentconfigurejoints", "icon": "SOP/agentconfigurejoints", "since": "14.5", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Agent Configure Joints"], "extent": [104, 131]}, {"type": "summary", "indent": 0, "text": ["Creates point attributes that specify the rotation limits of an agent\u2019s joints."], "extent": [131, 219]}, {"type": "para", "indent": 0, "text": ["The rotation limits are described by a minimum and maximum rotation about each\naxis, which forms an elliptical cone within which rotation may take place.\nThe point attributes created by this node can be used by the ", {"scheme": "Node", "value": "/nodes/sop/agentconstraintnetwork", "type": "link", "text": ["Agent Constraint\nNetwork SOP"], "fullpath": "/nodes/sop/agentconstraintnetwork.html"}, " to build the ", {"scheme": "Node", "value": "/nodes/dop/constraintnetwork", "type": "link", "text": ["constraint\nnetwork"], "fullpath": "/nodes/dop/constraintnetwork.html"}, " geometry for a crowd of agents."], "extent": [219, 591]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [591, 603], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Group"], "extent": [603, 611], "body": [{"type": "para", "indent": 4, "text": ["The agents to configure joint limits for."], "extent": [611, 658]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": "joints", "container": true, "type": "h", "indent": 0, "text": ["Joints"], "extent": [658, 680], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Create Limits For Collision Layer"], "extent": [680, 716], "body": [{"type": "para", "indent": 4, "text": ["Adds a joint limit for each transform that has a shape attached to it in the agent\u2019s collision layer.\n    The rotation limits are initialized based on existing limits from the input agent, as well as the range of motion in the agent\u2019s animation clips."], "extent": [716, 973]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Animation Clips"], "extent": [973, 990], "body": [{"type": "para", "indent": 4, "text": ["A string pattern that specifies which animation clips should be used when computing initial rotation limits."], "extent": [990, 1104]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Reset All Limits"], "extent": [1104, 1122], "body": [{"type": "para", "indent": 4, "text": ["Resets all of the joint limits to their initial values.\n    The joint limits' initial values are determined from any existing limits on the input agent, or from the agent\u2019s animation clips.\n    This is equivalent to using the ", {"type": "ui", "text": ["Reset Limits"]}, " button for all of the multiparm entries."], "extent": [1122, 1411]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Joint Limits"], "extent": [1411, 1425], "body": [{"type": "para", "indent": 4, "text": ["The number of joint limits to configure."], "extent": [1425, 1471]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Transform Name"], "extent": [1471, 1487], "body": [{"type": "para", "indent": 4, "text": ["Specifies which transform in the agent\u2019s rig to configure the rotation limit for."], "extent": [1487, 1574]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Parent Transform Name"], "extent": [1574, 1597], "body": [{"type": "para", "indent": 4, "text": ["Specifies which transform in the agent\u2019s rig the cone should be attached to.\n    Typically this should be the parent of the ", {"type": "ui", "text": ["Transform Name"]}, ", but for some rigs another transform (such as the grandparent) may be a more appropriate choice."], "extent": [1597, 1842]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Child Rotation"], "extent": [1842, 1858], "body": [{"type": "para", "indent": 4, "text": ["Specifies the rotation of the twist axis, up axis, and out axis in the space of the child transform.\n    By default, the twist axis is aligned with the bone."], "extent": [1858, 2021]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Anchor Position"], "extent": [2021, 2038], "body": [{"type": "para", "indent": 4, "text": ["The position of the cone in the local space of the parent transform."], "extent": [2038, 2112]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Cone Rotation"], "extent": [2112, 2127], "body": [{"type": "para", "indent": 4, "text": ["The orientation of the cone in the local space of the parent transform."], "extent": [2127, 2204]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Twist Rotation Range"], "extent": [2204, 2226], "body": [{"type": "para", "indent": 4, "text": ["Specifies the minimum and maximum rotation about the twist axis in degrees."], "extent": [2226, 2307]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Up Rotation Range"], "extent": [2307, 2326], "body": [{"type": "para", "indent": 4, "text": ["Specifies the minimum and maximum rotation about the up axis in degrees."], "extent": [2326, 2404]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Out Rotation Range"], "extent": [2404, 2424], "body": [{"type": "para", "indent": 4, "text": ["Specifies the minimum and maximum rotation about the out axis in degrees."], "extent": [2424, 2503]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Reset Limits"], "extent": [2503, 2517], "body": [{"type": "para", "indent": 4, "text": ["Reset the joint limits to their initial values.\n    If limits were already configured for this joint, those values will be extracted to allow editing existing limits.\n    Otherwise, the limits will be computed from the agent\u2019s animation clips."], "extent": [2517, 2766]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Initialize from Animation Clips"], "extent": [2766, 2799], "body": [{"type": "para", "indent": 4, "text": ["Computes rotation limits by analyzing the agent\u2019s animation clips.\n    This can provide a useful starting point for the ragdoll\u2019s rotation limits."], "extent": [2799, 2951]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": "guides", "container": true, "type": "h", "indent": 0, "text": ["Guides"], "extent": [2951, 2973], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Scale"], "extent": [2973, 2981], "body": [{"type": "para", "indent": 4, "text": ["Adjusts the size of the guide geometry."], "extent": [2981, 3026]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Cone Limit Color"], "extent": [3026, 3044], "body": [{"type": "para", "indent": 4, "text": ["The color of the guide geometry for the ", {"type": "ui", "text": ["Up Rotation Range"]}, " and ", {"type": "ui", "text": ["Out Rotation Range"]}, "."], "extent": [3044, 3139]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Twist Limit Color"], "extent": [3139, 3158], "body": [{"type": "para", "indent": 4, "text": ["The color of the guide geometry for the ", {"type": "ui", "text": ["Twist Rotation Range"]}, "."], "extent": [3158, 3229]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Twist Axis Color"], "extent": [3229, 3247], "body": [{"type": "para", "indent": 4, "text": ["The color of the guide geometry for the child\u2019s twist axis."], "extent": [3247, 3312]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Up Axis Color"], "extent": [3312, 3327], "body": [{"type": "para", "indent": 4, "text": ["The color of the guide geometry for the child\u2019s up axis."], "extent": [3327, 3389]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [3389, 3398], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agent", "type": "link", "text": "", "fullpath": "/nodes/sop/agent.html"}], "extent": [3398, 3417]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agentcollisionlayer", "type": "link", "text": "", "fullpath": "/nodes/sop/agentcollisionlayer.html"}], "extent": [3417, 3450]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/sop/agentconstraintnetwork", "type": "link", "text": "", "fullpath": "/nodes/sop/agentconstraintnetwork.html"}], "extent": [3450, 3486]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/dop/bulletrbdsolver", "type": "link", "text": "", "fullpath": "/nodes/dop/bulletrbdsolver.html"}], "extent": [3486, 3515]}], "container": true}], "text": "Related"}], "title": ["Agent Configure Joints"], "summary": ["Creates point attributes that specify the rotation limits of an agent\u2019s joints."]}