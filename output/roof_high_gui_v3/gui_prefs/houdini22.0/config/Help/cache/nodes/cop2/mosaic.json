{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "mosaic", "icon": "COP2/mosaic", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Mosaic"], "extent": [76, 87]}, {"type": "summary", "indent": 0, "text": ["Takes a sequence of images and combines them into 1 image by tiling them."], "extent": [87, 169]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation takes a sequence of images and combines them into 1 image\nby tiling them. If the sequence is not completely divisible by the\nnumber of images per line or images per frame, the missing tiles are\nfilled with a background color."], "extent": [212, 454]}, {"type": "para", "indent": 0, "text": ["A limit on the number of images per frame can also be used to create more than one mosaic frame with a smaller set of images."], "extent": [454, 582]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [582, 594], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Images per Line"], "extent": [594, 615], "body": [{"type": "para", "indent": 8, "text": ["Defines the number of image per row or per column, depending on\n        whether images are stacked by row or column."], "extent": [647, 772]}], "container": true, "attrs": {"channels": "/numperline"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Stack Vertically"], "extent": [772, 794], "body": [{"type": "para", "indent": 8, "text": ["Defines the vertical stack order."], "extent": [794, 836]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Stack Horizontally"], "extent": [836, 860], "body": [{"type": "para", "indent": 8, "text": ["Defines the horizontal stack order."], "extent": [860, 904]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Stack Images in Rows"], "extent": [904, 930], "body": [{"type": "para", "indent": 8, "text": ["If on, images are stacked horizontally first, then vertically.\n        If off, images are stacked vertically first."], "extent": [930, 1054]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Max Images/Frame"], "extent": [1054, 1076], "body": [{"type": "para", "indent": 8, "text": ["Limits the number of input images in one image. If on, each 'N'\n        input images form 1 output image. If off, the entire sequence is\n        put into 1 image."], "extent": [1108, 1279]}], "container": true, "attrs": {"channels": "/imagelimit"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Keep Full Size"], "extent": [1279, 1299], "body": [{"type": "para", "indent": 8, "text": ["If on, the image will always have at least as many images as\n        specified in 'Images per Line' and 'Max Images/Frame', even if\n        the sequence is shorter than either value. The missing frames\n        are filled with the background color."], "extent": [1299, 1555]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Background Color"], "extent": [1555, 1577], "body": [{"type": "para", "indent": 8, "text": ["The color to substitute for areas of the mosaic not covered\n        by input frames, which can occur if the number of frames in the\n        input is not evenly divisible by the Images per Line (or Max\n        Images per Frame)."], "extent": [1645, 1881]}], "container": true, "attrs": {"channels": "/backcolorr /backcolorg /backcolorb /backcolora"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1881, 1889], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1915, 1924], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/tile", "type": "link", "text": "", "fullpath": "/nodes/cop2/tile.html"}], "extent": [1924, 1948]}], "container": true}], "text": "Related"}], "title": ["Mosaic"], "summary": ["Takes a sequence of images and combines them into 1 image by tiling them."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}