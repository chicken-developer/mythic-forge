{"type": "root", "attrs": {"type": "node", "context": "cop", "internal": "pyro_block_begin", "icon": "COP/pyro_block_begin", "since": "21.0", "version": "", "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Pyro Block Begin"], "extent": [108, 129]}, {"type": "summary", "indent": 0, "text": ["Start of a Pyro simulation block."], "extent": [129, 171]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [171, 177], "body": [{"type": "para", "indent": 4, "text": ["Although COP Pyro is in COPs, you need DOP level permissions to use it. This means that COP Pyro is ", {"type": "em", "text": ["not"]}, " available in Houdini Core, but only in Houdini FX, Houdini Apprentice, Houdini Indie, and Houdini Education."], "extent": [177, 397]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This node marks the beginning of a Pyro simulation block."], "extent": [397, 456]}, {"type": "para", "indent": 0, "text": ["Operations that are independent of previous frames should occur before the block so they only get cooked once.   Likewise, post processing operations that are not needed to feedback should occur after the\nblock end."], "extent": [456, 673]}, {"type": "para", "indent": 0, "text": ["The ", {"type": "code", "text": ["passthrough"]}, " input can be used to bring additional inputs inside the block, and the ", {"type": "code", "text": ["feedback"]}, " to add additional values that need to be updated every frame."], "extent": [673, 836]}, {"type": "para", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_configure", "type": "link", "text": ["Pyro Configure COP"], "fullpath": "/nodes/cop/pyro_configure.html"}, " can be used to setup the initial VDBs for a simulation."], "extent": [836, 938]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [938, 950], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Block Path"], "extent": [950, 963], "body": [{"type": "para", "indent": 4, "text": ["The path to the ", {"scheme": "Node", "value": "/nodes/cop/pyro_block_end", "type": "link", "text": ["Pyro Block End COP"], "fullpath": "/nodes/cop/pyro_block_end.html"}, " that\u2019s the final and closing node of this block. The Block End node must be at the same network level as this Block Begin node."], "extent": [982, 1185]}], "container": true, "attrs": {"id": "blockpath"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Activation"], "extent": [1185, 1202], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Enable Activation"], "extent": [1202, 1222], "body": [{"type": "para", "indent": 4, "text": ["The simulation only solves in activated leaves, which are blocks of 8^3 voxels.   If the simulation domain is known, it can be pre-activated, in which case the activation rules can be skipped for faster performance.  But usually the cost of activation makes up for the improvement in speed of working with a smaller volume."], "extent": [1239, 1577]}], "container": true, "attrs": {"id": "resize"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["VDBs to Activate"], "extent": [1577, 1595], "body": [{"type": "para", "indent": 4, "text": ["The wire-names of the VDBs that should resize to the new bounds."], "extent": [1618, 1688]}, {"type": "para", "indent": 4, "text": ["Note the velocity VDB ", {"type": "code", "text": ["v"]}, " is always activated if activation is turned on ."], "extent": [1688, 1777]}], "container": true, "attrs": {"id": "activatelist"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Density Cutoff"], "extent": [1777, 1793], "body": [{"type": "para", "indent": 4, "text": ["Any leaf whose maximum density is below the cutoff will be eligible to be deactivated."], "extent": [1810, 1906]}], "container": true, "attrs": {"id": "cutoff"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Leaf Padding"], "extent": [1906, 1920], "body": [{"type": "para", "indent": 4, "text": ["Expand the active region a fixed number of leaves."], "extent": [1947, 2003]}, {"type": "para", "indent": 4, "text": ["The maximum of ", {"type": "ui", "text": ["Padding Distance"]}, " and ", {"type": "ui", "text": ["Leaf Padding"]}, " are used."], "extent": [2003, 2079]}], "container": true, "attrs": {"id": "leafdilation"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Padding Distance"], "extent": [2079, 2097], "body": [{"type": "para", "indent": 4, "text": ["Expand the active region a fixed distance in world space. This is raised to the nearest leaf.  "], "extent": [2128, 2229]}, {"type": "para", "indent": 4, "text": ["The maximum of ", {"type": "ui", "text": ["Padding Distance"]}, " and ", {"type": "ui", "text": ["Leaf Padding"]}, " are used."], "extent": [2229, 2305]}], "container": true, "attrs": {"id": "leafdilationdist"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Pad by Velocity"], "extent": [2305, 2322], "body": [{"type": "para", "indent": 4, "text": ["Each leaf\u2019s maximum velocity in each of the directions is measured, and the leaf expanded to cover that distance."], "extent": [2346, 2465]}, {"type": "para", "indent": 4, "text": ["This can ensure the air field is present for the incoming air."], "extent": [2465, 2542]}], "container": true, "attrs": {"id": "veldilate"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Velocity Scale"], "extent": [2542, 2558], "body": [{"type": "para", "indent": 4, "text": ["Scale the velocity used for velocity dilation.  This also scaled by the timestep."], "extent": [2581, 2672]}], "container": true, "attrs": {"id": "velscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Tangential Scale"], "extent": [2672, 2690], "body": [{"type": "para", "indent": 4, "text": ["Also dilate in the perpendicular directions to the velocity by this portion of the velocity dilation.  Usually fluid is turbulent, so if it needs to extend in one direction the neighboring directions are also likely important."], "extent": [2714, 2950]}], "container": true, "attrs": {"id": "tangscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Min X"], "extent": [2950, 2962], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions less than this in X."], "extent": [2981, 3054]}], "container": true, "attrs": {"id": "clipminx"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Min Y"], "extent": [3054, 3066], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions less than this in Y."], "extent": [3089, 3162]}], "container": true, "attrs": {"id": "clipminy"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Min Z"], "extent": [3162, 3174], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions less than this in Z."], "extent": [3197, 3266]}], "container": true, "attrs": {"id": "clipminz"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Max X"], "extent": [3266, 3278], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions greater than this in X."], "extent": [3301, 3373]}], "container": true, "attrs": {"id": "clipmaxx"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Max Y"], "extent": [3373, 3385], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions greater than this in Y."], "extent": [3404, 3480]}], "container": true, "attrs": {"id": "clipmaxy"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Clip Max Z"], "extent": [3480, 3492], "body": [{"type": "para", "indent": 4, "text": ["Deactivate any leaves with world positions greater than this in Z."], "extent": [3515, 3596]}], "container": true, "attrs": {"id": "clipmaxz"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Advection"], "extent": [3596, 3612], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Integrator"], "extent": [3612, 3625], "body": [{"type": "para", "indent": 4, "text": ["The method used to compute the flow map of the velocity VDB."], "extent": [3650, 3720]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Path Trace"], "extent": [3720, 3736], "body": [{"type": "para", "indent": 8, "text": ["The velocity VDB is traced using the the CFL condition to control the step size.  This can handle large velocities in a single step."], "extent": [3736, 3886]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Average of Two"], "extent": [3886, 3906], "body": [{"type": "para", "indent": 8, "text": ["The velocity VDB is sampled twice, once at the location, and once where that would have come from.  The average is used. This provides a fixed-cost and does a better job preserving rotations, but will break up with large velocities."], "extent": [3906, 4152]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "integrator"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["CFL Condition"], "extent": [4152, 4167], "body": [{"type": "para", "indent": 4, "text": ["How big of a step should be used.  This is approximately how many voxels will be stepped during path tracing."], "extent": [4189, 4308]}], "container": true, "attrs": {"id": "cflcond"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Maximum Steps"], "extent": [4308, 4323], "body": [{"type": "para", "indent": 4, "text": ["Global clamp on how many steps can be performed.  For extremely fast motion this may need to be increased; but it might be better to raise the CFL condition instead."], "extent": [4345, 4520]}], "container": true, "attrs": {"id": "maxstep"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Data"], "extent": [4520, 4533], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["VDBs to Advect"], "extent": [4533, 4550], "body": [{"type": "para", "indent": 4, "text": ["The wire-names of the VDBs to advect by the velocity field.  "], "extent": [4575, 4642]}, {"type": "para", "indent": 4, "text": ["Note that the velocity VDB ", {"type": "code", "text": ["v"]}, " is always advected."], "extent": [4642, 4702]}], "container": true, "attrs": {"id": "advectlist"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Method"], "extent": [4702, 4710], "body": [{"type": "para", "indent": 4, "text": ["The method used to advect the data VDBs."], "extent": [4736, 4786]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["BFECC"], "extent": [4786, 4797], "body": [{"type": "para", "indent": 8, "text": ["Perform backwards-forward error correction.  This requires considerable time and memory; but does the best job of preserving the sharpness of features."], "extent": [4797, 4966]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler + Sharpen"], "extent": [4966, 4987], "body": [{"type": "para", "indent": 8, "text": ["Combines the simplest form of advection with a dynamic sharpen field that combats the diffusion introduced by the trilinear operation."], "extent": [4987, 5139]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler"], "extent": [5139, 5150], "body": [{"type": "para", "indent": 8, "text": ["The simplest and fastest form of advection, but tends to cause excessive blurring."], "extent": [5150, 5246]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "data_method"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Sharpen"], "extent": [5246, 5255], "body": [{"type": "para", "indent": 4, "text": ["How much to sharpen the VDB.  This is automatically adjusted per voxel based on how the VDB was sampled.  While the sharpening kernel is clamped, too high a value will create grid artifacts."], "extent": [5282, 5482]}], "container": true, "attrs": {"id": "data_sharpen"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 3, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Velocity"], "extent": [5482, 5499], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Method"], "extent": [5499, 5508], "body": [{"type": "para", "indent": 4, "text": ["The method used to advect the velocity VDB."], "extent": [5527, 5580]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["BFECC"], "extent": [5580, 5591], "body": [{"type": "para", "indent": 8, "text": ["Perform backwards-forward error correction.  This requires considerable time and memory; but does the best job of preserving the sharpness of features."], "extent": [5591, 5760]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler + Sharpen"], "extent": [5760, 5781], "body": [{"type": "para", "indent": 8, "text": ["Combines the simplest form of advection with a dynamic sharpen field that combats the diffusion introduced by the trilinear operation."], "extent": [5781, 5933]}], "container": true}, {"type": "dt", "indent": 4, "text": ["Euler"], "extent": [5933, 5944], "body": [{"type": "para", "indent": 8, "text": ["The simplest and fastest form of advection, but tends to cause excessive blurring."], "extent": [5944, 6040]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "v_method"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Sharpen"], "extent": [6040, 6049], "body": [{"type": "para", "indent": 4, "text": ["How much to sharpen the VDB.  This is automatically adjusted per voxel based on how the VDB was sampled.  While the sharpening kernel is clamped, a value that is too high will create grid artifacts."], "extent": [6073, 6281]}], "container": true, "attrs": {"id": "v_sharpen"}, "role": "item"}], "container": true, "role": "item_group"}]}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [6281, 6289], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["density"], "extent": [6289, 6302], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB providing how thick the smoke is at a voxel.  "], "extent": [6302, 6370]}, {"type": "para", "indent": 8, "text": ["This is only read on the initial frame."], "extent": [6370, 6419]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [6419, 6426], "body": [{"type": "para", "indent": 8, "text": ["A Vector VDB providing the wind speed of each voxel.  Note this does not include any ", {"type": "ui", "text": ["Ambient Velocity"]}, "."], "extent": [6426, 6542]}, {"type": "para", "indent": 8, "text": ["This is only read on the initial frame."], "extent": [6542, 6591]}], "container": true}, {"type": "dt", "indent": 4, "text": ["temperature"], "extent": [6591, 6608], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB providing the temperature at each voxel."], "extent": [6608, 6670]}, {"type": "para", "indent": 8, "text": ["Note newly activated voxels will get a temperature of ", {"type": "code", "text": ["0"]}, " so that should be used as baseline usually."], "extent": [6670, 6781]}, {"type": "para", "indent": 8, "text": ["This is only read on the initial frame."], "extent": [6781, 6830]}], "container": true}, {"type": "dt", "indent": 4, "text": ["feedback"], "extent": [6830, 6844], "body": [{"type": "para", "indent": 8, "text": ["A Cable providing wires that will be fedback to the next iteration of the solve.  It is important the input\u2019s cable structure exactly matches the ", {"scheme": "Node", "value": "/nodes/cop/pyroblockend", "type": "link", "text": ["Pyro Block End COP\u2019s"], "fullpath": "/nodes/cop/pyroblockend.html"}, " input."], "extent": [6844, 7051]}, {"type": "para", "indent": 8, "text": ["This is only read on the initial frame."], "extent": [7051, 7100]}], "container": true}, {"type": "dt", "indent": 4, "text": ["activate_pts"], "extent": [7100, 7118], "body": [{"type": "para", "indent": 8, "text": ["Optional Geometry input.  Any leaves that overlap these points will be activated on the frame.  This is read each frame, so can be used to activate moving sources."], "extent": [7118, 7291]}], "container": true}, {"type": "dt", "indent": 4, "text": ["passthrough"], "extent": [7291, 7308], "body": [{"type": "para", "indent": 8, "text": ["Optional ", {"scheme": null, "value": "/copernicus/cables", "type": "link", "text": ["cable"], "fullpath": "/copernicus/cables.html"}, " providing layers and VDBs that should be computed outside of the simulation.  They will be read each frame, so can be used to inject animated sources; but cannot depend on the results of the simulation."], "extent": [7308, 7556]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [7556, 7565], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["density"], "extent": [7565, 7578], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB of the density that has been fedback to this frame."], "extent": [7578, 7651]}], "container": true}, {"type": "dt", "indent": 4, "text": ["v"], "extent": [7651, 7658], "body": [{"type": "para", "indent": 8, "text": ["A Vector VDB of the velocity that has been fedback to this frame."], "extent": [7658, 7733]}], "container": true}, {"type": "dt", "indent": 4, "text": ["temperature"], "extent": [7733, 7750], "body": [{"type": "para", "indent": 8, "text": ["A Float VDB of the temperature that has been fedback to this frame."], "extent": [7750, 7827]}], "container": true}, {"type": "dt", "indent": 4, "text": ["feedback"], "extent": [7827, 7841], "body": [{"type": "para", "indent": 8, "text": ["A Cable of the extra data that has been fedback to this frame."], "extent": [7841, 7913]}], "container": true}, {"type": "dt", "indent": 4, "text": ["passthrough"], "extent": [7913, 7930], "body": [{"type": "para", "indent": 8, "text": ["A Cable passing through the input, so updating every frame from the input."], "extent": [7930, 8014]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [8014, 8023], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_block_end", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_block_end.html"}], "extent": [8023, 8051]}, {"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/cop/pyro_configure", "type": "link", "text": "", "fullpath": "/nodes/cop/pyro_configure.html"}], "extent": [8051, 8080]}], "container": true}], "text": "Related"}], "title": ["Pyro Block Begin"], "summary": ["Start of a Pyro simulation block."]}