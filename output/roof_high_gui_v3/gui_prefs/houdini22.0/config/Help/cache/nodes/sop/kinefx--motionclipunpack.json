{"type": "root", "attrs": {"type": "node", "context": "sop", "namespace": "kinefx", "internal": "motionclipunpack", "icon": "SOP/kinefx-motionclipunpack", "tags": "animation", "since": "18.5", "version": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["MotionClip Unpack"], "extent": [139, 161]}, {"type": "summary", "indent": 0, "text": ["Evaluates a MotionClip at one or more frames."], "extent": [161, 215]}, {"type": "para", "indent": 0, "text": ["This SOP takes as input a MotionClip (for example, from the ", {"scheme": "Node", "value": "/nodes/sop/kinefx--motionclipevaluate", "type": "link", "text": ["MotionClip Evaluate SOP"], "fullpath": "/nodes/sop/kinefx--motionclipevaluate.html"}, ") and evaluates it at one or more frames. This node acts as the evaluator for the MotionClip Evaluate and ", {"scheme": "Node", "value": "/nodes/sop/kinefx--motionclipextract", "type": "link", "text": ["MotionClip Extract SOP"], "fullpath": "/nodes/sop/kinefx--motionclipextract.html"}, "."], "extent": [215, 504]}, {"type": "para", "indent": 0, "text": ["The output geometry contains the requested joints from the given frames, assigning\neach point a time attribute that describes where it originated from."], "extent": [504, 657]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [657, 669], "body": [{"level": 3, "type": "sep", "indent": 0, "text": [" Evaluation "], "extent": [669, 689], "body": [{"type": "para", "indent": 4, "text": ["These parameters determine how the MotionClip is evaluated."], "extent": [689, 759]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Joint Group"], "extent": [759, 776], "body": [{"type": "para", "indent": 8, "text": ["The group of joints to evaluate from the MotionClip."], "extent": [801, 863]}], "container": true, "attrs": {"id": "jointnames"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Sampling Mode"], "extent": [863, 882], "body": [{"type": "para", "indent": 8, "text": ["Specifies whether to output the current frame, a specific frame, or a range of frames."], "extent": [907, 1003]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Single Frame"], "extent": [1003, 1025], "body": [{"type": "para", "indent": 12, "text": ["The MotionClip will be evaluated at a specified frame."], "extent": [1025, 1093]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Frame Range"], "extent": [1093, 1114], "body": [{"type": "para", "indent": 12, "text": ["The MotionClip will be evaluated across a frame range."], "extent": [1114, 1182]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Current Frame"], "extent": [1182, 1205], "body": [{"type": "para", "indent": 12, "text": ["The MotionClip will be evaluated at the current frame."], "extent": [1205, 1273]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "samplemode"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame"], "extent": [1273, 1284], "body": [{"type": "para", "indent": 8, "text": ["The frame to evaluate."], "extent": [1304, 1336]}, {"type": "para", "indent": 8, "text": ["This parameter is available when ", {"type": "ui", "text": ["Sampling Mode"]}, " is set to ", {"type": "ui", "text": ["Single Frame"]}, "."], "extent": [1336, 1429]}], "container": true, "attrs": {"id": "frame"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Interpolation"], "extent": [1429, 1448], "body": [{"type": "para", "indent": 8, "text": ["The method used to interpolate between the poses of the MotionClip."], "extent": [1469, 1546]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Linear"], "extent": [1546, 1562], "body": [{"type": "para", "indent": 12, "text": ["The MotionClip is evaluated by linearly interpolating between\n            the pose at or immediately before the requested frame, and the\n            pose immediately after the requested frame."], "extent": [1562, 1768]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Constant"], "extent": [1768, 1786], "body": [{"type": "para", "indent": 12, "text": ["The MotionClip is evaluated at the frame of the pose at or immediately\n            before the requested frame."], "extent": [1786, 1910]}], "container": true}], "container": true}, {"type": "para", "indent": 8, "text": ["This parameter is available when ", {"type": "ui", "text": ["Sampling Mode"]}, " is set to ", {"type": "ui", "text": ["Single Frame"]}, " or ", {"type": "ui", "text": ["Current Frame"]}, "."], "extent": [1910, 2019]}], "container": true, "attrs": {"id": "interp"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Output Mode"], "extent": [2019, 2036], "body": [{"type": "para", "indent": 8, "text": ["Specifies whether to output skeletons (", {"type": "ui", "text": ["Frames"]}, ") or motion trails displaying lines that show the movement of each joint (", {"type": "ui", "text": ["Motion Trails"]}, ")."], "extent": [2061, 2213]}, {"type": "para", "indent": 8, "text": ["This parameter is available when ", {"type": "ui", "text": ["Sampling Mode"]}, " is set to ", {"type": "ui", "text": ["Frame Range"]}, "."], "extent": [2213, 2300]}], "container": true, "attrs": {"id": "outputmode"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Unpack Existing Samples"], "extent": [2300, 2329], "body": [{"type": "para", "indent": 8, "text": ["When turned on, the MotionClip is evaluated at all of the samples within the range."], "extent": [2358, 2451]}, {"type": "para", "indent": 8, "text": ["This option is useful when working with sparse data and you only want to modify the keyframes, skipping the frames in between."], "extent": [2451, 2587]}, {"type": "para", "indent": 8, "text": ["This parameter is available when ", {"type": "ui", "text": ["Sampling Mode"]}, " is set to ", {"type": "ui", "text": ["Frame Range"]}, "."], "extent": [2587, 2674]}], "container": true, "attrs": {"id": "unpackexisting"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Clip Range"], "extent": [2674, 2690], "body": [{"type": "para", "indent": 8, "text": ["The source used to define the frame range and rate when extracting poses. This can be obtained from either the ", {"type": "code", "text": ["clipinfo"]}, " detail attribute of the MotionClip or the ", {"type": "ui", "text": ["Frame Range"]}, " parameter."], "extent": [2714, 2914]}, {"type": "para", "indent": 8, "text": ["This parameter is available when ", {"type": "ui", "text": ["Sampling Mode"]}, " is set to ", {"type": "ui", "text": ["Frame Range"]}, "."], "extent": [2914, 3001]}], "container": true, "attrs": {"id": "cliprnage"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Range"], "extent": [3001, 3018], "body": [{"type": "para", "indent": 8, "text": ["Specifies the start/end/increment of the range of frames to be extracted. These values are based on the scene frame rate."], "extent": [3038, 3169]}, {"type": "para", "indent": 8, "text": ["The ", {"type": "ui", "text": ["Unpack Existing Samples"]}, " parameter can be used to extract every frame in the Motion Clip within this range."], "extent": [3169, 3293]}, {"type": "para", "indent": 8, "text": ["This parameter is available when ", {"type": "ui", "text": ["Clip Range"]}, " is set to ", {"type": "ui", "text": ["Custom Frame Range"]}, "."], "extent": [3293, 3384]}], "container": true, "attrs": {"id": "range"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["End Behavior"], "extent": [3384, 3402], "body": [{"type": "para", "indent": 8, "text": ["Describes the behavior of the animation when it is evaluated outside the bounds of the MotionClip. When turned off, the left and right end behaviors are determined from the ", {"type": "code", "text": ["clipinfo"]}, " detail attribute."], "extent": [3428, 3639]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Clamp"], "extent": [3639, 3654], "body": [{"type": "para", "indent": 12, "text": ["The first and last poses are extended out indefinitely."], "extent": [3654, 3723]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Loop"], "extent": [3723, 3737], "body": [{"type": "para", "indent": 12, "text": ["The animation repeats from the beginning."], "extent": [3737, 3792]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Mirrored Loop"], "extent": [3792, 3815], "body": [{"type": "para", "indent": 12, "text": ["The animation repeats in reverse."], "extent": [3815, 3862]}], "container": true}], "container": true}], "container": true, "attrs": {"id": "endbehavior"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"level": 3, "type": "sep", "indent": 0, "text": [" Center of Mass "], "extent": [3862, 3885], "body": [{"type": "para", "indent": 4, "text": ["These parameters determine the center of mass of the skeleton and define how it is used."], "extent": [3885, 3980]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Output Center of Mass"], "extent": [3980, 4007], "body": [{"type": "para", "indent": 8, "text": ["When turned on, creates a point at the skeleton\u2019s center of mass with a name defined by ", {"type": "ui", "text": ["Point Name"]}, ".\n        The unpacked attributes for this point are taken from the first point of the skeleton."], "extent": [4031, 4239]}], "container": true, "attrs": {"id": "outputcom"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Isolate Center of Mass"], "extent": [4239, 4267], "body": [{"type": "para", "indent": 8, "text": ["When turned on, deletes all the skeleton points so that only the point at the center of mass remains."], "extent": [4292, 4403]}], "container": true, "attrs": {"id": "isolatecom"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Point Name"], "extent": [4403, 4419], "body": [{"type": "para", "indent": 8, "text": ["The name of the point at the center of mass."], "extent": [4441, 4495]}], "container": true, "attrs": {"id": "comname"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Configuration Attribute"], "extent": [4495, 4524], "body": [{"type": "para", "indent": 8, "text": ["The name of the dictionary point attribute on the rest pose of the MotionClip that defines the mass and local center of mass for each joint of the skeleton.\n        This attribute can be created using the ", {"scheme": null, "value": "kinefx--configurejoints", "type": "link", "text": ["Configure Joints SOP"], "fullpath": "/nodes/sop/kinefx--configurejoints.html"}, "."], "extent": [4551, 4813]}], "container": true, "attrs": {"id": "configattrib"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}, {"level": 3, "type": "sep", "indent": 0, "text": [" Attributes "], "extent": [4813, 4832], "body": [{"type": "para", "indent": 4, "text": ["These parameters determine the extra attributes that are unpacked from the MotionClip."], "extent": [4832, 4925]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Unpack Attributes"], "extent": [4925, 4948], "body": [{"type": "para", "indent": 8, "text": ["When turned on, any attributes other than ", {"type": "code", "text": ["P"]}, ", ", {"type": "code", "text": ["transform"]}, ", ", {"type": "code", "text": ["name"]}, ", ", {"type": "code", "text": ["path"]}, ", and\n        ", {"type": "code", "text": ["clipinfo"]}, " are preset on the output geometry."], "extent": [4973, 5116]}, {"type": "para", "indent": 8, "text": ["Turn off this parameter for maximum performance."], "extent": [5116, 5174]}], "container": true, "attrs": {"id": "useattribs"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Rest Attributes"], "extent": [5174, 5195], "body": [{"type": "para", "indent": 8, "text": ["The attributes that should be unpacked from the rest pose of the MotionClip."], "extent": [5221, 5315]}, {"type": "para", "indent": 8, "text": ["All groups, primitive attributes, and vertex attributes in the MotionClip are unpacked exclusively from the rest pose of the MotionClip."], "extent": [5315, 5469]}, {"type": "para", "indent": 8, "text": ["Additionally, all animation attributes that are not matched by the ", {"type": "ui", "text": ["Attributes to Store"]}, " parameter on the ", {"scheme": null, "value": "kinefx--motionclip", "type": "link", "text": ["MotionClip"], "fullpath": "/nodes/sop/kinefx--motionclip.html"}, " SOP can be unpacked from the rest pose of the MotionClip."], "extent": [5469, 5676]}], "container": true, "attrs": {"id": "restattribs"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Animated Attributes"], "extent": [5676, 5701], "body": [{"type": "para", "indent": 8, "text": ["The attributes that should be evaluated from the animated poses of the MotionClip. These are the attributes that are matched by the ", {"type": "ui", "text": ["Attributes to Store"]}, " parameter on the ", {"scheme": null, "value": "kinefx--motionclip", "type": "link", "text": ["MotionClip"], "fullpath": "/nodes/sop/kinefx--motionclip.html"}, " SOP."], "extent": [5723, 5942]}, {"type": "para", "indent": 8, "text": ["If an attribute is unpacked from the rest pose, and evaluated from the animated poses, the animated attribute takes priority."], "extent": [5942, 6077]}], "container": true, "attrs": {"id": "attribs"}, "role": "item"}], "container": true, "role": "item_group"}], "container": true}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [6077, 6085], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["MotionClip"], "extent": [6085, 6102], "body": [{"type": "para", "indent": 8, "text": ["The MotionClip to evaluate or extract."], "extent": [6102, 6150]}], "container": true}], "container": true}], "text": "Inputs"}, {"level": 1, "id": "outputs", "container": true, "type": "outputs_section", "indent": 0, "role": "section", "extent": [6150, 6159], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 4, "text": ["Output1"], "extent": [6159, 6173], "body": [{"type": "para", "indent": 8, "text": ["The skeleton in a range of poses evaluated from the MotionClip. If a joint does not exist at that frame, data is interpolated from the surrounding frames."], "extent": [6173, 6337]}], "container": true}], "container": true}], "text": "Outputs"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [6337, 6346], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/sop/kinefx--motionclip", "type": "link", "text": "", "fullpath": "/nodes/sop/kinefx--motionclip.html"}], "extent": [6346, 6382]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/sop/kinefx--motionclipevaluate", "type": "link", "text": "", "fullpath": "/nodes/sop/kinefx--motionclipevaluate.html"}], "extent": [6382, 6426]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/sop/kinefx--motionclipextract", "type": "link", "text": "", "fullpath": "/nodes/sop/kinefx--motionclipextract.html"}], "extent": [6426, 6469]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/sop/kinefx--configurejoints", "type": "link", "text": "", "fullpath": "/nodes/sop/kinefx--configurejoints.html"}], "extent": [6469, 6511]}], "container": true}], "text": "Related"}], "title": ["MotionClip Unpack"], "summary": ["Evaluates a MotionClip at one or more frames."]}