{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "timescale", "icon": "COP2/timescale", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Time Scale"], "extent": [82, 97]}, {"type": "summary", "indent": 0, "text": ["Stretches or compresses a sequence in time."], "extent": [97, 149]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation stretches or compresses a sequence in time. Frames are\neither dropped, doubled or interpolated. If interpolation is not used,\nthis operation will not use any cache memory."], "extent": [192, 381]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [381, 393], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Scale Method"], "extent": [393, 411], "body": [{"type": "para", "indent": 8, "text": ["Select a method for changing the timing."], "extent": [411, 461]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Modify Sequence Length Only"], "extent": [461, 498], "body": [{"type": "para", "indent": 12, "text": ["Changes the length of the sequence without changing the\n            frame rate; the sequence will be longer or shorter in time."], "extent": [498, 638]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Modify Sequence Length, Same Time Span"], "extent": [638, 686], "body": [{"type": "para", "indent": 12, "text": ["Changes the length of the sequence Time Span and adjusts the\n            frame rate so the sequence is the same time length."], "extent": [686, 823]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Modify Frame Rate Only"], "extent": [823, 855], "body": [{"type": "para", "indent": 12, "text": ["Only changes the frame rate. The sequence becomes longer or\n            shorter, but the number of frames stays the same."], "extent": [855, 989]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Modify Frame Rate, Same Time Span"], "extent": [989, 1032], "body": [{"type": "para", "indent": 12, "text": ["Changes the frame rate and increases Span or decreases the\n            number of frames to keep the sequence the same time length."], "extent": [1032, 1175]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Interpolation"], "extent": [1175, 1194], "body": [{"type": "para", "indent": 8, "text": ["When increasing or decreasing the number of frames in the\n        sequence, this parameter determines the frame(s) to use for the\n        output frames."], "extent": [1194, 1356]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Previous Frame"], "extent": [1356, 1380], "body": [{"type": "para", "indent": 12, "text": ["Uses the input frame exactly at or before the time of the\n            output frame."], "extent": [1380, 1476]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Closest Frame"], "extent": [1476, 1499], "body": [{"type": "para", "indent": 12, "text": ["Uses the input frame exactly at or closest to the time of\n            the output frame."], "extent": [1499, 1599]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Next Frame"], "extent": [1599, 1619], "body": [{"type": "para", "indent": 12, "text": ["Uses the input frame exactly at or after the time of the\n            output frame."], "extent": [1619, 1714]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Blend Nearest Frames"], "extent": [1714, 1744], "body": [{"type": "para", "indent": 12, "text": ["Picks the 2 closest frames and linearly blends them\n            together, weighting them with how close each input frames'\n            time is to the output frame."], "extent": [1744, 1920]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Rate"], "extent": [1920, 1936], "body": [{"type": "para", "indent": 8, "text": ["The frame rate, for methods that require it."], "extent": [1936, 1989]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Length Method"], "extent": [1989, 2008], "body": [{"type": "para", "indent": 8, "text": ["Specifies how to change the length of the sequence, for Scale\n        Methods that require it (see below)."], "extent": [2008, 2123]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Length Scale"], "extent": [2123, 2141], "body": [{"type": "para", "indent": 8, "text": ["Changes the length of the sequence by a scale factor. Scales\n        greater than 1 increase the length, scales less than 1 decrease\n        it."], "extent": [2141, 2294]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Sequence Length"], "extent": [2294, 2315], "body": [{"type": "para", "indent": 8, "text": ["Specifies the new length of the sequence, in frames."], "extent": [2315, 2376]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Length Difference"], "extent": [2376, 2399], "body": [{"type": "para", "indent": 8, "text": ["Specifies how many frames to add or subtract from the input\n        sequence length."], "extent": [2399, 2492]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [2492, 2500], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [2526, 2535], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/reverse", "type": "link", "text": "", "fullpath": "/nodes/cop2/reverse.html"}], "extent": [2535, 2561]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/shift", "type": "link", "text": "", "fullpath": "/nodes/cop2/shift.html"}], "extent": [2561, 2585]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/warp", "type": "link", "text": "", "fullpath": "/nodes/cop2/warp.html"}], "extent": [2585, 2609]}], "container": true}], "text": "Related"}], "title": ["Time Scale"], "summary": ["Stretches or compresses a sequence in time."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}