eters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Direct Volume"], "extent": [5472, 5488], "body": [{"type": "para", "indent": 4, "text": ["Add the direct (no bounces) volume component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["directvolume"]}, ", using the LPE ", {"type": "code", "text": ["CVL"]}, "."], "extent": [5511, 5630]}], "container": true, "attrs": {"id": "directvolume"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [5630, 5634]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Indirect Volume"], "extent": [5634, 5652], "body": [{"type": "para", "indent": 4, "text": ["Add the indirect (one or more bounces) volume component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["indirectvolume"]}, ", using the LPE ", {"type": "code", "text": ["CV.+L"]}, "."], "extent": [5677, 5811]}], "container": true, "attrs": {"id": "indirectvolume"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [5811, 5815]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["BSDF Labelled ", {"type": "code", "text": ["coat"]}], "extent": [5815, 5838], "body": [{"type": "para", "indent": 4, "text": ["Add the coat component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["coat"]}, ", using the LPE ", {"type": "code", "text": ["C<...'coat'>.*[LO]"]}, "."], "extent": [5853, 5957]}], "container": true, "attrs": {"id": "coat"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [5957, 5961]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["BSDF Labelled ", {"type": "code", "text": ["sss"]}], "extent": [596