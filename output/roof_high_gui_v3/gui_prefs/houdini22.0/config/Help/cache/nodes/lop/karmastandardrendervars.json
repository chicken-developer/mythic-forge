;C<RD>.+L"]}, "."], "extent": [3530, 3720]}], "container": true, "attrs": {"id": "indirectdiffuseunshadowed"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [3720, 3724]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Combined Glossy Reflection"], "extent": [3724, 3753], "body": [{"type": "para", "indent": 4, "text": ["Add the combined (any number of bounces) glossy surface reflection component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["combinedglossyreflection"]}, ", using the LPE ", {"type": "code", "text": ["C<RG>.*[LO]"]}, "."], "extent": [3792, 3963]}], "container": true, "attrs": {"id": "combinedglossyreflection"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [3963, 3967]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Direct Glossy Reflection"], "extent": [3967, 3994], "body": [{"type": "para", "indent": 4, "text": ["Add the direct (no bounces) glossy surface reflection component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["directglossyreflection"]}, ", using the LPE ", {"type": "code", "text": ["C<RG>L"]}, "."], "extent": [4027, 4178]}], "container": true, "attrs": {"id": "directglossyreflection"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [4178, 4182]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Indirect Glossy Reflection"], "extent": [4182, 4211], "body": [{"type": "para", "indent": 4, "text": ["Add the indirect (one or more bounces) glossy reflection component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["indirectglossyreflection"]}, ", using the LPE ", {"type": "code", "text": ["C<RG>.+L"]}, "."], "extent": [4246, 4404]}], "container": true, "attrs": {"id": "indirectglossyreflection"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 4, "type": "sep", "indent": 0, "extent": [4404, 4409]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Glossy Transmission"], "extent": [4409, 4431], "body": [{"type": "para", "indent": 4, "text": ["Add the glossy transmission component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["glossytransmission"]}, ", using the LPE ", {"type": "code", "text": ["C<TG>.*[LO]"]}, "."], "extent": [4460, 4586]}], "container": true, "attrs": {"id": "glossytransmission"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [4586, 4590]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Visible Lights"], "extent": [4590, 4607], "body": [{"type": "para", "indent": 4, "text": ["Add the visible lights component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["visiblelights"]}, ", using the LPE ", {"type": "code", "text": ["CL"]}, "."], "extent": [4631, 4738]}], "container": true, "attrs": {"id": "visiblelights"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 3, "type": "sep", "indent": 0, "extent": [4738, 4742]}, {"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Combined Emission"], "extent": [4742, 4762], "body": [{"type": "para", "indent": 4, "text": ["Add the combined (any number of bounces) emission component as a ", {"type": "code", "text": ["color3f"]}, " render var named ", {"type": "code", "text": ["combinedemission"]}, ", using the LPE ", {"type": "code", "text": ["C.*O"]}, "."], "extent": [4789, 4928]}], "container": true, "attrs": {"id": "combinedemission"}, "role": "item"}]