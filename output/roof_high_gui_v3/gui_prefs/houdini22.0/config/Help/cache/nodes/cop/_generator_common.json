{"type": "root", "attrs": {"type": "include"}, "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Seed"], "extent": [17, 23], "body": [{"type": "para", "indent": 4, "text": ["The seed value that randomizes the values used in the generator. Changing this value results in a different output, but retains the same concept and look."], "extent": [37, 197]}], "container": true, "attrs": {"id": "seed"}}], "container": true}, {"level": 2, "id": "range", "container": true, "type": "h", "indent": 0, "text": ["Range"], "extent": [197, 217], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Amplitude"], "extent": [217, 229], "body": [{"type": "para", "indent": 4, "text": ["The amount by which to multiply the pixel value (originally in the ", {"type": "code", "text": ["0"]}, " to ", {"type": "code", "text": ["1"]}, " range). The node applies this before the ", {"type": "ui", "text": ["Center"]}, " adjustment."], "extent": [243, 390]}, {"type": "para", "indent": 4, "text": ["Values in the generated layer cover the range from ", {"type": "code", "text": ["C-A"]}, " to ", {"type": "code", "text": ["C+A"]}, ", where ", {"type": "code", "text": ["C"]}, " is ", {"type": "ui", "text": ["Center"]}, " and ", {"type": "code", "text": ["A"]}, " is ", {"type": "ui", "text": ["Amplitude"]}, "."], "extent": [390, 512]}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [512, 522], "body": [{"type": "para", "indent": 8, "text": ["Layers can store negative numbers and values above ", {"type": "code", "text": ["1"]}, ", so this may result in out-of-bounds values. Use Post Processing options to clamp the output."], "extent": [522, 680]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "amp"}}, {"type": "dt", "indent": 0, "text": ["Center"], "extent": [680, 688], "body": [{"type": "para", "indent": 4, "text": ["The center of the output pixel values, applied as an offset."], "extent": [705, 771]}, {"type": "para", "indent": 4, "text": ["Values in the generated layer cover the range from ", {"type": "code", "text": ["C-A"]}, " to ", {"type": "code", "text": ["C+A"]}, ", where ", {"type": "code", "text": ["C"]}, " is ", {"type": "ui", "text": ["Center"]}, " and ", {"type": "code", "text": ["A"]}, " is ", {"type": "ui", "text": ["Amplitude"]}, "."], "extent": [771, 893]}, {"type": "note_group", "body": [{"type": "note", "indent": 4, "role": "item", "extent": [893, 903], "body": [{"type": "para", "indent": 8, "text": ["Layers can store negative numbers and values above ", {"type": "code", "text": ["1"]}, ", so this may result in out-of-bounds values. Use Post Processing options to clamp the output."], "extent": [903, 1061]}], "container": true}], "container": true, "role": "item_group"}], "container": true, "attrs": {"id": "center"}}, {"type": "dt", "indent": 0, "text": ["Mask Contrast"], "extent": [1061, 1076], "body": [{"type": "para", "indent": 4, "text": ["The amount of contrast to apply to the pixel values before the ", {"type": "ui", "text": ["Amplitude"]}, " and ", {"type": "ui", "text": ["Center"]}, " parameters. You can use this parameter to make the values more extreme without exceeding the ", {"type": "code", "text": ["0"]}, " to ", {"type": "code", "text": ["1"]}, " range."], "extent": [1095, 1303]}], "container": true, "attrs": {"id": "contrast"}}], "container": true}]}, {"level": 2, "id": "pattern", "container": true, "type": "h", "indent": 0, "text": ["Pattern"], "extent": [1303, 1327], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Element Size"], "extent": [1327, 1342], "body": [{"type": "para", "indent": 4, "text": ["The size (in ", {"scheme": null, "value": "/copernicus/spaces", "type": "link", "text": ["image coordinates"], "fullpath": "/copernicus/spaces.html"}, ") of the basic element of the generated pattern. You can turn on the ", {"scheme": "Smallicon", "value": "BUTTONS/decompose_transforms", "type": "link", "text": "", "fullpath": "/nodes/cop/BUTTONS/decompose_transforms.html"}, " ", {"type": "ui", "text": ["Per-Component Controls"]}, " button to adjust this further using the ", {"type": "ui", "text": ["Element Scale"]}, " parameter."], "extent": [1368, 1630]}], "container": true, "attrs": {"id": "elementsize"}}, {"type": "dt", "indent": 0, "text": ["Element Scale"], "extent": [1630, 1645], "body": [{"type": "para", "indent": 4, "text": ["When the ", {"scheme": "Smallicon", "value": "BUTTONS/decompose_transforms", "type": "link", "text": "", "fullpath": "/nodes/cop/BUTTONS/decompose_transforms.html"}, " ", {"type": "ui", "text": ["Per-Component Controls"]}, " button is on, this is the per-axis scaling of the element size."], "extent": [1668, 1814]}], "container": true, "attrs": {"id": "elementscale"}}, {"type": "dt", "indent": 0, "text": ["Offset"], "extent": [1814, 1822], "body": [{"type": "para", "indent": 4, "text": ["The amount to offset the entire pattern in image coordinates."], "extent": [1836, 1903]}], "container": true, "attrs": {"id": "off"}}, {"type": "dt", "indent": 0, "text": ["Tile Size"], "extent": [1903, 1914], "body": [{"type": "para", "indent": 4, "text": ["The size of a single tile of the pattern. The pattern periodically repeats in this size. The size is in image coordinates, so the default is for the entire default canonical image. If you have a non-square image, this should match the aspect ratio."], "extent": [1933, 2186]}], "container": true, "attrs": {"id": "tilesize"}}], "container": true}]}]}