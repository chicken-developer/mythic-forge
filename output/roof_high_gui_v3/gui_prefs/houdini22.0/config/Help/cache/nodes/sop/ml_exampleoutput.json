{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "ml_exampleoutput", "icon": "SOP/ml_exampleoutput", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["ML Example Output"], "extent": [92, 114]}, {"type": "summary", "indent": 0, "text": ["Output examples to a raw file"], "extent": [114, 152]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overview"], "extent": [152, 167], "body": [{"type": "para", "indent": 0, "text": ["ML Example Output writes a set of labeled examples to a file to directly use with ", {"scheme": "Node", "value": "/nodes/top/ml_trainregression", "type": "link", "text": ["ML Train Regression"], "fullpath": "/nodes/top/ml_trainregression.html"}, ". ML Example Output expects an input geometry consisting exclusively of packed primitives, each of which represents a single labeled example. See ", {"scheme": "Node", "value": "/nodes/sop/ml_example", "type": "link", "text": ["ML Example"], "fullpath": "/nodes/sop/ml_example.html"}, " for more details about representing examples using geometry."], "extent": [167, 540]}, {"type": "para", "indent": 0, "text": ["The data stored in the attributes and volumes specified in the multiparms are written out in linear order to disk. When writing python snippets in ML Train regression, for example using convolution layers, It is important to know in what order the floating-point values stored in a volume are written out. This becomes relevant when reshaping flat tensors to make them suitable as inputs to a convolution layer. For example, if we have a volume that\u2019s an RGB image, it is useful to know that the first non-batch dimension would be the color, followed by the x dimension and the y dimension. In general for tuple-valued volumes, the first nonbatch dimension would correspond to the tuple index, while the dimensions after that would correspond to indices into voxels."], "extent": [540, 1308]}, {"type": "para", "indent": 0, "text": ["This node can be referenced from TOPs using a ", {"scheme": "Node", "value": "/nodes/top/ropfetch", "type": "link", "text": ["ROP Fetch"], "fullpath": "/nodes/top/ropfetch.html"}, " to make writing out the data set part of a recipe for doing ML."], "extent": [1308, 1449]}, {"type": "para", "indent": 0, "text": ["See ", {"scheme": null, "value": "/ml/index", "type": "link", "text": ["Machine Learning documentation"], "fullpath": "/ml/index.html"}, " for more general information."], "extent": [1449, 1527]}, {"type": "fig_group", "body": [{"ext": null, "type": "fig", "indent": 0, "text": [{"scheme": "Image", "value": "/images/ml/ml_exampleoutput_tutexample.jpg", "type": "img", "text": ""}], "role": "item", "extent": [1527, 1583], "body": [{"type": "summary", "indent": 4, "text": ["Uses the ML Example Output to store them in a ", {"type": "code", "text": ["data_set.raw"]}, " file. Then loads it into a ML Regression Train TOP. An example from the ", {"type": "ui", "text": [{"scheme": null, "value": "https://www.sidefx.com/tutorials/ml-sketching/", "type": "link", "text": ["ML Sketching tutorial"], "exists": true}]}, ". "], "extent": [1583, 1806]}], "container": true}], "container": true, "role": "item_group"}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [1806, 1818], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Save to Disk"], "extent": [1818, 1833], "body": [{"type": "para", "indent": 4, "text": ["Click to save the data set to the specified output file."], "extent": [1851, 1913]}], "container": true, "attrs": {"id": "execute"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Output File"], "extent": [1913, 1926], "body": [{"type": "para", "indent": 4, "text": ["This specifies the raw output file path."], "extent": [1946, 1992]}], "container": true, "attrs": {"id": "sopoutput"}, "role": "item"}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Number of Inputs"], "extent": [1992, 2015], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Type"], "extent": [2015, 2022], "body": [{"type": "para", "indent": 4, "text": ["Type of input contribution: either a point attribute or a volume."], "extent": [2042, 2113]}], "container": true, "attrs": {"id": "inputtype#"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Point Attribute"], "extent": [2113, 2130], "body": [{"type": "para", "indent": 4, "text": ["Name of a point float attribute."], "extent": [2160, 2198]}], "container": true, "attrs": {"id": "inputpointattribute#"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Volume Name"], "extent": [2198, 2211], "body": [{"type": "para", "indent": 4, "text": ["The name of a volume."], "extent": [2237, 2264]}], "container": true, "attrs": {"id": "inputvolumename#"}, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Number of Targets"], "extent": [2264, 2288], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Type"], "extent": [2288, 2295], "body": [{"type": "para", "indent": 4, "text": ["Type of target contribution: either a point attribute or a volume."], "extent": [2316, 2388]}], "container": true, "attrs": {"id": "targettype#"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Point Attribute"], "extent": [2388, 2405], "body": [{"type": "para", "indent": 4, "text": ["Name of a point float attribute."], "extent": [2436, 2474]}], "container": true, "attrs": {"id": "targetpointattribute#"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Volume Name"], "extent": [2474, 2487], "body": [{"type": "para", "indent": 4, "text": ["The name of the volume."], "extent": [2514, 2544]}], "container": true, "attrs": {"id": "targetvolumename#"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "inputs", "container": true, "type": "inputs_section", "indent": 0, "role": "section", "extent": [2544, 2552], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["Examples"], "extent": [2552, 2563], "body": [{"type": "para", "indent": 4, "text": ["A geometry consisting of examples, each represented by a packed primitive."], "extent": [2563, 2643]}], "container": true}], "container": true}], "text": "Inputs"}], "title": ["ML Example Output"], "summary": ["Output examples to a raw file"]}