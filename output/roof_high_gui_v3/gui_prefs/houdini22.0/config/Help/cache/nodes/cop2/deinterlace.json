{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "deinterlace", "icon": "COP2/deinterlace", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Deinterlace"], "extent": [86, 102]}, {"type": "summary", "indent": 0, "text": ["De-interlaces a frame of video by either averaging scanlines or\ncopying a scanline."], "extent": [102, 194]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["De-interlaces a frame of video by either averaging scanlines or copying\na scanline. You can choose which scanlines get kept, odd or even."], "extent": [237, 376]}, {"type": "para", "indent": 0, "text": ["You can also choose to drop the scanline, which will then be replaced\nwith a color of your choice."], "extent": [376, 477]}, {"type": "tip_group", "body": [{"type": "tip", "indent": 0, "role": "item", "extent": [477, 482], "body": [{"type": "para", "indent": 4, "text": ["Averaging almost always looks best."], "extent": [482, 523]}], "container": true}], "container": true, "role": "item_group"}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Overloading VEX Parameters"], "extent": [27, 60], "body": [{"type": "para", "indent": 0, "text": ["This operator is implemented in VEX, which supports parameter\noverloading. If the first input has a plane which matches an\noperation parameter\u2019s channel name, the input plane will be used as\nthe parameter\u2019s value, effectively overriding it. The overloaded\nparameter is then evaluated from the plane on a per-pixel basis."], "extent": [60, 383]}, {"type": "para", "indent": 0, "text": [{"type": "em", "text": ["eg."]}, " If the input COP has the following planes:"], "extent": [383, 433]}, {"lang": null, "type": "pre", "indent": 0, "text": ["\nC{r,g,b}\nA\nfogdens\n"], "extent": [433, 460]}, {"type": "para", "indent": 0, "text": ["and it is fed into a VEX Fog COP, the fog density will be determined\nat each pixel by the fogdens plane, since the Fog Density\nparameter\u2019s channel name matches the 'fogdens' channel name."], "extent": [460, 649]}]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [543, 555], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Field to Keep"], "extent": [555, 574], "body": [{"type": "para", "indent": 8, "text": ["Select Odd or Even fields to keep."], "extent": [605, 648]}], "container": true, "attrs": {"channels": "/keepfield"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Method"], "extent": [648, 660], "body": [{"type": "para", "indent": 8, "text": ["What will happen when the field is dropped."], "extent": [688, 741]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["Average"], "extent": [741, 758], "body": [{"type": "para", "indent": 12, "text": ["The lines above and below the discarded field will be\n            averaged together."], "extent": [758, 855]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Copy"], "extent": [855, 869], "body": [{"type": "para", "indent": 12, "text": ["The line above the discarded field will be copied."], "extent": [869, 932]}], "container": true}, {"type": "dt", "indent": 8, "text": ["Drop"], "extent": [932, 946], "body": [{"type": "para", "indent": 12, "text": ["The space left by the discarded field will be filled by the\n            color specified."], "extent": [946, 1047]}], "container": true}], "container": true}], "container": true, "attrs": {"channels": "/method"}, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Drop Color"], "extent": [1047, 1063], "body": [{"type": "para", "indent": 8, "text": ["The color used to fill the gap if ", {"type": "q", "text": ["Drop"]}, " is selected as the\n        Replacement Method."], "extent": [1095, 1191]}], "container": true, "attrs": {"channels": "/dropcolour"}, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1191, 1199], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": 