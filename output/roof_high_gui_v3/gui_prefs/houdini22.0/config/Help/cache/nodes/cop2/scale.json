{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "scale", "icon": "COP2/scale", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Scale"], "extent": [74, 84]}, {"type": "summary", "indent": 0, "text": ["Changes the resolution of the image."], "extent": [84, 129]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation changes the resolution of the image. The contents of the\nimage are scaled appropriately. The aspect ratio may be optionally\npreserved."], "extent": [172, 323]}, {"type": "para", "indent": 0, "text": ["Scale does not affect the cook resolution of its Inputs."], "extent": [323, 381]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [381, 387], "body": [{"type": "para", "indent": 4, "text": ["As Scale affects the resolution of the image sequence, its\n    parameters cannot be animated (if animation is desired, use a\n    Transform COP\u2019s scale parameter)."], "extent": [387, 556]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [556, 568], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Scale"], "extent": [568, 579], "body": [{"type": "para", "indent": 8, "text": ["Specifies the scaling method:"], "extent": [579, 618]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 8, "text": ["To Resolution"], "extent": [618, 641], "body": [{"type": "para", "indent": 12, "text": ["Scales to the specified number of pixels."], "extent": [641, 695]}], "container": true}, {"type": "dt", "indent": 8, "text": ["To Fraction"], "extent": [695, 716], "body": [{"type": "para", "indent": 12, "text": ["Scales to a fraction (e.g. 0.5 = 50%)"], "extent": [716, 766]}], "container": true}, {"type": "dt", "indent": 8, "text": ["To Aspect Ratio"], "extent": [766, 791], "body": [{"type": "para", "indent": 12, "text": ["Scales to a given Pixel Aspect ratio."], "extent": [791, 841]}], "container": true}, {"type": "dt", "indent": 8, "text": ["To Second Input\u2019s Resolution"], "extent": [841, 879], "body": [{"type": "para", "indent": 12, "text": ["Scales to match the resolution of the second input."], "extent": [879, 943]}], "container": true}, {"type": "dt", "indent": 8, "text": ["To a Fraction of the Second Input"], "extent": [943, 986], "body": [{"type": "para", "indent": 12, "text": ["Scales to match the resolution of the second input scaled by\n            a fraction (e.g. 0.5 = 50%)."], "extent": [986, 1100]}], "container": true}, {"type": "dt", "indent": 8, "text": ["To Second Input\u2019s Aspect Ratio"], "extent": [1100, 1140], "body": [{"type": "para", "indent": 12, "text": ["Scales to match the second input\u2019s aspect ratio."], "extent": [1140, 1201]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Image Size"], "extent": [1201, 1217], "body": [{"type": "para", "indent": 8, "text": ["Specify the size the image should be scaled to (in Pixels)."], "extent": [1217, 1285]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Image Fraction"], "extent": [1285, 1305], "body": [{"type": "para", "indent": 8, "text": ["Specify the size you'd like to scale the image as a fraction\n        (e.g. 0.5 = 50%)."], "extent": [1305, 1400]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Pixel Aspect"], "extent": [1400, 1418], "body": [{"type": "para", "indent": 8, "text": ["Pixel Aspect is the ratio of the width to the height. Specify\n        the pixel aspect ratio to scale the image by here."], "extent": [1418, 1547]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Preserve Aspect Ratio"], "extent": [1547, 1574], "body": [{"type": "para", "indent": 8, "text": ["When enabled, it preserves the ratio of the image width to\n        height when scaling."], "extent": [1574, 1670]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Image Filter"], "extent": [1670, 1688], "body": [{"type": "para", "indent": 8, "text": ["Specifies the type of filter to use when scaling. The Box filter\n        is the fastest; for almost all uses, the Gaussian is the best\n        choice; use Catmull when you need something a bit sharper than\n        Gaussian."], "extent": [1688, 1920]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [1920, 1928], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1954, 1963], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/crop", "type": "link", "text": "", "fullpath": "/nodes/cop2/crop.html"}], "extent": [1963, 1986]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/xform", "type": "link", "text": "", "fullpath": "/nodes/cop2/xform.html"}], "extent": [1986, 2011]}], "container": true}], "text": "Related"}], "title": ["Scale"], "summary": ["Changes the resolution of the image."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}