{"type": "root", "attrs": {"type": "node", "context": "sop", "internal": "layoutbrushscale", "icon": "SOP/layoutbrushscale", "tags": "paintinstancesbrush", "allow_hidden": "true", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Scale (Paint Instances brush)"], "extent": [0, 34]}, {"type": "summary", "indent": 0, "text": ["Applies a scale to the assets you brush over."], "extent": [164, 217]}, {"type": "box_group", "body": [{"ext": null, "type": "box", "indent": 0, "role": "item", "extent": [16, 22], "body": [{"type": "para", "indent": 4, "text": ["This node is designed to customize the behavior of the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["Paint Instances LOP"], "fullpath": "/nodes/lop/paintinstances.html"}, ". See the ", {"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": ["help for Paint Instances"], "fullpath": "/nodes/lop/paintinstances.html"}, " for more information."], "extent": [51, 238]}], "container": true, "attrs": {"id": "see_paintinstances"}}], "container": true, "role": "item_group"}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [268, 274], "body": [{"type": "para", "indent": 4, "text": ["This brush can only affect assets that were added in the current Paint Instances node."], "extent": [274, 367]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [367, 379], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Brush"], "extent": [379, 392], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Mode"], "extent": [392, 399], "body": [{"type": "para", "indent": 4, "text": ["Sets the brush to be either screen space or world space."], "extent": [413, 475]}], "container": true, "attrs": {"id": "mode"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Radius"], "extent": [475, 483], "body": [{"type": "para", "indent": 4, "text": ["The radius of the brush."], "extent": [483, 513]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Soft Radius"], "extent": [513, 526], "body": [{"type": "para", "indent": 4, "text": ["The fraction of the brush radius where it starts to fall off to 0.0 at the edge. For example, if you set this to ", {"type": "code", "text": ["0.5"]}, ", the brush is at full strength in the inner half of the radius, and falls off from the halfway point to the outer edge."], "extent": [526, 771]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Transform"], "extent": [771, 787], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 0, "text": ["Scale Mode"], "extent": [787, 800], "body": [{"type": "para", "indent": 3, "text": ["Set to ", {"type": "code", "text": ["Absolute"]}, " to replace the scale of each instance with the value in ", {"type": "ui", "text": ["Scale"]}, ". ", {"type": "code", "text": ["Incremental"]}, " multiplies the current scale by the value in ", {"type": "ui", "text": ["Scale"]}, " with each move of the brush."], "extent": [816, 1003]}], "container": true, "attrs": {"id": "smode"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Scale"], "extent": [1003, 1010], "body": [{"type": "para", "indent": 4, "text": ["The absolute scale value to which each instance is set."], "extent": [1026, 1087]}], "container": true, "attrs": {"id": "scale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Scale"], "extent": [1087, 1094], "body": [{"type": "para", "indent": 4, "text": ["The incremental scale value that is multiplied by the current scale of each instance."], "extent": [1113, 1204]}], "container": true, "attrs": {"id": "scaleinc"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Min Scale"], "extent": [1204, 1215], "body": [{"type": "para", "indent": 4, "text": ["When applying incremental scaling, this is the minimum scale value that will be set on any instance."], "extent": [1234, 1340]}], "container": true, "attrs": {"id": "minscale"}, "role": "item"}, {"type": "parameters_item", "indent": 0, "text": ["Max Scale"], "extent": [1340, 1351], "body": [{"type": "para", "indent": 4, "text": ["When applying incremental scaling, this is the maximum scale value that will be set on any instance."], "extent": [1370, 1476]}], "container": true, "attrs": {"id": "maxscale"}, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [1476, 1485], "body": [{"type": "bullet_group", "body": [{"blevel": 2, "type": "bullet", "indent": 0, "text": [{"scheme": "Node", "value": "/nodes/lop/paintinstances", "type": "link", "text": "", "fullpath": "/nodes/lop/paintinstances.html"}], "extent": [1485, 1514]}], "container": true}], "text": "Related"}], "title": ["Scale (Paint Instances brush)"], "summary": ["Applies a scale to the assets you brush over."], "included": ["/nodes/sop/_paintinstancesbrush"]}