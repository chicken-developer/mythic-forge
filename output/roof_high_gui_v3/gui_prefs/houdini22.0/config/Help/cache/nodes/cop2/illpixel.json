{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "illpixel", "icon": "COP2/illpixel", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Illegal Pixel"], "extent": [80, 98]}, {"type": "summary", "indent": 0, "text": ["Detects illegal pixels, like NAN and INF, in images."], "extent": [98, 159]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["Shaders and renderers can generate illegal floating point values every\nonce in a while. This operation detects bad pixels, specifically NAN and\nINF, and either highlights them or fixes them. It can also notify you\nthrough a warning or an error which frame and plane have bad pixels."], "extent": [202, 486]}, {"type": "para", "indent": 0, "text": ["Because the data is missing from that pixel, it can be zeroed out or\nreplaced by blending together surrounding pixels. When zeroing pixels,\nthe entire pixel is zeroed even if only one component is bad (to avoid\ncolor shifting)."], "extent": [486, 715]}, {"type": "para", "indent": 0, "text": ["If pixels are replaced, and only a part of the pixel\u2019s components is\nbad, only that component will be replaced. If a large block of bad\npixels is present, it will attempt to iterate up to 16 times to break\ndown the block. Large blocks will look like blurry spots in the image,\nso you may want to limit the number of bad pixels to replace."], "extent": [715, 1055]}, {"type": "note_group", "body": [{"type": "note", "indent": 0, "role": "item", "extent": [1055, 1061], "body": [{"type": "para", "indent": 4, "text": ["Bad pixels are only detectable in floating point formats (16 and 32\n    bit floating point). Integer formats will have already been\n    quantized to a valid (but possibly random) color in the renderer,\n    making them impossible to detect."], "extent": [1061, 1306]}], "container": true}, {"type": "note", "indent": 0, "role": "item", "extent": [1306, 1312], "body": [{"type": "para", "indent": 4, "text": ["Bad pixels will not be detected in planes or areas of the image that\n    are not used during the cook."], "extent": [1312, 1421]}], "container": true}], "container": true, "role": "item_group"}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [1421, 1433], "body": [{"level": 2, "id": null, "container": true, "type": "h", "indent": 4, "text": ["Illegal Pixel"], "extent": [1433, 1458], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 8, "text": ["Illegal Pixels"], "extent": [1458, 1483], "body": [{"type": "para", "indent": 12, "text": ["Illegal pixels can be flagged or fixed. Often, flagging is\n            used to debug the shader, while fixing is used to attempt to\n            continue with the image as-is."], "extent": [1483, 1671]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Fix by Blending Surrounding Pixels"]}], "extent": [1671, 1721], "body": [{"type": "para", "indent": 16, "text": ["For small numbers or isolated pixels, this method will\n                work well to fix the image."], "extent": [1721, 1836]}], "container": true}, {"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Fix by Zeroing"]}], "extent": [1836, 1866], "body": [{"type": "para", "indent": 16, "text": ["This method clears the NANs so that downstream\n                compositing operations behave, but doesn\u2019t do much in\n                the way of visually correcting the image."], "extent": [1866, 2057]}], "container": true}, {"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Show by Highlighting"]}], "extent": [2057, 2093], "body": [{"type": "para", "indent": 16, "text": ["Shows bad pixels by highlighting them super-red\n                (20,0,0)."], "extent": [2093, 2183]}], "container": true}, {"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Show by Isolating"]}], "extent": [2183, 2216], "body": [{"type": "para", "indent": 16, "text": ["Shows bad pixels by highlighting them and clearing all\n                correct pixels."], "extent": [2216, 2319]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": ["Notification"], "extent": [2319, 2341], "body": [{"type": "para", "indent": 12, "text": ["If a bad pixel is found, this operation can raise a warning\n            or an error."], "extent": [2341, 2439]}, {"type": "dt_group", "body": [{"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["None"]}], "extent": [2439, 2459], "body": [{"type": "para", "indent": 16, "text": ["The node is not flagged with an error or warning, though\n                the number of bad pixels is still reported in the node\n                info."], "extent": [2459, 2625]}], "container": true}, {"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Warning"]}], "extent": [2625, 2648], "body": [{"type": "para", "indent": 16, "text": ["A warning flag is posted with the number of bad pixels\n                in the node info."], "extent": [2648, 2753]}], "container": true}, {"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Error"]}], "extent": [2753, 2774], "body": [{"type": "para", "indent": 16, "text": ["An error is raised. The number of bad pixels is printed\n                in the node info, but it may not be entirely accurate\n                because this will terminate the cook, and no more tiles\n                will be processed."], "extent": [2774, 3023]}], "container": true}, {"type": "dt", "indent": 12, "text": [{"type": "q", "text": ["Error if Over Limit"]}], "extent": [3023, 3058], "body": [{"type": "para", "indent": 16, "text": ["An error is raised if the number of bad pixels in a\n                single plane is greater than the limit specified.\n                Otherwise, a warning is raised."], "extent": [3058, 3240]}], "container": true}], "container": true}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 8, "text": [{"type": "q", "text": ["Illegal Pixel Limit"]}], "extent": [3240, 3271], "body": [{"type": "para", "indent": 12, "text": ["The number of acceptable bad pixels. If more than this\n            number are in the image, the cook will halt."], "extent": [3271, 3395]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}]}], "text": "Parameters"}, {"level": 1, "id": "locals", "container": true, "type": "locals_section", "indent": 0, "role": "section", "extent": [3395, 3403], "body": [{"type": "dt_group", "body": [{"type": "dt", "indent": 0, "text": ["L"], "extent": [26, 29], "body": [{"type": "para", "indent": 4, "text": ["Sequence length"], "extent": [29, 49]}], "container": true}, {"type": "dt", "indent": 0, "text": ["S"], "extent": [49, 52], "body": [{"type": "para", "indent": 4, "text": ["Start of sequence"], "extent": [52, 74]}], "container": true}, {"type": "dt", "indent": 0, "text": ["E"], "extent": [74, 77], "body": [{"type": "para", "indent": 4, "text": ["End of sequence"], "extent": [77, 97]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IL"], "extent": [97, 101], "body": [{"type": "para", "indent": 4, "text": ["Input sequence length"], "extent": [101, 127]}], "container": true}, {"type": "dt", "indent": 0, "text": ["SR"], "extent": [127, 131], "body": [{"type": "para", "indent": 4, "text": ["Sequence frame rate"], "extent": [131, 155]}], "container": true}, {"type": "dt", "indent": 0, "text": ["NP"], "extent": [155, 159], "body": [{"type": "para", "indent": 4, "text": ["Number of planes in sequence"], "extent": [159, 192]}], "container": true}, {"type": "dt", "indent": 0, "text": ["W,H"], "extent": [192, 197], "body": [{"type": "para", "indent": 4, "text": ["Width and height of image"], "extent": [197, 227]}], "container": true}, {"type": "dt", "indent": 0, "text": ["I"], "extent": [227, 230], "body": [{"type": "para", "indent": 4, "text": ["Image index (0 at start frame)"], "extent": [230, 265]}], "container": true}, {"type": "dt", "indent": 0, "text": ["IT"], "extent": [265, 269], "body": [{"type": "para", "indent": 4, "text": ["Image time (0 at start frame)"], "extent": [269, 303]}], "container": true}, {"type": "dt", "indent": 0, "text": ["AI"], "extent": [303, 307], "body": [{"type": "para", "indent": 4, "text": ["Current plane array index"], "extent": [307, 337]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PI"], "extent": [337, 341], "body": [{"type": "para", "indent": 4, "text": ["Current plane index"], "extent": [341, 365]}], "container": true}, {"type": "dt", "indent": 0, "text": ["PC"], "extent": [365, 369], "body": [{"type": "para", "indent": 4, "text": ["Num of channels in current plane"], "extent": [369, 406]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CXRES"], "extent": [406, 413], "body": [{"type": "para", "indent": 4, "text": ["Composite Project X resolution"], "extent": [413, 448]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CYRES"], "extent": [448, 455], "body": [{"type": "para", "indent": 4, "text": ["Composite Project Y resolution"], "extent": [455, 490]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CPIXA"], "extent": [490, 497], "body": [{"type": "para", "indent": 4, "text": ["Composite Project pixel aspect ratio"], "extent": [497, 538]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CDEPTH"], "extent": [538, 546], "body": [{"type": "para", "indent": 4, "text": ["Composite Project raster depth"], "extent": [546, 581]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CBP"], "extent": [581, 586], "body": [{"type": "para", "indent": 4, "text": ["Composite Project black point"], "extent": [586, 620]}], "container": true}, {"type": "dt", "indent": 0, "text": ["CWP"], "extent": [620, 625], "body": [{"type": "para", "indent": 4, "text": ["Composite Project white point"], "extent": [625, 659]}], "container": true}], "container": true}], "text": "Locals"}], "title": ["Illegal Pixel"], "summary": ["Detects illegal pixels, like NAN and INF, in images."], "included": ["/composite/_old_cops_deprecated", "/nodes/cop2/localvars"]}