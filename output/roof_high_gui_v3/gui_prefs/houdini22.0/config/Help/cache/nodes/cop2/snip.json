{"type": "root", "attrs": {"type": "node", "context": "cop2", "internal": "snip", "icon": "COP2/snip", "index": "no", "version": null, "namespace": null}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Snip"], "extent": [72, 81]}, {"type": "summary", "indent": 0, "text": ["Either removes frames from a sequence or allows you to order them in\na user-defined order."], "extent": [81, 180]}, {"type": "warning_group", "body": [{"ext": null, "type": "warning", "indent": 0, "text": ["Old network"], "role": "item", "extent": [16, 38], "body": [{"type": "para", "indent": 4, "text": ["As of Houdini 20.5, use ", {"scheme": null, "value": "/nodes/cop/index", "type": "link", "text": ["Copernicus nodes"], "fullpath": "/nodes/cop/index.html"}, " instead of Compositing nodes. Though both networks still exist, the Compositing network is now designated as ", {"type": "code", "text": ["COP Network - Old"]}, ". The Compositing network and its nodes will be deprecated and then removed in a future Houdini release."], "extent": [38, 335]}], "container": true}], "container": true, "role": "item_group"}, {"type": "para", "indent": 0, "text": ["This operation either removes frames from a sequence or allows you to\norder them in a user-defined order. This operation does not use any\ncache memory."], "extent": [223, 377]}, {"level": 1, "id": "parameters", "container": true, "type": "parameters_section", "indent": 0, "role": "section", "extent": [377, 389], "body": [{"type": "parameters_item_group", "body": [{"type": "parameters_item", "indent": 4, "text": ["Frame Operation"], "extent": [389, 410], "body": [{"type": "para", "indent": 8, "text": [{"type": "q", "text": ["Snip Scoped Frames"]}, " removes the specified frames; ", {"type": "q", "text": ["Keep Scoped\n        Frames"]}, " keeps only the specified frames; ", {"type": "q", "text": ["User Defined Order"]}, "\n        re-orders the frames in the order defined in the ", {"type": "q", "text": ["Frame Order"]}, "\n        parameter."], "extent": [410, 642]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frames"], "extent": [642, 654], "body": [{"type": "para", "indent": 8, "text": ["The frames to either Snip or Keep."], "extent": [654, 697]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Frame Order"], "extent": [697, 714], "body": [{"type": "para", "indent": 8, "text": ["The new order of the frames in the sequence."], "extent": [714, 767]}], "container": true, "role": "item"}, {"type": "parameters_item", "indent": 4, "text": ["Automatically Adjust for Length Changes"], "extent": [767, 812], "body": [{"type": "para", "indent": 8, "text": ["If on, all the frame numbers will be adjusted when the length of\n        the input sequence changes."], "extent": [812, 922]}], "container": true, "role": "item"}], "container": true, "role": "item_group"}], "text": "Parameters"}, {"level": 1, "id": "related", "container": true, "type": "related_section", "indent": 0, "role": "section", "extent": [922, 931], "body": [{"type": "bullet_group", "body": [{"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/extend", "type": "link", "text": "", "fullpath": "/nodes/cop2/extend.html"}], "extent": [931, 956]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/shift", "type": "link", "text": "", "fullpath": "/nodes/cop2/shift.html"}], "extent": [956, 980]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/shuffle", "type": "link", "text": "", "fullpath": "/nodes/cop2/shuffle.html"}], "extent": [980, 1006]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/sequence", "type": "link", "text": "", "fullpath": "/nodes/cop2/sequence.html"}], "extent": [1006, 1033]}, {"blevel": 6, "type": "bullet", "indent": 4, "text": [{"scheme": "Node", "value": "/nodes/cop2/trim", "type": "link", "text": "", "fullpath": "/nodes/cop2/trim.html"}], "extent": [1033, 1057]}], "container": true}], "text": "Related"}], "title": ["Snip"], "summary": ["Either removes frames from a sequence or allows you to order them in\na user-defined order."], "included": ["/composite/_old_cops_deprecated"]}