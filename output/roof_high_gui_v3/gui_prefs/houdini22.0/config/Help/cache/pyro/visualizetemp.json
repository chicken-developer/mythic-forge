{"type": "root", "attrs": {"index": "no"}, "body": [{"level": 0, "type": "title", "indent": 0, "text": ["Visualizing the temperature field of a smoke object"], "extent": [12, 68]}, {"type": "para", "indent": 0, "text": ["You can use the information attainted through visualizing the temperature field to determine how to modify parameters on the ", {"type": "ui", "text": ["Forces"]}, " tab of the ", {"scheme": "Node", "value": "/nodes/dop/smokesolver", "type": "link", "text": ["Smoke Solver"], "fullpath": "/nodes/dop/smokesolver.html"}, "."], "extent": [68, 254]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Visualizing hot fluid"], "extent": [254, 282], "body": [{"type": "ord_group", "body": [{"blevel": 2, "type": "ord", "indent": 0, "text": ["Create a ", {"scheme": null, "value": "/shelf/smokebox", "type": "link", "text": ["smoke container"], "fullpath": "/shelf/smokebox.html"}, " with a ", {"scheme": "Node", "value": "/nodes/sop/sphere", "type": "link", "text": ["sphere"], "fullpath": "/nodes/sop/sphere.html"}, " inside it. "], "extent": [282, 373]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["Use the ", {"scheme": null, "value": "/shelf/sourcefromvolume", "type": "link", "text": ["Source from volume"], "fullpath": "/shelf/sourcefromvolume.html"}, " tool on the ", {"type": "ui", "text": ["Volume Fluids"]}, " shelf tab to make the sphere emit smoke."], "extent": [373, 500]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["On the ", {"scheme": "Node", "value": "/nodes/dop/smokeobject", "type": "link", "text": ["Smoke Object"], "fullpath": "/nodes/dop/smokeobject.html"}, ", turn on the ", {"type": "ui", "text": ["Show Guide Geometry"]}, " checkbox on the ", {"type": "ui", "text": ["Temperature"]}, " subtab of the ", {"type": "ui", "text": ["Guides"]}, " tab. "], "extent": [500, 646], "body": [{"type": "para", "indent": 4, "text": ["This will create a grid that changes color to provide valuable information about the temperature of the simulation. Blue indicates a cooler temperature and red indicates a hotter temperature. This is useful for simulating fire and explosions."], "extent": [646, 894]}], "container": true}], "container": true}, {"type": "para", "indent": 0, "text": [{"scheme": "Image", "value": "/images/howto/visualize_smoke_1.jpg", "type": "img", "text": ""}, "\n", {"scheme": "Image", "value": "/images/howto/visualize_smoke_2.jpg", "type": "img", "text": ""}, "\n", {"scheme": "Image", "value": "/images/howto/visualize_smoke_3.jpg", "type": "img", "text": ""}], "extent": [894, 1027]}]}, {"level": 2, "id": null, "container": true, "type": "h", "indent": 0, "text": ["Visualizing cold fluid"], "extent": [1027, 1056], "body": [{"type": "para", "indent": 0, "text": ["You can also visualize cold fluid by changing a few parameters in the simulation."], "extent": [1056, 1140]}, {"type": "ord_group", "body": [{"blevel": 2, "type": "ord", "indent": 0, "text": ["On the ", {"scheme": "Node", "value": "/nodes/dop/staticobject", "type": "link", "text": ["Static Object"], "fullpath": "/nodes/dop/staticobject.html"}, ", change the ", {"type": "ui", "text": ["Temperature"]}, " from 1 to -1. "], "extent": [1140, 1231]}, {"blevel": 2, "type": "ord", "indent": 0, "text": ["On the ", {"scheme": "Node", "value": "/nodes/dop/smokeobject", "type": "link", "text": ["Smoke Object"], "fullpath": "/nodes/dop/smokeobject.html"}, ", navigate to the ", {"type": "ui", "text": ["Temperature"]}, " subtab of the ", {"type": "ui", "text": ["Guides"]}, " tab and change the ", {"type": "ui", "text": ["Guide Range"]}, " parameter from 0 and 1 to -1 and 0."], "extent": [1231, 1406]}], "container": true}, {"type": "para", "indent": 0, "text": [{"scheme": "Image", "value": "/images/howto/visualize_smoke_4.jpg", "type": "img", "text": ""}, "\n", {"scheme": "Image", "value": "/images/howto/visualize_smoke_5.jpg", "type": "img", "text": ""}, "\n", {"scheme": "Image", "value": "/images/howto/visualize_smoke_6.jpg", "type": "img", "text": ""}], "extent": [1406, 1539]}, {"type": "para", "indent": 0, "text": ["Blue indicates a cooler temperature and red indicates a hotter temperature, as in the first example."], "extent": [1539, 1640]}]}], "title": ["Visualizing the temperature field of a smoke object"]}