// Only guide curves; native PolyWire supplies trim topology.
int old=nprimitives(0);string done[];
for(int pr=0;pr<old;pr++){
 int pts[]=primpoints(0,pr);vector n0=prim_normal(0,pr,.5,.5);
 for(int i=0;i<len(pts);i++){
  int a=pts[i],b=pts[(i+1)%len(pts)],pa[]=pointprims(0,a),pb[]=pointprims(0,b);
  foreach(int neighbor;pa){
   if(neighbor<=pr||find(pb,neighbor)<0)continue;
   vector n1=prim_normal(0,neighbor,.5,.5);
   string r0=prim(0,"roof_patch_id",pr),r1=prim(0,"roof_patch_id",neighbor);
   int junction=r0!=r1,ridge=dot(normalize(n0),normalize(n1))<.8;
   if(!junction&&!ridge)continue;
   string key=itoa(min(a,b))+"_"+itoa(max(a,b));if(find(done,key)>=0)continue;append(done,key);
   vector p0=point(0,"P",a),p1=point(0,"P",b),up=normalize(n0+n1);
   int p=addpoint(0,p0+up*.018),q=addpoint(0,p1+up*.018);
   int line=addprim(0,"polyline",p,q);
   string id=junction?"junction/"+r0+"_"+r1:"ridge/"+r0;
   setprimattrib(0,"name",line,"roof/"+id);setprimattrib(0,"roof_junction_id",line,id);
   setprimattrib(0,"material_family",line,junction?"metal":"tile");
   setprimattrib(0,"Cd",line,junction?set(.18,.19,.20):set(.28,.20,.13));
  }
 }
}
for(int pr=old-1;pr>=0;pr--)removeprim(0,pr,1);
