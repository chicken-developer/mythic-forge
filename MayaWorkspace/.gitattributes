# Maya ASCII scenes, MEL and scripts stay diffable with normalized LF endings.
* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
*.ma text eol=lf
*.mel text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.mtl text eol=lf
*.usda text eol=lf
*.ass text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary scenes, geometry and published caches require Git LFS.
*.mb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
*.mcx filter=lfs diff=lfs merge=lfs -text
*.mcc filter=lfs diff=lfs merge=lfs -text
*.vdb filter=lfs diff=lfs merge=lfs -text
*.usd filter=lfs diff=lfs merge=lfs -text
*.usdc filter=lfs diff=lfs merge=lfs -text
*.usdz filter=lfs diff=lfs merge=lfs -text
*.ass.gz filter=lfs diff=lfs merge=lfs -text
*.xgen filter=lfs diff=lfs merge=lfs -text
*.xpd filter=lfs diff=lfs merge=lfs -text

