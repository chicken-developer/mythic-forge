# Ignore all files by default, but scan all directories.
*
!*/

# Do not ignore git files in the root of the repo.
!/.git*

# Do not ignore current project's `.uproject`. & ref file
!/*.uproject
!/*.pur
!/Docs/Architecture/RepositoryBaseline.md
!/Docs/Architecture/EnginePluginPolicy.md
!/Docs/Implementation/**
!/Scripts/**
!/Tests/**
!/.github/**

# Do not ignore source, config and plugins dirs.
!/Source/**
!/Config/**
!/Plugins/**

# Only allow .uasset and .umap files from /Content dir.
# They're tracked by git-lfs, don't forget to track other
# files if adding them here.
!/Content/**/*.uasset
!/Content/**/*.umap
#Ignore temp folder from Houdini
Content/HoudiniEngine/Temp/*

# Allow any files from /RawContent dir.
# Any file in /RawContent dir will be managed by git lfs.
!/RawContent/**/*

# Gothic asset sources, reproducible tooling, and reviewed renders.
!/SourceAssets/Gothic/**
!/Tools/Gothic/**
!/RenderTests/Gothic/**
/Tools/Gothic/__pycache__/

# Current prop catalogs, portable Houdini definitions, and validation evidence.
!/CATALOG_GUIDE.txt
!/MEDIEVAL_GUIDE.txt
!/CITY_GUIDE.txt
!/SourceAssets/Houdini/**
/SourceAssets/Houdini/**/__pycache__/
/SourceAssets/Houdini/**/backup/
/SourceAssets/Houdini/Gothic/production_pipeline.py
!/SourceAssets/Medieval/mesh_manifest*.json
!/SourceAssets/Medieval/material_manifest.json
!/SourceAssets/Medieval/Meshes/*.fbx
!/SourceAssets/Medieval/Low/*.fbx
!/SourceAssets/Medieval/High/*.fbx
!/Tools/Props/**
/Tools/Props/__pycache__/
!/Tools/Medieval/build_levels.py
!/Tools/Medieval/import_assets.py
!/Tools/Medieval/scene.py
!/RenderTests/PropsDetail/**
!/RenderTests/BuildingJoints/**
!/RenderTests/EditableHDA/**
!/RenderTests/SkyTown/**

# OS/platform generated files.

# Windows
ehthumbs.db
Thumbs.db

# Mac OS X
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# vim
[._]*.s[a-w][a-z]
[._]s[a-w][a-z]
*.un~
Session.vim
.netrwhist

# Visual Studio
.vs

# Generated outputs from project-owned plugins and tooling.
/Plugins/Knight/**/Binaries/
/Plugins/Knight/**/Intermediate/
/Scripts/**/__pycache__/
