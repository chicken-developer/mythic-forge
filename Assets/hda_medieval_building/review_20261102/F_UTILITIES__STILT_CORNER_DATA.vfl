
int original=nprimitives(0);
string mode=chs("../foundation_mode");
vector lo,hi;getbbox(0,lo,hi);
if(mode=="stilts" || mode=="hybrid")
    for(int pr=0;pr<original;pr++)
    {
        int corners[]=primpoints(0,pr);
        int step=int(prim(0,"is_round",pr)) ? max(1,len(corners)/4) : 1;
        vector center=prim(0,"role_center",pr);
        float top=prim(0,"base_h",pr)-.08;
        for(int k=0;k<len(corners);k+=step)
        {
            vector corner=point(0,"P",corners[k]);
            corner=lerp(corner,set(center.x,0.,center.z),.06);
            float ground=-ch("../terrain_slope")*(corner.x-lo.x);
            float bottom=ground+.18,height=max(top-bottom,.08);
            int pt=addpoint(0,set(corner.x,bottom+height*.5,corner.z));
            setpointattrib(0,"scale",pt,set(.26,height,.26),"set");
            setpointattrib(0,"ground_y",pt,ground,"set");
            setpointattrib(0,"role",pt,string(prim(0,"role",pr)),"set");
            setpointattrib(0,"role_id",pt,int(prim(0,"role_id",pr)),"set");
        }
    }
for(int pr=original-1;pr>=0;pr--) removeprim(0,pr,1);
