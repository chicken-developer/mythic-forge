
int count=nprimitives(0);float spacing=max(.16,ch("../tile_size"));
for(int src=0;src<count;src++)
{
    if(int(prim(0,"is_round",src)))continue;
    float w=prim(0,"width",src),d=prim(0,"depth",src),e=prim(0,"eave",src),top=prim(0,"top_y",src),h=prim(0,"roof_h",src);
    float angle=prim(0,"rot_y",src);vector center=prim(0,"role_center",src);center.y=0.;
    float span=chs("../roof_shape")=="hipped" ? max(.035,d-w) : d+2.*e;
    int n=max(1,int(ceil(span/spacing)));float step=span/n;
    matrix3 rot=ident();rotate(rot,radians(angle),set(0.,1.,0.));
    matrix3 frame=ident();scale(frame,set(1.,1.,step*.97));rotate(frame,radians(angle),set(0.,1.,0.));
    for(int k=0;k<n;k++)
    {
        vector local=set(0.,top+h+.055,-span*.5+(k+.5)*step);
        int pt=addpoint(0,local*rot+center);
        setpointattrib(0,"transform",pt,frame,"set");
        setpointattrib(0,"role_id",pt,int(prim(0,"role_id",src)),"set");
    }
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
