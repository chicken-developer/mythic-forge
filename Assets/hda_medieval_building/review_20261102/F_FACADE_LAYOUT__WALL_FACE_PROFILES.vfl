// Derive separate 2D wall profiles from the native mass side faces.
int count=nprimitives(0);
for(int src=0;src<count;src++){
 vector normal=prim_normal(0,src,.3,.3);if(abs(normal.y)>.1)continue;
 int points[]=primpoints(0,src),newpoints[];
 foreach(int pt;points){vector pos=point(0,"P",pt);int added=addpoint(0,pos);append(newpoints,added);setpointattrib(0,"extrude_direction",added,-normal);}
 int p=addprim(0,"poly",reverse(newpoints));
 string ints[]=array("floor_i","floor_count","role_id","is_round","round_segments");
 string floats[]=array("floor_b","floor_h","width","depth","base_width","base_depth","rot_y");
 string strings[]=array("role","level_key");
 foreach(string n;ints){int v=prim(0,n,src);setprimattrib(0,n,p,v);}
 foreach(string n;floats){float v=prim(0,n,src);setprimattrib(0,n,p,v);}
 foreach(string n;strings){string v=prim(0,n,src);setprimattrib(0,n,p,v);}
 vector center=prim(0,"role_center",src);setprimattrib(0,"role_center",p,center);
 setprimattrib(0,"facade_normal",p,normal);setprimattrib(0,"extrude_distance",p,float(ch("../wall_thickness_m")));
 setprimattrib(0,"material_family",p,"plaster");setprimattrib(0,"name",p,"wall_"+itoa(src));
 setprimattrib(0,"Cd",p,set(.9,.82,.63));
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
