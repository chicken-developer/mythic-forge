int count=nprimitives(0);
for(int src=0;src<count;src++){
 string opening=prim(0,"opening",src);if(opening!="W"&&opening!="D")continue;
 vector n=prim(0,"facade_normal",src),u=prim(0,"edge_u",src),up={0,1,0};
 vector center=primuv(0,"P",src,set(.5,.5,0));float b=prim(0,"floor_b",src),fh=prim(0,"floor_h",src),w=prim(0,"bay_width",src);
 float prototype_w=opening=="D"?ch("../door_width_m"):ch("../window_width_m");
 float prototype_h=opening=="D"?ch("../door_height_m"):ch("../window_height_m");
 float sx=min(1.,max(.45,w-.25)/max(.01,prototype_w));float sy=min(1.,(fh-.4)/max(.1,prototype_h));
 center.y=opening=="D"?b+prototype_h*sy/2:b+fh*.52;
 center+=n*.015;
 int pt=addpoint(0,center);matrix3 frame=set(u*sx,up*sy,-n);
 setpointattrib(0,"transform",pt,frame);setpointattrib(0,"opening_kind",pt,opening);
 string id=prim(0,"bay_id",src);setpointattrib(0,"opening_id",pt,id);
 string key=prim(0,"level_key",src);setpointattrib(0,"level_key",pt,key);
 setpointattrib(0,"outward",pt,n);setpointattrib(0,"aperture_w",pt,prototype_w*sx);setpointattrib(0,"aperture_h",pt,prototype_h*sy);
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
