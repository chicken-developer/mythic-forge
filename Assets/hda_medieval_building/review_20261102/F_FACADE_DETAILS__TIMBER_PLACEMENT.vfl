int count=nprimitives(0);vector up={0,1,0};
for(int src=0;src<count;src++){
 vector normal=prim(0,"facade_normal",src),u=prim(0,"edge_u",src);float b=prim(0,"floor_b",src),h=prim(0,"floor_h",src),w=prim(0,"bay_width",src);
 vector c=primuv(0,"P",src,set(.5,.5,0));c.y=b+h/2;c+=normal*.035;
 string id=prim(0,"bay_id",src),opening=prim(0,"opening",src);
 for(int kind=0;kind<3;kind++){
   vector p=c;vector size;
   if(kind==0){p-=u*w/2;size=set(.16,h+.08,.18);}
   else{p.y=b+(kind==1?.08:h-.03);size=set(w+.1,.16,.20);}
   int pt=addpoint(0,p);matrix3 frame=set(u*size.x,up*size.y,-normal*size.z);
   setpointattrib(0,"transform",pt,frame);setpointattrib(0,"name",pt,"timber_"+id+"_"+itoa(kind));
   setpointattrib(0,"material_family",pt,"wood");setpointattrib(0,"Cd",pt,set(.27,.19,.12));
 }
 if(opening=="." && chs("../timber_pattern")!="curved_brace"){
   vector a=c-u*(w/2-.15)-up*(h/2-.25),z=c+u*(w/2-.15)+up*(h/2-.25);
   if(chs("../timber_pattern")=="cross_brace" && prim(0,"bay_i",src)%2){float t=a.y;a.y=z.y;z.y=t;}
   vector along=normalize(z-a),side=normalize(cross(along,normal)),depth=normalize(cross(side,along));
   int pt=addpoint(0,(a+z)/2);matrix3 frame=set(side*.12,along*distance(a,z),depth*.12);
   setpointattrib(0,"transform",pt,frame);setpointattrib(0,"name",pt,"brace_"+id);
   setpointattrib(0,"material_family",pt,"wood");setpointattrib(0,"Cd",pt,set(.27,.19,.12));
 }
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
