
vector worldpos(vector p;vector center;float angle)
{
    float c=cos(radians(angle)),s=sin(radians(angle));
    return set(center.x+c*p.x+s*p.z,p.y,center.z-s*p.x+c*p.z);
}
float grade(vector p;vector lo;vector hi)
{
    string preset=chs("../ground_slope_preset");float amount=ch("../ground_slope_amount_m");
    if(preset=="flat" || preset=="none")return 0.;
    if(preset=="legacy" || preset=="")return -ch("../terrain_slope")*(p.x-lo.x);
    int alongz=find(preset,"z")>=0;
    float q=alongz ? (p.z-lo.z)/max(hi.z-lo.z,.01) : (p.x-lo.x)/max(hi.x-lo.x,.01);
    float sign=(find(preset,"neg")>=0 || find(preset,"-")>=0) ? -1. : 1.;
    return sign*amount*q;
}
void solidprofile(vector p[];vector direction;float depth;string material;string name;vector color;string role;int rid)
{
    if(len(p)<3 || depth<.001)return;
    int reverse=dot(cross(p[1]-p[0],p[2]-p[0]),direction)>0.;
    int poly=addprim(0,"poly");
    for(int i=0;i<len(p);i++)
    {
        int pt=addpoint(0,p[reverse ? len(p)-1-i : i]);addvertex(0,poly,pt);
        setpointattrib(0,"extrude_direction",pt,direction,"set");
    }
    setprimattrib(0,"extrude_distance",poly,depth,"set");
    setprimattrib(0,"name",poly,name,"set");setprimattrib(0,"material_family",poly,material,"set");
    setprimattrib(0,"Cd",poly,color,"set");setprimattrib(0,"role",poly,role,"set");
    setprimattrib(0,"role_id",poly,rid,"set");setprimattrib(0,"component",poly,"site","set");
}
void member(vector position;vector size;vector center;float angle;string part;string material;vector color;string role;int rid)
{
    if(min(size)<.001)return;
    float a=radians(angle);vector x=set(cos(a),0.,-sin(a)),z=set(sin(a),0.,cos(a));
    int pt=addpoint(0,worldpos(position,center,angle));
    matrix3 transform=set(x*size.x,set(0.,size.y,0.),z*size.z);
    setpointattrib(0,"transform",pt,transform,"set");
    setpointattrib(0,"part_name",pt,part,"set");setpointattrib(0,"part_material",pt,material,"set");
    setpointattrib(0,"part_color",pt,color,"set");setpointattrib(0,"role",pt,role,"set");setpointattrib(0,"role_id",pt,rid,"set");
}
void beam(vector start;vector end;float width;vector center;float angle;string part;string role;int rid)
{
    vector a=worldpos(start,center,angle),b=worldpos(end,center,angle),along=normalize(b-a);
    vector ref=abs(along.y)<.95 ? set(0.,1.,0.) : set(1.,0.,0.);
    vector x=normalize(cross(along,ref)),z=cross(x,along);
    int pt=addpoint(0,(a+b)*.5);matrix3 transform=set(x*width,along*distance(a,b),z*width);
    setpointattrib(0,"transform",pt,transform,"set");setpointattrib(0,"part_name",pt,part,"set");
    setpointattrib(0,"part_material",pt,"wood","set");setpointattrib(0,"part_color",pt,set(.27,.19,.12),"set");
    setpointattrib(0,"role",pt,role,"set");setpointattrib(0,"role_id",pt,rid,"set");
}

int count=nprimitives(0);
for(int pr=0;pr<count;pr++)
{
    if(string(prim(0,"role",pr))!="main")continue;
    if(hasprimattrib(0,"floor_i") && int(prim(0,"floor_i",pr))>0)continue;
    int awning=chi("../awning_enable"),canopy=chi("../entrance_canopy");
    if(!awning && !canopy)break;
    vector center=prim(0,"role_center",pr);float angle=prim(0,"rot_y",pr),w=prim(0,"base_width",pr),d=prim(0,"base_depth",pr),base=prim(0,"base_h",pr);
    if(int(prim(0,"is_round",pr)))d=w;
    int rid=prim(0,"role_id",pr);float a=radians(angle);vector direction=set(sin(a),0.,cos(a));
    vector outline[];float depth;
    if(awning)
    {
        string rows[]=split(chs("../front_bays"),"/");int bays=len(rows)>0 ? max(len(rows[0]),1) : 3;
        float span=int(prim(0,"is_round",pr)) ? 2.1 : w/bays;
        depth=1.45;float z=-d*.5-.12-depth,y=base+2.5-.22;
        for(int j=0;j<=12;j++){float x=-span*.5+span*j/12.;append(outline,worldpos(set(x,y-.18*(1-pow(2*x/span,2)),z),center,angle));}
        for(int j=12;j>=0;j--){float x=-span*.5+span*j/12.;append(outline,worldpos(set(x,y-.18*(1-pow(2*x/span,2))-.025,z),center,angle));}
        direction=normalize(set(sin(a)*depth,.22,cos(a)*depth));depth=sqrt(depth*depth+.22*.22);
        solidprofile(outline,direction,depth,"canvas","site/main/awning_canvas",set(.78,.57,.32),"main",rid);
    }
    else
    {
        depth=1.29;float z=-d*.5-1.145,y=base+2.38;
        vector p[]=array(set(-.895,y+.04,z),set(0.,y+.48,z),set(.895,y+.04,z),set(.895,y-.06,z),set(0.,y+.38,z),set(-.895,y-.06,z));
        foreach(vector pos;p)append(outline,worldpos(pos,center,angle));
        solidprofile(outline,direction,depth,"roof","site/main/entrance_canopy",set(.43,.15,.09),"main",rid);
    }
    break;
}
for(int pr=count-1;pr>=0;pr--)removeprim(0,pr,1);
