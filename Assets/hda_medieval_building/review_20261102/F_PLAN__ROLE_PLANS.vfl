// A live footprint stream, not output-space architecture meshes.
vector lo,hi;getbbox(0,lo,hi);vector size=hi-lo;
float w=size.x,d=size.z,b=ch("../foundation_height_m"),fh=ch("../floor_height_m");
int floors=chi("../floor_count");string footprint=chs("../footprint");
int old=nprimitives(0);for(int p=old-1;p>=0;p--)removeprim(0,p,1);
int roles=1+(footprint=="l_shape"||footprint=="hybrid");
for(int r=0;r<roles;r++){
 string role=r==0?"main":footprint=="l_shape"?"wing":"tower";
 float rw=w,rd=d,angle=0,rh=ch("../roof_height_m");vector center={0,0,0};
 int count=floors,round=footprint=="round";
 if(round)rd=rw;
 if(role=="wing"){
   float ew=w*ch("../wing_width_ratio"),ed=d*ch("../wing_depth_ratio");
   rw=ed;rd=ew;angle=90;count=chi("../wing_floor_count");rh*=ch("../wing_roof_ratio");
   center=set(w/2+ew/2-ch("../wing_overlap_m"),0,ch("../wing_offset_z_m"));
 }
 if(role=="tower"){
   rw=rd=2*ch("../tower_radius_m");round=1;rh=1.5;
   center=set(w/2+ch("../tower_radius_m")*ch("../tower_inset_ratio"),0,ch("../tower_offset_z_m"));
 }
 if(chi("../layout_input_enable") && nprimitives(1)>0){
   string group="@layout_role="+role;int pieces[]=expandprimgroup(1,group);
   if(len(pieces)>0){vector a,c;getbbox(1,group,a,c);center=(a+c)/2;center.y=0;
      rw=c.x-a.x;rd=c.z-a.z;b=a.y;count=max(1,int(rint((c.y-a.y)/fh)));angle=0;}
 }
 matrix3 rot=ident();rotate(rot,radians(angle),{0,1,0});
 int segments=chs("../mesh_quality")=="low"?12:chs("../mesh_quality")=="high"?24:16;
 int pts[];int n=round?segments:4;
 for(int i=0;i<n;i++){
   vector local;
   if(round){float a=2*M_PI*i/n;local=set(cos(a)*rw/2,0,sin(a)*rw/2);}
   else{float xs[]=array(-1.,1.,1.,-1.);float zs[]=array(-1.,-1.,1.,1.);local=set(xs[i]*rw/2,0,zs[i]*rd/2);}
   append(pts,addpoint(0,local*rot+center));
 }
 int p=addprim(0,"poly",pts);
 setprimattrib(0,"role",p,role);setprimattrib(0,"role_id",p,r);
 setprimattrib(0,"floor_count",p,count);setprimattrib(0,"is_round",p,round);
 setprimattrib(0,"round_segments",p,segments);
 setprimattrib(0,"base_width",p,rw);setprimattrib(0,"base_depth",p,rd);
 setprimattrib(0,"width",p,rw);setprimattrib(0,"depth",p,rd);
 setprimattrib(0,"base_h",p,b);setprimattrib(0,"floor_h",p,fh);
 setprimattrib(0,"rot_y",p,angle);setprimattrib(0,"role_center",p,center);
 setprimattrib(0,"roof_h",p,rh);setprimattrib(0,"eave",p,float(ch("../eave_depth_m")));
 setprimattrib(0,"curve",p,float(ch("../eave_curve")));
 setprimattrib(0,"extra_h",p,role=="tower"?float(ch("../tower_extra_height_m")):0.);
}
