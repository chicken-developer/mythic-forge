
int solid_profile(vector p[]; vector direction; float depth; string material; string name; vector color)
{
    int prim=addprim(0,"poly");
    int reverse=dot(cross(p[1]-p[0],p[2]-p[0]),direction)>0.;
    for(int i=0;i<len(p);i++)
    {
        int index=reverse ? len(p)-1-i : i;
        int pt=addpoint(0,p[index]);addvertex(0,prim,pt);
        setpointattrib(0,"extrude_direction",pt,direction,"set");
    }
    setprimattrib(0,"extrude_distance",prim,depth,"set");
    setprimattrib(0,"material_family",prim,material,"set");
    setprimattrib(0,"name",prim,name,"set");
    setprimattrib(0,"Cd",prim,color,"set");
    return prim;
}

vector p[];int steps=12;float outer=.18,inner=.12;
for(int k=0;k<=steps;k++){float a=M_PI*k/steps;append(p,set(outer*cos(a),outer*sin(a),-.5));}
for(int k=steps;k>=0;k--){float a=M_PI*k/steps;append(p,set(inner*cos(a),inner*sin(a),-.5));}
solid_profile(p,set(0.,0.,1.),1.,"tile","roof_ridge_cap",set(.76,.24,.105));
