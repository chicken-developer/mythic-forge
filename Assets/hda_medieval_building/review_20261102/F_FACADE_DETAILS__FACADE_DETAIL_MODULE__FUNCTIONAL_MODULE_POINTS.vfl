
void part(float x;float y;float z;vector size;int pr;string module;string label;string material;vector color;float angle)
{
    if(min(size)<.005)return;
    vector n=prim(0,"facade_normal",pr);n=normalize(set(n.x,0.,n.z));
    vector up=set(0.,1.,0.),u=normalize(cross(n,up));
    vector center=primuv(0,"P",pr,set(.5,.5,0.));center.y=y;
    float a=radians(angle);vector ux=u*cos(a)+up*sin(a),uy=-u*sin(a)+up*cos(a);
    matrix3 m=set(ux*size.x,uy*size.y,-n*size.z);
    int pt=addpoint(0,center+u*x+n*z);
    string role=prim(0,"role",pr),slot=prim(0,"facade_slot",pr);
    setpointattrib(0,"transform",pt,m,"set");
    setpointattrib(0,"name",pt,"facade/"+slot+"/"+module+"/"+label,"set");
    setpointattrib(0,"material_family",pt,material,"set");
    setpointattrib(0,"Cd",pt,color,"set");
    setpointattrib(0,"role",pt,role,"set");setpointattrib(0,"role_id",pt,role=="main"?0:1,"set");
    setpointattrib(0,"facade_slot",pt,slot,"set");setpointattrib(0,"facade_module",pt,module,"set");
    setpointattrib(0,"component",pt,"facade_details","set");
}

void frame(float y;float w;float h;float depth;int pr;string module)
{
    vector wood=set(.27,.19,.12);
    for(int side=-1;side<=1;side+=2)
    {
        part(side*(w-.065)*.5,y,depth*.5,set(.065,h,depth),pr,module,"jamb_"+itoa(side),"wood",wood,0.);
        part(0.,y+side*(h-.065)*.5,depth*.5,set(w,.065,depth),pr,module,"rail_"+itoa(side),"wood",wood,0.);
    }
}

void safe_band(int pr;export float y;export float height)
{
    float base=prim(0,"floor_b",pr),fh=prim(0,"floor_h",pr);
    string opening=prim(0,"opening",pr);y=base+fh*.60;height=min(1.,fh*.45);
    if(opening=="W")
    {
        float wh=min(ch("../../window_height_m"),fh-.4);
        float gap=max(.12,fh*.52-wh*.5-.10);
        height=min(height,gap-.06);y=base+gap*.5;
    }
    else if(opening=="D")
    {
        float dh=min(ch("../../door_height_m"),fh-.4),gap=max(.12,fh-dh-.08);
        height=min(height,gap-.06);y=base+dh+.04+gap*.5;
    }
}

int original=nprimitives(0);
for(int pr=0;pr<original;pr++)
{
    string module=prim(0,"functional_kind",pr);if(module=="")continue;
    string opening=prim(0,"opening",pr);
    float bw=prim(0,"bay_width",pr),b=prim(0,"floor_b",pr),fh=prim(0,"floor_h",pr);
    float w=min(.88,bw-.22),h=.75,y=b+fh*.46;
    vector wood=set(.27,.19,.12);
    if(module=="planter")
    {
        float wh=min(ch("../../window_height_m"),fh-.4);
        y=b+fh*.52-wh*.5-.28;w=min(bw-.20,ch("../../window_width_m")+.16);
        part(0.,y-.10,.22,set(w,.06,.36),pr,module,"bottom","wood",wood,0.);
        for(int side=-1;side<=1;side+=2)
        {
            part(side*(w-.045)*.5,y,.22,set(.045,.22,.36),pr,module,"end_"+itoa(side),"wood",wood,0.);
            part(0.,y,.22+side*.157,set(w,.22,.045),pr,module,"board_"+itoa(side),"wood",wood,0.);
        }
        part(0.,y+.045,.22,set(w-.10,.035,.26),pr,module,"soil","wood",set(.12,.085,.045),0.);
        for(int j=0;j<3;j++)
            part((j-1)*w*.24,y+.16,.22,set(w*.16,.18,.17),pr,module,"plant_"+itoa(j),"leaf",set(.21,.39,.16),j*17.);
    }
    else if(module=="oriel"&&opening=="W")
    {
        float aperture=min(ch("../../window_width_m"),max(.45,bw-.25));
        w=min(bw-.08,aperture+.16);h=min(ch("../../window_height_m"),fh-.4)+.16;y=b+fh*.52;
        frame(y,w,h,.37,pr,module);
        part(0.,y,.36,set(w-.13,h-.13,.025),pr,module,"glazing","glass",set(.10,.24,.27),0.);
    }
    else if(module=="sign")
    {
        safe_band(pr,y,h);h=min(.28,h);w=min(.82,bw-.22);
        part(0.,y,.15,set(w,h,.10),pr,module,"board","wood",wood,0.);
        part(0.,y,.207,set(w*.79,h*.62,.018),pr,module,"painted_face","canvas",set(.73,.65,.43),0.);
        part(0.,y+h*.5+.045,.10,set(w*.42,.045,.15),pr,module,"mount","metal",set(.14,.15,.14),0.);
    }
    else if(module=="infill")
        part(0.,y,.035,set(w,fh*.68,.035),pr,module,"panel","plaster",set(.76,.66,.45),0.);
    else if(module=="trellis")
    {
        h=fh*.60;y=b+fh*.48;
        for(int j=0;j<4;j++)part((j-1.5)*w/3.,y,.14,set(.035,h,.035),pr,module,"upright_"+itoa(j),"wood",wood,0.);
        for(int j=0;j<4;j++)part(0.,y+(j-1.5)*h/3.,.16,set(w,.035,.035),pr,module,"crossbar_"+itoa(j),"wood",wood,0.);
        part(-w*.23,y+.13,.19,set(.23,h*.43,.12),pr,module,"vine","leaf",set(.22,.37,.16),-12.);
    }
    else if(module=="niche"||module=="service")
    {
        frame(y,w,h,.22,pr,module);
        part(0.,y,.035,set(w-.12,h-.12,.035),pr,module,"recessed_back","wood",set(.14,.10,.065),0.);
        if(module=="service")
        {
            part(0.,y,.235,set(w-.14,h-.14,.045),pr,module,"access_panel","teal",set(.09,.37,.36),0.);
            part(w*.22,y,.27,set(.045,.10,.035),pr,module,"latch","metal",set(.14,.15,.14),0.);
        }
        else part(0.,y-h*.20,.10,set(w-.15,.04,.14),pr,module,"shelf","wood",wood,0.);
    }
}
for(int p=original-1;p>=0;p--)removeprim(0,p,1);
