
int solid_profile(vector p[]; vector direction; float depth; string material; string name; vector color)
{
    int prim=addprim(0,"poly");
    int reverse=dot(cross(p[1]-p[0],p[2]-p[0]),direction)>0.;
    for(int i=0;i<len(p);i++)
    {
        int index=reverse ? len(p)-1-i : i;
        int pt=addpoint(0,p[index]);addvertex(0,prim,pt);
        setpointattrib(0,"extrude_direction",pt,direction,"set");
    }
    setprimattrib(0,"extrude_distance",prim,depth,"set");
    setprimattrib(0,"material_family",prim,material,"set");
    setprimattrib(0,"name",prim,name,"set");
    setprimattrib(0,"Cd",prim,color,"set");
    return prim;
}

int count=nprimitives(0),hipped=chs("../roof_shape")=="hipped";
float board=ch("../board_width"),drop=ch("../board_height"),tile=ch("../tile_size");
for(int src=0;src<count;src++)
{
    float w=prim(0,"width",src),d=prim(0,"depth",src),top=prim(0,"top_y",src);
    float e=prim(0,"eave",src),h=prim(0,"roof_h",src),curve=prim(0,"curve",src);
    float angle=prim(0,"rot_y",src);vector center=prim(0,"role_center",src);center.y=0.;
    matrix3 rot=ident();rotate(rot,radians(angle),set(0.,1.,0.));
    float hw=w*.5+e,hd=d*.5+e;
    if(!int(prim(0,"is_round",src)))
    {
        int steps=max(5,int(ceil(hw/max(tile,.16))));
        // Four planar curved gable-edge ribbons, extruded together in one SOP.
        if(!hipped)for(int end=0;end<2;end++)for(int side=0;side<2;side++)
        {
            float z=end==0 ? -hd-board*.22 : hd-board*.78;
            float sign=side==0 ? -1. : 1.;vector p[];
            for(int k=0;k<=steps;k++)
            {
                float q=float(k)/steps,x=sign*hw*q,y=top+h*(1.-q)+curve*pow(q,4.)+.015;
                append(p,set(x,y,z)*rot+center);
            }
            for(int k=steps;k>=0;k--)
            {
                float q=float(k)/steps,x=sign*hw*q,y=top+h*(1.-q)+curve*pow(q,4.)+.015-drop;
                append(p,set(x,y,z)*rot+center);
            }
            solid_profile(p,set(0.,0.,1.)*rot,board,"wood","roof_bargeboard",set(.205,.105,.045));
        }
        // Two straight eave boards share the same extrusion stream.
        for(int side=0;side<2;side++)
        {
            float x=side==0 ? -hw-board*.22 : hw-board*.78,y=top+curve+.015;
            vector p[]=array(set(x,y,-hd),set(x,y,hd),set(x,y-drop,hd),set(x,y-drop,-hd));
            for(int k=0;k<len(p);k++)p[k]=p[k]*rot+center;
            solid_profile(p,set(1.,0.,0.)*rot,board,"wood","roof_eave_board",set(.205,.105,.045));
        }
        if(hipped)for(int end=0;end<2;end++)
        {
            float z=end==0 ? -hd-board*.22 : hd-board*.78,y=top+curve+.015;
            vector p[]=array(set(-hw,y,z),set(hw,y,z),set(hw,y-drop,z),set(-hw,y-drop,z));
            for(int k=0;k<len(p);k++)p[k]=p[k]*rot+center;
            solid_profile(p,set(0.,0.,1.)*rot,board,"wood","roof_eave_board",set(.205,.105,.045));
        }
    }
    else
    {
        // A thin annulus supports the cone eave. Native extrusion supplies depth.
        int segments=48;float y=top+curve-drop;
        for(int k=0;k<segments;k++)
        {
            float a=2.*M_PI*k/segments,b=2.*M_PI*(k+1)/segments;
            vector p[]=array(set(hw*cos(a),y,hw*sin(a)),set(hw*cos(b),y,hw*sin(b)),
                             set((hw-board)*cos(b),y,(hw-board)*sin(b)),set((hw-board)*cos(a),y,(hw-board)*sin(a)));
            for(int j=0;j<len(p);j++)p[j]+=center;
            solid_profile(p,set(0.,1.,0.),drop,"wood","cone_eave_ring",set(.205,.105,.045));
        }
    }
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
