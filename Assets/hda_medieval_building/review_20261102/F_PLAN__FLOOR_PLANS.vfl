int original=nprimitives(0);
string floats[]=array("base_width","base_depth","base_h","floor_h","rot_y","roof_h","eave","curve","extra_h");
for(int src=0;src<original;src++){
 vector center=prim(0,"role_center",src);float w=prim(0,"base_width",src),d=prim(0,"base_depth",src);
 float b=prim(0,"base_h",src),fh=prim(0,"floor_h",src);int count=prim(0,"floor_count",src);
 int round=prim(0,"is_round",src);string role=prim(0,"role",src);
 int vertices[]=primpoints(0,src);
 for(int f=0;f<count;f++){
   float over=(f>0 && role=="main" && !round && chs("../footprint")=="rectangular")?ch("../upper_overhang_m"):0;
   float taper=round?ch("../tower_taper"):0,scale0=1-taper*float(f)/count,scale1=1-taper*float(f+1)/count;
   int pts[];
   foreach(int oldpt;vertices){vector p=point(0,"P",oldpt)-center;p.x*=(1+2*over/w)*scale0;p.z*=(1+2*over/d)*scale0;p+=center;p.y=b+f*fh;append(pts,addpoint(0,p));}
   int p=addprim(0,"poly",pts);
   foreach(string name;floats){float value=prim(0,name,src);setprimattrib(0,name,p,value);}
   setprimattrib(0,"role",p,role);setprimattrib(0,"role_id",p,int(prim(0,"role_id",src)));
   setprimattrib(0,"floor_count",p,count);setprimattrib(0,"is_round",p,round);
   int segments=prim(0,"round_segments",src);setprimattrib(0,"round_segments",p,segments);
   setprimattrib(0,"role_center",p,center);setprimattrib(0,"floor_i",p,f);
   setprimattrib(0,"floor_b",p,b+f*fh);setprimattrib(0,"width",p,(w+2*over)*scale0);setprimattrib(0,"depth",p,(d+2*over)*scale0);
   setprimattrib(0,"top_width",p,(w+2*over)*scale1);setprimattrib(0,"top_depth",p,(d+2*over)*scale1);
   setprimattrib(0,"inset_distance",p,round?w*.5*(scale0-scale1)*cos(M_PI/max(3,segments)):0.);
   setprimattrib(0,"level_key",p,role+"_"+itoa(f));
   float height=fh+(f==count-1?float(prim(0,"extra_h",src)):0.);
   setprimattrib(0,"extrude_distance",p,height);
   foreach(int pt;pts)setpointattrib(0,"extrude_direction",pt,set(0,1,0));
 }
}
for(int p=original-1;p>=0;p--)removeprim(0,p,1);
