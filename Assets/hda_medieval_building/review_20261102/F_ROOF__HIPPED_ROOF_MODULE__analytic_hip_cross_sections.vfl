
int old=nprimitives(0);
if(chs("../../roof_shape")=="hipped")for(int src=0;src<old;src++)
{
    if(int(prim(0,"is_round",src)))continue;
    float w=prim(0,"width",src),d=prim(0,"depth",src),e=prim(0,"eave",src);
    float top=prim(0,"top_y",src),h=prim(0,"roof_h",src),curve=prim(0,"curve",src);
    float angle=prim(0,"rot_y",src);vector center=prim(0,"role_center",src);center.y=0.;
    int rid=prim(0,"role_id",src);string role=prim(0,"role",src);
    matrix3 rot=ident();rotate(rot,radians(angle),set(0.,1.,0.));
    float hw=w*.5+e,hd=d*.5+e,tipx=.0175,tipz=max(.0175,(d-w)*.5);
    int steps=max(4,int(ceil(sqrt(hw*hw+h*h)/max(.16,ch("../../tile_size_m")))));
    for(int j=0;j<=steps;j++)
    {
        float t=float(j)/steps,q=1.-t;
        float x=lerp(hw,tipx,t),z=lerp(hd,tipz,t),y=top+h*t+curve*pow(q,4.);
        vector p[]=array(set(-x,y,-z),set(x,y,-z),set(x,y,z),set(-x,y,z));
        int pts[];
        foreach(vector position;p)
        {
            int pt=addpoint(0,position*rot+center);append(pts,pt);
            setpointattrib(0,"roof_role",pt,rid,"set");
            setpointattrib(0,"roof_role_name",pt,role,"set");
        }
        int pr=addprim(0,"poly",pts);
        setprimattrib(0,"role_id",pr,rid,"set");setprimattrib(0,"hip_top_cap",pr,0,"set");
        setprimgroup(0,"hip_role_"+itoa(rid),pr,1);
        if(j==steps)
        {
            // A narrow final top quad closes the 35mm ridge rather than leaving a slit.
            int cap=addprim(0,"poly",pts);
            setprimattrib(0,"role_id",cap,rid,"set");setprimattrib(0,"hip_top_cap",cap,1,"set");
        }
    }
}
for(int p=old-1;p>=0;p--)removeprim(0,p,1);
