
setdetailattrib(0,"bay_opening_id",string(detail(1,"bay_opening_id")),"set");
for(int pr=0;pr<nprimitives(0);pr++)
{
    setprimattrib(0,"component",pr,"attachments","set");
    string name=prim(0,"name",pr),material=prim(0,"material_family",pr);
    if(name=="")
    {
        setprimattrib(0,"name",pr,"attachments/main/cupola_conical_cap","set");
        setprimattrib(0,"material_family",pr,"tile","set");setprimattrib(0,"Cd",pr,set(.76,.24,.105),"set");
    }
    else if(material=="cut")
    {
        setprimattrib(0,"name",pr,"attachments/main/bay_aperture_reveal","set");
        setprimattrib(0,"material_family",pr,"plaster","set");setprimattrib(0,"Cd",pr,set(.88,.81,.64),"set");
    }
}
