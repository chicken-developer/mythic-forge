
string furnishing_style()
{
    string style=chs("../interior_style");
    if(style!="auto")return style;
    string utility=chs("../utility_type");
    if(utility=="windmill" || utility=="waterwheel")return "mill";
    return chi("../workshop_enable") ? "workshop" : "home";
}

vector worldpos(vector p; vector center; float angle)
{
    matrix3 rot=ident();rotate(rot,radians(angle),set(0.,1.,0.));
    center.y=0.;return p*rot+center;
}

int clear_of_stairs(vector p;vector size;int pr)
{
    float t=ch("../wall_thickness"),sw=ch("../stair_width");
    float w=prim(0,"width",pr),d=prim(0,"depth",pr),bw=prim(0,"base_width",pr),bd=prim(0,"base_depth",pr);
    int f=prim(0,"floor_i",pr);
    if(int(prim(0,"is_round",pr)))
    {
        float outer=w*.5-t-.035,hole=f>0 ? min(.98,outer*.57)+.035 : 0.;
        vector near=set(max(0.,abs(p.x)-size.x*.5),0.,max(0.,abs(p.z)-size.z*.5));
        vector far=set(abs(p.x)+size.x*.5,0.,abs(p.z)+size.z*.5);
        return length(far)<outer && length(near)>=hole;
    }
    if(abs(p.x)+size.x*.5>w*.5-t-.02 || abs(p.z)+size.z*.5>d*.5-t-.02)return 0;
    float xhi=bw*.5-t,xlo=xhi-(2.*sw+.16),zhi=bd*.5-t-.10;
    float run=min(1.9,bd-2.*t-1.35),zlo=zhi-run-sw;
    return p.x+size.x*.5<=xlo-.035 || p.x-size.x*.5>=xhi+.035 ||
           p.z+size.z*.5<=zlo-.035 || p.z-size.z*.5>=zhi+.035;
}

void part(vector p;vector size;int pr;string label;string material;vector color;int external)
{
    if(min(size)<.005 || (!external && !clear_of_stairs(p,size,pr)))return;
    vector center=prim(0,"role_center",pr);float angle=prim(0,"rot_y",pr);
    matrix3 transform=ident();scale(transform,size);rotate(transform,radians(angle),set(0.,1.,0.));
    int pt=addpoint(0,worldpos(p,center,angle));
    string role=prim(0,"role",pr);int f=prim(0,"floor_i",pr);
    setpointattrib(0,"transform",pt,transform,"set");
    setpointattrib(0,"part_name",pt,(external?"dressing/":"furnishing/")+role+"/floor_"+itoa(f)+"/"+label,"set");
    setpointattrib(0,"part_material",pt,material,"set");setpointattrib(0,"part_color",pt,color,"set");
    setpointattrib(0,"part_component",pt,external?"dressing":"furnishing","set");
    setpointattrib(0,"role",pt,role,"set");setpointattrib(0,"role_id",pt,int(prim(0,"role_id",pr)),"set");
    setpointattrib(0,"floor_i",pt,f,"set");
    setpointattrib(0,"interior_style",pt,furnishing_style(),"set");
}

void table(vector p;float width;float depth;int pr)
{
    vector wood=set(.29,.17,.075);
    part(p+set(0.,.76,0.),set(width,.10,depth),pr,"table_top","wood",wood,0);
    for(int a=0;a<2;a++)for(int b=0;b<2;b++)
        part(p+set((a-.5)*(width-.18),.36,(b-.5)*(depth-.18)),set(.09,.72,.09),pr,"table_leg","wood",wood,0);
    for(int side=0;side<2;side++)
    {
        vector stool=p+set(0.,0.,(side==0?-1.:1.)*(depth*.5+.35));
        part(stool+set(0.,.43,0.),set(.36,.08,.32),pr,"stool_seat","wood",wood,0);
        for(int a=0;a<2;a++)for(int b=0;b<2;b++)
            part(stool+set((a-.5)*.24,.20,(b-.5)*.20),set(.065,.40,.065),pr,"stool_leg","wood",wood,0);
    }
}

void shelf(vector p;float width;int pr)
{
    if(chs("../detail_level")=="low")return;
    vector wood=set(.25,.145,.065);
    for(int side=0;side<2;side++)part(p+set((side-.5)*(width-.075),.73,0.),set(.075,1.46,.30),pr,"shelf_upright","wood",wood,0);
    for(int k=0;k<3;k++)part(p+set(0.,.22+k*.52,0.),set(width,.065,.30),pr,"shelf_board","wood",wood,0);
    part(p+set(-width*.19,.41,0.),set(width*.31,.30,.24),pr,"storage_box","wood",set(.38,.25,.12),0);
    part(p+set(width*.20,.96,0.),set(width*.25,.34,.23),pr,"stored_linen","canvas",set(.55,.62,.56),0);
}

void bed(vector p;float width;float length;int pr)
{
    vector wood=set(.24,.135,.06);
    part(p+set(0.,.34,0.),set(width,.12,length),pr,"bed_frame","wood",wood,0);
    for(int a=0;a<2;a++)for(int b=0;b<2;b++)
        part(p+set((a-.5)*(width-.13),.16,(b-.5)*(length-.15)),set(.10,.32,.10),pr,"bed_leg","wood",wood,0);
    part(p+set(0.,.49,0.),set(width-.07,.18,length-.08),pr,"bed_mattress","sail",set(.78,.73,.57),0);
    if(chs("../detail_level")!="low")
    {
        part(p+set(0.,.59,length*.13),set(width-.045,.065,length*.65),pr,"bed_blanket","canvas",set(.20,.42,.43),0);
        part(p+set(0.,.62,-length*.33),set(width-.18,.13,length*.20),pr,"bed_pillow","sail",set(.86,.82,.69),0);
    }
    part(p+set(0.,.67,-length*.5+.035),set(width,.63,.075),pr,"bed_headboard","wood",wood,0);
}

void lantern(vector p;int pr;int external)
{
    vector iron=set(.075,.075,.065);
    part(p,set(.16,.25,.16),pr,"lantern_glow","light",set(1.,.67,.24),external);
    for(int k=0;k<2;k++)part(p+set(0.,(k-.5)*.31,0.),set(.23,.055,.23),pr,"lantern_cap","metal",iron,external);
    if(chs("../detail_level")!="low")for(int a=0;a<2;a++)for(int b=0;b<2;b++)
            part(p+set((a-.5)*.18,0.,(b-.5)*.18),set(.027,.29,.027),pr,"lantern_frame","metal",iron,external);
    part(p+set(0.,.31,0.),set(.025,.25,.025),pr,"lantern_hanger","metal",iron,external);
}

void workbench(vector p;float width;int pr)
{
    vector wood=set(.28,.17,.075);
    part(p+set(0.,.86,0.),set(width,.13,.64),pr,"workshop_bench_top","wood",wood,0);
    for(int a=0;a<2;a++)for(int b=0;b<2;b++)
        part(p+set((a-.5)*(width-.16),.40,(b-.5)*.48),set(.11,.80,.11),pr,"workshop_bench_leg","wood",wood,0);
    part(p+set(0.,.24,0.),set(width-.13,.085,.48),pr,"workshop_bench_shelf","wood",wood,0);
    part(p+set(-width*.24,.40,0.),set(width*.32,.26,.40),pr,"tool_storage_box","wood",set(.39,.26,.12),0);
}

void toolrack(vector p;float width;int pr)
{
    part(p+set(0.,1.24,0.),set(width,.14,.08),pr,"workshop_tool_rack","wood",set(.27,.16,.07),0);
    if(chs("../detail_level")=="low")return;
    for(int k=0;k<4;k++)
    {
        float x=width*(k-1.5)/4.;
        part(p+set(x,.97,-.07),set(.045,.56,.045),pr,"tool_handle_"+itoa(k),"wood",set(.38,.25,.12),0);
        part(p+set(x,1.28,-.07),set(.21,.13,.07),pr,"tool_head_"+itoa(k),"metal",set(.17,.18,.17),0);
    }
}

void innbar(vector p;float width;int pr)
{
    part(p+set(0.,1.02,0.),set(width,.12,.48),pr,"inn_bar_top","wood",set(.32,.18,.075),0);
    part(p+set(0.,.48,-.15),set(width-.12,.96,.10),pr,"inn_bar_front","wood",set(.25,.14,.06),0);
    for(int k=0;k<2;k++)part(p+set((k-.5)*(width-.18),.48,0.),set(.12,.96,.40),pr,"inn_bar_support","wood",set(.25,.14,.06),0);
    if(chs("../detail_level")!="low")for(int k=0;k<3;k++)
        part(p+set(width*(k-1)/4.,1.15,0.),set(.10,.16,.10),pr,"inn_bar_cup_"+itoa(k),"stone",set(.48,.39,.28),0);
}

void flourstore(vector p;float width;int pr)
{
    part(p+set(0.,.15,0.),set(width,.28,.52),pr,"mill_storage_box","wood",set(.35,.22,.10),0);
    int count=max(1,int(floor(width/.40)));
    for(int k=0;k<count;k++)
        part(p+set(-width*.5+(k+.5)*width/count,.58,0.),set(min(.36,width/count-.025),.58,.40),pr,"mill_flour_sack_"+itoa(k),"sail",set(.74,.68,.49),0);
}

int count=nprimitives(0);float t=ch("../wall_thickness"),th=ch("../floor_thickness"),sw=ch("../stair_width");
string style=furnishing_style();
for(int pr=0;pr<count;pr++)
{
    string role=prim(0,"role",pr);int f=prim(0,"floor_i",pr),rounded=prim(0,"is_round",pr);
    float w=prim(0,"width",pr),d=prim(0,"depth",pr),bw=prim(0,"base_width",pr);
    float y=prim(0,"floor_b",pr)+th,fh=prim(0,"floor_h",pr);
    float xl=-w*.5+t+.04,zl=-d*.5+t+.04,zr=d*.5-t-.04;
    float xhi=bw*.5-t,xlo=xhi-(2.*sw+.16),free_width=xlo-xl-.12;
    if(chi("../enable"))
    {
        if(chi("../furniture"))
        {
            if(!rounded && free_width>.45)
            {
                float width=min(1.1,free_width-.12),x=xl+width*.5+.06;
                if(style=="workshop")
                {
                    float benchwidth=min(1.8,free_width-.12),cx=xl+benchwidth*.5+.06;
                    workbench(set(cx,y,-.20),benchwidth,pr);
                    toolrack(set(cx,y,zr-.12),benchwidth,pr);
                }
                else if(style=="mill")
                {
                    float storewidth=min(1.6,free_width-.12),cx=xl+storewidth*.5+.06;
                    flourstore(set(cx,y,zr-.38),storewidth,pr);
                    if(f==0)
                    {
                        float stonewidth=min(1.,free_width-.16),sx=xl+stonewidth*.5+.08;
                        part(set(sx,y+.20,-.35),set(stonewidth*.75,.40,stonewidth*.75),pr,"mill_grindstone_pedestal","wood",set(.28,.17,.075),0);
                        part(set(sx,y+.84,-.35),set(.42,.48,.42),pr,"mill_hopper","wood",set(.39,.25,.11),0);
                    }
                    else flourstore(set(cx,y,zl+.38),storewidth,pr);
                }
                else if(style=="inn")
                {
                    if(f==0)
                    {
                        float barwidth=min(1.8,free_width-.12),cx=xl+barwidth*.5+.06;
                        innbar(set(cx,y,zl+.50),barwidth,pr);
                        table(set(x,y,.55),width,.70,pr);
                        shelf(set(x,y,zr-.18),width,pr);
                    }
                    else
                    {
                        float bw=min(.85,free_width-.12);
                        bed(set(xl+bw*.5+.06,y,zr-1.02),bw,1.88,pr);
                        if(free_width>2.)bed(set(xl+bw*1.5+.23,y,zr-1.02),bw,1.88,pr);
                        table(set(x,y,zl+.70),min(.70,width),.45,pr);
                    }
                }
                else if(f==0)
                {
                    table(set(x,y,-.35),width,.70,pr);
                    shelf(set(x,y,zr-.18),width,pr);
                }
                else
                {
                    bed(set(x,y,zr-1.02),width,1.88,pr);
                    shelf(set(x,y,zl+.18),width,pr);
                }
            }
            else if(rounded)
            {
                float outer=w*.5-t-.09;
                float cx=-outer*.62,width=min(.9,outer*.48);
                if(style=="mill")
                {
                    flourstore(set(cx,y,outer*.45),width,pr);
                    if(f==0)part(set(cx,y+.20,-.35),set(width*.75,.40,width*.75),pr,"mill_grindstone_pedestal","wood",set(.28,.17,.075),0);
                }
                else if(style=="workshop")
                {
                    workbench(set(cx,y,0.),width,pr);
                    toolrack(set(cx,y,outer*.40),width,pr);
                }
                else if(style=="inn" && f==0)
                {
                    innbar(set(cx,y,-outer*.35),width,pr);
                    table(set(cx,y,outer*.35),min(.70,width),.45,pr);
                }
                else if(f==0)table(set(cx,y,0.),width,.70,pr);
                else if(outer>1.6)bed(set(-outer*.73,y,0.),.65,1.15,pr);
            }
        }
        if(chi("../partitions") && !rounded && f>0 && free_width>1.3)
        {
            float left=xl,right=xlo-.12,door=.85,end=right-door,head=min(2.05,fh-.30),top=fh-.18;
            part(set((left+end)*.5,y+head*.5,-.35),set(end-left,head,.10),pr,"partition_wall","plaster",set(.88,.81,.65),0);
            part(set((left+right)*.5,y+(head+top)*.5,-.35),set(right-left,top-head,.10),pr,"partition_header","plaster",set(.88,.81,.65),0);
            for(int k=0;k<2;k++)part(set(k==0?end:right,y+head*.5,-.35),set(.065,head,.15),pr,"partition_door_jamb","wood",set(.25,.14,.065),0);
        }
        if(chi("../lighting"))
        {
            float x=rounded ? -(w*.5-t-.09)*.70 : xl+.43;
            lantern(set(x,y+fh-.62,0.),pr,0);
        }
    }
    if(chi("../dressing") && role=="main" && f==0)
    {
        lantern(set(-bw*.34,y+1.80,-d*.5-.20),pr,1);
        part(set(-bw*.34,y+2.24,-d*.5-.10),set(.055,.055,.25),pr,"lantern_wall_bracket","metal",set(.075,.075,.065),1);
        if(chs("../detail_level")!="low")
        {
            vector p=set(bw*.30,float(prim(0,"base_h",pr))+.035,-d*.5-.42);
            part(p,set(.72,.07,.40),pr,"planter_base","wood",set(.25,.15,.07),1);
            for(int k=0;k<2;k++)part(p+set(0.,.14,(k-.5)*.36),set(.72,.28,.05),pr,"planter_side","wood",set(.25,.15,.07),1);
            for(int k=0;k<2;k++)part(p+set((k-.5)*.67,.14,0.),set(.05,.28,.32),pr,"planter_end","wood",set(.25,.15,.07),1);
            part(p+set(0.,.29,0.),set(.60,.18,.29),pr,"planter_leaves","leaf",set(.26,.43,.16),1);
        }
    }
}
for(int pr=count-1;pr>=0;pr--)removeprim(0,pr,1);
