
vector worldpos(vector p; vector center; float angle)
{
    float c=cos(radians(angle)),s=sin(radians(angle));
    return set(center.x+c*p.x+s*p.z,p.y,center.z-s*p.x+c*p.z);
}

void rectprofile(float xa;float xb;float za;float zb;float y;float depth;
                 vector center;float angle;string part;string role;int rid;int level)
{
    if(xb-xa<.005 || zb-za<.005) return;
    // The source profile faces -Y. Its back cap becomes the walking surface.
    vector p[]=array(set(xa,y,za),set(xa,y,zb),set(xb,y,zb),set(xb,y,za));
    int poly=addprim(0,"poly");
    foreach(vector pos;p)
    {
        int pt=addpoint(0,worldpos(pos,center,angle));addvertex(0,poly,pt);
        setpointattrib(0,"extrude_direction",pt,set(0.,-1.,0.),"set");
    }
    setprimattrib(0,"extrude_distance",poly,depth,"set");
    setprimattrib(0,"name",poly,part,"set");
    setprimattrib(0,"material_family",poly,"wood","set");
    setprimattrib(0,"Cd",poly,set(.27,.19,.12),"set");
    setprimattrib(0,"role",poly,role,"set");
    setprimattrib(0,"role_id",poly,rid,"set");
    setprimattrib(0,"floor_i",poly,level,"set");
    setprimattrib(0,"component",poly,"interior","set");
}

void plankrect(float xa;float xb;float za;float zb;float y;float depth;
               vector center;float angle;string prefix;string role;int rid;int level)
{
    if(xb-xa<.005 || zb-za<.005) return;
    int count=max(1,int(ceil((xb-xa)/.28)));
    for(int i=0;i<count;i++)
    {
        float a=lerp(xa,xb,float(i)/count),b=lerp(xa,xb,float(i+1)/count);
        rectprofile(a+.0015,b-.0015,za,zb,y,depth,center,angle,
                    prefix+"_board_"+itoa(i),role,rid,level);
    }
}

void member(vector position;vector size;vector center;float angle;
            string part;string material;vector color;string role;int rid;int level)
{
    if(min(size)<.001) return;
    float a=radians(angle);vector x=set(cos(a),0.,-sin(a)),z=set(sin(a),0.,cos(a));
    int pt=addpoint(0,worldpos(position,center,angle));
    matrix3 transform=set(x*size.x,set(0.,size.y,0.),z*size.z);
    setpointattrib(0,"transform",pt,transform,"set");
    setpointattrib(0,"part_name",pt,part,"set");
    setpointattrib(0,"part_material",pt,material,"set");
    setpointattrib(0,"part_color",pt,color,"set");
    setpointattrib(0,"role",pt,role,"set");setpointattrib(0,"role_id",pt,rid,"set");
    setpointattrib(0,"floor_i",pt,level,"set");
}

void beam(vector start;vector end;float width;float depth;vector center;float angle;
          string part;string role;int rid;int level)
{
    vector a=worldpos(start,center,angle),b=worldpos(end,center,angle);
    vector along=normalize(b-a),ref=abs(along.y)<.95?set(0.,1.,0.):set(1.,0.,0.);
    vector x=normalize(cross(along,ref)),z=cross(x,along);
    matrix3 transform=set(x*width,along*distance(a,b),z*depth);
    int pt=addpoint(0,(a+b)*.5);
    setpointattrib(0,"transform",pt,transform,"set");
    setpointattrib(0,"part_name",pt,part,"set");
    setpointattrib(0,"part_material",pt,"wood","set");
    setpointattrib(0,"part_color",pt,set(.27,.19,.12),"set");
    setpointattrib(0,"role",pt,role,"set");setpointattrib(0,"role_id",pt,rid,"set");
    setpointattrib(0,"floor_i",pt,level,"set");
}

int count=nprimitives(0);
float t=ch("../wall_thickness"),th=ch("../floor_thickness"),sw=ch("../stair_width"),spacing=ch("../joist_spacing");
if(chi("../enable"))for(int pr=0;pr<count;pr++)
{
    string role=prim(0,"role",pr);int rid=prim(0,"role_id",pr),f=prim(0,"floor_i",pr),levels=prim(0,"floor_count",pr);
    float w=prim(0,"width",pr),d=prim(0,"depth",pr),bw=prim(0,"base_width",pr),bd=prim(0,"base_depth",pr);
    float y=prim(0,"floor_b",pr),fh=prim(0,"floor_h",pr),angle=prim(0,"rot_y",pr);
    int round=prim(0,"is_round",pr);vector center=prim(0,"role_center",pr);
    string prefix="interior/"+role+"/floor_"+itoa(f);
    if(round)
    {
        float outer=max(.2,w*.5-t-.03),hole=min(.98,outer*.57);
        if(f>0)for(int j=0;j<8;j++)
        {
            float a=2*M_PI*j/8;
            beam(set((hole+.06)*cos(a),y-.10,(hole+.06)*sin(a)),set((outer-.07)*cos(a),y-.10,(outer-.07)*sin(a)),.14,.14,center,angle,prefix+"_radial_joist_"+itoa(j),role,rid,f);
        }
        if(f<levels-1)
        {
            member(set(0,y+fh*.5,0),set(.16,fh,.16),center,angle,prefix+"_spiral_post","wood",set(.27,.19,.12),role,rid,f);
            int steps=max(14,int(ceil(fh/.18)));vector previous=0;
            for(int j=0;j<steps;j++)
            {
                float a=-M_PI*.5+2*M_PI*(j+1)/steps,h=y+th+(j+1)*fh/steps;
                vector foot=set((hole-.025)*cos(a),h,(hole-.025)*sin(a)),top=foot+set(0.,.9,0.);
                beam(foot,top,.035,.035,center,angle,prefix+"_spiral_baluster_"+itoa(j),role,rid,f);
                if(j>0)beam(previous,top,.05,.05,center,angle,prefix+"_spiral_rail_"+itoa(j),role,rid,f);
                previous=top;
            }
        }
        if(f>0)for(int j=2;j<30;j++)
        {
            float a=-M_PI*.5+2*M_PI*j/32,b=-M_PI*.5+2*M_PI*(j+1)/32;
            vector p=set(hole*cos(a),y+1,hole*sin(a)),q=set(hole*cos(b),y+1,hole*sin(b));
            beam(p,q,.05,.05,center,angle,prefix+"_void_guard_"+itoa(j),role,rid,f);
            beam(p-set(0.,.92,0.),p,.04,.04,center,angle,prefix+"_void_baluster_"+itoa(j),role,rid,f);
        }
        continue;
    }
    float xl=-w*.5+t,xr=w*.5-t,zl=-d*.5+t,zr=d*.5-t;
    float x1=bw*.5-t,x0=x1-(2*sw+.16),z1=bd*.5-t-.10,run=min(1.9,bd-2*t-1.35),z0=z1-run-sw;
    if(f>0)
    {
        vector rectangles[]=array(set(xl,x0,zl),set(xr,zr,0),set(x1,xr,zl),set(xr,zr,0),set(x0,x1,zl),set(xr,z0,0),set(x0,x1,z1),set(xr,zr,0));
        for(int r=0;r<4;r++)
        {
            vector a=rectangles[r*2],b=rectangles[r*2+1];float xa=a.x,xb=a.y,za=a.z,zb=b.y;
            if(xb-xa<.005 || zb-za<.005)continue;
            int n=max(1,int(ceil((zb-za)/spacing)));
            for(int j=0;j<n;j++)member(set((xa+xb)*.5,y-.10,lerp(za,zb,(j+.5)/n)),set(xb-xa,.20,.12),center,angle,prefix+"_joist_"+itoa(r)+"_"+itoa(j),"wood",set(.27,.19,.12),role,rid,f);
        }
    }
    if(f<levels-1 && run>.20 && x0>xl-.001 && z0>zl-.001)
    {
        int n=max(7,int(ceil(fh/.36)));float rise=fh/(2*n),tread=run/n;
        for(int flight=0;flight<2;flight++)
        {
            float x=flight==0?x0+sw*.5:x1-sw*.5;
            for(int j=0;j<n;j++)
            {
                float z=flight==0?z0+(j+.5)*tread:z0+run-(j+.5)*tread;
                float top=y+th+(j+1+flight*n)*rise;
                member(set(x,top-.045,z),set(sw,.09,tread+.008),center,angle,prefix+"_stair_tread_"+itoa(flight)+"_"+itoa(j),"wood",set(.27,.19,.12),role,rid,f);
            }
            float za=flight==0?z0:z0+run,zb=flight==0?z0+run:z0;
            float ya=y+th+flight*fh*.5,yb=ya+fh*.5;
            int signs[]=array(-1,1);foreach(int sign;signs)
            {
                float dx=sign*(sw*.5-.06);
                beam(set(x+dx,ya-.12,za),set(x+dx,yb-.12,zb),.12,.12,center,angle,prefix+"_stringer_"+itoa(flight)+"_"+itoa(sign),role,rid,f);
                dx=sign*(sw*.5-.025);
                beam(set(x+dx,ya+.9,za),set(x+dx,yb+.9,zb),.055,.055,center,angle,prefix+"_handrail_"+itoa(flight)+"_"+itoa(sign),role,rid,f);
                for(int j=0;j<4;j++)
                {
                    float q=j/3.;vector foot=set(x+dx,lerp(ya,yb,q),lerp(za,zb,q));
                    beam(foot,foot+set(0.,.9,0.),.045,.045,center,angle,prefix+"_baluster_"+itoa(flight)+"_"+itoa(sign)+"_"+itoa(j),role,rid,f);
                }
            }
        }
        member(set((x0+x1)*.5,y+th+fh*.5-.05,z0+run+sw*.5),set(x1-x0,.10,sw),center,angle,prefix+"_midlanding","wood",set(.27,.19,.12),role,rid,f);
    }
    if(f>0)
    {
        vector edges[]=array(set(x0,y+1,z0),set(x0,y+1,z1),set(x0,y+1,z1),set(x1,y+1,z1),set(x1,y+1,z1),set(x1,y+1,z0));
        for(int side=0;side<3;side++)
        {
            vector a=edges[side*2],b=edges[side*2+1];
            beam(a,b,.065,.065,center,angle,prefix+"_void_guard_"+itoa(side),role,rid,f);
            int n=max(1,int(ceil(distance(a,b)/.35)));
            for(int j=0;j<=n;j++){vector top=lerp(a,b,float(j)/n);beam(top-set(0.,.92,0.),top,.045,.045,center,angle,prefix+"_void_baluster_"+itoa(side)+"_"+itoa(j),role,rid,f);}
        }
    }
}
for(int pr=count-1;pr>=0;pr--)removeprim(0,pr,1);
