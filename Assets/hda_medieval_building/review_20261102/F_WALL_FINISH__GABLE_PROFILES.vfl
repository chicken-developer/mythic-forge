int count=nprimitives(0);
for(int src=0;src<count;src++){
 if(int(prim(0,"is_round",src)) || chs("../roof_shape")=="hipped")continue;
 vector center=prim(0,"role_center",src);float top=prim(0,"top_y",src),w=prim(0,"width",src),d=prim(0,"depth",src),e=prim(0,"eave",src);
 float h=prim(0,"roof_h",src),curve=prim(0,"curve",src),angle=prim(0,"rot_y",src);matrix3 rot=ident();rotate(rot,radians(angle),{0,1,0});
 int n=max(8,int(ceil(w/ch("../tile_size_m"))));n+=n%2;
 for(int end=0;end<2;end++){
   int pts[];float z=(end?1:-1)*d/2;
   append(pts,addpoint(0,set(-w/2,top,z)*rot+center));append(pts,addpoint(0,set(w/2,top,z)*rot+center));
   for(int i=n;i>=0;i--){float x=-w/2+w*i/n,q=abs(x)/(w/2+e);float y=top+h*(1-q)+curve*pow(q,4)-.13;append(pts,addpoint(0,set(x,y,z)*rot+center));}
   if(!end)pts=reverse(pts);int p=addprim(0,"poly",pts);
   vector dir=set(0,0,end?-1:1)*rot;foreach(int pt;pts)setpointattrib(0,"extrude_direction",pt,dir);
   setprimattrib(0,"extrude_distance",p,float(ch("../wall_thickness_m")));setprimattrib(0,"material_family",p,"plaster");setprimattrib(0,"name",p,"gable_"+itoa(src)+"_"+itoa(end));setprimattrib(0,"Cd",p,set(.9,.82,.63));
 }
 // Raised eaves need thin side closure strips at the two long wall tops.
 float q=(w/2)/(w/2+e),height=h*(1-q)+curve*pow(q,4)-.13;
 for(int side=0;side<2;side++){
   float x=(side?1:-1)*w/2;vector pnts[]=array(set(x,top,-d/2),set(x,top,d/2),set(x,top+height,d/2),set(x,top+height,-d/2));
   if(side)pnts=reverse(pnts);int pts[];foreach(vector v;pnts)append(pts,addpoint(0,v*rot+center));int p=addprim(0,"poly",pts);
   foreach(int pt;pts)setpointattrib(0,"extrude_direction",pt,set(side?-1:1,0,0)*rot);
   setprimattrib(0,"extrude_distance",p,float(ch("../wall_thickness_m")));setprimattrib(0,"material_family",p,"plaster");setprimattrib(0,"name",p,"eave_closure_"+itoa(src)+"_"+itoa(side));setprimattrib(0,"Cd",p,set(.9,.82,.63));
 }
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
