
int old=npoints(0);int markers[]=expandpointgroup(0,"cupola_datum");
foreach(int marker;markers)
{
    vector center=point(0,"P",marker);float angle=point(0,"role_angle",marker);
    for(int ring=0;ring<2;ring++)
    {
        int pr=addprim(0,"poly");float radius=ring==0?.78:.025,y=ring==0?.57:1.24;
        for(int k=0;k<8;k++)
        {
            float a=2.*M_PI*k/8.-radians(angle);int pt=addpoint(0,center+set(radius*cos(a),y,radius*sin(a)));addvertex(0,pr,pt);
            setpointattrib(0,"extrude_direction",pt,set(0.,-1.,0.),"set");
        }
        setprimattrib(0,"extrude_distance",pr,.08,"set");setprimattrib(0,"material_family",pr,"tile","set");
        setprimattrib(0,"name",pr,"attachments/main/cupola_conical_cap","set");setprimattrib(0,"Cd",pr,set(.76,.24,.105),"set");
    }
}
for(int pt=old-1;pt>=0;pt--)removepoint(0,pt);
