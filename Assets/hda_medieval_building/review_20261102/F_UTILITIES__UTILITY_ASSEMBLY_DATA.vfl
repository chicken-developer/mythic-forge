
string kind=chs("../utility_type");
int original=nprimitives(0);
for(int pr=0;pr<original;pr++)
{
    string role=prim(0,"role",pr);
    if(role!="main" || kind=="none") continue;
    if(kind=="windmill" && !int(prim(0,"is_round",pr))) continue;
    vector center=prim(0,"role_center",pr);
    float w=prim(0,"base_width",pr),d=prim(0,"base_depth",pr);
    float base=prim(0,"base_h",pr),fh=prim(0,"floor_h",pr);
    int floors=prim(0,"floor_count",pr);
    float roof=prim(0,"roof_h",pr),angle=prim(0,"rot_y",pr);
    matrix3 m=ident();rotate(m,radians(angle),set(0.,1.,0.));
    vector local;
    if(kind=="windmill")
    {
        float total=max(floors,1)*fh+roof;
        local=set(0.,base+.65*total,-d*.5-.70);
    }
    else if(kind=="waterwheel")
    {
        float radius=max(ch("../wheel_radius_m"),.3);
        float y=base+radius*(chs("../context_mode")=="water_channel" ? .78 : 1.)+.02;
        local=set(w*.5+.55+radius*.12,y,.15);
    }
    else continue;
    vector horizontal=set(local.x,0.,local.z)*m;
    int pt=addpoint(0,set(center.x+horizontal.x,local.y,center.z+horizontal.z));
    setpointattrib(0,"transform",pt,m,"set");
    setpointattrib(0,"role",pt,role,"set");
    setpointattrib(0,"role_id",pt,int(prim(0,"role_id",pr)),"set");
    setpointattrib(0,"utility_type",pt,kind,"set");
    setpointgroup(0,kind,pt,1);
    break;
}
for(int pr=original-1;pr>=0;pr--) removeprim(0,pr,1);
