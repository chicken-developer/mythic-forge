
int profile(vector positions[]; string material; string part; vector color; float depth)
{
    int prim = addprim(0, "poly");
    // Houdini's polygon convention is clockwise viewed from its normal.
    // The profile faces +Z, extrusion goes into the wall, and its back cap
    // becomes the visible exterior surface facing -Z.
    for (int i=len(positions)-1; i>=0; i--)
    {
        int pt = addpoint(0, positions[i]);
        addvertex(0, prim, pt);
        setpointattrib(0, "extrude_direction", pt, set(0.,0.,1.), "set");
    }
    setprimattrib(0, "extrude_distance", prim, depth, "set");
    setprimattrib(0, "name", prim, part, "set");
    setprimattrib(0, "material_family", prim, material, "set");
    setprimattrib(0, "Cd", prim, color, "set");
    return prim;
}

void rectangle(float x0; float y0; float x1; float y1; float z;
               string material; string part; vector color; float depth)
{
    vector p[] = array(set(x0,y0,z),set(x1,y0,z),set(x1,y1,z),set(x0,y1,z));
    profile(p, material, part, color, depth);
}

function vector[] clip_x(vector polygon[];float boundary;int keep_greater)
{
    vector result[];
    if(len(polygon)==0)return result;
    vector previous=polygon[len(polygon)-1];
    int previous_in=keep_greater ? previous.x>=boundary : previous.x<=boundary;
    foreach(vector current;polygon)
    {
        int current_in=keep_greater ? current.x>=boundary : current.x<=boundary;
        if(current_in!=previous_in)
        {
            float t=(boundary-previous.x)/(current.x-previous.x);
            append(result,lerp(previous,current,t));
        }
        if(current_in)append(result,current);
        previous=current;previous_in=current_in;
    }
    return result;
}

vector lo,hi;getbbox(0,lo,hi);float w=hi.x-lo.x;
int ids[]=primpoints(0,0);vector outline[];
for(int i=len(ids)-1;i>=0;i--)
{
    vector p=point(0,"P",ids[i]);
    p.y+=abs(p.y-lo.y)<1e-5 ? .012 : -.008;
    p.z=-.035;append(outline,p);
}
int count=max(4,int(ceil(w/.18)));
for(int i=0;i<count;i++)
{
    float x0=lo.x+w*float(i)/count+.006;
    float x1=lo.x+w*float(i+1)/count-.006;
    vector left[]=clip_x(outline,x0,1);vector p[]=clip_x(left,x1,0);
    float tint=.94+.07*float(i%3)/2.;
    if(len(p)>=3)profile(p,"wood","door_plank_"+itoa(i),set(.32,.23,.14)*tint,.065);
}
removeprim(0,0,1);
