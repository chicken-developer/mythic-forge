void part(vector p;vector u;vector n;vector size;string name;string material){
 int pt=addpoint(0,p);matrix3 m=set(u*size.x,set(0,1,0)*size.y,-n*size.z);
 setpointattrib(0,"transform",pt,m);setpointattrib(0,"part_name",pt,name);
 setpointattrib(0,"part_material",pt,material);setpointattrib(0,"part_color",pt,material=="stone"?set(.55,.52,.44):set(.12,.28,.43));
}
int count=nprimitives(0);vector lo,hi;getbbox(0,lo,hi);
int caps=chi("caps");
for(int pr=0;pr<count;pr++){
 if(prim(0,"functional_kind",pr)!="guild_pier"||int(prim(0,"floor_i",pr))!=0)continue;
 vector n=prim(0,"facade_normal",pr),u=prim(0,"edge_u",pr),up={0,1,0};
 float b=prim(0,"floor_b",pr),w=prim(0,"bay_width",pr),top=hi.y+.45;
 int sign=int(prim(0,"bay_i",pr))==0?-1:1;
 vector p=primuv(0,"P",pr,set(.5,.5,0));p+=u*sign*(w*.5-.45)+n*.28;
 string id="guild/"+string(prim(0,"facade_slot",pr));
 if(caps){p.y=top+.55;part(p,u,n,set(1.5,1.10,1.5),id+"/pyramid","tile");continue;}
 p.y=b+.12;part(p,u,n,set(1.32,.24,1.32),id+"/plinth","stone");
 int courses=max(1,int(ceil((top-b-.24)/.44)));float height=(top-b-.24)/courses;
 for(int j=0;j<courses;j++){
  p.y=b+.24+(j+.5)*height;float span=j%2?1.06:1.14;
  part(p,u,n,set(span,height-.012,span),id+"/course_"+itoa(j),"stone");
 }
 p.y=top-.08;part(p,u,n,set(1.32,.18,1.32),id+"/capital","stone");
 if(int(prim(0,"side",pr))==0){
  p.y=b+2.7;part(p+n*.62,u,n,set(.62,1.45,.055),id+"/banner","teal");
  p.y=b+3.48;part(p+n*.64,u,n,set(.84,.10,.10),id+"/banner_rail","wood");
 }
}
for(int pr=count-1;pr>=0;pr--)removeprim(0,pr,1);
