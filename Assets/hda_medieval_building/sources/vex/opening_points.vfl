// Shared clear apertures; reserve the FULL shutter/frame envelope inside each bay.
int count=nprimitives(0);vector up={0,1,0};
for(int src=0;src<count;src++){
 string kind=prim(0,"opening",src);if(kind!="W"&&kind!="D")continue;
 vector n=prim(0,"facade_normal",src),u=prim(0,"edge_u",src);
 vector c=primuv(0,"P",src,set(.5,.5,0));
 float b=prim(0,"floor_b",src),fh=prim(0,"floor_h",src),bay=prim(0,"bay_width",src);
 float pw=kind=="D"?ch("../door_width_m"):ch("../window_width_m");
 float ph=kind=="D"?ch("../door_height_m"):ch("../window_height_m");
 float frame=ch("../frame_width_m");
 float envelope=pw+(kind=="W"&&chi("../shutters_enable")?pw*.68:0.)+2*frame;
 float sx=min(1.,max(.1,bay-.42)/max(.01,envelope));
 float sy=min(1.,max(.1,fh-.44)/max(.1,ph+2*frame));
 float bottom=kind=="D"?b+ch("../floor_thickness_m"):b+max(.72,(fh-ph*sy)*.48);
 c.y=bottom+ph*sy*.5;c+=n*.015;
 int pt=addpoint(0,c);matrix3 m=set(u*sx,up*sy,-n);
 setpointattrib(0,"transform",pt,m);
 setpointattrib(0,"opening_kind",pt,kind);
 setpointattrib(0,"opening_id",pt,string(prim(0,"bay_id",src)));
 setpointattrib(0,"level_key",pt,string(prim(0,"level_key",src)));
 setpointattrib(0,"outward",pt,n);
 setpointattrib(0,"aperture_w",pt,pw*sx);setpointattrib(0,"aperture_h",pt,ph*sy);
 setpointattrib(0,"envelope_w",pt,envelope*sx);setpointattrib(0,"bay_width",pt,bay);
 setpointattrib(0,"opening_bottom",pt,bottom);setpointattrib(0,"opening_top",pt,bottom+ph*sy);
 setpointattrib(0,"floor_i",pt,int(prim(0,"floor_i",src)));
 setpointattrib(0,"side",pt,int(prim(0,"side",src)));
 setpointattrib(0,"role",pt,string(prim(0,"role",src)));
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
