// The inside framing uses the SAME visible bay stream as the outside.
void member(vector p;vector u;vector n;vector size;string name;int floor){
 int pt=addpoint(0,p);matrix3 m=set(u*size.x,set(0,1,0)*size.y,n*size.z);
 setpointattrib(0,"transform",pt,m);setpointattrib(0,"part_name",pt,name);
 setpointattrib(0,"part_material",pt,"wood");setpointattrib(0,"part_color",pt,set(.27,.19,.12));
 setpointattrib(0,"floor_i",pt,floor);setpointattrib(0,"role",pt,"main");
}
int count=nprimitives(0);
if(chi("../enable"))for(int pr=0;pr<count;pr++){
 vector n=prim(0,"facade_normal",pr),u=prim(0,"edge_u",pr);
 float b=prim(0,"floor_b",pr),h=prim(0,"floor_h",pr),w=prim(0,"bay_width",pr);
 vector c=primuv(0,"P",pr,set(.5,.5,0));c.y=b+h*.5;c-=n*(ch("../wall_thickness")+.035);
 string id="interior/frame/"+string(prim(0,"bay_id",pr));int f=prim(0,"floor_i",pr);
 member(c-u*w*.5,u,n,set(.12,h-.25,.12),id+"/post",f);
 if(int(prim(0,"bay_i",pr))==int(prim(0,"bay_count",pr))-1)
  member(c+u*w*.5,u,n,set(.12,h-.25,.12),id+"/end_post",f);
 for(int j=0;j<2;j++){
  vector p=c;p.y=b+(j==0?.16:h-.14);
  member(p,u,n,set(max(.05,w-.12),.14,.14),id+(j==0?"/sole":"/plate"),f);
 }
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
