void beam(vector a;vector b;float width;string name){
 vector along=normalize(b-a),ref=abs(along.y)<.95?set(0,1,0):set(1,0,0);
 vector u=normalize(cross(along,ref)),z=cross(u,along);
 int pt=addpoint(0,(a+b)*.5);matrix3 m=set(u*width,along*distance(a,b),z*width);
 setpointattrib(0,"transform",pt,m);setpointattrib(0,"name",pt,name);
}
int count=nprimitives(0);
if(chs("../roof_shape")=="gable")for(int pr=0;pr<count;pr++){
 if(int(prim(0,"is_round",pr)))continue;
 vector center=prim(0,"role_center",pr);float angle=prim(0,"rot_y",pr);
 matrix3 rot=ident();rotate(rot,radians(angle),{0,1,0});
 float w=prim(0,"width",pr),d=prim(0,"depth",pr),top=prim(0,"top_y",pr),h=prim(0,"roof_h",pr);
 for(int side=-1;side<=1;side+=2){
  float z=side*(d*.5+.035);string id="gable/"+string(prim(0,"role",pr))+"/"+itoa(side);
  vector a=set(-w*.5,top+.08,z),b=set(w*.5,top+.08,z),peak=set(0,top+h-.10,z);
  beam(a*rot+center,b*rot+center,.18,id+"/tie");
  float bottom=top+.15;
  if(side==-1&&chi("../attic_window_enable")&&string(prim(0,"role",pr))=="main")
   bottom=top+.88+ch("../window_height_m")*.35+.14;
  if(top+h-.10>bottom)beam(set(0,bottom,z)*rot+center,peak*rot+center,.16,id+"/king_post");
  for(int sign=-1;sign<=1;sign+=2){
   vector p=set(sign*w*.40,top+.14,z),q=set(sign*w*.13,top+h*.70,z);
   beam(p*rot+center,q*rot+center,.14,id+"/strut_"+itoa(sign));
  }
 }
}
for(int p=count-1;p>=0;p--)removeprim(0,p,1);
