// WINGS: core volume + roof of every wing footprint (OUT_WING_PLAN, input 1; input 2 = OUT_FOOTPRINT, used
// to find the main roof for the cross-gable valley). Facades of the wings come from
// LAYOUT + MOD_* like the main body. Local frame per wing: origin O = middle of the edge against the
// main body, `out` = away from the main body, `along` = parallel to that wall.
// roof: 0 cross gable (ridge along `out`, gable on the outer face, runs `back` metres into the main roof)
//       1 shed sloping away from the main wall, 2 gable parallel to the main wall, 3 flat slab.
float gh = ch("../ground_h"), fh = ch("../floor_h"), t = ch("../wall_t");
float ov = ch("../roof_overhang"), rt = ch("../roof_t");
vector up = {0,1,0};
for (int w = 0; w < nprimitives(1); w++) {
    int pts[] = primpoints(1, w);
    if (len(pts) != 4) continue;
    vector A = point(1, "P", pts[0]), B = point(1, "P", pts[1]), C = point(1, "P", pts[2]);
    vector along = normalize(A - B);
    vector out = normalize(C - B);
    float ww = distance(A, B), dd = distance(B, C);
    vector O = (A + B) * 0.5;
    int nf = prim(1, "floors", w);
    int rtype = prim(1, "roof", w);
    float pitch = prim(1, "pitch", w);
    float back = prim(1, "back", w);
    float Hw = gh + (max(nf, 1) - 1) * fh;
    float tp = tan(radians(pitch));

    if (!chi("../interior")) {
        // core: inset box (rectangle) up to the wing eave
        vector q[] = array(A - along * t + out * t, B + along * t + out * t, C + along * t - out * t,
                           A + (C - B) - along * t - out * t);
        for (int i = 0; i < 4; i++) {
            vector a = q[i], b = q[(i + 1) % 4];
            add_poly(array(a, b, b + set(0, Hw, 0), a + set(0, Hw, 0)), cross(normalize(b - a), up), "wall", "core");
        }
        vector top[];
        foreach (vector p; q) append(top, p + set(0, Hw, 0));
        add_poly(top, up, "roof", "core_top");
    } else {
        // interior shell: floor slabs + ceiling, open towards the main wall (the wing has no wall there),
        // half-way into the side and outer walls
        float  h2 = t * 0.5;
        float  ft = ch("../floor_t"), ct = ch("../ceiling_t");
        string fm = chi("../interior_floor_mat") == 1 ? "stone" : "timber";
        vector q[] = array(A - along * h2, B + along * h2, C + along * h2 - out * h2, A + (C - B) - along * h2 - out * h2);
        for (int k = 0; k < max(nf, 1); k++) {
            vector s0[];
            foreach (vector p; q) append(s0, p + set(0, (k == 0) ? 0 : gh + (k - 1) * fh, 0));
            add_slab(s0, up, ft, fm, "floor", k == 0 ? "slab_under" : "ceiling");
        }
        float cy = (rtype == 3) ? Hw - max(rt, 0.1) : Hw;   // a flat wing roof sits on the eave line
        vector s1[];
        foreach (vector p; q) append(s1, p + set(0, cy, 0));
        add_slab(s1, up, ct, "wall", "ceiling_top", "ceiling");
    }

    vector base = O;
    base.y = Hw;
    if (rtype == 0) {
        // Cross gable. Each slope runs back only to where it meets the main roof (the valley), 10 cm further
        // so it is tucked into the main slab. Before, both slopes ran `back` metres at full width: their
        // eaves went through the main wall and showed under the ceiling of the room behind it.
        //   pitched main roof, wing on an eave side : valley from the wing eave to the wing ridge
        //   pitched main roof, wing on a gable end  : the roof stops inside the main wall
        //   flat main roof                          : unchanged, `back` metres over the flat roof
        float half = ww * 0.5 + ov;
        float ey = -ov * tp, ry = ey + half * tp;
        float r_ridge = -back - ov, r_eave = -back - ov;     // back end of the ridge / of the valley's low end
        float sc = half;                                     // |s| of the valley's low end (half = at the eave)
        if (chi("../roof_type") != 0) {
            r_ridge = -t * 0.5;
            r_eave = -t * 0.5;
            if (nprimitives(2) > 0) {
                int mp = min(1, nprimitives(2) - 1);
                vector mp0, mR, mS;
                float mr0, mr1, ms0, ms1;
                roof_frame(2, mp, chi("../roof_axis"), mp0, mR, mS, mr0, mr1, ms0, ms1);
                float side = dot(mS, out);
                if (abs(side) > 0.7) {
                    float mtp   = max(tan(radians(ch("../roof_pitch"))), 1e-3);
                    float Hm    = gh + chi("../floor_n") * fh;
                    float mhalf = (ms1 - ms0) * 0.5;
                    float so    = dot(O - mp0, mS);
                    float jo    = (side > 0) ? ms1 - so : so - ms0;   // O to the upper wall line (jetty)
                    float hcut  = Hm - ov * mtp - Hw;        // main eave edge, as a height above the wing wall top
                    float ylow  = max(ey, hcut);             // the valley exists above this height only
                    sc = clamp(half - (ylow - ey) / max(tp, 1e-3), 0.0, half);
                    r_ridge = jo - clamp((Hw - Hm + ry) / mtp, 0.0, mhalf) - 0.1;
                    r_eave  = jo - clamp((Hw - Hm + ylow) / mtp, -ov, mhalf) - 0.1;
                }
            }
        }
        float rb = dd + ov;
        float yc = ry - sc * tp;                             // slope height at |s| = sc
        float _sg_list0[] = array(-1.0, 1.0);
        foreach (float sg; _sg_list0) {
            if (sc > 1e-3) {                                 // ridge side: cut by the valley
                vector SA[] = array(rp(base, out, along, r_eave, sg * sc, yc), rp(base, out, along, rb, sg * sc, yc),
                                   rp(base, out, along, rb, 0, ry), rp(base, out, along, r_ridge, 0, ry));
                add_slab(SA, up_normal(SA), rt, "roof", "slope", "soffit");
            }
            if (sc < half - 1e-3) {                          // strip lower than the main eave: runs to the main wall
                vector SB[] = array(rp(base, out, along, -t * 0.5, sg * half, ey), rp(base, out, along, rb, sg * half, ey),
                                   rp(base, out, along, rb, sg * sc, yc), rp(base, out, along, -t * 0.5, sg * sc, yc));
                add_slab(SB, up_normal(SB), rt, "roof", "slope", "soffit");
            }
        }
        add_poly(array(rp(base, out, along, dd, -ww * 0.5, 0), rp(base, out, along, dd, ww * 0.5, 0),
                       rp(base, out, along, dd, 0, ry)), out, "wall", "gable");
    } else if (rtype == 1)
        shed_roof(base, along, out, -ww * 0.5, ww * 0.5, 0, dd, dd * tp, 0, ov, rt, 1, "wall");
    else if (rtype == 2)
        gable_roof(base, along, out, -ww * 0.5, ww * 0.5, 0, dd, tp, ov, ov, rt, 0, 1, 1, "wall");
    else {
        vector s[] = array(rp(base, along, out, -ww*0.5-ov, 0, 0), rp(base, along, out, ww*0.5+ov, 0, 0),
                           rp(base, along, out, ww*0.5+ov, dd+ov, 0), rp(base, along, out, -ww*0.5-ov, dd+ov, 0));
        add_slab(s, up, max(rt, 0.1), "roof", "slope", "soffit");
    }
}
